rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ---------- Owner-side member uploads ----------
    // Path: memberOnboarding/{memberId}/{filename}
    // The member's owner (signed-in, approved) can write here. Supervisors of
    // that owner with `canEditMembers` may also upload — scoped to their
    // parent owner's members only.
    match /memberOnboarding/{memberId}/{filename} {
      function memberOwnerId() {
        return firestore.get(/databases/(default)/documents/members/$(memberId)).data.ownerId;
      }

      function isSupervisorOfMemberOwner() {
        return firestore.exists(/databases/(default)/documents/supervisors/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/supervisors/$(request.auth.uid)).data.status == 'active'
          && firestore.get(/databases/(default)/documents/supervisors/$(request.auth.uid)).data.ownerId == memberOwnerId()
          && firestore.get(/databases/(default)/documents/supervisors/$(request.auth.uid)).data.permissions.canEditMembers == true;
      }

      allow read: if true;

      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/members/$(memberId))
        && (
          memberOwnerId() == request.auth.uid
          || isSupervisorOfMemberOwner()
        )
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ---------- Public uploads via a verified onboarding token ----------
    // Path: memberOnboardingPublic/{token}/{filename}
    // No auth required, but the token must currently be active+verified+unexpired.
    match /memberOnboardingPublic/{token}/{filename} {
      allow read: if true;

      allow write: if firestore.exists(/databases/(default)/documents/memberOnboardingLinks/$(token))
        && firestore.get(/databases/(default)/documents/memberOnboardingLinks/$(token)).data.status == 'active'
        && firestore.get(/databases/(default)/documents/memberOnboardingLinks/$(token)).data.verifiedAt is timestamp
        && firestore.get(/databases/(default)/documents/memberOnboardingLinks/$(token)).data.expiresAt > request.time
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Default: deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
