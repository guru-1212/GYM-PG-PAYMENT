    </div>\r
  }\r
</div>\r
\r
<ng-template #ownerSectionsTpl>\r
  <section class="nb-section" aria-labelledby="nb-sec-alerts">\r
    <div class="nb-section-head">\r
      <h3 id="nb-sec-alerts" class="nb-section-title">Your alerts</h3>\r
      <span class="nb-section-hint">{{ ownerRows().length }} total</span>\r
    </div>\r
    @if (ownerRows().length === 0) {\r
      <p class="nb-empty">No alerts yet.</p>\r
    } @else {\r
      <div class="nb-table-scroll">\r
        <table class="nb-table">\r
          <colgroup>\r
            <col class="nb-col-time" />\r
            <col class="nb-col-title" />\r
            <col class="nb-col-msg" />\r
            <col class="nb-col-status" />\r
          </colgroup>\r
          <thead>\r
            <tr>\r
              <th scope="col">When</th>\r
              <th scope="col">Title</th>\r
              <th scope="col">Message</th>\r
              <th scope="col">Status</th>\r
            </tr>\r
          </thead>\r
          <tbody>\r
            @for (n of ownerRows(); track trackOwner($index, n)) {\r
              <tr\r
                class="nb-tr"\r
                [class.nb-tr--unread]="!n.read"\r
                (click)="onPickOwner(n)"\r
                (keydown.enter)="onPickOwner(n)"\r
                tabindex="0"\r
                role="button"\r
              >\r
                <td class="nb-td nb-td--time">\r
                  @if (n.createdAt; as ca) {\r
                    {{ ca.toDate() | date: 'MMM d, y, h:mm a' }}\r
                  } @else {\r
                    \u2014\r
                  }\r
                </td>\r
                <td class="nb-td nb-td--title">{{ n.title }}</td>\r
                <td class="nb-td nb-td--msg">{{ previewText(n.body, 120) }}</td>\r
                <td class="nb-td nb-td--status">\r
                  <span class="nb-pill" [class.nb-pill--unread]="!n.read">{{ n.read ? 'Read' : 'Unread' }}</span>\r
                </td>\r
              </tr>\r
            }\r
          </tbody>\r
        </table>\r
      </div>\r
    }\r
  </section>\r
\r
  <section class="nb-section" aria-labelledby="nb-sec-sent">\r
    <div class="nb-section-head">\r
      <h3 id="nb-sec-sent" class="nb-section-title">Sent to members</h3>\r
      <span class="nb-section-hint">History</span>\r
    </div>\r
    @if (ownerSentRows().length === 0) {\r
      <p class="nb-empty">No messages sent yet. Use Notify members to broadcast.</p>\r
    } @else {\r
      <div class="nb-table-scroll">\r
        <table class="nb-table nb-table--sent">\r
          <colgroup>\r
            <col class="nb-col-time" />\r
            <col class="nb-col-title" />\r
            <col class="nb-col-msg" />\r
          </colgroup>\r
          <thead>\r
            <tr>\r
              <th scope="col">When</th>\r
              <th scope="col">Title</th>\r
              <th scope="col">Message</th>\r
            </tr>\r
          </thead>\r
          <tbody>\r
            @for (b of ownerSentRows(); track trackSent($index, b)) {\r
              <tr class="nb-tr">\r
                <td class="nb-td nb-td--time">\r
                  @if (b.createdAt; as ca) {\r
                    {{ ca.toDate() | date: 'MMM d, y, h:mm a' }}\r
                  } @else {\r
                    \u2014\r
                  }\r
                </td>\r
                <td class="nb-td nb-td--title">{{ b.title }}</td>\r
                <td class="nb-td nb-td--msg">{{ previewText(b.body, 160) }}</td>\r
              </tr>\r
            }\r
          </tbody>\r
        </table>\r
      </div>\r
    }\r
  </section>\r
</ng-template>\r
`, styles: ["/* src/app/shared/notification-bell/notification-bell.component.scss */\n:host {\n  display: inline-flex;\n  align-items: center;\n}\n:host.nb-host--page {\n  display: block;\n  width: 100%;\n}\n.nb-wrap {\n  display: contents;\n}\n.nb-wrap--page {\n  display: block;\n  width: 100%;\n}\n.nb-page {\n  width: 100%;\n  max-width: 56rem;\n  margin: 0 auto;\n}\n.nb-page-head {\n  margin-bottom: 0.75rem;\n}\n.nb-page-body {\n  padding-top: 0.25rem;\n}\n.nb-root {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n}\n.nb-root--hub {\n  flex-direction: row;\n  align-items: center;\n}\n.nb-hub {\n  display: inline-flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.2rem;\n  border-radius: 0.85rem;\n  background: rgb(248, 250, 252);\n  border: 1px solid rgb(226, 232, 240);\n}\n:host-context(.dark) .nb-hub {\n  background: rgb(30, 41, 59);\n  border-color: rgb(51, 65, 85);\n}\n.nb-tab-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.4rem;\n  padding: 0.45rem 0.85rem;\n  border-radius: 0.65rem;\n  border: 1px solid rgb(226, 232, 240);\n  background: white;\n  font-size: 0.8rem;\n  font-weight: 700;\n  color: rgb(51, 65, 85);\n  cursor: pointer;\n  transition: background 0.15s ease, box-shadow 0.15s ease;\n}\n.nb-tab-btn:hover {\n  background: rgb(239, 246, 255);\n  box-shadow: 0 2px 8px rgba(79, 70, 229, 0.12);\n}\n:host-context(.dark) .nb-tab-btn {\n  border-color: rgb(71, 85, 105);\n  background: rgb(15, 23, 42);\n  color: rgb(226, 232, 240);\n}\n:host-context(.dark) .nb-tab-btn:hover {\n  background: rgba(49, 46, 129, 0.35);\n}\n.nb-ico-svg {\n  display: block;\n  flex-shrink: 0;\n  width: 1.35rem;\n  height: 1.35rem;\n}\n.nb-ico-svg--tab {\n  width: 1.1rem;\n  height: 1.1rem;\n  opacity: 0.88;\n}\n.nb-ico-svg--close {\n  width: 1.25rem;\n  height: 1.25rem;\n}\n.nb-tab-count {\n  min-width: 1.15rem;\n  padding: 0 0.35rem;\n  border-radius: 999px;\n  background: rgb(220, 38, 38);\n  color: white;\n  font-size: 0.65rem;\n  font-weight: 800;\n  line-height: 1.25rem;\n  text-align: center;\n}\n.nb-trigger--pair {\n  width: 2.5rem;\n  height: 2.5rem;\n  padding: 0;\n}\n.nb-trigger {\n  position: relative;\n  z-index: 2;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 2.5rem;\n  height: 2.5rem;\n  border-radius: 0.75rem;\n  border: 1px solid rgb(226, 232, 240);\n  background: white;\n  color: rgb(51, 65, 85);\n  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);\n  cursor: pointer;\n  transition:\n    background 0.15s ease,\n    box-shadow 0.15s ease,\n    transform 0.12s ease;\n}\n.nb-trigger:hover {\n  background: rgb(248, 250, 252);\n  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);\n  transform: translateY(-1px);\n}\n:host-context(.dark) .nb-trigger {\n  border-color: rgb(71, 85, 105);\n  background: rgb(30, 41, 59);\n  color: rgb(226, 232, 240);\n}\n:host-context(.dark) .nb-trigger:hover {\n  background: rgb(51, 65, 85);\n}\n.nb-badge {\n  position: absolute;\n  top: -0.15rem;\n  right: -0.15rem;\n  min-width: 1.1rem;\n  padding: 0 0.28rem;\n  border-radius: 999px;\n  background: rgb(220, 38, 38);\n  color: white;\n  font-size: 0.65rem;\n  font-weight: 700;\n  line-height: 1.2rem;\n  text-align: center;\n}\n.nb-backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 100;\n  background: rgba(15, 23, 42, 0.45);\n  backdrop-filter: blur(4px);\n  -webkit-backdrop-filter: blur(4px);\n  animation: nb-fade-in 0.2s ease;\n}\n@keyframes nb-fade-in {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n.nb-drawer {\n  position: fixed;\n  top: 0;\n  right: 0;\n  z-index: 101;\n  display: flex;\n  flex-direction: column;\n  width: min(100vw, 36rem);\n  max-width: 100vw;\n  height: 100%;\n  height: 100dvh;\n  background: white;\n  border-left: 1px solid rgb(226, 232, 240);\n  box-shadow: -12px 0 40px rgba(15, 23, 42, 0.12);\n  animation: nb-slide-in 0.28s cubic-bezier(0.22, 1, 0.36, 1);\n}\n@media (max-width: 480px) {\n  .nb-drawer {\n    width: 100vw;\n    max-width: 100vw;\n    border-left: none;\n  }\n}\n@keyframes nb-slide-in {\n  from {\n    transform: translateX(100%);\n    opacity: 0.96;\n  }\n  to {\n    transform: translateX(0);\n    opacity: 1;\n  }\n}\n:host-context(.dark) .nb-drawer {\n  background: rgb(15, 23, 42);\n  border-left-color: rgb(51, 65, 85);\n  box-shadow: -12px 0 48px rgba(0, 0, 0, 0.5);\n}\n.nb-drawer-head {\n  flex-shrink: 0;\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 0.75rem;\n  padding: 1rem 1rem 0.75rem;\n  border-bottom: 1px solid rgb(241, 245, 249);\n}\n:host-context(.dark) .nb-drawer-head {\n  border-bottom-color: rgb(51, 65, 85);\n}\n.nb-drawer-head-text {\n  min-width: 0;\n}\n.nb-drawer-title {\n  margin: 0;\n  font-size: 1.125rem;\n  font-weight: 800;\n  letter-spacing: -0.02em;\n  color: rgb(15, 23, 42);\n}\n:host-context(.dark) .nb-drawer-title {\n  color: rgb(248, 250, 252);\n}\n.nb-drawer-sub {\n  margin: 0.25rem 0 0;\n  font-size: 0.8rem;\n  line-height: 1.4;\n  color: rgb(100, 116, 139);\n}\n:host-context(.dark) .nb-drawer-sub {\n  color: rgb(148, 163, 184);\n}\n.nb-drawer-close {\n  flex-shrink: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 2.5rem;\n  height: 2.5rem;\n  margin: -0.25rem -0.25rem 0 0;\n  border: none;\n  border-radius: 0.65rem;\n  background: rgb(241, 245, 249);\n  color: rgb(51, 65, 85);\n  cursor: pointer;\n  transition: background 0.15s ease;\n}\n.nb-drawer-close:hover {\n  background: rgb(226, 232, 240);\n}\n:host-context(.dark) .nb-drawer-close {\n  background: rgb(30, 41, 59);\n  color: rgb(226, 232, 240);\n}\n:host-context(.dark) .nb-drawer-close:hover {\n  background: rgb(51, 65, 85);\n}\n.nb-drawer-toolbar {\n  flex-shrink: 0;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.5rem 1rem 0.75rem;\n  border-bottom: 1px solid rgb(241, 245, 249);\n}\n:host-context(.dark) .nb-drawer-toolbar {\n  border-bottom-