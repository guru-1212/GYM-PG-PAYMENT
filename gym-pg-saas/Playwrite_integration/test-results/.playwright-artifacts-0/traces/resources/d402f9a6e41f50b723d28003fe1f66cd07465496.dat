    (() => {
      (typeof ngDevMode === "undefined" || ngDevMode) && i0.\u0275setClassMetadata(NotificationBellComponent, [{
        type: Component,
        args: [{ selector: "app-notification-bell", standalone: true, imports: [DatePipe, NgTemplateOutlet], template: `<div class="nb-wrap" [class.nb-wrap--page]="pageMode && mode === 'owner'">\r
  @if (pageMode && mode === 'owner') {\r
    <div class="nb-page">\r
      <header class="nb-page-head">\r
        <h2 class="nb-drawer-title">Notifications</h2>\r
        <p class="nb-drawer-sub">Your alerts and messages sent to members</p>\r
      </header>\r
      <div class="nb-drawer-toolbar">\r
        @if (unreadOwnerCount() > 0) {\r
          <button type="button" class="nb-toolbar-btn" (click)="markAllOwnerRead()">Mark all alerts read</button>\r
        }\r
      </div>\r
      <div class="nb-drawer-body nb-page-body">\r
        <ng-container *ngTemplateOutlet="ownerSectionsTpl"></ng-container>\r
      </div>\r
    </div>\r
  } @else {\r
    <div class="nb-root" [class.nb-root--hub]="hub && mode === 'owner'" data-notify-bell-root>\r
      @if (menuOpen()) {\r
        <div class="nb-backdrop" (click)="closeMenu()" aria-hidden="true"></div>\r
        <aside\r
          id="nb-drawer"\r
          class="nb-drawer"\r
          role="dialog"\r
          aria-modal="true"\r
          aria-labelledby="nb-drawer-title"\r
          (click)="$event.stopPropagation()"\r
        >\r
          <header class="nb-drawer-head">\r
            <div class="nb-drawer-head-text">\r
              <h2 id="nb-drawer-title" class="nb-drawer-title">Notifications</h2>\r
              <p class="nb-drawer-sub">\r
                {{ mode === 'owner' ? 'Your alerts and messages sent to members' : 'Messages from your owner' }}\r
              </p>\r
            </div>\r
            <button type="button" class="nb-drawer-close" (click)="closeMenu()" aria-label="Close panel">\r
              <svg class="nb-ico-svg nb-ico-svg--close" viewBox="0 0 24 24" fill="none" aria-hidden="true">\r
                <path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />\r
              </svg>\r
            </button>\r
          </header>\r
\r
          <div class="nb-drawer-toolbar">\r
            @if (mode === 'owner' && unreadOwnerCount() > 0) {\r
              <button type="button" class="nb-toolbar-btn" (click)="markAllOwnerRead()">Mark all alerts read</button>\r
            }\r
            @if (mode === 'member' && unreadMemberCount() > 0) {\r
              <button type="button" class="nb-toolbar-btn" (click)="markAllMemberRead()">Mark all read</button>\r
            }\r
          </div>\r
\r
          <div class="nb-drawer-body">\r
            @if (mode === 'owner') {\r
              <ng-container *ngTemplateOutlet="ownerSectionsTpl"></ng-container>\r
            } @else {\r
              <section class="nb-section" aria-labelledby="nb-sec-member">\r
                <div class="nb-section-head">\r
                  <h3 id="nb-sec-member" class="nb-section-title">Your messages</h3>\r
                  <span class="nb-section-hint">{{ memberRows().length }} total</span>\r
                </div>\r
                @if (memberRows().length === 0) {\r
                  <p class="nb-empty">No messages yet.</p>\r
                } @else {\r
                  <div class="nb-table-scroll">\r
                    <table class="nb-table">\r
                      <colgroup>\r
                        <col class="nb-col-time" />\r
                        <col class="nb-col-title" />\r
                        <col class="nb-col-msg" />\r
                        <col class="nb-col-status" />\r
                      </colgroup>\r
                      <thead>\r
                        <tr>\r
                          <th scope="col">When</th>\r
                          <th scope="col">Title</th>\r
                          <th scope="col">Message</th>\r
                          <th scope="col">Status</th>\r
                        </tr>\r
                      </thead>\r
                      <tbody>\r
                        @for (b of memberRows(); track trackMember($index, b)) {\r
                          <tr\r
                            class="nb-tr"\r
                            [class.nb-tr--unread]="isMemberBroadcastUnread(b)"\r
                            (click)="onPickMemberBroadcast(b)"\r
                            (keydown.enter)="onPickMemberBroadcast(b)"\r
                            tabindex="0"\r
                            role="button"\r
                          >\r
                            <td class="nb-td nb-td--time">\r
                              @if (b.createdAt; as ca) {\r
                                {{ ca.toDate() | date: 'MMM d, y, h:mm a' }}\r
                              } @else {\r
                                \u2014\r
                              }\r
                            </td>\r
                            <td class="nb-td nb-td--title">{{ b.title }}</td>\r
                            <td class="nb-td nb-td--msg">{{ previewText(b.body, 120) }}</td>\r
                            <td class="nb-td nb-td--status">\r
                              <span class="nb-pill" [class.nb-pill--unread]="isMemberBroadcastUnread(b)">\r
                                {{ isMemberBroadcastUnread(b) ? 'New' : 'Seen' }}\r
                              </span>\r
                            </td>\r
                          </tr>\r
                        }\r
                      </tbody>\r
                    </table>\r
                  </div>\r
                }\r
              </section>\r
            }\r
          </div>\r
        </aside>\r
      }\r
\r
      @if (hub && mode === 'owner') {\r
        <div class="nb-hub" (click)="$event.stopPropagation()">\r
          <button\r
            type="button"\r
            class="nb-tab-btn"\r
            (click)="toggleMenu(); $event.stopPropagation()"\r
            [attr.aria-expanded]="menuOpen()"\r
            aria-controls="nb-drawer"\r
          >\r
            <svg class="nb-ico-svg nb-ico-svg--tab" viewBox="0 0 24 24" fill="none" aria-hidden="true">\r
              <path\r
                stroke="currentColor"\r
                stroke-width="1.75"\r
                stroke-linecap="round"\r
                stroke-linejoin="round"\r
                d="M20 13V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v6m16 0-4 4H8l-4-4m16 0v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-4"\r
              />\r
            </svg>\r
            <span>Notifications</span>\r
            @if (badgeCount() > 0) {\r
              <span class="nb-tab-count">{{ badgeCount() > 99 ? '99+' : badgeCount() }}</span>\r
            }\r
          </button>\r
          <!-- <button\r
            type="button"\r
            class="nb-trigger nb-trigger--pair"\r
            (click)="toggleMenu(); $event.stopPropagation()"\r
            [attr.aria-expanded]="menuOpen()"\r
            aria-controls="nb-drawer"\r
            aria-label="Notifications"\r
          >\r
            <svg class="nb-ico-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">\r
              <path\r
                d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"\r
                stroke="currentColor"\r
                stroke-width="1.75"\r
                stroke-linecap="round"\r
                stroke-linejoin="round"\r
              />\r
              <path\r
                d="M10.29 21a1.73 1.73 0 0 0 3.42 0"\r
                stroke="currentColor"\r
                stroke-width="1.75"\r
                stroke-linecap="round"\r
                stroke-linejoin="round"\r
              />\r
            </svg>\r
            @if (badgeCount() > 0) {\r
              <span class="nb-badge">{{ badgeCount() > 99 ? '99+' : badgeCount() }}</span>\r
            }\r
          </button> -->\r
        </div>\r
      } @else {\r
        <!-- <button\r
          type="button"\r
          class="nb-trigger"\r
          (click)="toggleMenu(); $event.stopPropagation()"\r
          [attr.aria-expanded]="menuOpen()"\r
          aria-label="Notifications"\r
        >\r
          <svg class="nb-ico-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">\r
            <path\r
              d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"\r
