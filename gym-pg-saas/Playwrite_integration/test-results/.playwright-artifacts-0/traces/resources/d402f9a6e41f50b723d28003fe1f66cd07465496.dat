28%;\n}\n.nb-col-title {\n  width: 22%;\n}\n.nb-col-msg {\n  width: auto;\n}\n.nb-col-status {\n  width: 14%;\n}\n.nb-table--sent .nb-col-time {\n  width: 30%;\n}\n.nb-table--sent .nb-col-title {\n  width: 26%;\n}\n.nb-table thead {\n  position: sticky;\n  top: 0;\n  z-index: 1;\n  background: rgb(248, 250, 252);\n  box-shadow: 0 1px 0 rgb(226, 232, 240);\n}\n:host-context(.dark) .nb-table thead {\n  background: rgb(30, 41, 59);\n  box-shadow: 0 1px 0 rgb(51, 65, 85);\n}\n.nb-table th {\n  padding: 0.55rem 0.65rem;\n  text-align: left;\n  font-weight: 700;\n  color: rgb(71, 85, 105);\n  white-space: nowrap;\n}\n:host-context(.dark) .nb-table th {\n  color: rgb(203, 213, 225);\n}\n.nb-table td {\n  padding: 0.55rem 0.65rem;\n  vertical-align: top;\n  border-top: 1px solid rgb(241, 245, 249);\n  color: rgb(51, 65, 85);\n}\n:host-context(.dark) .nb-table td {\n  border-top-color: rgb(51, 65, 85);\n  color: rgb(226, 232, 240);\n}\n.nb-tr {\n  cursor: pointer;\n  transition: background 0.12s ease;\n}\n.nb-tr:hover {\n  background: rgb(248, 250, 252);\n}\n:host-context(.dark) .nb-tr:hover {\n  background: rgb(30, 41, 59);\n}\n.nb-tr:focus-visible {\n  outline: 2px solid rgb(99, 102, 241);\n  outline-offset: -2px;\n}\n.nb-tr--unread {\n  background: rgba(239, 246, 255, 0.85);\n}\n:host-context(.dark) .nb-tr--unread {\n  background: rgba(49, 46, 129, 0.35);\n}\n.nb-td--time {\n  white-space: nowrap;\n  font-variant-numeric: tabular-nums;\n  font-size: 0.75rem;\n  color: rgb(100, 116, 139);\n  width: 1%;\n}\n.nb-td--title {\n  font-weight: 700;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  word-break: normal;\n}\n.nb-td--msg {\n  word-break: normal;\n  overflow-wrap: break-word;\n  line-height: 1.4;\n  color: rgb(71, 85, 105);\n  white-space: normal;\n}\n:host-context(.dark) .nb-td--msg {\n  color: rgb(148, 163, 184);\n}\n.nb-td--status {\n  width: 1%;\n  white-space: nowrap;\n}\n.nb-pill {\n  display: inline-block;\n  padding: 0.15rem 0.45rem;\