// src/app/core/utils/member-import-sample.util.ts
function memberImportSampleAoA(isPg) {
  const header = ["name", "mobile", "plan", "dueDate", "subscriptionType", "floor", "room", "bed"];
  if (isPg) {
    return [
      header,
      ["Ravi Kumar", "9876543210", 4e3, "2026-04-30", "monthly", "", "101", 1],
      ["Priya Singh", "9988776655", 5e3, "2026-05-15", "monthly", 2, 4, 2],
      ["Amit Patel", "9123456789", 3500, "2026-06-10", "monthly", "", "407", 1]
    ];
  }
  return [
    header,
    ["Ravi Kumar", "9876543210", 2500, "2026-04-30", "monthly", "", "", ""],
    ["Anita Sharma", "9988776655", 3200, "2026-05-15", "quarterly", "", "", ""],
    ["Vikram Singh", "9123456789", 2e3, "2026-05-20", "monthly", "", "", ""]
  ];
}
function memberImportSampleCsv(isPg) {
  return memberImportSampleAoA(isPg).map((row) => row.map((cell) => {
    const s = String(cell ?? "");
    return /[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
  }).join(",")).join("\n");
}
