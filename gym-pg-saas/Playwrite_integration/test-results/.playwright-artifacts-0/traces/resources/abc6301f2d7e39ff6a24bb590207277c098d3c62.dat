          BrandLogoComponent,
          ThemeToggleComponent,
          ThemePickerComponent
        ], template: `<div class="flex min-h-screen bg-transparent dark:bg-slate-950">\r
  <!-- ============================================================ -->\r
  <!-- Desktop sidebar                                                -->\r
  <!-- ============================================================ -->\r
  <aside\r
    class="hidden w-64 shrink-0 flex-col border-r border-white/60 bg-white/75 backdrop-blur-xl md:sticky md:top-0 md:flex md:h-screen md:max-h-screen md:self-start dark:border-slate-700/70 dark:bg-slate-950/90 dark:backdrop-blur-xl"\r
  >\r
    <div class="shrink-0 border-b border-slate-100/80 px-5 py-5 dark:border-slate-800/80">\r
      <div class="mb-3 flex items-center justify-between gap-2">\r
        <app-brand-logo [logoSize]="'32px'" [showText]="true" brandName="OurPGTracker"></app-brand-logo>\r
      </div>\r
      <!-- Working-under badge: gives the supervisor unambiguous context\r
           about which business their actions are scoped to. -->\r
      <div class="mt-1 rounded-xl border border-indigo-100 bg-gradient-to-br from-indigo-50 to-blue-50 px-3 py-2.5 dark:border-indigo-900/60 dark:from-indigo-950/60 dark:to-blue-950/40">\r
        <p class="text-[10px] font-semibold uppercase tracking-wider text-indigo-700 dark:text-indigo-300">\r
          Working under\r
        </p>\r
        <p class="mt-0.5 truncate text-sm font-semibold text-slate-900 dark:text-slate-100">\r
          {{ parentBusinessName() || parentOwnerName() || 'Loading\u2026' }}\r
        </p>\r
        <p class="mt-1 inline-flex items-center gap-1 rounded-full bg-white/70 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-indigo-700 dark:bg-slate-900/50 dark:text-indigo-300">\r
          <span class="material-icons-outlined text-[12px] leading-none">badge</span>\r
          Supervisor\r
        </p>\r
      </div>\r
    </div>\r
\r
    <nav class="flex min-h-0 flex-1 flex-col gap-1 overflow-y-auto overflow-x-hidden overscroll-contain p-3">\r
      <a\r
        routerLink="/supervisor/dashboard"\r
        routerLinkActive="bg-indigo-50 text-indigo-800 shadow-sm dark:bg-indigo-950/70 dark:text-indigo-100 dark:shadow-md"\r
        [routerLinkActiveOptions]="{ exact: true }"\r
        class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-md dark:text-slate-200 dark:hover:bg-slate-800/90"\r
      >\r
        <span class="material-icons-outlined">dashboard</span>\r
        Dashboard\r
      </a>\r
\r
      @if (canViewMembers()) {\r
        <a\r
          routerLink="/supervisor/members"\r
          routerLinkActive="bg-indigo-50 text-indigo-800 shadow-sm dark:bg-indigo-950/70 dark:text-indigo-100 dark:shadow-md"\r
          class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-md dark:text-slate-200 dark:hover:bg-slate-800/90"\r
        >\r
          <span class="material-icons-outlined">groups</span>\r
          Members\r
        </a>\r
      }\r
\r
      @if (canViewInactiveMembers()) {\r
        <a\r
          routerLink="/supervisor/inactive-members"\r
          routerLinkActive="bg-indigo-50 text-indigo-800 shadow-sm dark:bg-indigo-950/70 dark:text-indigo-100 dark:shadow-md"\r
          class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-md dark:text-slate-200 dark:hover:bg-slate-800/90"\r
        >\r
          <span class="material-icons-outlined">person_off</span>\r
          Inactive members\r
        </a>\r
      }\r
\r
      @if (canViewPayments()) {\r
        <a\r
          routerLink="/supervisor/payments"\r
          routerLinkActive="bg-indigo-50 text-indigo-800 shadow-sm dark:bg-indigo-950/70 dark:text-indigo-100 dark:shadow-md"\r
          class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-md dark:text-slate-200 dark:hover:bg-slate-800/90"\r
        >\r
          <span class="material-icons-outlined">payments</span>\r
          Payments\r
        </a>\r
      }\r
\r
      @if (isPg() && canViewRooms()) {\r
