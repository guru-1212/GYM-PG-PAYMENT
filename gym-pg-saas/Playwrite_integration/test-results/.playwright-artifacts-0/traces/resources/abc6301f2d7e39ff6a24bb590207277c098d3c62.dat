    (() => {
      (typeof ngDevMode === "undefined" || ngDevMode) && i024.\u0275setClassMetadata(MemberOnboardingComponent, [{
        type: Component15,
        args: [{ selector: "app-member-onboarding", standalone: true, imports: [ReactiveFormsModule3], template: `<div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 relative overflow-hidden">\r
  <!-- Background decoration -->\r
  <div class="absolute inset-0 opacity-30">\r
    <div class="absolute top-20 left-20 w-72 h-72 bg-gradient-to-br from-blue-400 to-indigo-600 rounded-full blur-3xl"></div>\r
    <div class="absolute bottom-20 right-20 w-96 h-96 bg-gradient-to-br from-purple-400 to-pink-600 rounded-full blur-3xl"></div>\r
  </div>\r
  \r
  <div class="relative z-10 px-4 py-8">\r
    <div class="mx-auto max-w-2xl">\r
      <!-- Header -->\r
      <header class="mb-8 text-center">\r
        <div class="mb-4 inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-blue-600 to-indigo-600 rounded-2xl shadow-lg">\r
          <span class="material-icons-outlined text-2xl text-white">person_add</span>\r
        </div>\r
        <h1 class="text-3xl font-bold bg-gradient-to-r from-blue-900 to-indigo-900 bg-clip-text text-transparent">Complete Your Profile</h1>\r
        @if (businessName()) {\r
          <p class="mt-2 text-sm text-slate-600">\r
            Welcome to <span class="font-semibold text-indigo-700">{{ businessName() }}</span>\r
          </p>\r
          <p class="mt-1 text-xs text-slate-500">Please fill in your details to get started</p>\r
        }\r
      </header>\r
\r
      <!-- Loading State -->\r
      @if (stage() === 'loading') {\r
        <div class="backdrop-blur-xl bg-white/90 border border-white/20 rounded-3xl p-8 shadow-2xl">\r
          <div class="flex flex-col items-center justify-center gap-4">\r
            <div class="relative">\r
              <div class="w-12 h-12 border-4 border-indigo-200 border-t-indigo-600 rounded-full animate-spin"></div>\r
              <div class="absolute inset-0 w-12 h-12 border-4 border-transparent border-t-blue-400 rounded-full animate-spin animation-delay-150"></div>\r
            </div>\r
            <p class="text-base font-medium text-slate-700">Loading your profile...</p>\r
            <p class="text-sm text-slate-500">Please wait a moment</p>\r
          </div>\r
        </div>\r
      }\r
\r
      <!-- Error State -->\r
      @if (stage() === 'error') {\r
        <div class="backdrop-blur-xl bg-white/90 border border-white/20 rounded-3xl p-8 shadow-2xl">\r
          <div class="text-center">\r
            <div class="mx-auto w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mb-4">\r
              <span class="material-icons-outlined text-3xl text-red-600">error_outline</span>\r
            </div>\r
            <h2 class="text-xl font-bold text-slate-900 mb-2">Link Expired or Invalid</h2>\r
            <p class="text-slate-600 mb-6">{{ errorMessage() }}</p>\r
            <button\r
              type="button"\r
              class="px-6 py-3 bg-gradient-to-r from-slate-600 to-slate-700 text-white font-medium rounded-xl hover:from-slate-700 hover:to-slate-800 transition-all duration-200 shadow-lg hover:shadow-xl"\r
              (click)="goHome()"\r
            >\r
              Go to Home\r
            </button>\r
          </div>\r
        </div>\r
      }\r
\r
      <!-- Verification Stage -->\r
      @if (stage() === 'verify') {\r
        <div class="backdrop-blur-xl bg-white/90 border border-white/20 rounded-3xl p-8 shadow-2xl">\r
          <div class="mb-6">\r
            <div class="flex items-center gap-3 mb-4">\r
              <div class="w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center">\r
                <span class="material-icons-outlined text-indigo-600">smartphone</span>\r
              </div>\r
              <h2 class="text-xl font-bold text-slate-900">Verify Your Mobile Number</h2>\r
            </div>\r
            @if (memberDisplayName()) {\r
              <p class="text-sm text-slate-600 mb-4">\r
                Hi <span class="font-semibold text-indigo-700">{{ memberDisplayName() }}</span>,\r
              </p>\r
            }\r
            <p class="text-sm text-slate-700 leading-relaxed">\r
              Enter the <span class="font-semibold text-indigo-700">same 10-digit mobile number</span> that your owner has saved for your profile. This helps us verify your identity.\r
            </p>\r
          </div>\r
          \r
          <form [formGroup]="verifyForm" (ngSubmit)="submitVerify()" class="space-y-6">\r
            <div class="relative">\r
              <label class="block text-sm font-semibold text-slate-700 mb-2">Mobile Number</label>\r
              <div class="relative">\r
                <span class="absolute left-4 top-1/2 transform -translate-y-1/2 text-slate-500">\r
                  <span class="material-icons-outlined text-lg">phone</span>\r
                </span>\r
                <input\r
                  formControlName="mobile"\r
                  inputmode="numeric"\r
                  maxlength="10"\r
                  autocomplete="tel"\r
                  (input)="onMobileInput($event)"\r
                  class="w-full pl-12 pr-4 py-4 border-2 border-slate-200 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all duration-200 text-base font-medium"\r
                  placeholder="Enter 10-digit mobile"\r
                />\r
              </div>\r
              @if (verifyForm.controls.mobile.touched && verifyForm.controls.mobile.invalid) {\r
                <div class="mt-2 flex items-center gap-2 text-red-600">\r
                  <span class="material-icons-outlined text-sm">error_outline</span>\r
                  <p class="text-sm">Please enter a valid 10-digit mobile number</p>\r
                </div>\r
              }\r
            </div>\r
            \r
            <button\r
              type="submit"\r
              [disabled]="busy()"\r
              class="flex w-full min-h-[3.25rem] items-center justify-center rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 py-4 font-semibold text-white shadow-lg transition-all duration-200 hover:from-indigo-700 hover:to-blue-700 hover:shadow-xl disabled:cursor-not-allowed disabled:opacity-50"\r
            >\r
              <span class="inline-flex items-center justify-center gap-2.5">\r
                @if (busy()) {\r
                  <svg\r
                    class="h-5 w-5 shrink-0 animate-spin text-white"\r
                    xmlns="http://www.w3.org/2000/svg"\r
                    fill="none"\r
                    viewBox="0 0 24 24"\r
                    aria-hidden="true"\r
                  >\r
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>\r
                    <path\r
                      class="opacity-75"\r
                      fill="currentColor"\r
                      d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"\r
                    ></path>\r
                  </svg>\r
                  <span class="text-center leading-none">Verifying\u2026</span>\r
                } @else {\r
                  <span class="text-center leading-none">Verify and Continue</span>\r
                }\r
              </span>\r
            </button>\r
            \r
            <div class="bg-amber-50 border border-amber-200 rounded-xl p-3">\r
              <p class="text-xs text-amber-800 flex items-center gap-2">\r
                <span class="material-icons-outlined text-sm">security</span>\r
                For your security, this link will be locked after 5 wrong attempts.\r
              </p>\r
            </div>\r
          </form>\r
        </div>\r
      }\r
\r
      <!-- Form Fill Stage -->\r
      @if (stage() === 'fill') {\r
        <form [formGroup]="detailsForm" (ngSubmit)="submitDetails()" class="backdrop-blur-xl bg-white/90 border border-white/20 rounded-3xl p-8 shadow-2xl space-y-6">\r
          <div class="mb-6">\r
            <div class="flex items-center gap-3">\r
              <div class="w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center">\r
                <span class="material-icons-outlined text-emerald-600">edit_note</span>\r
              </div>\r
              <h2 class="text-xl font-bold text-slate-900">Personal Information</h2>\r
            </div>\r
            <p class="text-sm text-slate-600 mt-2">Please provide your complete details for verification</p>\r
          </div>\r
\r
          <!-- Basic Info Section -->\r
          <div class="bg-gradient-to-r from-slate-50 to-indigo-50 rounded-2xl p-6 space-y-4">\r
            <div class="grid gap-4 sm:grid-cols-2">\r
              <div>\r
                <label class="block text-sm font-semibold text-slate-700 mb-2">First Name</label>\r
                <div class="relative">\r
                  <input\r
                    formControlName="firstName"\r
                    class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl bg-slate-100 text-slate-600 font-medium"\r
                    readonly\r
                  />\r
                  <span class="absolute right-3 top-1/2 transform -translate-y-1/2 text-slate-400">\r
                    <span class="material-icons-outlined text-sm">lock</span>\r
                  </span>\r
                </div>\r
              </div>\r
              <div>\r
                <label class="block text-sm font-semibold text-slate-700 mb-2">Last Name</label>\r
                <input\r
                  formControlName="lastName"\r
                  class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all duration-200"\r
                  placeholder="Enter last name"\r
                />\r
              </div>\r
            </div>\r
\r
            <div>\r
              <label class="block text-sm font-semibold text-slate-700 mb-2">Email Address</label>\r
              <div class="relative">\r
                <span class="absolute left-4 top-1/2 transform -translate-y-1/2 text-slate-500">\r
                  <span class="material-icons-outlined text-lg">email</span>\r
                </span>\r
                <input\r
                  type="email"\r
                  formControlName="email"\r
                  class="w-full pl-12 pr-4 py-3 border-2 border-slate-200 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all duration-200"\r
                  placeholder="your.email@example.com"\r
                />\r
              </div>\r
              @if (detailsForm.controls.email.touched && detailsForm.controls.email.errors?.['email']) {\r
                <div class="mt-2 flex items-center gap-2 text-red-600">\r
                  <span class="material-icons-outlined text-sm">error_outline</span>\r
                  <p class="text-sm">Please enter a valid email address</p>\r
                </div>\r
              }\r
            </div>\r
\r
            <div class="grid gap-4 sm:grid-cols-2">\r
              <div>\r
                <label class="block text-sm font-semibold text-slate-700 mb-2">Gender</label>\r
                <div class="relative">\r
                  <span class="absolute left-4 top-1/2 transform -translate-y-1/2 text-slate-500">\r
                    <span class="material-icons-outlined text-lg">person</span>\r
                  </span>\r
                  <select\r
                    formControlName="gender"\r
                    class="w-full pl-12 pr-4 py-3 border-2 border-slate-200 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all duration-200 appearance-none"\r
                  >\r
                    <option value="">Select gender</option>\r
                    <option value="male">Male</option>\r
                    <option value="female">Female</option>\r
                    <option value="other">Other</option>\r
                  </select>\r
                  <span class="absolute right-4 top-1/2 transform -translate-y-1/2 text-slate-400 pointer-events-none">\r
                    <span class="material-icons-outlined text-sm">arrow_drop_down</span>\r
                  </span>\r
                </div>\r
              </div>\r
              <div>\r
                <label class="block text-sm font-semibold text-slate-700 mb-2">Aadhaar Number</label>\r
                <div class="relative">\r
                  <span class="absolute left-4 top-1/2 transform -translate-y-1/2 text-slate-500">\r
                    <span class="material-icons-outlined text-lg">credit_card</span>\r
                  </span>\r
                  <input\r
                    formControlName="aadhaarNumber"\r
                    inputmode="numeric"\r
                    maxlength="12"\r
                    (input)="onAadhaarInput($event)"\r
                    class="w-full pl-12 pr-4 py-3 border-2 border-slate-200 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all duration-200"\r
                    placeholder="1234 5678 9012"\r
                  />\r
                </div>\r
                @if (detailsForm.controls.aadhaarNumber.touched && detailsForm.controls.aadhaarNumber.invalid) {\r
                  <div class="mt-2 flex items-center gap-2 text-red-600">\r
                    <span class="material-icons-outlined text-sm">error_outline</span>\r
                    <p class="text-sm">Enter 12-digit Aadhaar or leave blank</p>\r
                  </div>\r
                }\r
              </div>\r
            </div>\r
\r
            <div>\r
              <label class="block text-sm font-semibold text-slate-700 mb-2">Enter Permanent Address</label>\r
              <div class="relative">\r
                <span class="absolute left-4 top-3 text-slate-500">\r
                  <span class="material-icons-outlined text-lg">location_on</span>\r
                </span>\r
                <textarea\r
                  formControlName="address"\r
                  rows="3"\r
                  class="w-full pl-12 pr-4 py-3 border-2 border-slate-200 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all duration-200 resize-none"\r
                  placeholder="Enter your complete address"\r
                ></textarea>\r
              </div>\r
            </div>\r
          </div>\r
\r
          <!-- Photo Upload Section -->\r
          <div class="bg-gradient-to-r from-emerald-50 to-teal-50 rounded-2xl p-6 space-y-6">\r
            <div class="flex items-center gap-3">\r
              <div class="w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center">\r
                <span class="material-icons-outlined text-emerald-600">photo_camera</span>\r
              </div>\r
              <h3 class="text-lg font-bold text-slate-900">Photo Upload</h3>\r
            </div>\r
            <p class="text-sm text-slate-600">Please upload clear photos for verification</p>\r
\r
            <!-- Profile Photo -->\r
            <div class="bg-white rounded-xl p-4 border border-emerald-200">\r
              <label class="block text-sm font-semibold text-slate-700 mb-3">\r
                Profile Photo <span class="text-red-500">*</span>\r
              </label>\r
              @if (profilePhotoPreview()) {\r
                <div class="mb-4 relative">\r
                  <img\r
                    [src]="profilePhotoPreview()"\r
                    alt="Profile preview"\r
                    class="w-32 h-32 rounded-xl object-cover border-2 border-emerald-300 shadow-lg"\r
                  />\r
                  <div class="absolute -top-2 -right-2 w-6 h-6 bg-emerald-500 rounded-full flex items-center justify-center">\r
                    <span class="material-icons-outlined text-white text-sm">check</span>\r
                  </div>\r
                </div>\r
              }\r
              <div class="relative">\r
                <input\r
                  type="file"\r
                  accept="image/jpeg,image/png,image/webp"\r
                  class="hidden"\r
                  id="profilePhoto"\r
                  (change)="onPhotoSelected('profile', $event)"\r
                />\r
                <label\r
                  for="profilePhoto"\r
                  class="flex items-center justify-center gap-2 w-full py-3 px-4 border-2 border-dashed border-emerald-300 rounded-xl cursor-pointer hover:border-emerald-500 hover:bg-emerald-50 transition-all duration-200"\r
                >\r
                  <span class="material-icons-outlined text-emerald-600">cloud_upload</span>\r
                  <span class="text-sm font-medium text-emerald-700">\r
                    {{ profilePhotoPreview() ? 'Change Photo' : 'Upload Photo' }}\r
                  </span>\r
                </label>\r
              </div>\r
            </div>\r
\r
            <!-- Aadhaar Photos -->\r
            <div class="grid gap-4 sm:grid-cols-2">\r
              <div class="bg-white rounded-xl p-4 border border-emerald-200">\r
                <label class="block text-sm font-semibold text-slate-700 mb-3">\r
                  Aadhaar Front <span class="text-red-500">*</span>\r
                </label>\r
                @if (aadhaarFrontPreview()) {\r
                  <div class="mb-4 relative">\r
                    <img\r
                      [src]="aadhaarFrontPreview()"\r
                      alt="Aadhaar front"\r
                      class="w-full h-32 rounded-xl object-cover border-2 border-emerald-300 shadow-lg"\r
                    />\r
                    <div class="absolute -top-2 -right-2 w-6 h-6 bg-emerald-500 rounded-full flex items-center justify-center">\r
                      <span class="material-icons-outlined text-white text-sm">check</span>\r
                    </div>\r
                  </div>\r
                }\r
                <div class="relative">\r
                  <input\r
                    type="file"\r
                    accept="image/jpeg,image/png,image/webp"\r
                    class="hidden"\r
                    id="aadhaarFront"\r
                    (change)="onPhotoSelected('aadhaarFront', $event)"\r
                  />\r
                  <label\r
                    for="aadhaarFront"\r
                    class="flex items-center justify-center gap-2 w-full py-3 px-4 border-2 border-dashed border-emerald-300 rounded-xl cursor-pointer hover:border-emerald-500 hover:bg-emerald-50 transition-all duration-200"\r
                  >\r
                    <span class="material-icons-outlined text-emerald-600">cloud_upload</span>\r
                    <span class="text-sm font-medium text-emerald-700">\r
                      {{ aadhaarFrontPreview() ? 'Change Photo' : 'Upload Front' }}\r
                    </span>\r
                  </label>\r
                </div>\r
              </div>\r
\r
              <div class="bg-white rounded-xl p-4 border border-emerald-200">\r
                <label class="block text-sm font-semibold text-slate-700 mb-3">\r
                  Aadhaar Back <span class="text-red-500">*</span>\r
                </label>\r
                @if (aadhaarBackPreview()) {\r
                  <div class="mb-4 relative">\r
                    <img\r
                      [src]="aadhaarBackPreview()"\r
                      alt="Aadhaar back"\r
                      class="w-full h-32 rounded-xl object-cover border-2 border-emerald-300 shadow-lg"\r
                    />\r
                    <div class="absolute -top-2 -right-2 w-6 h-6 bg-emerald-500 rounded-full flex items-center justify-center">\r
                      <span class="material-icons-outlined text-white text-sm">check</span>\r
                    </div>\r
                  </div>\r
                }\r
                <div class="relative">\r
                  <input\r
                    type="file"\r
                    accept="image/jpeg,image/png,image/webp"\r
                    class="hidden"\r
                    id="aadhaarBack"\r
                    (change)="onPhotoSelected('aadhaarBack', $event)"\r
                  />\r
                  <label\r
                    for="aadhaarBack"\r
                    class="flex items-center justify-center gap-2 w-full py-3 px-4 border-2 border-dashed border-emerald-300 rounded-xl cursor-pointer hover:border-emerald-500 hover:bg-emerald-50 transition-all duration-200"\r
                  >\r
                    <span class="material-icons-outlined text-emerald-600">cloud_upload</span>\r
                    <span class="text-sm font-medium text-emerald-700">\r
                      {{ aadhaarBackPreview() ? 'Change Photo' : 'Upload Back' }}\r
                    </span>\r
                  </label>\r
                </div>\r
              </div>\r
            </div>\r
          </div>\r
\r
          <!-- Progress Indicator -->\r
          @if (busy()) {\r
            <div class="bg-gradient-to-r from-emerald-50 to-teal-50 border border-emerald-200 rounded-xl p-6">\r
              <div class="flex items-center gap-3 mb-4">\r
                <div class="w-8 h-8 bg-emerald-500 rounded-full flex items-center justify-center">\r
                  <span class="material-icons-outlined text-white text-sm animate-pulse">cloud_upload</span>\r
                </div>\r
                <div>\r
                  <p class="font-semibold text-emerald-900">{{ submitStatus() }}</p>\r
                  <p class="text-sm text-emerald-700">Uploading your details...</p>\r
                </div>\r
              </div>\r
              <div class="mb-3">\r
                <div class="flex justify-between text-sm text-emerald-700 mb-1">\r
                  <span>Progress</span>\r
                  <span>{{ submitProgress() }}%</span>\r
                </div>\r
                <div class="w-full h-3 bg-emerald-200 rounded-full overflow-hidden">\r
                  <div\r
                    class="h-full bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full transition-all duration-300 ease-out"\r
                    [style.width.%]="submitProgress()"\r
                  ></div>\r
                </div>\r
              </div>\r
              <p class="text-xs text-emerald-600 leading-relaxed">\r
                <span class="material-icons-outlined text-sm align-middle mr-1">info</span>\r
                Photos are optimized for faster upload. Wi-Fi recommended for best experience.\r
              </p>\r
            </div>\r
          }\r
\r
          <!-- Submit Button -->\r
          <button\r
            type="submit"\r
            [disabled]="busy()"\r
            class="flex w-full min-h-[3.25rem] items-center justify-center rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 py-4 text-lg font-bold text-white shadow-lg transition-all duration-200 hover:from-emerald-700 hover:to-teal-700 hover:shadow-xl disabled:cursor-not-allowed disabled:opacity-50"\r
          >\r
            <span class="inline-flex items-center justify-center gap-2.5">\r
              @if (busy()) {\r
                <svg\r
                  class="h-5 w-5 shrink-0 animate-spin text-white"\r
                  xmlns="http://www.w3.org/2000/svg"\r
                  fill="none"\r
                  viewBox="0 0 24 24"\r
                  aria-hidden="true"\r
                >\r
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>\r
                  <path\r
                    class="opacity-75"\r
                    fill="currentColor"\r
                    d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"\r
                  ></path>\r
                </svg>\r
                <span class="text-center leading-tight">Sending profile\u2026</span>\r
                @if (submitProgress() > 0) {\r
                  <span class="shrink-0 text-sm font-semibold tabular-nums text-white/90">{{ submitProgress() }}%</span>\r
                }\r
              } @else {\r
                <span class="material-icons-outlined shrink-0 text-[1.35rem] leading-none">send</span>\r
                <span class="text-center leading-none">Submit Profile</span>\r
              }\r
            </span>\r
          </button>\r
        </form>\r
      }\r
\r
      <!-- Success State -->\r
      @if (stage() === 'done') {\r
        <div class="backdrop-blur-xl bg-white/90 border border-white/20 rounded-3xl p-8 shadow-2xl text-center">\r
          <div class="mx-auto w-20 h-20 bg-gradient-to-br from-emerald-500 to-teal-500 rounded-full flex items-center justify-center mb-6 shadow-lg">\r
            <span class="material-icons-outlined text-3xl text-white">check_circle</span>\r
          </div>\r
          <h2 class="text-2xl font-bold text-slate-900 mb-3">Profile Submitted!</h2>\r
          <p class="text-slate-600 mb-2">Your profile has been successfully submitted for review</p>\r
          <p class="text-sm text-slate-500">\r
            {{ businessName() }} will verify your details and activate your membership shortly\r
          </p>\r
          <div class="mt-6 p-4 bg-emerald-50 rounded-xl border border-emerald-200">\r
            <p class="text-sm text-emerald-800">\r
              <span class="material-icons-outlined text-sm align-middle mr-1">check_circle_outline</span>\r
              You can safely close this page now\r
            </p>\r
          </div>\r
        </div>\r
      }\r
    </div>\r
  </div>\r
</div>\r
` }]
