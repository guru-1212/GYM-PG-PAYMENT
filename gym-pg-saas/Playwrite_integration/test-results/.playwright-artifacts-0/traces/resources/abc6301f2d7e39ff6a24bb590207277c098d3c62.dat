            }\r
            <span class="material-icons-outlined text-[22px] leading-none">insights</span>\r
            <span class="text-[10px] font-semibold leading-tight">Analytics</span>\r
          </a>\r
        } @else {\r
          <button\r
            type="button"\r
            (click)="openMobileMenu()"\r
            class="relative flex min-w-0 flex-1 flex-col items-center justify-center gap-0.5 text-slate-500 transition active:scale-[0.96] dark:text-slate-400"\r
            aria-label="Open more menu"\r
          >\r
            <span class="material-icons-outlined text-[22px] leading-none">more_horiz</span>\r
            <span class="text-[10px] font-semibold leading-tight">More</span>\r
          </button>\r
        }\r
      </div>\r
    </nav>\r
  </div>\r
</div>\r
\r
<app-modal [open]="notificationsOpen()" title="Admin Chat" [wide]="true" (closed)="closeNotifications()">\r
  <div class="space-y-3">\r
    <div class="max-h-[45vh] space-y-2 overflow-y-auto rounded-xl border border-slate-200 bg-slate-50 p-3">\r
      @if (chatMessages().length === 0) {\r
        <p class="text-center text-sm text-slate-500">No messages yet.</p>\r
      } @else {\r
        @for (msg of chatMessages(); track msg.id) {\r
          <div class="flex" [class.justify-end]="msg.senderRole === 'owner'" [class.justify-start]="msg.senderRole === 'admin'">\r
            <div\r
              class="max-w-[80%] rounded-2xl px-3 py-2 text-sm shadow-sm"\r
              [class.bg-indigo-600]="msg.senderRole === 'owner'"\r
              [class.text-white]="msg.senderRole === 'owner'"\r
              [class.bg-white]="msg.senderRole === 'admin'"\r
              [class.text-slate-800]="msg.senderRole === 'admin'"\r
            >\r
              <p>{{ msg.text }}</p>\r
              <p class="mt-1 text-[10px]" [class.text-indigo-100]="msg.senderRole === 'owner'" [class.text-slate-400]="msg.senderRole === 'admin'">\r
                {{ formatChatTime(msg) }}\r
              </p>\r
            </div>\r
          </div>\r
        }\r
      }\r
    </div>\r
    <div class="flex gap-2">\r
      <input\r
        type="text"\r
        class="saas-input flex-1"\r
        placeholder="Type message to admin"\r
        [value]="chatText()"\r
        (input)="chatText.set($any($event.target).value)"\r
        (keydown.enter)="sendMessageToAdmin()"\r
      />\r
      <button type="button" class="saas-btn-primary px-4 py-2 text-sm" (click)="sendMessageToAdmin()">Send</button>\r
    </div>\r
  </div>\r
</app-modal>\r
` }]
