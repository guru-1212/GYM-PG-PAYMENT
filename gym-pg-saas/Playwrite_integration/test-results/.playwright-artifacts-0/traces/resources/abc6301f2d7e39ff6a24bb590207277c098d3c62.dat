                          min="0"\r
                          max="20"\r
                          class="w-14 rounded-md border border-slate-200 px-1.5 py-0.5 text-xs"\r
                          [value]="supervisorQuotaValue(o)"\r
                          [disabled]="busyId() === o.ownerId"\r
                          (change)="setSupervisorQuota(o, $any($event.target).value)"\r
                        />\r
                      </label>\r
                    }\r
                  </div>\r
                } @else if (o.status === 'inactive') {\r
                  <div class="flex flex-wrap justify-end gap-2">\r
                    <button\r
                      type="button"\r
                      class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700 disabled:opacity-50"\r
                      [disabled]="busyId() === o.ownerId"\r
                      (click)="openActiveConfirm(o)"\r
                    >\r
                      Mark Active\r
                    </button>\r
                  </div>\r
                } @else {\r
                  <span class="text-xs text-slate-400">\u2014</span>\r
                }\r
              </td>\r
            </tr>\r
          }\r
        </tbody>\r
      </table>\r
    </div>\r
\r
    <div class="space-y-3 p-3 lg:hidden">\r
      @for (o of filteredOwnerRows(); track o.ownerId) {\r
        <article class="rounded-xl border border-slate-200 bg-white p-3 shadow-sm">\r
          <div class="flex items-start justify-between gap-2">\r
            <div class="min-w-0">\r
              <p class="truncate text-sm font-semibold text-slate-900">{{ o.name }}</p>\r
              <p class="truncate text-xs text-slate-600">{{ o.email }}</p>\r
              <p class="mt-1 text-xs text-slate-600">Mobile: {{ o.phone || '\u2014' }}</p>\r
            </div>\r
            <span\r
              class="inline-flex rounded-full px-2 py-0.5 text-xs font-semibold"\r
              [class.bg-amber-100]="o.status === 'pending'"\r
              [class.text-amber-900]="o.status === 'pending'"\r
              [class.bg-emerald-100]="o.status === 'approved'"\r
              [class.text-emerald-900]="o.status === 'approved'"\r
              [class.bg-red-100]="o.status === 'rejected'"\r
              [class.text-red-900]="o.status === 'rejected'"\r
              [class.bg-slate-200]="o.status === 'inactive'"\r
              [class.text-slate-800]="o.status === 'inactive'"\r
            >\r
              {{ o.status }}\r
            </span>\r
          </div>\r
\r
          <div class="mt-3 grid grid-cols-2 gap-2 text-xs">\r
            <p class="text-slate-500">Business</p>\r
            <p class="justify-self-end uppercase text-slate-700">{{ o.businessType }}</p>\r
            <p class="text-slate-500">Members</p>\r
            <p class="justify-self-end font-semibold text-slate-800">{{ memberCount(o.ownerId) }}</p>\r
            <p class="text-slate-500">{{ 'admin.planStatus' | t }}</p>\r
            <p class="justify-self-end text-slate-700">{{ getPlanStatus(o) }}</p>\r
            <p class="text-slate-500">{{ 'admin.daysRemaining' | t }}</p>\r
            <p class="justify-self-end font-semibold text-slate-800">{{ getDaysRemaining(o) }} / 30</p>\r
          </div>\r
\r
          <div class="mt-3 flex flex-wrap gap-2">\r
            <button\r
              type="button"\r
              class="relative rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50"\r
              [disabled]="busyId() === o.ownerId"\r
              (click)="openOwnerChat(o)"\r
            >\r
              Message\r
              @if (unreadForOwner(o.ownerId) > 0) {\r
                <span class="ml-1 rounded-full bg-red-600 px-1.5 py-0.5 text-[10px] font-bold text-white">{{ unreadForOwner(o.ownerId) }}</span>\r
              }\r
            </button>\r
            @if (o.status === 'pending') {\r
              <button\r
                type="button"\r
                class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700 disabled:opacity-50"\r
                [disabled]="busyId() === o.ownerId"\r
                (click)="openApproveModal(o)"\r
              >\r
                {{ 'admin.approve' | t }}\r
              </button>\r
              <button\r
                type="button"\r
                class="rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-800 hover:bg-red-100 disabled:opacity-50"\r
                [disabled]="busyId() === o.ownerId"\r
                (click)="reject(o)"\r
              >\r
                Reject\r
              </button>\r
            } @else if (o.status === 'approved') {\r
              <button\r
                type="button"\r
                class="rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-700 disabled:opacity-50"\r
                [disabled]="busyId() === o.ownerId"\r
                (click)="openExtendModal(o)"\r
              >\r
                {{ 'admin.extendPlan' | t }}\r
              </button>\r
              <button\r
                type="button"\r
                class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-50"\r
                [disabled]="busyId() === o.ownerId"\r
                (click)="openInactiveConfirm(o)"\r
              >\r
                Mark Inactive\r
              </button>\r
              <div class="mt-1 flex w-full flex-wrap items-center gap-2">\r
                <input\r
                  type="number"\r
                  min="1"\r
                  class="w-16 rounded-lg border border-slate-200 px-2 py-1 text-xs"\r
                  [value]="dayAdjustValue(o.ownerId)"\r
                  (input)="setDayAdjustValue(o.ownerId, $any($event.target).value)"\r
                />\r
                <button\r
                  type="button"\r
                  class="rounded-lg border border-red-200 bg-red-50 px-2.5 py-1 text-xs font-semibold text-red-700 hover:bg-red-100 disabled:opacity-50"\r
                  [disabled]="busyId() === o.ownerId"\r
                  (click)="adjustPlanByDays(o, -1)"\r
                >\r
                  - Days\r
                </button>\r
                <button\r
                  type="button"\r
                  class="rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 hover:bg-emerald-100 disabled:opacity-50"\r
                  [disabled]="busyId() === o.ownerId"\r
                  (click)="adjustPlanByDays(o, 1)"\r
                >\r
                  + Days\r
                </button>\r
              </div>\r
            } @else if (o.status === 'inactive') {\r
              <button\r
                type="button"\r
                class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700 disabled:opacity-50"\r
                [disabled]="busyId() === o.ownerId"\r
                (click)="openActiveConfirm(o)"\r
              >\r
                Mark Active\r
              </button>\r
            }\r
          </div>\r
\r
          @if (o.status === 'approved') {\r
            <div class="mt-3 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2">\r
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Features</p>\r
              <div class="mt-2 flex flex-wrap items-center gap-3 text-xs">\r
                <label class="flex items-center gap-1.5 text-slate-700">\r
                  <input\r
                    type="checkbox"\r
                    class="h-4 w-4 accent-indigo-600"\r
                    [checked]="isSupervisorEnabled(o)"\r
                    [disabled]="busyId() === o.ownerId"\r
                    (change)="toggleSupervisorEnabled(o, $any($event.target).checked)"\r
                  />\r
                  Supervisors\r
                </label>\r
                <label class="flex items-center gap-1.5 text-slate-700">\r
                  <input\r
                    type="checkbox"\r
                    class="h-4 w-4 accent-emerald-600"\r
                    [checked]="isWhatsappEnabled(o)"\r
                    [disabled]="busyId() === o.ownerId"\r
                    (change)="toggleWhatsappEnabled(o, $any($event.target).checked)"\r
                  />\r
                  WhatsApp\r
                </label>\r
                <label class="flex items-center gap-1.5 text-slate-700">\r
                  <input\r
                    type="checkbox"\r
                    class="h-4 w-4 accent-amber-600"\r
                    [checked]="isAuditLogEnabled(o)"\r
                    [disabled]="busyId() === o.ownerId"\r
                    (change)="toggleAuditLogEnabled(o, $any($event.target).checked)"\r
                  />\r
                  Audit Log\r
                </label>\r
                <label class="flex items-center gap-1.5 text-slate-700">\r
                  <input\r
                    type="checkbox"\r
                    class="h-4 w-4 accent-teal-600"\r
                    [checked]="isTenantMemberAppEnabled(o)"\r
                    [disabled]="busyId() === o.ownerId"\r
                    (change)="toggleTenantMemberAppEnabled(o, $any($event.target).checked)"\r
                  />\r
                  Tenant app\r
                </label>\r
                @if (isSupervisorEnabled(o)) {\r
                  <label class="flex items-center gap-1.5 text-slate-700">\r
                    Cap\r
                    <input\r
                      type="number"\r
                      min="0"\r
                      max="20"\r
                      class="w-14 rounded-md border border-slate-200 px-1.5 py-0.5 text-xs"\r
                      [value]="supervisorQuotaValue(o)"\r
                      [disabled]="busyId() === o.ownerId"\r
                      (change)="setSupervisorQuota(o, $any($event.target).value)"\r
                    />\r
                  </label>\r
                }\r
              </div>\r
            </div>\r
          }\r
        </article>\r
      }\r
    </div>\r
\r
    @if (ownerRows().length === 0) {\r
      <p class="px-4 py-8 text-center text-sm text-slate-500">{{ 'admin.noOwnersYet' | t }}</p>\r
    } @else if (filteredOwnerRows().length === 0) {\r
      <p class="px-4 py-8 text-center text-sm text-slate-500">{{ 'admin.noOwnersMatchFilters' | t }}</p>\r
    }\r
  </div>\r
</div>\r
\r
<app-modal\r
  [open]="!!inactiveConfirmOwner()"\r
  [title]="'admin.markInactiveTitle' | t"\r
  [closable]="!inactiveConfirmBusy()"\r
  [backdropClose]="false"\r
  (closed)="closeInactiveConfirm()"\r
>\r
  @if (inactiveConfirmOwner(); as io) {\r
    <p class="text-sm text-slate-600 dark:text-slate-300">\r
      {{ 'admin.markInactiveBody' | t: { name: io.name || io.email || io.ownerId } }}\r
    </p>\r
    <label class="mt-4 block">\r
      <span class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{{\r
        'admin.markInactiveAdminPassword' | t\r
      }}</span>\r
      <input\r
        type="password"\r
        autocomplete="current-password"\r
        class="saas-input mt-1.5 w-full"\r
        [value]="inactiveConfirmPassword()"\r
        (input)="inactiveConfirmPassword.set($any($event.target).value)"\r
        (keydown.enter)="confirmInactiveOwner()"\r
      />\r
    </label>\r
    <div class="mt-5 flex flex-wrap justify-end gap-2">\r
      <button\r
        type="button"\r
        class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"\r
        [disabled]="inactiveConfirmBusy()"\r
        (click)="closeInactiveConfirm()"\r
      >\r
        {{ 'admin.cancel' | t }}\r
      </button>\r
      <button\r
        type="button"\r
        class="rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700 disabled:opacity-50"\r
        [disabled]="inactiveConfirmBusy()"\r
        (click)="confirmInactiveOwner()"\r
      >\r
        {{ 'admin.markInactiveConfirm' | t }}\r
      </button>\r
    </div>\r
  }\r
</app-modal>\r
\r
<app-modal\r
  [open]="!!activeConfirmOwner()"\r
  [title]="'admin.activateOwnerTitle' | t"\r
  [closable]="!activeConfirmBusy()"\r
  [backdropClose]="false"\r
  (closed)="closeActiveConfirm()"\r
>\r
  @if (activeConfirmOwner(); as ao) {\r
    <p class="text-sm text-slate-600 dark:text-slate-300">\r
      {{ 'admin.activateOwnerBody' | t: { name: ao.name || ao.email || ao.ownerId } }}\r
    </p>\r
    <div class="mt-5 flex flex-wrap justify-end gap-2">\r
      <button\r
        type="button"\r
        class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"\r
        [disabled]="activeConfirmBusy()"\r
        (click)="closeActiveConfirm()"\r
      >\r
        {{ 'admin.cancel' | t }}\r
      </button>\r
      <button\r
        type="button"\r
        class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700 disabled:opacity-50"\r
        [disabled]="activeConfirmBusy()"\r
        (click)="confirmActivateOwner()"\r
      >\r
        {{ 'admin.activateOwnerConfirm' | t }}\r
      </button>\r
    </div>\r
  }\r
</app-modal>\r
\r
<!-- Subscription Modal -->\r
<app-subscription-modal\r
  [open]="showSubscriptionModal()"\r
  [loading]="modalLoading()"\r
  (approve)="selectedOwner()?.status === 'pending' ? approve($event) : extendPlan($event)"\r
  (cancel)="closeModal()"\r
/>\r
\r
<app-modal [open]="chatModalOpen()" title="Owner Chat" [wide]="true" (closed)="closeOwnerChat()">\r
  @if (chatOwner(); as owner) {\r
    <div class="space-y-3">\r
      <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm">\r
        <span class="font-semibold text-slate-900">{{ owner.name }}</span>\r
        <span class="ml-2 text-slate-600">{{ owner.email }}</span>\r
      </div>\r
      <div class="max-h-[45vh] space-y-2 overflow-y-auto rounded-xl border border-slate-200 bg-slate-50 p-3">\r
        @if (chatMessages().length === 0) {\r
          <p class="text-center text-sm text-slate-500">No messages yet.</p>\r
        } @else {\r
          @for (msg of chatMessages(); track msg.id) {\r
            <div class="flex" [class.justify-end]="msg.senderRole === 'admin'" [class.justify-start]="msg.senderRole === 'owner'">\r
              <div\r
                class="max-w-[80%] rounded-2xl px-3 py-2 text-sm shadow-sm"\r
                [class.bg-indigo-600]="msg.senderRole === 'admin'"\r
                [class.text-white]="msg.senderRole === 'admin'"\r
                [class.bg-white]="msg.senderRole === 'owner'"\r
                [class.text-slate-800]="msg.senderRole === 'owner'"\r
              >\r
                <p [innerHTML]="formatChatMessage(msg.text)"></p>\r
                <p class="mt-1 text-[10px]" [class.text-indigo-100]="msg.senderRole === 'admin'" [class.text-slate-400]="msg.senderRole === 'owner'">\r
                  {{ formatChatTime(msg) }}\r
                </p>\r
              </div>\r
            </div>\r
          }\r
        }\r
      </div>\r
      <div class="flex gap-2">\r
        <input\r
          type="text"\r
          class="saas-input flex-1"\r
          placeholder="Type message"\r
          [value]="chatText()"\r
          (input)="chatText.set($any($event.target).value)"\r
          (keydown.enter)="sendAdminMessage()"\r
        />\r
        <button type="button" class="saas-btn-primary px-4 py-2 text-sm" (click)="sendAdminMessage()">Send</button>\r
      </div>\r
    </div>\r
  }\r
</app-modal>\r
` }]
