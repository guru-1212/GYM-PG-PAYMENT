      <div class="px-5 py-4">\r
        @if (isIosSafari() && !canInstall()) {\r
          <p class="text-sm text-slate-700">\r
            Tap <strong>Install App</strong> below \u2014 we'll show you how to add it to your iPhone home screen in 3 quick steps.\r
          </p>\r
        } @else {\r
          <ul class="space-y-2 text-sm text-slate-700">\r
            <li class="flex items-start gap-2">\r
              <i class="fa-solid fa-bolt mt-1 text-indigo-600"></i>\r
              <span>Opens instantly from your home screen \u2014 no browser tabs.</span>\r
            </li>\r
            <li class="flex items-start gap-2">\r
              <i class="fa-solid fa-bell mt-1 text-indigo-600"></i>\r
              <span>Get rent due and payment reminders even when the site is closed.</span>\r
            </li>\r
            <li class="flex items-start gap-2">\r
              <i class="fa-solid fa-shield-halved mt-1 text-indigo-600"></i>\r
              <span>Same secure account \u2014 nothing extra to set up.</span>\r
            </li>\r
          </ul>\r
        }\r
\r
        <div class="mt-5 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">\r
          <button\r
            type="button"\r
            class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"\r
            (click)="closeInstallPopup()"\r
          >\r
            Not now\r
          </button>\r
          <button\r
            type="button"\r
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-indigo-700"\r
            (click)="installFromPopup()"\r
          >\r
            <i class="fa-solid fa-download"></i>\r
            Install App\r
          </button>\r
        </div>\r
      </div>\r
    </div>\r
  </div>\r
}\r
\r
