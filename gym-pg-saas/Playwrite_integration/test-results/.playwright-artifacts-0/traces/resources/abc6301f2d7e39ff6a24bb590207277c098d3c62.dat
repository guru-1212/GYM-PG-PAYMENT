  <div>\r
    <h1 class="text-2xl font-bold text-slate-900">{{ 'admin.owners' | t }}</h1>\r
    <p class="text-slate-600">{{ 'admin.manageOwners' | t }}</p>\r
    @if (hasActiveOwnerFilters() && ownerRows().length > 0) {\r
      <p class="mt-2 text-sm text-slate-500">\r
        {{ 'admin.showingFiltered' | t: { shown: filteredOwnerRows().length, total: ownerRows().length } }}\r
      </p>\r
    }\r
  </div>\r
\r
  <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">\r
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">\r
      <h2 class="text-sm font-semibold text-slate-800">{{ 'admin.filters' | t }}</h2>\r
      @if (hasActiveOwnerFilters()) {\r
        <button\r
          type="button"\r
          class="text-xs font-semibold text-indigo-600 hover:text-indigo-800"\r
          (click)="clearOwnerFilters()"\r
        >\r
          {{ 'admin.clearFilters' | t }}\r
        </button>\r
      }\r
    </div>\r
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">\r
      <div class="min-w-0 sm:col-span-2 lg:col-span-1">\r
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500" for="admin-owner-search">{{\r
          'admin.filterSearch' | t\r
        }}</label>\r
        <input\r
          id="admin-owner-search"\r
          type="search"\r
          class="saas-input w-full"\r
          [value]="filterSearch()"\r
          (input)="filterSearch.set($any($event.target).value)"\r
          [attr.placeholder]="'admin.filterSearchPlaceholder' | t"\r
        />\r
      </div>\r
      <div>\r
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500" for="admin-filter-status">{{\r
          'admin.filterAccountStatus' | t\r
        }}</label>\r
        <select\r
          id="admin-filter-status"\r
          class="saas-input w-full"\r
          [value]="filterStatus()"\r
          (change)="setFilterStatus($any($event.target).value)"\r
        >\r
          <option value="all">{{ 'admin.filterAll' | t }}</option>\r
          <option value="pending">{{ 'admin.statusPending' | t }}</option>\r
          <option value="approved">{{ 'admin.statusApproved' | t }}</option>\r
          <option value="rejected">{{ 'admin.statusRejected' | t }}</option>\r
          <option value="inactive">{{ 'admin.statusInactive' | t }}</option>\r
        </select>\r
      </div>\r
      <div>\r
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500" for="admin-filter-plan">{{\r
          'admin.filterPlanStatus' | t\r
        }}</label>\r
        <select\r
          id="admin-filter-plan"\r
          class="saas-input w-full"\r
          [value]="filterPlan()"\r
          (change)="setFilterPlan($any($event.target).value)"\r
        >\r
          <option value="all">{{ 'admin.filterAll' | t }}</option>\r
          <option value="active">{{ 'admin.active' | t }}</option>\r
          <option value="expiring-soon">{{ 'admin.expiringsoon' | t }}</option>\r
          <option value="expired">{{ 'admin.expired' | t }}</option>\r
        </select>\r
      </div>\r
      <div>\r
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500" for="admin-filter-type">{{\r
          'admin.filterBusinessType' | t\r
        }}</label>\r
        <select\r
          id="admin-filter-type"\r
          class="saas-input w-full"\r
          [value]="filterBusinessType()"\r
          (change)="setFilterBusinessType($any($event.target).value)"\r
        >\r
          <option value="all">{{ 'admin.filterAll' | t }}</option>\r
          <option value="pg">{{ 'login.pg' | t }}</option>\r
          <option value="gym">{{ 'login.gym' | t }}</option>\r
        </select>\r
      </div>\r
    </div>\r
  </div>\r
\r
  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">\r
    <div class="hidden overflow-x-auto lg:block">\r
      <table class="min-w-full text-left text-sm">\r
        <thead class="bg-slate-50 text-xs font-semibold uppercase text-slate-500">\r
          <tr>\r
            <th class="px-4 py-3">{{ 'admin.ownerName' | t }}</th>\r
            <th class="px-4 py-3">Email</th>\r
            <th class="px-4 py-3">Mobile</th>\r
            <th class="px-4 py-3">{{ 'admin.businessName' | t }}</th>\r
            <th class="px-4 py-3">Members</th>\r
            <th class="px-4 py-3">{{ 'admin.planStatus' | t }}</th>\r
            <th class="px-4 py-3">{{ 'admin.daysRemaining' | t }}</th>\r
            <th class="px-4 py-3">Status</th>\r
            <th class="px-4 py-3 text-right">{{ 'admin.actions' | t }}</th>\r
          </tr>\r
        </thead>\r
        <tbody class="divide-y divide-slate-100">\r
          @for (o of filteredOwnerRows(); track o.ownerId) {\r
            <tr class="hover:bg-slate-50">\r
              <td class="px-4 py-3 font-medium text-slate-900">{{ o.name }}</td>\r
              <td class="px-4 py-3 text-slate-600 text-xs">{{ o.email }}</td>\r
              <td class="px-4 py-3 text-slate-600 text-xs">{{ o.phone || '\u2014' }}</td>\r
              <td class="px-4 py-3 uppercase text-slate-600 text-xs">{{ o.businessType }}</td>\r
              <td class="px-4 py-3 text-xs font-semibold text-slate-800">{{ memberCount(o.ownerId) }}</td>\r
              <td class="px-4 py-3">\r
                <span\r
                  class="inline-flex rounded-full px-2 py-1 text-xs font-semibold"\r
                  [class.bg-emerald-100]="getPlanStatus(o) === 'active'"\r
                  [class.text-emerald-900]="getPlanStatus(o) === 'active'"\r
                  [class.bg-yellow-100]="getPlanStatus(o) === 'expiring-soon'"\r
                  [class.text-yellow-900]="getPlanStatus(o) === 'expiring-soon'"\r
                  [class.bg-red-100]="getPlanStatus(o) === 'expired'"\r
                  [class.text-red-900]="getPlanStatus(o) === 'expired'"\r
                >\r
                  {{ getPlanStatus(o) }}\r
                </span>\r
              </td>\r
              <td class="px-4 py-3">\r
                <span\r
                  class="font-semibold"\r
                  [class.text-emerald-600]="getDaysRemaining(o) > 5"\r
                  [class.text-yellow-600]="getDaysRemaining(o) <= 5 && getDaysRemaining(o) > 0"\r
                  [class.text-red-600]="getDaysRemaining(o) === 0"\r
                >\r
                  {{ getDaysRemaining(o) }} / 30\r
                </span>\r
              </td>\r
              <td class="px-4 py-3">\r
                <span\r
                  class="inline-flex rounded-full px-2 py-0.5 text-xs font-semibold"\r
                  [class.bg-amber-100]="o.status === 'pending'"\r
                  [class.text-amber-900]="o.status === 'pending'"\r
                  [class.bg-emerald-100]="o.status === 'approved'"\r
                  [class.text-emerald-900]="o.status === 'approved'"\r
                  [class.bg-red-100]="o.status === 'rejected'"\r
                  [class.text-red-900]="o.status === 'rejected'"\r
                  [class.bg-slate-200]="o.status === 'inactive'"\r
                  [class.text-slate-800]="o.status === 'inactive'"\r
                >\r
                  {{ o.status }}\r
                </span>\r
              </td>\r
              <td class="px-4 py-3 text-right">\r
                <div class="mb-2 flex justify-end">\r
                  <button\r
                    type="button"\r
                    class="relative rounded-lg border border-slate-200 bg-white p-2 text-slate-700 hover:bg-slate-50"\r
                    [disabled]="busyId() === o.ownerId"\r
                    (click)="openOwnerChat(o)"\r
                    title="Send / View messages"\r
                  >\r
                    <span class="material-icons-outlined text-base">notifications</span>\r
                    @if (unreadForOwner(o.ownerId) > 0) {\r
                      <span class="absolute -right-1 -top-1 min-w-[1rem] rounded-full bg-red-600 px-1 text-[10px] font-bold text-white">\r
                        {{ unreadForOwner(o.ownerId) }}\r
                      </span>\r
                    }\r
                  </button>\r
                </div>\r
                @if (o.status === 'pending') {\r
                  <div class="flex flex-wrap justify-end gap-2">\r
                    <button\r
                      type="button"\r
                      class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700 disabled:opacity-50"\r
                      [disabled]="busyId() === o.ownerId"\r
                      (click)="openApproveModal(o)"\r
                    >\r
                      {{ 'admin.approve' | t }}\r
                    </button>\r
                    <button\r
                      type="button"\r
                      class="rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-800 hover:bg-red-100 disabled:opacity-50"\r
                      [disabled]="busyId() === o.ownerId"\r
                      (click)="reject(o)"\r
                    >\r
                      Reject\r
                    </button>\r
                  </div>\r
                } @else if (o.status === 'approved') {\r
                  <div class="flex flex-wrap justify-end gap-2">\r
                    <button\r
                      type="button"\r
                      class="rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-700 disabled:opacity-50"\r
                      [disabled]="busyId() === o.ownerId"\r
                      (click)="openExtendModal(o)"\r
                    >\r
                      {{ 'admin.extendPlan' | t }}\r
                    </button>\r
                    <button\r
                      type="button"\r
                      class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-50"\r
                      [disabled]="busyId() === o.ownerId"\r
                      (click)="openInactiveConfirm(o)"\r
                    >\r
                      Mark Inactive\r
                    </button>\r
                  </div>\r
                  <div class="mt-2 flex flex-wrap items-center justify-end gap-2">\r
                    <input\r
                      type="number"\r
                      min="1"\r
                      class="w-16 rounded-lg border border-slate-200 px-2 py-1 text-xs"\r
                      [value]="dayAdjustValue(o.ownerId)"\r
                      (input)="setDayAdjustValue(o.ownerId, $any($event.target).value)"\r
                    />\r
                    <button\r
                      type="button"\r
                      class="rounded-lg border border-red-200 bg-red-50 px-2.5 py-1 text-xs font-semibold text-red-700 hover:bg-red-100 disabled:opacity-50"\r
                      [disabled]="busyId() === o.ownerId"\r
                      (click)="adjustPlanByDays(o, -1)"\r
                    >\r
                      - Days\r
                    </button>\r
                    <button\r
                      type="button"\r
                      class="rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 hover:bg-emerald-100 disabled:opacity-50"\r
                      [disabled]="busyId() === o.ownerId"\r
                      (click)="adjustPlanByDays(o, 1)"\r
                    >\r
                      + Days\r
                    </button>\r
                    <input\r
                      type="date"\r
                      class="rounded-lg border border-slate-200 px-2 py-1 text-xs"\r
                      [value]="calendarValue(o)"\r
                      (change)="setCalendarValue(o.ownerId, $any($event.target).value)"\r
                    />\r
                    <button\r
                      type="button"\r
                      class="rounded-lg border border-indigo-200 bg-indigo-50 px-2.5 py-1 text-xs font-semibold text-indigo-700 hover:bg-indigo-100 disabled:opacity-50"\r
                      [disabled]="busyId() === o.ownerId"\r
                      (click)="setPlanByCalendar(o)"\r
                    >\r
                      Update Date\r
                    </button>\r
                  </div>\r
                  <div class="mt-2 flex flex-wrap items-center justify-end gap-3 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs">\r
                    <span class="font-semibold uppercase tracking-wide text-slate-500">Features</span>\r
                    <label class="flex items-center gap-1.5 text-slate-700">\r
                      <input\r
                        type="checkbox"\r
                        class="h-4 w-4 accent-indigo-600"\r
