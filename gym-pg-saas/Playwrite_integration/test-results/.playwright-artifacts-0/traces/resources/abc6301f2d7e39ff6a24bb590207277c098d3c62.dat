    class="hidden w-64 shrink-0 flex-col border-r border-white/60 bg-white/75 backdrop-blur-xl md:sticky md:top-0 md:flex md:h-screen md:max-h-screen md:self-start dark:border-slate-700/70 dark:bg-slate-950/90 dark:backdrop-blur-xl"\r
  >\r
    <div class="shrink-0 border-b border-slate-100/80 px-5 py-6 dark:border-slate-800/80">\r
      <div class="mb-3 flex items-center justify-between gap-2">\r
        <app-brand-logo [logoSize]="'32px'" [showText]="true" brandName="OurPGTracker"></app-brand-logo>\r
        @if (profile()?.ownerId) {\r
          <app-notification-bell [ownerId]="profile()!.ownerId" />\r
        }\r
        <!-- <button\r
          type="button"\r
          class="relative flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-700 shadow-sm hover:bg-slate-50"\r
          (click)="openNotifications()"\r
          aria-label="Notifications"\r
        >\r
          <span class="material-icons-outlined text-lg">notifications</span>\r
          @if (unreadCount() > 0) {\r
            <span class="absolute -right-1 -top-1 min-w-[1rem] rounded-full bg-red-600 px-1 text-[10px] font-bold text-white">\r
              {{ unreadCount() }}\r
            </span>\r
          }\r
        </button> -->\r
        <!-- sadf -->\r
      </div>\r
      <div class="flex items-start justify-between gap-2">\r
        <!-- <div class="min-w-0 flex-1">\r
          <p class="text-sm font-bold tracking-tight text-slate-900">{{ 'brand.gmPg' | t }}</p>\r
          <p class="mt-0.5 bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-xs font-semibold uppercase tracking-wide text-transparent">\r
            {{ 'brand.paybook' | t }}\r
          </p>\r
          <p class="mt-1 truncate text-sm font-semibold text-slate-900">{{ profile()?.name }}</p>\r
          <p class="truncate text-xs text-slate-500">{{ profile()?.email }}</p>\r
        </div> -->\r
        <!-- <app-language-switcher class="shrink-0" /> -->\r
        <!-- <app-language-switcher class="shrink-0" /> -->\r
      </div>\r
    </div>\r
    <nav class="flex min-h-0 flex-1 flex-col gap-1 overflow-y-auto overflow-x-hidden overscroll-contain p-3">\r
      <a\r
        routerLink="/dashboard"\r
        routerLinkActive="bg-indigo-50 text-indigo-800 shadow-sm dark:bg-indigo-950/70 dark:text-indigo-100 dark:shadow-md"\r
        [routerLinkActiveOptions]="{ exact: true }"\r
        class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-md dark:text-slate-200 dark:hover:bg-slate-800/90 dark:hover:shadow-lg dark:hover:shadow-black/25"\r
      >\r
        <span class="material-icons-outlined">dashboard</span>\r
        {{ 'nav.dashboard' | t }}\r
      </a>\r
      <!-- Notifications nav hidden for now.\r
      @if (profile()?.ownerId) {\r
        <a\r
          routerLink="/notifications"\r
          routerLinkActive="bg-indigo-50 text-indigo-800 shadow-sm dark:bg-indigo-950/70 dark:text-indigo-100 dark:shadow-md"\r
          class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-md dark:text-slate-200 dark:hover:bg-slate-800/90 dark:hover:shadow-lg dark:hover:shadow-black/25"\r
        >\r
          <span class="material-icons-outlined">notifications</span>\r
          <span class="min-w-0 flex-1">{{ 'nav.notifications' | t }}</span>\r
          @if (ownerInAppUnread() > 0) {\r
            <span\r
              class="shrink-0 rounded-full bg-red-600 px-1.5 py-0.5 text-[10px] font-bold leading-none text-white tabular-nums"\r
              >{{ ownerInAppUnread() > 99 ? '99+' : ownerInAppUnread() }}</span>\r
          }\r
        </a>\r
      }\r
      -->\r
      @if (canViewMembers()) {\r
        <a\r
          routerLink="/members"\r
          routerLinkActive="bg-indigo-50 text-indigo-800 shadow-sm dark:bg-indigo-950/70 dark:text-indigo-100 dark:shadow-md"\r
          class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-md dark:text-slate-200 dark:hover:bg-slate-800/90 dark:hover:shadow-lg dark:hover:shadow-black/25"\r
        >\r
          <span class="material-icons-outlined">groups</span>\r
          {{ 'nav.members' | t }}\r
        </a>\r
      }\r
      @if (canViewInactiveMembers()) {\r
        <a\r
          routerLink="/inactive-members"\r
          routerLinkActive="bg-indigo-50 text-indigo-800 shadow-sm dark:bg-indigo-950/70 dark:text-indigo-100 dark:shadow-md"\r
          class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-md dark:text-slate-200 dark:hover:bg-slate-800/90 dark:hover:shadow-lg dark:hover:shadow-black/25"\r
        >\r
          <span class="material-icons-outlined">person_off</span>\r
          Inactive Members\r
        </a>\r
      }\r
      @if (canViewPayments()) {\r
        <a\r
          routerLink="/payments"\r
          routerLinkActive="bg-indigo-50 text-indigo-800 shadow-sm dark:bg-indigo-950/70 dark:text-indigo-100 dark:shadow-md"\r
          class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-md dark:text-slate-200 dark:hover:bg-slate-800/90 dark:hover:shadow-lg dark:hover:shadow-black/25"\r
        >\r
          <span class="material-icons-outlined">payments</span>\r
          {{ 'nav.payments' | t }}\r
        </a>\r
      }\r
      @if (isPgOwner() && canViewRooms()) {\r
        <a\r
          routerLink="/rooms"\r
          routerLinkActive="bg-indigo-50 text-indigo-800 shadow-sm dark:bg-indigo-950/70 dark:text-indigo-100 dark:shadow-md"\r
          class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-md dark:text-slate-200 dark:hover:bg-slate-800/90 dark:hover:shadow-lg dark:hover:shadow-black/25"\r
        >\r
          <span class="material-icons-outlined">hotel</span>\r
          {{ 'nav.rooms' | t }}\r
        </a>\r
      }\r
      @if (canViewMonthlyEarnings()) {\r
        <a\r
          routerLink="/monthly-earnings"\r
          routerLinkActive="bg-indigo-50 text-indigo-800 shadow-sm dark:bg-indigo-950/70 dark:text-indigo-100 dark:shadow-md"\r
          class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-md dark:text-slate-200 dark:hover:bg-slate-800/90 dark:hover:shadow-lg dark:hover:shadow-black/25"\r
        >\r
          <span class="material-icons-outlined">bar_chart</span>\r
          Monthly Earnings\r
        </a>\r
      }\r
      @if (canSeeSupervisorsLink()) {\r
        <a\r
          routerLink="/supervisors"\r
          routerLinkActive="bg-indigo-50 text-indigo-800 shadow-sm dark:bg-indigo-950/70 dark:text-indigo-100 dark:shadow-md"\r
          class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-md dark:text-slate-200 dark:hover:bg-slate-800/90 dark:hover:shadow-lg dark:hover:shadow-black/25"\r
        >\r
          <span class="material-icons-outlined">supervisor_account</span>\r
          {{ 'nav.supervisors' | t }}\r
        </a>\r
      }\r
      @if (canViewAnalytics()) {\r
        <a\r
          routerLink="/analytics"\r
          routerLinkActive="bg-indigo-50 text-indigo-800 shadow-sm dark:bg-indigo-950/70 dark:text-indigo-100 dark:shadow-md"\r
          class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-md dark:text-slate-200 dark:hover:bg-slate-800/90 dark:hover:shadow-lg dark:hover:shadow-black/25"\r
        >\r
          <span class="material-icons-outlined">analytics</span>\r
          Analytics\r
        </a>\r
      }\r
      @if (canViewAuditLog()) {\r
        <a\r
          routerLink="/audit-log"\r
          routerLinkActive="bg-indigo-50 text-indigo-800 shadow-sm dark:bg-indigo-950/70 dark:text-indigo-100 dark:shadow-md"\r
          class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-md dark:text-slate-200 dark:hover:bg-slate-800/90 dark:hover:shadow-lg dark:hover:shadow-black/25"\r
        >\r
          <span class="material-icons-outlined">verified_user</span>\r
          Audit Log\r
        </a>\r
      }\r
      @if (!isSupervisor()) {\r
        <a\r
          routerLink="/complaints"\r
          routerLinkActive="bg-amber-50 text-amber-800 shadow-sm dark:bg-amber-950/60 dark:text-amber-100 dark:shadow-md"\r
          class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-md dark:text-slate-200 dark:hover:bg-slate-800/90 dark:hover:shadow-lg dark:hover:shadow-black/25"\r
        >\r
          <span class="material-icons-outlined">support_agent</span>\r
          <span class="min-w-0 flex-1">Complaint Box</span>\r
          @if (openComplaintsCount() > 0) {\r
            <span\r
              class="shrink-0 rounded-full bg-amber-500 px-1.5 py-0.5 text-[10px] font-bold leading-none text-white tabular-nums"\r
              >{{ openComplaintsCount() > 99 ? '99+' : openComplaintsCount() }}</span>\r
          }\r
        </a>\r
      }\r
      @if (!isSupervisor() && canSeeMemberAppQrLink()) {\r
        <a\r
          routerLink="/member-app-qr"\r
          routerLinkActive="bg-teal-50 text-teal-800 shadow-sm dark:bg-teal-950/60 dark:text-teal-100 dark:shadow-md"\r
          class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-md dark:text-slate-200 dark:hover:bg-slate-800/90 dark:hover:shadow-lg dark:hover:shadow-black/25"\r
        >\r
          <span class="material-icons-outlined">qr_code_2</span>\r
          Member App QR\r
        </a>\r
      }\r
    </nav>\r
    <div class="shrink-0 border-t border-slate-100 p-3 dark:border-slate-800">\r
      <button\r
        type="button"\r
        class="saas-btn-secondary flex w-full items-center justify-center gap-2 py-3 text-sm"\r
        (click)="signOut()"\r
      >\r
        <span class="material-icons-outlined text-lg">logout</span>\r
        {{ 'nav.signOut' | t }}\r
      </button>\r
    </div>\r
  </aside>\r
\r
  <div class="flex min-w-0 flex-1 flex-col">\r
    <!-- Desktop: slim bar \u2014 theme / accent live under the settings (gear) menu -->\r
    <header\r
      class="sticky top-0 z-20 hidden h-12 w-full min-w-0 shrink-0 items-center justify-end gap-2 border-b border-slate-200/90 bg-white/90 px-4 backdrop-blur-md dark:border-slate-700 dark:bg-slate-950/90 md:flex"\r
    >\r
      <div class="relative shrink-0" data-appearance-menu-root>\r
        <button\r
          type="button"\r
          class="flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-700 shadow-sm transition-all hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"\r
          (click)="toggleAppearanceMenu($event)"\r
          [attr.aria-expanded]="appearanceMenuOpen()"\r
          aria-label="Display and theme settings"\r
        >\r
          <span class="material-icons-outlined text-[22px]">settings</span>\r
        </button>\r
        @if (appearanceMenuOpen()) {\r
          <div\r
            class="absolute right-0 top-11 z-50 w-72 max-w-[calc(100vw-2rem)] rounded-xl border border-slate-200 bg-white p-3 shadow-xl dark:border-slate-600 dark:bg-slate-900 dark:shadow-black/40"\r
            role="menu"\r
            (click)="$event.stopPropagation()"\r
          >\r
            <p class="mb-2 text-[10px] font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Appearance</p>\r
            <div class="mb-3">\r
              <app-theme-picker />\r
            </div>\r
            <app-theme-toggle />\r
          </div>\r
        }\r
      </div>\r
    </header>\r
\r
    <header\r
      class="sticky top-0 z-20 flex w-full min-w-0 items-center justify-between gap-3 border-b border-slate-200/90 bg-white px-3 py-2.5 md:hidden dark:border-slate-700 dark:bg-slate-950"\r
    >\r
      <button\r
        type="button"\r
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-800 shadow-sm transition-all hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700"\r
        (click)="openMobileMenu()"\r
        [attr.aria-label]="'a11y.openMenu' | t"\r
        [attr.aria-expanded]="mobileMenuOpen()"\r
      >\r
        <span class="material-icons-outlined text-2xl">menu</span>\r
      </button>\r
      <div class="min-w-0 flex-1 px-1 text-center">\r
        <p\r
          class="truncate text-[13px] font-semibold leading-tight tracking-tight text-slate-800 dark:text-slate-100 sm:text-sm"\r
          [attr.title]="\r
            ownerHeaderGreeting().displayName\r
              ? ownerHeaderGreeting().text + ' \u2014 ' + ownerHeaderGreeting().displayName\r
              : ownerHeaderGreeting().text\r
          "\r
        >\r
          <span\r
            class="material-icons-outlined mr-0.5 align-[-3px] text-[17px] text-indigo-600 dark:text-indigo-400"\r
            aria-hidden="true"\r
            >{{ ownerHeaderGreeting().icon }}</span\r
          ><span>{{ ownerHeaderGreeting().text }}</span>\r
          @if (ownerHeaderGreeting().displayName) {\r
            <span class="mx-0.5 font-normal text-slate-500 dark:text-slate-400">\u2014</span>\r
            <span\r
              class="material-icons-outlined mx-0.5 align-[-3px] text-[15px] text-indigo-500 dark:text-indigo-400"\r
              aria-hidden="true"\r
              >person</span\r
            ><span>{{ ownerHeaderGreeting().displayName }}</span>\r
          }\r
        </p>\r
      </div>\r
      <div class="flex shrink-0 items-center gap-2">\r
        @if (profile()?.ownerId) {\r
          <app-notification-bell class="shrink-0" [ownerId]="profile()!.ownerId" />\r
        }\r
        <div class="relative shrink-0" data-appearance-menu-root>\r
          <button\r
            type="button"\r
            class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-700 shadow-sm transition-all hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"\r
            (click)="toggleAppearanceMenu($event)"\r
            [attr.aria-expanded]="appearanceMenuOpen()"\r
            aria-label="Display and theme settings"\r
          >\r
            <span class="material-icons-outlined text-[22px]">settings</span>\r
          </button>\r
          @if (appearanceMenuOpen()) {\r
            <div\r
              class="absolute right-0 top-12 z-50 w-[min(18rem,calc(100vw-2rem))] rounded-xl border border-slate-200 bg-white p-3 shadow-xl dark:border-slate-600 dark:bg-slate-900 dark:shadow-black/40"\r
              role="menu"\r
              (click)="$event.stopPropagation()"\r
            >\r
              <p class="mb-2 text-[10px] font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Appearance</p>\r
              <div class="mb-3">\r
                <app-theme-picker />\r
              </div>\r
              <app-theme-toggle />\r
            </div>\r
          }\r
        </div>\r
        <div class="relative shrink-0" data-user-menu-root>\r
          <button\r
            type="button"\r
            class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-indigo-600 to-blue-600 text-sm font-bold text-white shadow-md ring-2 ring-white"\r
            (click)="toggleUserMenu($event)"\r
            [attr.aria-expanded]="userMenuOpen()"\r
            [attr.aria-label]="'a11y.userMenu' | t"\r
          >\r
            {{ ownerInitial() }}\r
          </button>\r
          @if (userMenuOpen()) {\r
            <div\r
              class="absolute right-0 top-12 z-50 min-w-[14rem] rounded-xl border border-slate-200 bg-white p-2 shadow-xl dark:border-slate-600 dark:bg-slate-900 dark:shadow-black/40"\r
              role="menu"\r
            >\r
              <p class="border-b border-slate-100 px-3 py-2 text-xs text-slate-500 dark:border-slate-700 dark:text-slate-400">{{ 'auth.email' | t }}</p>\r
              <p class="px-3 pb-2 text-sm font-medium text-slate-900 break-all dark:text-slate-100">{{ profile()?.email }}</p>\r
              <button\r
                type="button"\r
                class="mt-1 flex w-full items-center gap-2 rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800/80"\r
                role="menuitem"\r
                (click)="openNotifications(); closeUserMenu()"\r
              >\r
                <span class="material-icons-outlined text-lg">support_agent</span>\r
                Message admin\r
                @if (unreadCount() > 0) {\r
                  <span class="ml-auto rounded-full bg-red-600 px-1.5 text-[10px] font-bold text-white">{{ unreadCount() }}</span>\r
                }\r
              </button>\r
              <button\r
                type="button"\r
                class="mt-1 flex w-full items-center gap-2 rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-red-700 transition-colors hover:bg-red-50 dark:text-red-300 dark:hover:bg-red-950/40"\r
                role="menuitem"\r
                (click)="signOut()"\r
              >\r
                <span class="material-icons-outlined text-lg">logout</span>\r
                {{ 'auth.logout' | t }}\r
              </button>\r
            </div>\r
          }\r
        </div>\r
      </div>\r
    </header>\r
\r
    @if (mobileMenuOpen()) {\r
      <div\r
        class="fixed inset-0 z-40 md:hidden"\r
        role="dialog"\r
        aria-modal="true"\r
        [attr.aria-label]="'a11y.navMenu' | t"\r
      >\r
        <div\r
          class="absolute inset-0 bg-slate-900/45 backdrop-blur-sm transition-opacity"\r
          (click)="closeMobileMenu()"\r
        ></div>\r
        <aside\r
          class="saas-mobile-nav-drawer absolute left-0 top-0 flex h-full w-[min(18rem,88vw)] flex-col border-r border-slate-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-950 dark:shadow-black/40"\r
          (click)="$event.stopPropagation()"\r
        >\r
          <div class="flex items-center justify-between border-b border-slate-100 px-4 py-4 dark:border-slate-800">\r
            <div class="min-w-0 pr-2">\r
              <p class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-xs font-semibold uppercase tracking-wide text-transparent">\r
                {{ 'nav.menu' | t }}\r
              </p>\r
              <p class="truncate text-sm font-semibold text-slate-900 dark:text-slate-100">{{ profile()?.name }}</p>\r
              @if (planCountdown(); as c) {\r
                <p class="mt-1 text-xs font-semibold" [class.text-red-600]="c.expired" [class.text-emerald-700]="!c.expired">\r
                  Plan: {{ c.display }}\r
                </p>\r
              }\r
            </div>\r
            <button\r
              type="button"\r
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"\r
              (click)="closeMobileMenu()"\r
              [attr.aria-label]="'a11y.closeMenu' | t"\r
            >\r
              <span class="material-icons-outlined text-2xl">close</span>\r
            </button>\r
          </div>\r
          <nav class="flex flex-1 flex-col gap-1 overflow-y-auto p-3">\r
            <a\r
              routerLink="/dashboard"\r
              routerLinkActive="bg-indigo-50 text-indigo-800 shadow-sm dark:bg-indigo-950/70 dark:text-indigo-100 dark:shadow-md"\r
              [routerLinkActiveOptions]="{ exact: true }"\r
              class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 transition-all hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800/80"\r
              (click)="closeMobileMenu()"\r
            >\r
              <span class="material-icons-outlined">dashboard</span>\r
              {{ 'nav.home' | t }}\r
            </a>\r
            <!-- Notifications nav hidden for now.\r
            @if (profile()?.ownerId) {\r
              <a\r
                routerLink="/notifications"\r
                routerLinkActive="bg-indigo-50 text-indigo-800 shadow-sm dark:bg-indigo-950/70 dark:text-indigo-100 dark:shadow-md"\r
                class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 transition-all hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800/80"\r
                (click)="closeMobileMenu()"\r
              >\r
                <span class="material-icons-outlined">notifications</span>\r
                <span class="min-w-0 flex-1">{{ 'nav.notifications' | t }}</span>\r
                @if (ownerInAppUnread() > 0) {\r
                  <span\r
                    class="shrink-0 rounded-full bg-red-600 px-1.5 py-0.5 text-[10px] font-bold leading-none text-white tabular-nums"\r
                    >{{ ownerInAppUnread() > 99 ? '99+' : ownerInAppUnread() }}</span>\r
                }\r
              </a>\r
            }\r
            -->\r
            @if (canViewMembers()) {\r
              <a\r
                routerLink="/members"\r
                routerLinkActive="bg-indigo-50 text-indigo-800 shadow-sm dark:bg-indigo-950/70 dark:text-indigo-100 dark:shadow-md"\r
                class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 transition-all hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800/80"\r
                (click)="closeMobileMenu()"\r
              >\r
                <span class="material-icons-outlined">groups</span>\r
                {{ 'nav.members' | t }}\r
              </a>\r
            }\r
            @if (canViewInactiveMembers()) {\r
              <a\r
                routerLink="/inactive-members"\r
                routerLinkActive="bg-indigo-50 text-indigo-800 shadow-sm dark:bg-indigo-950/70 dark:text-indigo-100 dark:shadow-md"\r
