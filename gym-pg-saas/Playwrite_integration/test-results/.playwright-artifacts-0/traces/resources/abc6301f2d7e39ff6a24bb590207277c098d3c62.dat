    (() => {
      (typeof ngDevMode === "undefined" || ngDevMode) && i021.\u0275setClassMetadata(OwnerDashboardComponent, [{
        type: Component13,
        args: [{ selector: "app-owner-dashboard", standalone: true, imports: [DatePipe7, DecimalPipe7, NgClass6, RouterLink5, ReactiveFormsModule, ModalComponent, MonthlyEarningsDetailedComponent, BedMapSeatGridComponent, TranslatePipe], template: `<div class="saas-page mx-auto w-full min-w-0 max-w-7xl space-y-6 overflow-x-clip">\r
  <!-- \u2500\u2500 Header bar with title and plan countdown \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\r
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4">\r
    <div class="min-w-0 flex-1">\r
      <h1 class="truncate text-2xl font-bold text-slate-900 sm:text-3xl">{{ dashboardTitle() }}</h1>\r
      <p class="mt-0.5 text-sm text-slate-600">{{ 'dashboard.subtitle' | t }}</p>\r
    </div>\r
    <div class="hidden shrink-0 flex-col items-stretch gap-2 self-start sm:flex sm:items-end">\r
      <div\r
        class="inline-flex min-w-0 max-w-full flex-wrap items-center gap-x-1.5 gap-y-0.5 rounded-2xl border border-slate-200/90 bg-white/90 px-3.5 py-2 shadow-sm backdrop-blur-sm dark:border-slate-700 dark:bg-slate-900/80"\r
        [attr.title]="\r
          dashboardHeaderGreeting().displayName\r
            ? dashboardHeaderGreeting().text + ' \u2014 ' + dashboardHeaderGreeting().displayName\r
            : dashboardHeaderGreeting().text\r
        "\r
      >\r
        <span\r
          class="material-icons-outlined shrink-0 text-xl text-indigo-600 dark:text-indigo-400"\r
          aria-hidden="true"\r
          >{{ dashboardHeaderGreeting().icon }}</span>\r
        <span class="text-sm font-semibold tracking-tight text-slate-800 dark:text-slate-100">{{\r
          dashboardHeaderGreeting().text\r
        }}</span>\r
        @if (dashboardHeaderGreeting().displayName) {\r
          <span class="text-sm font-normal text-slate-500 dark:text-slate-400">\u2014</span>\r
          <span\r
            class="material-icons-outlined shrink-0 text-lg text-indigo-500 dark:text-indigo-400"\r
            aria-hidden="true"\r
            >person</span>\r
          <span class="truncate text-sm font-semibold tracking-tight text-slate-800 dark:text-slate-100">{{\r
            dashboardHeaderGreeting().displayName\r
          }}</span>\r
        }\r
      </div>\r
      @if (subscriptionCountdown(); as c) {\r
        <div\r
          class="inline-flex items-center justify-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-semibold shadow-sm"\r
          [ngClass]="\r
            c.expired || c.days <= 7\r
              ? 'border-red-200 bg-red-50 text-red-700 dark:border-red-800 dark:bg-red-950/50 dark:text-red-200'\r
              : 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-200'\r
          "\r
        >\r
          <span class="material-icons-outlined text-sm leading-none">schedule</span>\r
          <span>Plan {{ c.text }}</span>\r
        </div>\r
      }\r
    </div>\r
  </div>\r
\r
  <!-- \u2500\u2500 Pulse status strip (clickable chips, drill-down to filtered views) \u2500\u2500 -->\r
  @if (!loading() && pulseChips().length > 0) {\r
    <div class="-mx-1 flex gap-2 overflow-x-auto px-1 pb-1" role="toolbar" aria-label="Status pulse">\r
      @for (chip of pulseChips(); track trackByChipId($index, chip)) {\r
        <button\r
          type="button"\r
          (click)="goToPulseChip(chip)"\r
          [disabled]="!chip.link && !chip.action"\r
          class="group inline-flex shrink-0 items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-semibold shadow-sm transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-1 disabled:cursor-default"\r
          [ngClass]="{\r
            'border-red-200 bg-red-50 text-red-800 hover:bg-red-100 focus-visible:ring-red-300': chip.tone === 'red',\r
            'border-amber-200 bg-amber-50 text-amber-900 hover:bg-amber-100 focus-visible:ring-amber-300': chip.tone === 'amber',\r
            'border-emerald-200 bg-emerald-50 text-emerald-800 hover:bg-emerald-100 focus-visible:ring-emerald-300': chip.tone === 'emerald',\r
            'border-sky-200 bg-sky-50 text-sky-800 hover:bg-sky-100 focus-visible:ring-sky-300': chip.tone === 'sky',\r
            'border-violet-200 bg-violet-50 text-violet-800 hover:bg-violet-100 focus-visible:ring-violet-300': chip.tone === 'violet',\r
            'border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 focus-visible:ring-slate-300': chip.tone === 'slate'\r
          }"\r
        >\r
          <span\r
            class="inline-block h-1.5 w-1.5 rounded-full"\r
            [ngClass]="{\r
              'bg-red-500': chip.tone === 'red',\r
              'bg-amber-500': chip.tone === 'amber',\r
              'bg-emerald-500': chip.tone === 'emerald',\r
              'bg-sky-500': chip.tone === 'sky',\r
              'bg-violet-500': chip.tone === 'violet',\r
              'bg-slate-400': chip.tone === 'slate'\r
            }"\r
          ></span>\r
          <span class="material-icons-outlined text-sm leading-none">{{ chip.icon }}</span>\r
          <span class="whitespace-nowrap">{{ chip.label }}</span>\r
          @if (chip.link || chip.action) {\r
            <span class="material-icons-outlined ml-0.5 text-[14px] leading-none opacity-0 transition group-hover:opacity-70">arrow_forward</span>\r
          }\r
        </button>\r
      }\r
    </div>\r
  }\r
\r
  @if (isPg()) {\r
    <section class="saas-card p-4">\r
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">\r
        <div class="min-w-0">\r
          <p class="text-sm font-semibold text-slate-900">{{ 'dashboard.pgBedAvailability' | t }}</p>\r
          @if (hasPgLayout()) {\r
            <p class="text-xs text-slate-600">\r
              {{\r
                'dashboard.floorsRoomsBeds'\r
                  | t: { floors: pgLayout()?.floors?.length || 0, rooms: totalRooms(), beds: totalBeds() }\r
              }}\r
            </p>\r
            <p class="mt-1 text-base font-bold text-emerald-700">{{ 'dashboard.availableBeds' | t }}: {{ emptyBeds() }}</p>\r
          } @else {\r
            <p class="text-xs text-amber-700">{{ 'dashboard.setupRequired' | t }}</p>\r
          }\r
        </div>\r
        <div class="flex flex-wrap gap-2 sm:flex-nowrap">\r
          <button\r
            type="button"\r
            class="flex-1 rounded-xl border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 sm:flex-none sm:px-4"\r
            (click)="openSetupModal()"\r
          >\r
            {{ 'dashboard.setupBedAvailability' | t }}\r
          </button>\r
          <button\r
            type="button"\r
            class="saas-btn-primary flex-1 px-3 py-2 text-sm disabled:cursor-not-allowed disabled:opacity-50 sm:flex-none sm:px-4"\r
            [disabled]="!hasPgLayout()"\r
            (click)="openBedMap()"\r
          >\r
            {{ 'dashboard.viewBedMap' | t }}\r
          </button>\r
        </div>\r
      </div>\r
    </section>\r
  }\r
\r
  @if (loading()) {\r
    <!-- Skeleton: KPI cards + command deck shape, prevents layout shift on load -->\r
    <div class="space-y-6">\r
      <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3 xl:grid-cols-4">\r
        @for (_ of [1,2,3,4,5,6]; track $index) {\r
          <div class="h-[112px] animate-pulse rounded-2xl bg-gradient-to-br from-slate-200 to-slate-100 sm:h-[124px] dark:from-slate-700 dark:to-slate-800"></div>\r
        }\r
      </div>\r
      <div class="grid gap-4 lg:grid-cols-3">\r
        <div class="h-[420px] animate-pulse rounded-2xl bg-slate-100 lg:col-span-2 dark:bg-slate-800"></div>\r
        <div class="space-y-4">\r
          <div class="h-32 animate-pulse rounded-2xl bg-slate-100 dark:bg-slate-800"></div>\r
          <div class="h-48 animate-pulse rounded-2xl bg-slate-100 dark:bg-slate-800"></div>\r
          <div class="h-40 animate-pulse rounded-2xl bg-slate-100 dark:bg-slate-800"></div>\r
        </div>\r
      </div>\r
    </div>\r
  } @else {\r
    <div class="grid min-w-0 grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3 xl:grid-cols-4 [&>*]:min-w-0">\r
      <a\r
        routerLink="/members"\r
        [queryParams]="{ pay: 'all', due: null, onboarding: null }"\r
        queryParamsHandling="merge"\r
        class="group relative block overflow-hidden rounded-2xl bg-gradient-to-br from-slate-600 to-slate-800 p-4 text-left shadow-lg shadow-slate-900/20 outline-none ring-offset-2 transition hover:shadow-xl hover:shadow-slate-900/30 focus-visible:ring-2 focus-visible:ring-slate-400 sm:p-5"\r
        [attr.aria-label]="('dashboard.totalMembers' | t) + ' \u2014 ' + ('dashboard.viewFullList' | t)"\r
      >\r
        <span\r
          class="material-icons-outlined pointer-events-none absolute -right-1 top-2 text-5xl text-white/10 transition group-hover:text-white/15 select-none sm:text-6xl"\r
          aria-hidden="true"\r
          >groups</span\r
        >\r
        <p class="relative text-[10px] font-semibold uppercase tracking-wider text-white/80 sm:text-[11px] sm:text-white/70">\r
          {{ 'dashboard.totalMembers' | t }}\r
        </p>\r
        <p class="relative mt-1.5 text-2xl font-extrabold tabular-nums text-white sm:mt-2 sm:text-3xl">{{ totalMembers() }}</p>\r
        <p class="relative mt-1 line-clamp-2 text-[11px] leading-snug text-white/80 sm:text-xs sm:text-white/75">\r
          {{ 'dashboard.viewFullList' | t }}\r
        </p>\r
      </a>\r
      @if (!isSupervisor()) {\r
        <div\r
          class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-700 p-4 shadow-lg shadow-emerald-900/25 sm:p-5"\r
        >\r
          <span\r
            class="material-icons-outlined pointer-events-none absolute -right-1 top-2 text-5xl text-white/10 select-none sm:text-6xl"\r
            aria-hidden="true"\r
            >payments</span\r
          >\r
          <div class="relative flex items-start justify-between gap-1 sm:gap-2">\r
            <p class="text-[10px] font-semibold uppercase tracking-wider text-white/90 sm:text-[11px] sm:text-white/80">\r
              {{ 'dashboard.monthEarnings' | t }}\r
            </p>\r
            <div class="flex shrink-0 gap-0.5">\r
              <!-- <button\r
                type="button"\r
                class="rounded-lg p-1 text-white/90 transition hover:bg-white/15"\r
                (click)="showMonthlyEarningsModal.set(true)"\r
                title="View monthly earnings details"\r
              >\r
                <span class="material-icons-outlined text-lg">history</span>\r
              </button> -->\r
              <button\r
                type="button"\r
                class="rounded-lg p-1 text-white/90 transition hover:bg-white/15"\r
                (click)="showMonthEarnings.set(!showMonthEarnings())"\r
                [attr.aria-label]="showMonthEarnings() ? ('dashboard.hideEarnings' | t) : ('dashboard.showEarnings' | t)"\r
                [attr.title]="showMonthEarnings() ? ('dashboard.hideEarnings' | t) : ('dashboard.showEarnings' | t)"\r
              >\r
                <span class="material-icons-outlined text-lg">{{\r
                  showMonthEarnings() ? 'visibility_off' : 'visibility'\r
                }}</span>\r
              </button>\r
            </div>\r
          </div>\r
          @if (showMonthEarnings()) {\r
            <p class="relative mt-1.5 text-2xl font-extrabold tabular-nums text-white sm:mt-2 sm:text-3xl">\r
              \u20B9{{ monthEarnings() | number: '1.0-0' }}\r
            </p>\r
          } @else {\r
            <p class="relative mt-1.5 text-2xl font-extrabold tracking-wider text-white sm:mt-2 sm:text-3xl">\u20B9 \u2022\u2022\u2022\u2022\u2022\u2022</p>\r
          }\r
        </div>\r
        <button\r
          type="button"\r
          (click)="openTodayCollectionDetail()"\r
          class="group relative block w-full overflow-hidden rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-700 p-4 text-left shadow-lg shadow-violet-900/25 outline-none ring-offset-2 transition hover:shadow-xl hover:shadow-violet-900/35 focus-visible:ring-2 focus-visible:ring-violet-300 sm:p-5"\r
        >\r
          <span\r
            class="material-icons-outlined pointer-events-none absolute -right-1 top-2 text-5xl text-white/10 transition group-hover:text-white/15 select-none sm:text-6xl"\r
            aria-hidden="true"\r
            >today</span\r
          >\r
          <div class="relative flex items-start justify-between gap-1 sm:gap-2">\r
            <p class="text-[10px] font-semibold uppercase tracking-wider text-white/90 sm:text-[11px] sm:text-white/80">\r
              {{ 'dashboard.todayCollection' | t }}\r
            </p>\r
            <span\r
              class="material-icons-outlined shrink-0 rounded-lg bg-white/15 p-1 text-base text-white/95 transition group-hover:bg-white/25"\r
              [attr.title]="'dashboard.todayCollectionDetailTitle' | t"\r
              aria-hidden="true"\r
              >info_outline</span\r
            >\r
          </div>\r
\r
          <p class="relative mt-1.5 text-2xl font-extrabold tabular-nums text-white sm:mt-2 sm:text-3xl">\r
            \u20B9{{ todayCollection() | number: '1.0-0' }}\r
          </p>\r
\r
          <p class="relative mt-1 line-clamp-2 text-[11px] leading-snug text-white/85 sm:text-xs sm:text-white/75">\r
            @if (todayCollectionCount() > 0) {\r
              {{ todayCollectionCount() }} {{ todayCollectionCount() === 1 ? 'payment' : 'payments' }} captured today \xB7\r
              {{ 'dashboard.todayCollectionTapDetail' | t }}\r
            } @else {\r
              {{ 'dashboard.todayCollectionHint' | t }}\r
            }\r
          </p>\r
        </button>\r
        <button\r
          type="button"\r
          (click)="openAdvanceCollectionModal()"\r
          class="group relative block overflow-hidden rounded-2xl bg-gradient-to-br from-cyan-500 to-sky-800 p-4 text-left shadow-lg shadow-cyan-900/25 outline-none ring-offset-2 transition hover:shadow-xl hover:shadow-cyan-900/35 focus-visible:ring-2 focus-visible:ring-cyan-300 sm:p-5"\r
        >\r
          <span\r
            class="material-icons-outlined pointer-events-none absolute -right-1 top-2 text-5xl text-white/10 transition group-hover:text-white/15 select-none sm:text-6xl"\r
            aria-hidden="true"\r
            >savings</span\r
          >\r
          <p class="relative text-[10px] font-semibold uppercase tracking-wider text-white/90 sm:text-[11px] sm:text-white/80">\r
            {{ 'dashboard.advanceHeldTitle' | t }}\r
          </p>\r
          <p class="relative mt-1.5 text-2xl font-extrabold tabular-nums text-white sm:mt-2 sm:text-3xl">\r
            \u20B9{{ totalAdvanceHeld() | number: '1.0-0' }}\r
          </p>\r
          <p class="relative mt-1 line-clamp-2 text-[11px] leading-snug text-white/85 sm:text-xs sm:text-white/75">\r
            {{ 'dashboard.advanceThisMonth' | t }}: \u20B9{{ advanceAttributedThisMonth() | number: '1.0-0' }} \xB7\r
            {{ 'dashboard.advanceHeldHint' | t }}\r
          </p>\r
        </button>\r
      }\r
      @if (canSeeSupervisorCollections()) {\r
        <button\r
          type="button"\r
          (click)="openSupervisorCollections()"\r
          class="group relative block overflow-hidden rounded-2xl bg-gradient-to-br from-fuchsia-500 to-rose-600 p-4 text-left shadow-lg shadow-rose-900/25 outline-none ring-offset-2 transition hover:shadow-xl hover:shadow-rose-900/35 focus-visible:ring-2 focus-visible:ring-rose-300 sm:p-5"\r
        >\r
          <span\r
            class="material-icons-outlined pointer-events-none absolute -right-1 top-2 text-5xl text-white/10 transition group-hover:text-white/15 select-none sm:text-6xl"\r
            aria-hidden="true"\r
            >badge</span\r
          >\r
          <div class="relative flex items-start justify-between gap-1 sm:gap-2">\r
            <p class="text-[10px] font-semibold uppercase tracking-wider text-white/90 sm:text-[11px] sm:text-white/85">\r
              Supervisor collections\r
            </p>\r
            <span\r
              class="material-icons-outlined rounded-lg bg-white/15 p-1 text-base text-white/95 transition group-hover:bg-white/25"\r
              [attr.title]="'Tap to see who collected what \u2014 member, amount and method'"\r
              aria-hidden="true"\r
              >info_outline</span\r
            >\r
          </div>\r
        \r
            <p class="relative mt-1.5 text-2xl font-extrabold tabular-nums text-white sm:mt-2 sm:text-3xl">\r
              \u20B9{{ supervisorTodayTotal() | number: '1.0-0' }}\r
            </p>\r
          <p class="relative mt-1 line-clamp-2 text-[11px] leading-snug text-white/85 sm:text-xs sm:text-white/80">\r
            @if (supervisorTodayCount() > 0) {\r
              {{ supervisorTodayCount() }} {{ supervisorTodayCount() === 1 ? 'payment' : 'payments' }} today &middot; tap for day-wise log\r
            } @else {\r
              No supervisor activity yet today &middot; tap to view history\r
            }\r
          </p>\r
        </button>\r
      }\r
      <a\r
        routerLink="/members"\r
        [queryParams]="{ pay: 'pending' }"\r
        class="group relative block overflow-hidden rounded-2xl bg-gradient-to-br from-amber-500 to-orange-600 p-4 shadow-lg shadow-amber-600/25 outline-none ring-offset-2 transition hover:shadow-xl hover:shadow-amber-600/35 focus-visible:ring-2 focus-visible:ring-amber-400 sm:p-5"\r
      >\r
        <span\r
          class="material-icons-outlined pointer-events-none absolute -right-1 top-2 text-5xl text-white/10 transition group-hover:text-white/15 select-none sm:text-6xl"\r
          aria-hidden="true"\r
          >schedule</span\r
        >\r
        <p class="relative text-[10px] font-semibold uppercase tracking-wider text-white/90 sm:text-[11px] sm:text-white/85">\r
          {{ 'dashboard.pendingPayments' | t }}\r
        </p>\r
        <p class="relative mt-1.5 text-2xl font-extrabold tabular-nums text-white sm:mt-2 sm:text-3xl">{{ pendingCount() }}</p>\r
        <p class="relative mt-1 line-clamp-2 text-[11px] leading-snug text-white/85 sm:text-xs sm:text-white/75">\r
          {{ 'dashboard.dueTodayOrOverdue' | t }}\r
        </p>\r
      </a>\r
      <a\r
        routerLink="/members"\r
        [queryParams]="{ due: 'dueSoon' }"\r
        class="group relative block overflow-hidden rounded-2xl bg-gradient-to-br from-sky-500 to-blue-700 p-4 shadow-lg shadow-blue-600/25 outline-none ring-offset-2 transition hover:shadow-xl hover:shadow-blue-600/35 focus-visible:ring-2 focus-visible:ring-sky-400 sm:p-5"\r
      >\r
        <span\r
          class="material-icons-outlined pointer-events-none absolute -right-1 top-2 text-5xl text-white/10 transition group-hover:text-white/15 select-none sm:text-6xl"\r
          aria-hidden="true"\r
          >event</span\r
        >\r
        <p class="relative text-[10px] font-semibold uppercase tracking-wider text-white/90 sm:text-[11px] sm:text-white/85">\r
          {{ 'dashboard.dueSoonTitle' | t }}\r
        </p>\r
        <p class="relative mt-1.5 text-2xl font-extrabold tabular-nums text-white sm:mt-2 sm:text-3xl">{{ dueSoonList().length }}</p>\r
        <p class="relative mt-1 line-clamp-2 text-[11px] leading-snug text-white/85 sm:text-xs sm:text-white/75">\r
          {{ 'dashboard.dueSoonSubtitle' | t }}\r
        </p>\r
      </a>\r
      <a\r
        routerLink="/members"\r
        [queryParams]="{ pay: 'pending', due: 'overdue' }"\r
        class="group relative block overflow-hidden rounded-2xl bg-gradient-to-br from-rose-500 to-red-700 p-4 shadow-lg shadow-red-700/25 outline-none ring-offset-2 transition hover:shadow-xl hover:shadow-red-800/35 focus-visible:ring-2 focus-visible:ring-rose-400 sm:p-5"\r
      >\r
        <span\r
          class="material-icons-outlined pointer-events-none absolute -right-1 top-2 text-5xl text-white/10 transition group-hover:text-white/15 select-none sm:text-6xl"\r
          aria-hidden="true"\r
          >warning</span\r
        >\r
        <p class="relative text-[10px] font-semibold uppercase tracking-wider text-white/90 sm:text-[11px] sm:text-white/85">\r
          {{ 'dashboard.overdue' | t }}\r
        </p>\r
        <p class="relative mt-1.5 text-2xl font-extrabold tabular-nums text-white sm:mt-2 sm:text-3xl">{{ overdueList().length }}</p>\r
      </a>\r
      <a\r
        routerLink="/members"\r
        [queryParams]="{ pay: 'partial' }"\r
        class="group relative block overflow-hidden rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-700 p-4 shadow-lg shadow-violet-700/25 outline-none ring-offset-2 transition hover:shadow-xl hover:shadow-violet-800/35 focus-visible:ring-2 focus-visible:ring-indigo-400 sm:p-5"\r
      >\r
        <span\r
          class="material-icons-outlined pointer-events-none absolute -right-1 top-2 text-5xl text-white/10 transition group-hover:text-white/15 select-none sm:text-6xl"\r
          aria-hidden="true"\r
          >account_balance_wallet</span\r
        >\r
        <p class="relative text-[10px] font-semibold uppercase tracking-wider text-white/90 sm:text-[11px] sm:text-white/85">\r
          {{ 'dashboard.partialPending' | t }}\r
        </p>\r
        <p class="relative mt-1.5 text-2xl font-extrabold tabular-nums text-white sm:mt-2 sm:text-3xl">{{ partialPendingList().length }}</p>\r
      </a>\r
      @if (joinIntakeDashboardVisible()) {\r
        <div\r
          class="group relative overflow-hidden rounded-2xl bg-gradient-to-br from-teal-600 to-emerald-900 p-4 shadow-lg shadow-emerald-900/30 sm:p-5"\r
          role="region"\r
          [attr.aria-label]="'dashboard.joinIntakeTitle' | t"\r
        >\r
          <span\r
            class="material-icons-outlined pointer-events-none absolute -right-1 top-2 text-5xl text-white/10 transition group-hover:text-white/15 select-none sm:text-6xl"\r
            aria-hidden="true"\r
            >qr_code_2</span\r
          >\r
          <p class="relative text-[10px] font-semibold uppercase tracking-wider text-white/90 sm:text-[11px] sm:text-white/85">\r
            {{ 'dashboard.joinIntakeTitle' | t }}\r
          </p>\r
          <p class="relative mt-1.5 text-2xl font-extrabold tabular-nums text-white sm:mt-2 sm:text-3xl">\r
            {{ joinIntakePendingCount() }}\r
          </p>\r
          <p class="relative mt-1 line-clamp-2 text-[11px] leading-snug text-white/85 sm:text-xs sm:text-white/75">\r
            {{ 'dashboard.joinIntakeSubtitle' | t }}\r
          </p>\r
          <ul class="relative mt-3 max-h-40 space-y-2 overflow-y-auto pr-0.5">\r
            @for (row of pendingJoinRequests(); track row.token) {\r
              <li>\r
                <button\r
                  type="button"\r
                  class="flex w-full flex-col rounded-xl bg-white/15 px-3 py-2 text-left text-white ring-1 ring-white/20 transition hover:bg-white/25 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80"\r
                  (click)="goMembersWithJoinToken(row.token)"\r
                >\r
                  <span class="text-sm font-semibold leading-tight">{{ row.submissionFirstName }} {{ row.submissionLastName }}</span>\r
                  <span class="text-[11px] text-white/85">{{ row.submissionMobile }}</span>\r
                </button>\r
              </li>\r
            }\r
          </ul>\r
        </div>\r
      }\r
      <a\r
        routerLink="/members"\r
        [queryParams]="{ onboarding: 'review' }"\r
        class="group relative block overflow-hidden rounded-2xl bg-gradient-to-br from-fuchsia-600 to-purple-900 p-4 shadow-lg shadow-purple-900/30 outline-none ring-offset-2 transition hover:shadow-xl hover:shadow-purple-950/40 focus-visible:ring-2 focus-visible:ring-fuchsia-400 sm:p-5"\r
      >\r
        <span\r
          class="material-icons-outlined pointer-events-none absolute -right-1 top-2 text-5xl text-white/10 transition group-hover:text-white/15 select-none sm:text-6xl"\r
          aria-hidden="true"\r
          >how_to_reg</span\r
        >\r
        <p class="relative text-[10px] font-semibold uppercase tracking-wider text-white/90 sm:text-[11px] sm:text-white/85">\r
          {{ 'dashboard.reviewPendingTitle' | t }}\r
        </p>\r
        <p class="relative mt-1.5 text-2xl font-extrabold tabular-nums text-white sm:mt-2 sm:text-3xl">{{ reviewPendingCount() }}</p>\r
        <p class="relative mt-1 line-clamp-2 text-[11px] leading-snug text-white/85 sm:text-xs sm:text-white/75">\r
          {{ 'dashboard.reviewPendingSubtitle' | t }}\r
        </p>\r
      </a>\r
    </div>\r
\r
    @if (whatsappEnabled()) {\r
      <section\r
        class="saas-card relative overflow-hidden p-4 sm:p-5"\r
        aria-label="WhatsApp integration"\r
      >\r
        <div class="absolute -right-6 -top-6 h-28 w-28 rounded-full bg-emerald-200/50 blur-2xl"></div>\r
        <div class="relative flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">\r
          <div class="flex min-w-0 items-start gap-3">\r
            <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-2xl bg-emerald-500 text-white shadow-md sm:h-12 sm:w-12">\r
              <span class="material-icons-outlined">chat</span>\r
            </span>\r
            <div class="min-w-0">\r
              <p class="text-base font-semibold text-slate-900">{{ 'dashboard.whatsappTitle' | t }}</p>\r
              <p class="mt-1 max-w-xl text-sm text-slate-600">{{ 'dashboard.whatsappBody' | t }}</p>\r
            </div>\r
          </div>\r
          <span class="inline-flex items-center gap-1 self-start rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800">\r
            <span class="material-icons-outlined text-sm">schedule</span>\r
            {{ 'dashboard.whatsappComingSoon' | t }}\r
          </span>\r
        </div>\r
      </section>\r
    }\r
\r
    <!-- \u2500\u2500 Quick Actions Toolbar (full control, drill-down to features) \u2500\u2500\u2500 -->\r
    <section class="saas-card -mt-2 px-3 py-2.5 sm:px-4">\r
      <div class="-mx-1 flex gap-2 overflow-x-auto px-1 sm:flex-wrap sm:overflow-visible" role="toolbar" aria-label="Quick actions">\r
        <a\r
          routerLink="/members"\r
          class="inline-flex shrink-0 items-center gap-1.5 rounded-xl bg-emerald-600 px-3.5 py-2 text-xs font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-emerald-700 hover:shadow"\r
        >\r
          <span class="material-icons-outlined text-base leading-none">person_add</span>\r
          <span>Add member</span>\r
        </a>\r
        @if (!isSupervisor()) {\r
          <a\r
            routerLink="/members"\r
            [queryParams]="{ pay: 'pending' }"\r
            class="inline-flex shrink-0 items-center gap-1.5 rounded-xl border border-emerald-200 bg-emerald-50 px-3.5 py-2 text-xs font-semibold text-emerald-800 transition hover:-translate-y-0.5 hover:border-emerald-300 hover:bg-emerald-100"\r
          >\r
            <span class="material-icons-outlined text-base leading-none">payments</span>\r
            <span>Record payment</span>\r
          </a>\r
        }\r
        <button\r
          type="button"\r
          [disabled]="overdueList().length === 0"\r
          class="inline-flex shrink-0 items-center gap-1.5 rounded-xl border border-rose-200 bg-rose-50 px-3.5 py-2 text-xs font-semibold text-rose-800 transition hover:-translate-y-0.5 hover:border-rose-300 hover:bg-rose-100 disabled:cursor-not-allowed disabled:border-slate-200 disabled:bg-slate-50 disabled:text-slate-400 disabled:hover:translate-y-0"\r
          (click)="remindAllOverdue()"\r
        >\r
          <span class="material-icons-outlined text-base leading-none">forward_to_inbox</span>\r
          <span>Send reminders <span class="ml-0.5 rounded-full bg-rose-200/80 px-1.5 text-[10px] font-bold">{{ overdueList().length }}</span></span>\r
        </button>\r
        <button\r
          type="button"\r
          class="inline-flex shrink-0 items-center gap-1.5 rounded-xl border border-indigo-200 bg-indigo-50 px-3.5 py-2 text-xs font-semibold text-indigo-800 transition hover:-translate-y-0.5 hover:border-indigo-300 hover:bg-indigo-100"\r
          (click)="openImportModal()"\r
        >\r
          <span class="material-icons-outlined text-base leading-none">file_upload</span>\r
          <span>Import members</span>\r
        </button>\r
        @if (isPg()) {\r
          <button\r
            type="button"\r
            class="inline-flex shrink-0 items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50"\r
            (click)="openSetupModal()"\r
          >\r
            <span class="material-icons-outlined text-base leading-none">grid_view</span>\r
            <span>Setup beds</span>\r
          </button>\r
          <button\r
            type="button"\r
            [disabled]="!hasPgLayout()"\r
            class="inline-flex shrink-0 items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50"\r
            (click)="openBedMap()"\r
          >\r
            <span class="material-icons-outlined text-base leading-none">bed</span>\r
            <span>Bed map</span>\r
          </button>\r
        }\r
        @if (!isSupervisor()) {\r
          <a\r
            routerLink="/payments"\r
            class="inline-flex shrink-0 items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50"\r
          >\r
            <span class="material-icons-outlined text-base leading-none">receipt_long</span>\r
            <span>All payments</span>\r
          </a>\r
        }\r
        <a\r
          routerLink="/analytics"\r
          class="inline-flex shrink-0 items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50"\r
        >\r
          <span class="material-icons-outlined text-base leading-none">insights</span>\r
          <span>Analytics</span>\r
        </a>\r
      </div>\r
    </section>\r
\r
    <!-- \u2500\u2500 Command Deck: Action Queue (left) + Visual stack (right) \u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\r
    <div class="grid min-w-0 gap-4 lg:grid-cols-3 [&>*]:min-w-0">\r
      <!-- \u25C0 LEFT: Tabbed Action Queue (col-span-2 on lg+) -->\r
      <section id="action-queue" class="saas-card flex min-w-0 flex-col p-0 lg:col-span-2">\r
        <header class="flex flex-col gap-3 border-b border-slate-100 px-4 pb-3 pt-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4 sm:px-5 dark:border-slate-700">\r
          <div class="min-w-0">\r
            <h2 class="flex items-center gap-2 text-base font-semibold text-slate-900 sm:text-lg">\r
              <span class="material-icons-outlined text-emerald-600">speed</span>\r
              Action Queue\r
            </h2>\r
            <p class="mt-0.5 text-xs text-slate-500">Today's most pressing members. Click any row to view, or use the inline actions.</p>\r
          </div>\r
        </header>\r
\r
        <!-- Tabs (mobile: horizontal scroll) -->\r
        <div role="tablist" aria-label="Action queue tabs" class="flex gap-1 overflow-x-auto border-b border-slate-100 px-2 pt-2 sm:px-3 dark:border-slate-700">\r
          @for (t of [\r
            { id: 'overdue', label: 'Overdue', icon: 'warning', tone: 'red', count: actionQueueCounts().overdue },\r
            { id: 'dueToday', label: 'Due today', icon: 'today', tone: 'amber', count: actionQueueCounts().dueToday },\r
            { id: 'dueSoon', label: 'Due soon', icon: 'event', tone: 'sky', count: actionQueueCounts().dueSoon },\r
            { id: 'partial', label: 'Partial', icon: 'account_balance_wallet', tone: 'indigo', count: actionQueueCounts().partial }\r
          ]; track t.id) {\r
            <button\r
              type="button"\r
              role="tab"\r
              [attr.aria-selected]="activeActionTab() === t.id"\r
              (click)="setActionTab($any(t.id))"\r
              class="group inline-flex shrink-0 items-center gap-1.5 rounded-t-xl border-b-2 px-3 py-2 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-1"\r
              [ngClass]="{\r
                'border-red-500 text-red-700 dark:text-red-300': activeActionTab() === t.id && t.tone === 'red',\r
                'border-amber-500 text-amber-700 dark:text-amber-300': activeActionTab() === t.id && t.tone === 'amber',\r
                'border-sky-500 text-sky-700 dark:text-sky-300': activeActionTab() === t.id && t.tone === 'sky',\r
                'border-indigo-500 text-indigo-700 dark:text-indigo-300': activeActionTab() === t.id && t.tone === 'indigo',\r
                'border-transparent text-slate-500 hover:text-slate-800 dark:hover:text-slate-200': activeActionTab() !== t.id\r
              }"\r
            >\r
              <span class="material-icons-outlined text-base leading-none">{{ t.icon }}</span>\r
              <span class="whitespace-nowrap">{{ t.label }}</span>\r
              <span\r
                class="ml-0.5 inline-flex h-5 min-w-[20px] items-center justify-center rounded-full px-1.5 text-[11px] font-bold tabular-nums"\r
                [ngClass]="{\r
                  'bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-200': t.tone === 'red' && t.count > 0,\r
                  'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200': t.tone === 'amber' && t.count > 0,\r
                  'bg-sky-100 text-sky-800 dark:bg-sky-900/40 dark:text-sky-200': t.tone === 'sky' && t.count > 0,\r
                  'bg-indigo-100 text-indigo-800 dark:bg-indigo-900/40 dark:text-indigo-200': t.tone === 'indigo' && t.count > 0,\r
                  'bg-slate-100 text-slate-500 dark:bg-slate-700 dark:text-slate-400': t.count === 0\r
                }"\r
              >{{ t.count }}</span>\r
            </button>\r
          }\r
        </div>\r
\r
        <!-- Queue rows -->\r
        <div class="flex-1 px-2 pb-3 pt-1 sm:px-3">\r
          @if (actionQueueAll().length === 0) {\r
            <div class="flex flex-col items-center justify-center gap-2 px-4 py-12 text-center">\r
              <div class="flex h-14 w-14 items-center justify-center rounded-full bg-emerald-50 text-emerald-600 dark:bg-emerald-900/40 dark:text-emerald-300">\r
                <span class="material-icons-outlined text-3xl">check_circle</span>\r
              </div>\r
              <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">All clear in this lane</p>\r
              <p class="max-w-xs text-xs text-slate-500">Nothing needs your attention here right now. Switch tabs to see other lanes.</p>\r
            </div>\r
          } @else {\r
            <ul class="divide-y divide-slate-100 dark:divide-slate-700">\r
              @for (row of actionQueuePaged(); track trackByMemberId($index, row)) {\r
                <li>\r
                  <div\r
                    class="group flex min-w-0 items-center gap-2 rounded-xl px-1.5 py-2.5 transition hover:bg-slate-50 sm:gap-3 sm:px-3 dark:hover:bg-slate-800/60"\r
                  >\r
                    <!-- Avatar -->\r
                    <button\r
                      type="button"\r
                      class="relative flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-xs font-bold tracking-wider sm:h-10 sm:w-10 sm:text-sm"\r
                      [ngClass]="{\r
                        'bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-200': row.tone === 'red',\r
                        'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200': row.tone === 'amber',\r
                        'bg-sky-100 text-sky-700 dark:bg-sky-900/40 dark:text-sky-200': row.tone === 'sky',\r
                        'bg-indigo-100 text-indigo-700 dark:bg-indigo-900/40 dark:text-indigo-200': row.tone === 'indigo'\r
                      }"\r
                      (click)="openMemberDetail(row.m)"\r
                      [attr.aria-label]="'Open ' + row.m.firstName + ' details'"\r
                    >\r
                      {{ memberInitials(row.m) }}\r
                      <span\r
                        class="absolute -right-0.5 -top-0.5 inline-block h-2.5 w-2.5 rounded-full ring-2 ring-white dark:ring-slate-900"\r
                        [ngClass]="{\r
                          'bg-red-500': row.tone === 'red',\r
                          'bg-amber-500': row.tone === 'amber',\r
                          'bg-sky-500': row.tone === 'sky',\r
                          'bg-indigo-500': row.tone === 'indigo'\r
                        }"\r
                      ></span>\r
                    </button>\r
\r
                    <!-- Identity + status -->\r
                    <button\r
                      type="button"\r
                      (click)="openMemberDetail(row.m)"\r
                      class="min-w-0 flex-1 text-left"\r
                    >\r
                      <div class="flex items-center gap-2">\r
                        <p class="truncate text-sm font-semibold text-slate-900 dark:text-slate-100">\r
                          {{ row.m.firstName }} {{ row.m.lastName }}\r
                        </p>\r
                      </div>\r
                      <div class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[11px] text-slate-500 sm:text-xs">\r
                        <span class="truncate">{{ row.m.mobile || 'No mobile' }}</span>\r
                        @if (isPg() && row.m.floorNumber && row.m.roomNumber) {\r
                          <span class="text-slate-300">\u2022</span>\r
                          <span class="truncate">{{ formatRoomNumber(+row.m.floorNumber, +row.m.roomNumber) }}@if (row.m.bedNumber) { \xB7 bed {{ row.m.bedNumber }} }</span>\r
                        }\r
                        @if (row.secondary) {\r
                          <span class="text-slate-300">\u2022</span>\r
                          <span class="truncate">{{ row.secondary }}</span>\r
                        }\r
                      </div>\r
                    </button>\r
\r
                    <!-- Status pill -->\r
                    <span\r
                      class="hidden shrink-0 rounded-full px-2.5 py-1 text-[11px] font-semibold sm:inline-flex"\r
                      [ngClass]="{\r
                        'bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-200': row.tone === 'red',\r
                        'bg-amber-100 text-amber-900 dark:bg-amber-900/40 dark:text-amber-200': row.tone === 'amber',\r
                        'bg-sky-100 text-sky-900 dark:bg-sky-900/40 dark:text-sky-200': row.tone === 'sky',\r
                        'bg-indigo-100 text-indigo-900 dark:bg-indigo-900/40 dark:text-indigo-200': row.tone === 'indigo'\r
                      }"\r
                    >{{ row.status }}</span>\r
\r
                    <!-- Inline actions -->\r
                    <div class="flex shrink-0 items-center gap-0.5 sm:gap-1">\r
                      @if (row.m.mobile) {\r
                        <button\r
                          type="button"\r
                          title="Call"\r
                          aria-label="Call member"\r
                          class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 transition hover:-translate-y-0.5 hover:border-emerald-300 hover:bg-emerald-50 hover:text-emerald-700 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-emerald-900/40"\r
                          (click)="callMember(row.m)"\r
                        >\r
                          <span class="material-icons-outlined text-base">call</span>\r
                        </button>\r
                        <button\r
                          type="button"\r
                          title="Send WhatsApp reminder"\r
                          aria-label="Send WhatsApp reminder"\r
                          class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 transition hover:-translate-y-0.5 hover:border-emerald-300 hover:bg-emerald-50 hover:text-emerald-700 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-emerald-900/40"\r
                          (click)="whatsappReminder(row.m)"\r
                        >\r
                          <span class="material-icons-outlined text-base">chat</span>\r
                        </button>\r
                      }\r
                      @if (!isSupervisor()) {\r
                        <a\r
                          routerLink="/members"\r
                          [queryParams]="{ pay: row.tag === 'partial' ? 'partial' : 'pending' }"\r
                          title="Record payment"\r
                          aria-label="Record payment"\r
                          class="hidden h-8 w-8 items-center justify-center rounded-lg border border-emerald-200 bg-emerald-50 text-emerald-700 transition hover:-translate-y-0.5 hover:bg-emerald-100 sm:inline-flex"\r
                        >\r
                          <span class="material-icons-outlined text-base">payments</span>\r
                        </a>\r
                      }\r
                      <button\r
                        type="button"\r
                        title="Open profile"\r
                        aria-label="Open profile"\r
                        class="hidden h-8 w-8 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 transition hover:-translate-y-0.5 hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-700 sm:inline-flex dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-indigo-900/40"\r
                        (click)="openMemberDetail(row.m)"\r
                      >\r
                        <span class="material-icons-outlined text-base">person</span>\r
                      </button>\r
                    </div>\r
                  </div>\r
                </li>\r
              }\r
            </ul>\r
\r
            @if (actionQueuePages() > 1) {\r
              <div class="mt-3 flex flex-wrap items-center justify-between gap-2 px-2 sm:px-3">\r
                <p class="text-xs text-slate-500">\r
                  Showing {{ actionQueuePaged().length }} of {{ actionQueueAll().length }}\r
                </p>\r
                <div class="flex flex-wrap items-center gap-1">\r
                  @for (pageNum of getActionQueuePageNumbers(); track pageNum) {\r
                    <button\r
                      type="button"\r
                      (click)="setActionQueuePage(pageNum)"\r
                      class="rounded-md px-2.5 py-1 text-xs font-medium transition-colors"\r
                      [ngClass]="actionQueuePage() === pageNum\r
                        ? 'bg-emerald-600 text-white shadow-sm'\r
                        : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-700 dark:text-slate-300 dark:hover:bg-slate-600'"\r
                    >\r
                      {{ pageNum }}\r
                    </button>\r
                  }\r
                </div>\r
              </div>\r
            }\r
          }\r
        </div>\r
      </section>\r
\r
      <!-- \u25B6 RIGHT: Visual stack \u2014 Sparkline + Donut + Bed heatmap -->\r
      <aside class="min-w-0 space-y-4">\r
        <!-- 1) Earnings Sparkline (last 30 days) -->\r
        @if (!isSupervisor()) {\r
          <button\r
            type="button"\r
            (click)="goToSparkline()"\r
            class="saas-card group block w-full overflow-hidden p-4 text-left transition hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300"\r
          >\r
            <div class="mb-2 flex items-start justify-between gap-2">\r
              <div>\r
                <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Last 30 days</p>\r
                <p class="mt-0.5 text-xl font-extrabold tabular-nums text-slate-900 dark:text-slate-100">\r
                  {{ formatCompactRupee(sparkline().totalSum) }}\r
                </p>\r
                <p class="text-[11px] text-slate-500">Today {{ formatCompactRupee(sparkline().todayTotal) }}</p>\r
              </div>\r
              <span\r
                class="material-icons-outlined text-emerald-600 opacity-70 transition group-hover:translate-x-0.5 group-hover:opacity-100"\r
                aria-hidden="true"\r
              >arrow_forward</span>\r
            </div>\r
            <svg\r
              [attr.viewBox]="'0 0 ' + sparkline().width + ' ' + sparkline().height"\r
              class="h-16 w-full"\r
              preserveAspectRatio="none"\r
              role="img"\r
              aria-label="Daily earnings trend, last 30 days"\r
            >\r
              <defs>\r
                <linearGradient id="spark-grad" x1="0" y1="0" x2="0" y2="1">\r
                  <stop offset="0%" stop-color="#10b981" stop-opacity="0.35" />\r
                  <stop offset="100%" stop-color="#10b981" stop-opacity="0" />\r
                </linearGradient>\r
              </defs>\r
              @if (sparkline().area) {\r
                <path [attr.d]="sparkline().area" fill="url(#spark-grad)" />\r
              }\r
              @if (sparkline().line) {\r
                <path [attr.d]="sparkline().line" fill="none" stroke="#059669" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />\r
              }\r
              @for (p of sparkline().points; track $index) {\r
                <circle [attr.cx]="p.x" [attr.cy]="p.y" r="1.4" fill="#10b981" opacity="0.55">\r
                  <title>{{ p.label }} \xB7 \u20B9{{ p.total | number: '1.0-0' }}</title>\r
                </circle>\r
              }\r
            </svg>\r
          </button>\r
        }\r
\r
        <!-- 2) Collection Health Donut (clickable segments) -->\r
        <section class="saas-card overflow-hidden p-4">\r
          <div class="mb-2 flex items-start justify-between">\r
            <div>\r
              <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Collection health</p>\r
              <p class="mt-0.5 text-sm text-slate-600">Active members by status \u2014 click any slice to drill in.</p>\r
            </div>\r
          </div>\r
          @if (collectionDonut().length === 0) {\r
            <p class="rounded-xl bg-slate-50 px-3 py-6 text-center text-xs text-slate-500 dark:bg-slate-800/60">No active members yet.</p>\r
          } @else {\r
            <div class="flex flex-col items-center gap-3 min-[380px]:flex-row min-[380px]:items-center">\r
              <div class="relative shrink-0">\r
                <svg viewBox="0 0 120 120" class="h-24 w-24 sm:h-28 sm:w-28" role="img" aria-label="Member status donut">\r
                  @for (seg of collectionDonut(); track trackByLabel($index, seg)) {\r
                    <path\r
                      [attr.d]="seg.d"\r
                      [attr.fill]="seg.color"\r
                      class="cursor-pointer transition-opacity hover:opacity-80"\r
                      (click)="goToDonutSegment(seg)"\r
                    >\r
                      <title>{{ seg.label }}: {{ seg.count }}</title>\r
                    </path>\r
                  }\r
                </svg>\r
                <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center">\r
                  <span class="text-2xl font-extrabold tabular-nums text-slate-900 dark:text-slate-100">{{ donutCenterValue() }}</span>\r
                  <span class="-mt-0.5 text-[10px] font-medium uppercase tracking-wider text-slate-500">Active</span>\r
                </div>\r
              </div>\r
              <ul class="w-full min-w-0 flex-1 space-y-1.5">\r
                @for (seg of collectionDonut(); track trackByLabel($index, seg)) {\r
                  <li>\r
                    <button\r
                      type="button"\r
                      (click)="goToDonutSegment(seg)"\r
                      class="group flex w-full items-center justify-between gap-2 rounded-lg px-2 py-1 text-left transition hover:bg-slate-50 dark:hover:bg-slate-800/60"\r
                    >\r
                      <span class="flex min-w-0 items-center gap-2">\r
                        <span class="h-2.5 w-2.5 shrink-0 rounded-full" [style.background]="seg.color"></span>\r
                        <span class="truncate text-xs font-medium text-slate-700 dark:text-slate-200">{{ seg.label }}</span>\r
                      </span>\r
                      <span class="flex shrink-0 items-center gap-1.5">\r
                        <span class="text-xs font-bold tabular-nums text-slate-900 dark:text-slate-100">{{ seg.count }}</span>\r
                        <span class="text-[10px] tabular-nums text-slate-400">{{ (seg.pct * 100) | number: '1.0-0' }}%</span>\r
                        <span class="material-icons-outlined text-[14px] text-slate-300 opacity-0 transition group-hover:opacity-100">arrow_forward</span>\r
                      </span>\r
                    </button>\r
                  </li>\r
                }\r
              </ul>\r
            </div>\r
          }\r
        </section>\r
\r
        <!-- 3) Mini Bed Occupancy Heatmap (PG only, click \u2192 bed map modal) -->\r
        @if (isPg() && hasPgLayout()) {\r
          <button\r
            type="button"\r
            (click)="openBedMap()"\r
            class="saas-card group block w-full overflow-hidden p-4 text-left transition hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300"\r
          >\r
            <div class="mb-2 flex items-start justify-between">\r
              <div>\r
                <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Bed occupancy</p>\r
                <p class="mt-0.5 text-sm">\r
                  <span class="font-bold tabular-nums text-slate-900 dark:text-slate-100">{{ totalBeds() - emptyBeds() }}</span>\r
                  <span class="text-slate-500">/ {{ totalBeds() }} occupied</span>\r
                </p>\r
              </div>\r
              <span class="material-icons-outlined text-emerald-600 opacity-70 transition group-hover:translate-x-0.5 group-hover:opacity-100">arrow_forward</span>\r
            </div>\r
            <div class="space-y-1.5">\r
              @for (floor of miniBedFloors(); track trackByFloorLabel($index, floor)) {\r
                <div class="flex items-center gap-2">\r
                  <span class="w-7 shrink-0 text-[10px] font-semibold uppercase tracking-wider text-slate-400">{{ floor.label }}</span>\r
                  <div class="flex flex-1 flex-wrap gap-1">\r
                    @for (room of floor.rooms; track trackByRoomNumber($index, room)) {\r
                      <span\r
                        class="inline-block h-3 w-5 rounded-sm transition group-hover:scale-105"\r
                        [ngClass]="{\r
                          'bg-emerald-200 dark:bg-emerald-700/60': bedCellTone(room.occ, room.beds) === 'free',\r
                          'bg-amber-300 dark:bg-amber-600/70': bedCellTone(room.occ, room.beds) === 'partial',\r
                          'bg-rose-400 dark:bg-rose-600/80': bedCellTone(room.occ, room.beds) === 'full',\r
                          'bg-slate-200 dark:bg-slate-700': bedCellTone(room.occ, room.beds) === 'empty'\r
                        }"\r
                      >\r
                        <span class="sr-only">Room {{ room.roomNumber }}: {{ room.occ }}/{{ room.beds }}</span>\r
                        <span class="block w-full text-[0]" [title]="'Room ' + room.roomNumber + ' \xB7 ' + room.occ + '/' + room.beds + ' occupied'"></span>\r
                      </span>\r
                    }\r
                  </div>\r
                </div>\r
              }\r
            </div>\r
            <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-[10px] font-medium text-slate-500">\r
              <span class="inline-flex items-center gap-1"><span class="h-2 w-2 rounded-sm bg-emerald-200 dark:bg-emerald-700/60"></span>Free</span>\r
              <span class="inline-flex items-center gap-1"><span class="h-2 w-2 rounded-sm bg-amber-300 dark:bg-amber-600/70"></span>Partial</span>\r
              <span class="inline-flex items-center gap-1"><span class="h-2 w-2 rounded-sm bg-rose-400 dark:bg-rose-600/80"></span>Full</span>\r
            </div>\r
          </button>\r
        }\r
      </aside>\r
    </div>\r
<section class="saas-card overflow-hidden p-5">\r
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">\r
        <div>\r
          <h2 class="text-lg font-semibold text-slate-900">{{ 'dashboard.recentJoiners' | t }}</h2>\r
          <p class="mt-1 text-sm text-slate-600">\r
            {{ 'dashboard.recentJoinersBlurb' | t }}\r
          </p>\r
          <p class="mt-1 text-xs font-medium text-indigo-600 dark:text-indigo-300">\r
            {{ 'dashboard.recentWindow' | t: { count: recentJoiners().length } }}\r
          </p>\r
        </div>\r
        <button\r
          type="button"\r
          class="saas-btn-secondary shrink-0 px-4 py-2.5 text-sm"\r
          (click)="toggleRecentJoinersExpanded()"\r
        >\r
          {{ recentJoinersExpanded() ? ('dashboard.hideList' | t) : ('dashboard.viewFullList' | t) }}\r
        </button>\r
      </div>\r
\r
      @if (recentJoiners().length === 0) {\r
        <p\r
          class="mt-4 rounded-xl border border-slate-200/80 bg-white/50 px-4 py-6 text-center text-sm text-slate-500 backdrop-blur-sm dark:border-slate-600/80 dark:bg-slate-900/60 dark:text-slate-300"\r
        >\r
          {{ 'dashboard.noJoinedTen' | t }}\r
        </p>\r
      } @else {\r
        <div class="mt-4 space-y-2 md:hidden">\r
          @for (m of recentJoiners().slice(0, recentJoinersExpanded() ? recentJoiners().length : 5); track m.memberId) {\r
            <button\r
              type="button"\r
              class="flex w-full items-center justify-between gap-3 rounded-xl border border-white/70 bg-white/55 px-4 py-3 text-left shadow-sm backdrop-blur-md transition-all hover:border-indigo-200 hover:bg-white/80 hover:shadow-md dark:border-slate-600/90 dark:bg-slate-900/70 dark:shadow-black/20 dark:hover:border-indigo-500/50 dark:hover:bg-slate-800/90 dark:hover:shadow-md"\r
              (click)="openMemberDetail(m)"\r
            >\r
              <div class="min-w-0">\r
                <p class="truncate font-semibold text-slate-900">{{ m.firstName }} {{ m.lastName }}</p>\r
                <p class="text-xs text-slate-500">{{ m.mobile || '\u2014' }}</p>\r
              </div>\r
              <div class="shrink-0 text-right text-xs text-slate-600">\r
                <p class="font-medium text-indigo-700 dark:text-indigo-300">{{ memberJoinDate(m) | date: 'mediumDate' }}</p>\r
                <p>{{ 'dashboard.joined' | t }}</p>\r
                @if (canSendReceipt(m)) {\r
                  <button\r
                    type="button"\r
                    class="mt-2 rounded-lg border border-blue-200 bg-blue-50 px-2.5 py-1 text-[11px] font-semibold text-blue-700"\r
                    (click)="sendReceipt(m); $event.stopPropagation()"\r
                  >\r
                    Send Receipt\r
                  </button>\r
                }\r
              </div>\r
            </button>\r
          }\r
        </div>\r
\r
        <div\r
          class="mt-4 hidden overflow-x-auto rounded-xl border border-white/60 bg-white/40 backdrop-blur-md md:block dark:border-slate-600/80 dark:bg-slate-900/55 dark:shadow-inner dark:shadow-black/20"\r
        >\r
          <table class="saas-table min-w-full text-left text-sm">\r
            <thead>\r
              <tr>\r
                <th class="px-4 py-3">{{ 'dashboard.name' | t }}</th>\r
                <th class="px-4 py-3">{{ 'dashboard.mobile' | t }}</th>\r
                <th class="px-4 py-3">{{ 'dashboard.joinDate' | t }}</th>\r
                <th class="px-4 py-3">{{ isGym() ? ('dashboard.plan' | t) : ('dashboard.amountCol' | t) }}</th>\r
                <th class="px-4 py-3">{{ 'dashboard.status' | t }}</th>\r
                <th class="px-4 py-3 text-center">Send Receipt</th>\r
              </tr>\r
            </thead>\r
            <tbody class="divide-y divide-slate-100 dark:divide-slate-700">\r
              @for (m of recentJoiners().slice(0, recentJoinersExpanded() ? recentJoiners().length : 8); track m.memberId) {\r
                <tr\r
                  class="cursor-pointer transition-colors hover:bg-indigo-50/70 dark:hover:bg-indigo-950/35"\r
                  (click)="openMemberDetail(m)"\r
                  (keydown.enter)="openMemberDetail(m)"\r
                  tabindex="0"\r
                  role="button"\r
                >\r
                  <td class="px-4 py-3 font-medium text-slate-900">{{ m.firstName }} {{ m.lastName }}</td>\r
                  <td class="px-4 py-3 text-slate-600">{{ m.mobile || '\u2014' }}</td>\r
                  <td class="px-4 py-3 text-slate-700">{{ memberJoinDate(m) | date: 'mediumDate' }}</td>\r
                  <td class="px-4 py-3 text-slate-700">\r
                    @if (isGym()) {\r
                      <span class="capitalize">{{ m.subscriptionType || 'monthly' }}</span>\r
                    } @else {\r
                      \u20B9{{ m.amount | number: '1.0-0' }}\r
                    }\r
                  </td>\r
                  <td class="px-4 py-3">\r
                    <span\r
                      class="rounded-full px-2.5 py-1 text-xs font-semibold uppercase tracking-wide"\r
                      [ngClass]="\r
                        m.status === 'active'\r
                          ? 'bg-emerald-100 text-emerald-800 dark:border dark:border-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-200'\r
                          : 'bg-slate-200 text-slate-800 dark:border dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200'\r
                      "\r
                      >{{ m.status }}</span\r
                    >\r
                  </td>\r
                  <td class="px-4 py-3 text-center" (click)="$event.stopPropagation()">\r
                    @if (canSendReceipt(m)) {\r
                      <button\r
                        type="button"\r
                        title="Send Receipt"\r
                        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-blue-200 bg-blue-50 text-blue-700 transition-all hover:-translate-y-0.5 hover:shadow-md"\r
                        (click)="sendReceipt(m)"\r
                      >\r
                        <span class="material-icons-outlined text-base">receipt</span>\r
                      </button>\r
                    } @else {\r
                      <span class="text-xs text-slate-400">\u2014</span>\r
                    }\r
                  </td>\r
                </tr>\r
              }\r
            </tbody>\r
          </table>\r
        </div>\r
      }\r
    </section>\r
\r
    <!-- Complaint QR section disabled \u2014 restore when feature fixed\r
    <section class="saas-card p-5">\r
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">\r
        <div>\r
          <h2 class="text-lg font-semibold text-slate-900">Complaint QR</h2>\r
          <p class="text-sm text-slate-600">Members can scan and submit complaint from mobile.</p>\r
        </div>\r
        <span class="rounded-full px-2 py-1 text-xs font-semibold" [class.bg-emerald-100]="complaintEnabled()" [class.text-emerald-800]="complaintEnabled()" [class.bg-slate-100]="!complaintEnabled()" [class.text-slate-600]="!complaintEnabled()">\r
          {{ complaintEnabled() ? 'Enabled' : 'Disabled' }}\r
        </span>\r
      </div>\r
      @if (complaintUrl()) {\r
        <div class="mt-4 flex flex-col items-center gap-3 sm:flex-row sm:items-start sm:gap-6">\r
          <img [src]="complaintQrUrl()" alt="Complaint QR" class="h-44 w-44 rounded-xl border border-slate-200 bg-white p-2" />\r
          <div class="w-full min-w-0">\r
            <p class="text-xs font-medium text-slate-500">Complaint Link</p>\r
            <a [href]="complaintUrl()" target="_blank" rel="noopener noreferrer" class="mt-1 block break-all text-sm font-semibold text-indigo-700 underline">\r
              {{ complaintUrl() }}\r
            </a>\r
          </div>\r
        </div>\r
      }\r
    </section>\r
    -->\r
   \r
  }\r
</div>\r
\r
<!-- Advance collection by month (owners only) -->\r
@if (!isSupervisor() && advanceCollectionModalOpen()) {\r
  <app-modal\r
    [open]="true"\r
    [title]="advanceCollectionMonthKey() ? advanceMonthLabel(advanceCollectionMonthKey()!) : ('dashboard.advanceModalTitle' | t)"\r
    [wide]="true"\r
    (closed)="closeAdvanceCollectionModal()"\r
  >\r
    <div class="space-y-4">\r
      @if (!advanceCollectionMonthKey()) {\r
        @if (advanceCollectionByMonth().length === 0) {\r
          <p class="text-sm text-slate-500 dark:text-slate-400">{{ 'dashboard.advanceMonthsEmpty' | t }}</p>\r
        } @else {\r
          <ul class="max-h-[55vh] divide-y divide-slate-100 overflow-y-auto rounded-xl border border-slate-200 dark:divide-slate-700 dark:border-slate-600">\r
            @for (row of advanceCollectionByMonth(); track row.key) {\r
              <li>\r
                <button\r
                  type="button"\r
                  class="flex w-full items-center justify-between gap-3 px-3 py-3 text-left transition hover:bg-slate-50 dark:hover:bg-slate-800/80"\r
                  (click)="advanceCollectionMonthKey.set(row.key)"\r
                >\r
                  <span class="min-w-0 font-semibold text-slate-800 dark:text-slate-100">{{ advanceMonthLabel(row.key) }}</span>\r
                  <span class="shrink-0 text-right">\r
                    <span class="block text-sm font-bold tabular-nums text-cyan-700 dark:text-cyan-300">\u20B9{{ row.total | number: '1.0-0' }}</span>\r
                    <span class="block text-[10px] text-slate-500 dark:text-slate-400">{{ row.count }} {{ row.count === 1 ? 'member' : 'members' }}</span>\r
                  </span>\r
                </button>\r
              </li>\r
            }\r
          </ul>\r
        }\r
      } @else {\r
        <button\r
          type="button"\r
          class="inline-flex items-center gap-1 rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"\r
          (click)="advanceCollectionMonthKey.set(null)"\r
        >\r
          <span class="material-icons-outlined text-base">arrow_back</span>\r
          {{ 'dashboard.advanceBackToMonths' | t }}\r
        </button>\r
        <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-600">\r
          <table class="min-w-full text-left text-sm">\r
            <thead class="border-b border-slate-200 bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400">\r
              <tr>\r
                <th class="px-3 py-2">{{ 'dashboard.advanceColMember' | t }}</th>\r
                <th class="px-3 py-2">{{ 'dashboard.advanceColAmount' | t }}</th>\r
                <th class="px-3 py-2">{{ 'dashboard.advanceColDate' | t }}</th>\r
                <th class="px-3 py-2">{{ 'dashboard.advanceColStatus' | t }}</th>\r
              </tr>\r
            </thead>\r
            <tbody class="divide-y divide-slate-100 dark:divide-slate-700">\r
              @for (r of advanceRowsForSelectedMonth(); track r.memberId) {\r
                <tr class="bg-white dark:bg-slate-900">\r
                  <td class="px-3 py-2.5">\r
                    <span class="font-medium text-slate-900 dark:text-slate-100">{{ r.memberName }}</span>\r
                    @if (r.mobile) {\r
                      <span class="mt-0.5 block text-xs text-slate-500 dark:text-slate-400">{{ r.mobile }}</span>\r
                    }\r
                  </td>\r
                  <td class="px-3 py-2.5 font-semibold tabular-nums text-slate-800 dark:text-slate-200">\u20B9{{ r.amount | number: '1.0-0' }}</td>\r
                  <td class="px-3 py-2.5 text-slate-600 dark:text-slate-300">{{ r.attributedDate | date: 'mediumDate' }}</td>\r
                  <td class="px-3 py-2.5">\r
                    <span\r
                      class="rounded-full px-2 py-0.5 text-xs font-semibold"\r
                      [class.bg-emerald-100]="r.held"\r
                      [class.text-emerald-800]="r.held"\r
                      [class.dark:bg-emerald-900]="r.held"\r
                      [class.dark:text-emerald-200]="r.held"\r
                      [class.bg-slate-100]="!r.held"\r
                      [class.text-slate-600]="!r.held"\r
                      [class.dark:bg-slate-800]="!r.held"\r
                      [class.dark:text-slate-300]="!r.held"\r
                    >\r
                      {{ r.held ? ('dashboard.advanceStatusHeld' | t) : ('dashboard.advanceStatusReturned' | t) }}\r
                    </span>\r
                  </td>\r
                </tr>\r
              }\r
            </tbody>\r
          </table>\r
        </div>\r
      }\r
    </div>\r
  </app-modal>\r
}\r
\r
<!-- Today's collection detail (owner only) -->\r
@if (!isSupervisor()) {\r
  <app-modal\r
    [open]="todayCollectionDetailModalOpen()"\r
    [title]="'dashboard.todayCollectionDetailTitle' | t"\r
    [wide]="true"\r
    (closed)="closeTodayCollectionDetail()"\r
  >\r
    <div class="space-y-4">\r
      <div class="rounded-2xl border border-violet-100 bg-gradient-to-br from-violet-50 to-indigo-50 p-4 dark:border-violet-900/40 dark:from-violet-950/40 dark:to-indigo-950/40">\r
        <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">\r
          {{ 'dashboard.todayCollection' | t }}\r
        </p>\r
        <p class="mt-1 text-xl font-extrabold tabular-nums text-violet-700 dark:text-violet-300 sm:text-2xl">\r
          \u20B9{{ todayCollection() | number: '1.0-0' }}\r
        </p>\r
        <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">\r
          {{ todayCollectionCount() }} {{ todayCollectionCount() === 1 ? 'payment' : 'payments' }}\r
        </p>\r
      </div>\r
\r
      @if (todayCollectionDetailRows().length === 0) {\r
        <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 p-10 text-center dark:border-slate-700 dark:bg-slate-900/40">\r
          <span class="material-icons-outlined text-5xl text-slate-300 dark:text-slate-600">payments</span>\r
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">{{ 'dashboard.todayCollectionDetailEmpty' | t }}</p>\r
        </div>\r
      } @else {\r
        <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">\r
          <div class="hidden overflow-x-auto md:block">\r
            <table class="min-w-full text-left text-sm">\r
              <thead class="bg-slate-50/60 text-[11px] uppercase tracking-wide text-slate-500 dark:bg-slate-800/40 dark:text-slate-400">\r
                <tr>\r
                  <th class="px-4 py-2.5 font-semibold">Time</th>\r
                  <th class="px-4 py-2.5 font-semibold">Member</th>\r
                  <th class="px-4 py-2.5 font-semibold">Type</th>\r
                  <th class="px-4 py-2.5 font-semibold">Method</th>\r
                  <th class="px-4 py-2.5 font-semibold">Recorded by</th>\r
                  <th class="px-4 py-2.5 text-right font-semibold">Amount</th>\r
                </tr>\r
              </thead>\r
              <tbody>\r
                @for (row of todayCollectionDetailRows(); track trackTodayCollectionRow($index, row)) {\r
                  <tr class="border-t border-slate-100 align-top dark:border-slate-800">\r
                    <td class="whitespace-nowrap px-4 py-3 text-[12.5px] text-slate-600 dark:text-slate-300">\r
                      {{ row.timeLabel }}\r
                    </td>\r
                    <td class="px-4 py-3">\r
                      <p class="truncate text-sm font-semibold text-slate-900 dark:text-slate-100">{{ row.memberName }}</p>\r
                    </td>\r
                    <td class="px-4 py-3">\r
                      <span\r
                        class="inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold ring-1 {{ collectionKindClasses(row.kind) }}"\r
                      >\r
                        {{ row.kindLabel }}\r
                      </span>\r
                      @if (row.pendingAfter > 0) {\r
                        <p class="mt-1 text-[11px] text-amber-700 dark:text-amber-300">\r
                          Pending after: \u20B9{{ row.pendingAfter | number: '1.0-0' }}\r
                        </p>\r
                      }\r
                    </td>\r
                    <td class="px-4 py-3">\r
                      <span\r
                        class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-[11px] font-semibold ring-1 {{ methodChipClasses(row.method) }}"\r
                      >\r
                        <span class="material-icons-outlined text-[12px] leading-none">{{ methodIcon(row.method) }}</span>\r
                        {{ row.methodLabel }}\r
                      </span>\r
                    </td>\r
                    <td class="px-4 py-3 text-sm text-slate-800 dark:text-slate-200">{{ row.collectorLabel }}</td>\r
                    <td class="whitespace-nowrap px-4 py-3 text-right text-sm font-bold tabular-nums text-emerald-700 dark:text-emerald-300">\r
                      \u20B9{{ row.amount | number: '1.0-0' }}\r
                    </td>\r
                  </tr>\r
                }\r
              </tbody>\r
            </table>\r
          </div>\r
          <ul class="divide-y divide-slate-100 md:hidden dark:divide-slate-800">\r
            @for (row of todayCollectionDetailRows(); track trackTodayCollectionRow($index, row)) {\r
              <li class="space-y-2 px-4 py-3">\r
                <div class="flex items-start justify-between gap-2">\r
                  <div class="min-w-0">\r
                    <p class="truncate text-sm font-semibold text-slate-900 dark:text-slate-100">{{ row.memberName }}</p>\r
                    <p class="text-[11px] text-slate-500 dark:text-slate-400">\r
                      {{ row.timeLabel }} \xB7 {{ row.collectorLabel }}\r
                    </p>\r
                  </div>\r
                  <p class="shrink-0 text-base font-bold tabular-nums text-emerald-700 dark:text-emerald-300">\r
                    \u20B9{{ row.amount | number: '1.0-0' }}\r
                  </p>\r
                </div>\r
                <div class="flex flex-wrap items-center gap-1.5">\r
                  <span\r
                    class="inline-flex items-center rounded-full px-2.5 py-1 text-[10px] font-semibold ring-1 {{ collectionKindClasses(row.kind) }}"\r
                  >\r
                    {{ row.kindLabel }}\r
                  </span>\r
                  <span\r
                    class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-[10px] font-semibold ring-1 {{ methodChipClasses(row.method) }}"\r
                  >\r
                    <span class="material-icons-outlined text-[12px] leading-none">{{ methodIcon(row.method) }}</span>\r
                    {{ row.methodLabel }}\r
                  </span>\r
                  @if (row.pendingAfter > 0) {\r
                    <span\r
                      class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-1 text-[10px] font-semibold text-amber-700 ring-1 ring-amber-100 dark:bg-amber-950/40 dark:text-amber-300 dark:ring-amber-900/50"\r
                    >\r
                      Pending \u20B9{{ row.pendingAfter | number: '1.0-0' }}\r
                    </span>\r
                  }\r
                </div>\r
              </li>\r
            }\r
          </ul>\r
        </section>\r
      }\r
    </div>\r
  </app-modal>\r
}\r
\r
<!-- Monthly Earnings Details Modal (hidden for supervisors) -->\r
@if (!isSupervisor() && showMonthlyEarningsModal()) {\r
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 backdrop-blur-sm" (click)="showMonthlyEarningsModal.set(false)">\r
    <div class="max-h-[90vh] w-full max-w-5xl overflow-y-auto rounded-2xl border border-white/60 bg-white/95 shadow-2xl backdrop-blur-xl" (click)="$event.stopPropagation()">\r
      <div class="p-6">\r
        <app-monthly-earnings-detailed \r
          [paymentsInput]="payments()" \r
          [membersInput]="members()"\r
          (closed)="showMonthlyEarningsModal.set(false)"\r
        ></app-monthly-earnings-detailed>\r
      </div>\r
    </div>\r
  </div>\r
}\r
\r
<!-- Go to Top Button -->\r
@if (showScrollTopButton()) {\r
  <button\r
    type="button"\r
    (click)="scrollToTop()"\r
    class="fixed saas-btn-primary bottom-6 right-6 z-40 flex h-12 w-12 items-center justify-center rounded-full bg-emerald-600 text-white shadow-lg transition-all duration-200 hover:bg-emerald-700 hover:shadow-xl active:scale-95"\r
    [attr.aria-label]="'Go to top'"\r
    [attr.title]="'Go to top'"\r
  >\r
    <span class="material-icons-outlined">arrow_upward</span>\r
  </button>\r
}\r
\r
<!-- Supervisor collections detail modal -->\r
<app-modal\r
  [open]="supervisorCollectionsModalOpen()"\r
  title="Supervisor Collections"\r
  [wide]="true"\r
  (closed)="closeSupervisorCollections()"\r
>\r
  <div class="space-y-5">\r
    <!-- Top summary strip -->\r
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">\r
      <div class="rounded-2xl border border-rose-100 bg-gradient-to-br from-rose-50 to-fuchsia-50 p-4 dark:border-rose-900/40 dark:from-rose-950/40 dark:to-fuchsia-950/40">\r
        <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Today's collection</p>\r
        <p class="mt-1 text-xl font-extrabold tabular-nums text-rose-700 dark:text-rose-300 sm:text-2xl">\r
          \u20B9{{ supervisorTodayTotal() | number: '1.0-0' }}\r
        </p>\r
        <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">\r
          {{ supervisorTodayCount() }} {{ supervisorTodayCount() === 1 ? 'payment' : 'payments' }}\r
        </p>\r
      </div>\r
      <div class="rounded-2xl border border-emerald-100 bg-gradient-to-br from-emerald-50 to-teal-50 p-4 dark:border-emerald-900/40 dark:from-emerald-950/40 dark:to-teal-950/40">\r
        <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">All-time collection</p>\r
        <p class="mt-1 text-xl font-extrabold tabular-nums text-emerald-700 dark:text-emerald-300 sm:text-2xl">\r
          \u20B9{{ supervisorAllTimeTotal() | number: '1.0-0' }}\r
        </p>\r
        <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">\r
          By {{ supervisors().length }} {{ supervisors().length === 1 ? 'supervisor' : 'supervisors' }}\r
        </p>\r
      </div>\r
      <div class="col-span-2 rounded-2xl border border-slate-200 bg-white p-4 sm:col-span-1 dark:border-slate-700 dark:bg-slate-900">\r
        <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Today by supervisor</p>\r
        @if (supervisorTodayBreakdown().length === 0) {\r
          <p class="mt-1.5 text-xs text-slate-400 dark:text-slate-500">No collections today.</p>\r
        } @else {\r
          <ul class="mt-1.5 space-y-1.5">\r
            @for (s of supervisorTodayBreakdown(); track s.id) {\r
              <li class="flex items-center justify-between gap-2 text-xs">\r
                <span class="truncate text-slate-700 dark:text-slate-200">{{ s.name }}</span>\r
                <span class="shrink-0 font-bold tabular-nums text-emerald-700 dark:text-emerald-300">\r
                  \u20B9{{ s.total | number: '1.0-0' }}\r
                </span>\r
              </li>\r
            }\r
          </ul>\r
        }\r
      </div>\r
    </div>\r
\r
    <!-- Day-wise log -->\r
    @if (supervisorCollectionGroups().length === 0) {\r
      <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 p-10 text-center dark:border-slate-700 dark:bg-slate-900/40">\r
        <span class="material-icons-outlined text-5xl text-slate-300 dark:text-slate-600">receipt_long</span>\r
        <h3 class="mt-3 text-base font-semibold text-slate-900 dark:text-slate-100">No supervisor collections yet</h3>\r
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">\r
          Once your supervisors record payments, every transaction will appear here grouped by day.\r
        </p>\r
      </div>\r
    } @else {\r
      <div class="space-y-4">\r
        @for (group of supervisorCollectionGroups(); track trackSupervisorDay($index, group)) {\r
          <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">\r
            <header class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 bg-slate-50/80 px-4 py-2.5 dark:border-slate-800 dark:bg-slate-800/40">\r
              <div class="flex items-center gap-2">\r
                <span class="material-icons-outlined text-base text-slate-500 dark:text-slate-400">today</span>\r
                <p class="text-sm font-bold text-slate-900 dark:text-slate-100">{{ group.label }}</p>\r
                <span class="rounded-full bg-slate-200/80 px-2 py-0.5 text-[10px] font-semibold uppercase text-slate-700 dark:bg-slate-700 dark:text-slate-200">\r
                  {{ group.count }} {{ group.count === 1 ? 'event' : 'events' }}\r
                </span>\r
              </div>\r
              <p class="text-sm font-extrabold tabular-nums text-emerald-700 dark:text-emerald-300">\r
                \u20B9{{ group.total | number: '1.0-0' }}\r
              </p>\r
            </header>\r
\r
            <!-- Desktop table -->\r
            <div class="hidden overflow-x-auto md:block">\r
              <table class="min-w-full text-left text-sm">\r
                <thead class="bg-slate-50/60 text-[11px] uppercase tracking-wide text-slate-500 dark:bg-slate-800/40 dark:text-slate-400">\r
                  <tr>\r
                    <th class="px-4 py-2.5 font-semibold">Time</th>\r
                    <th class="px-4 py-2.5 font-semibold">Supervisor</th>\r
                    <th class="px-4 py-2.5 font-semibold">Member</th>\r
                    <th class="px-4 py-2.5 font-semibold">Type</th>\r
                    <th class="px-4 py-2.5 font-semibold">Method</th>\r
                    <th class="px-4 py-2.5 text-right font-semibold">Amount</th>\r
                  </tr>\r
                </thead>\r
                <tbody>\r
                  @for (row of group.rows; track trackSupervisorRow($index, row)) {\r
                    <tr class="border-t border-slate-100 align-top dark:border-slate-800">\r
                      <td class="whitespace-nowrap px-4 py-3 text-[12.5px] text-slate-600 dark:text-slate-300">\r
                        {{ row.timeLabel }}\r
                      </td>\r
                      <td class="px-4 py-3">\r
                        <div class="flex items-center gap-2">\r
                          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-[11px] font-bold text-white">\r
                            {{ (row.supervisorName.charAt(0) || '?').toUpperCase() }}\r
                          </span>\r
                          <span class="truncate text-sm font-semibold text-slate-900 dark:text-slate-100">{{ row.supervisorName }}</span>\r
                        </div>\r
                      </td>\r
                      <td class="px-4 py-3">\r
                        <p class="truncate text-sm font-semibold text-slate-900 dark:text-slate-100">{{ row.memberName }}</p>\r
                      </td>\r
                      <td class="px-4 py-3">\r
                        <span class="inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold ring-1 {{ collectionKindClasses(row.kind) }}">\r
                          {{ row.kindLabel }}\r
                        </span>\r
                        @if (row.pendingAfter > 0) {\r
                          <p class="mt-1 text-[11px] text-amber-700 dark:text-amber-300">\r
                            Pending after: \u20B9{{ row.pendingAfter | number: '1.0-0' }}\r
                          </p>\r
                        }\r
                      </td>\r
                      <td class="px-4 py-3">\r
                        <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-[11px] font-semibold ring-1 {{ methodChipClasses(row.method) }}">\r
                          <span class="material-icons-outlined text-[12px] leading-none">{{ methodIcon(row.method) }}</span>\r
                          {{ row.methodLabel }}\r
                        </span>\r
                      </td>\r
                      <td class="whitespace-nowrap px-4 py-3 text-right text-sm font-bold tabular-nums text-emerald-700 dark:text-emerald-300">\r
                        \u20B9{{ row.amount | number: '1.0-0' }}\r
                      </td>\r
                    </tr>\r
                  }\r
                </tbody>\r
              </table>\r
            </div>\r
\r
            <!-- Mobile cards -->\r
            <ul class="divide-y divide-slate-100 md:hidden dark:divide-slate-800">\r
              @for (row of group.rows; track trackSupervisorRow($index, row)) {\r
                <li class="space-y-2 px-4 py-3">\r
                  <div class="flex items-start justify-between gap-2">\r
                    <div class="min-w-0">\r
                      <p class="truncate text-sm font-semibold text-slate-900 dark:text-slate-100">{{ row.memberName }}</p>\r
                      <p class="text-[11px] text-slate-500 dark:text-slate-400">{{ row.timeLabel }} &middot; by {{ row.supervisorName }}</p>\r
                    </div>\r
                    <p class="shrink-0 text-base font-bold tabular-nums text-emerald-700 dark:text-emerald-300">\r
                      \u20B9{{ row.amount | number: '1.0-0' }}\r
                    </p>\r
                  </div>\r
                  <div class="flex flex-wrap items-center gap-1.5">\r
                    <span class="inline-flex items-center rounded-full px-2.5 py-1 text-[10px] font-semibold ring-1 {{ collectionKindClasses(row.kind) }}">\r
                      {{ row.kindLabel }}\r
                    </span>\r
                    <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-[10px] font-semibold ring-1 {{ methodChipClasses(row.method) }}">\r
                      <span class="material-icons-outlined text-[12px] leading-none">{{ methodIcon(row.method) }}</span>\r
                      {{ row.methodLabel }}\r
                    </span>\r
                    @if (row.pendingAfter > 0) {\r
                      <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-1 text-[10px] font-semibold text-amber-700 ring-1 ring-amber-100 dark:bg-amber-950/40 dark:text-amber-300 dark:ring-amber-900/50">\r
                        Pending \u20B9{{ row.pendingAfter | number: '1.0-0' }}\r
                      </span>\r
                    }\r
                  </div>\r
                </li>\r
              }\r
            </ul>\r
          </section>\r
        }\r
      </div>\r
    }\r
  </div>\r
</app-modal>\r
\r
<app-modal\r
  [open]="memberDetailTarget() !== null"\r
  [title]="memberDetailTitle()"\r
  [wide]="true"\r
  (closed)="closeMemberDetail()"\r
>\r
  @if (memberDetailTarget(); as m) {\r
    <div class="space-y-4">\r
      <div class="rounded-2xl border border-white/70 bg-gradient-to-br from-white/70 to-indigo-50/40 p-4 shadow-inner backdrop-blur-md sm:p-5">\r
        <p class="text-xs font-semibold uppercase tracking-wide text-indigo-600">Profile</p>\r
        <div class="mt-3 grid gap-3 sm:grid-cols-2">\r
          <div class="rounded-xl border border-white/60 bg-white/50 px-3 py-2 backdrop-blur-sm">\r
            <p class="text-xs text-slate-500">Join date</p>\r
            <p class="text-sm font-semibold text-slate-900">{{ memberJoinDate(m) | date: 'fullDate' }}</p>\r
          </div>\r
          <div class="rounded-xl border border-white/60 bg-white/50 px-3 py-2 backdrop-blur-sm">\r
            <p class="text-xs text-slate-500">Record created</p>\r
            <p class="text-sm font-semibold text-slate-900">\r
              @if (memberCreatedAt(m); as ca) {\r
                {{ ca | date: 'medium' }}\r
              } @else {\r
                \u2014\r
              }\r
            </p>\r
          </div>\r
          <div class="rounded-xl border border-white/60 bg-white/50 px-3 py-2 backdrop-blur-sm">\r
            <p class="text-xs text-slate-500">{{ dueLabel() }}</p>\r
            <p class="text-sm font-semibold text-slate-900">\r
              @if (memberDueDate(m); as due) {\r
                {{ due | date: 'mediumDate' }}\r
              } @else {\r
                \u2014\r
              }\r
            </p>\r
          </div>\r
          <div class="rounded-xl border border-white/60 bg-white/50 px-3 py-2 backdrop-blur-sm">\r
            <p class="text-xs text-slate-500">Status</p>\r
            <p class="text-sm font-semibold capitalize text-slate-900">{{ m.status }}</p>\r
          </div>\r
        </div>\r
      </div>\r
\r
      <div class="rounded-2xl border border-white/70 bg-white/45 p-4 backdrop-blur-md sm:p-5">\r
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Contact & billing</p>\r
        <div class="mt-3 grid gap-3 sm:grid-cols-2">\r
          <div class="rounded-xl border border-slate-200/60 bg-white/60 px-3 py-2">\r
            <p class="text-xs text-slate-500">Mobile</p>\r
            <p class="text-sm font-medium text-slate-900">{{ m.mobile || '\u2014' }}</p>\r
          </div>\r
          <div class="rounded-xl border border-slate-200/60 bg-white/60 px-3 py-2">\r
            <p class="text-xs text-slate-500">Amount (\u20B9)</p>\r
            <p class="text-sm font-medium text-slate-900">{{ m.amount | number: '1.0-0' }}</p>\r
          </div>\r
          @if (isGym()) {\r
            <div class="rounded-xl border border-slate-200/60 bg-white/60 px-3 py-2 sm:col-span-2">\r
              <p class="text-xs text-slate-500">Subscription</p>\r
              <p class="text-sm font-medium capitalize text-slate-900">{{ m.subscriptionType || 'monthly' }}</p>\r
            </div>\r
          }\r
          @if ((m.pendingAmount || 0) > 0) {\r
            <div class="rounded-xl border border-amber-200/80 bg-amber-50/70 px-3 py-2 sm:col-span-2">\r
              <p class="text-xs text-amber-800">Pending amount</p>\r
              <p class="text-sm font-semibold text-amber-900">\u20B9{{ (m.pendingAmount || 0) | number: '1.0-0' }}</p>\r
            </div>\r
          }\r
        </div>\r
        @if (m.address) {\r
          <div class="mt-3 rounded-xl border border-slate-200/60 bg-white/60 px-3 py-2">\r
            <p class="text-xs text-slate-500">Address</p>\r
            <p class="text-sm text-slate-800">{{ m.address }}</p>\r
          </div>\r
        }\r
      </div>\r
\r
      @if (m.gender || m.aadhaarLast4 || m.notes || m.floorNumber || m.roomNumber || m.bedNumber) {\r
        <div class="rounded-2xl border border-white/70 bg-white/40 p-4 backdrop-blur-md sm:p-5">\r
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">More details</p>\r
          <div class="mt-3 grid gap-3 sm:grid-cols-3">\r
            @if (m.gender) {\r
              <div class="rounded-xl border border-slate-200/50 bg-white/50 px-3 py-2">\r
                <p class="text-xs text-slate-500">Gender</p>\r
                <p class="text-sm capitalize text-slate-900">{{ m.gender }}</p>\r
              </div>\r
            }\r
            @if (m.aadhaarLast4) {\r
              <div class="rounded-xl border border-slate-200/50 bg-white/50 px-3 py-2">\r
                <p class="text-xs text-slate-500">Aadhaar (last 4)</p>\r
                <p class="text-sm text-slate-900">{{ m.aadhaarLast4 }}</p>\r
              </div>\r
            }\r
            @if (m.floorNumber || m.roomNumber || m.bedNumber) {\r
              <div class="rounded-xl border border-slate-200/50 bg-white/50 px-3 py-2 sm:col-span-3">\r
                <p class="text-xs text-slate-500">Floor / Room / Bed</p>\r
                <p class="text-sm text-slate-900">\r
                  {{ m.floorNumber || '\u2014' }} / {{ m.roomNumber || '\u2014' }} / {{ m.bedNumber || '\u2014' }}\r
                </p>\r
              </div>\r
            }\r
          </div>\r
          @if (m.notes) {\r
            <div class="mt-3 rounded-xl border border-slate-200/50 bg-white/50 px-3 py-2">\r
              <p class="text-xs text-slate-500">Notes</p>\r
              <p class="text-sm text-slate-800">{{ m.notes }}</p>\r
            </div>\r
          }\r
        </div>\r
      }\r
\r
      <div class="rounded-2xl border border-white/70 bg-white/35 p-4 backdrop-blur-md sm:p-5">\r
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Payment history</p>\r
        @if (memberDetailPayments().length === 0) {\r
          <p class="mt-2 text-sm text-slate-500">No payments recorded for this member yet.</p>\r
        } @else {\r
          <div class="mt-3 max-h-48 overflow-auto rounded-xl border border-slate-200/60 bg-white/50">\r
            <table class="min-w-full text-left text-xs sm:text-sm">\r
              <thead class="sticky top-0 bg-slate-100/90 text-slate-600 backdrop-blur-sm">\r
                <tr>\r
                  <th class="px-3 py-2">Date</th>\r
                  <th class="px-3 py-2">Amount</th>\r
                  <th class="px-3 py-2">Method</th>\r
                </tr>\r
              </thead>\r
              <tbody class="divide-y divide-slate-100">\r
                @for (p of memberDetailPayments(); track p.paymentId) {\r
                  <tr class="hover:bg-indigo-50/50">\r
                    <td class="px-3 py-2 text-slate-800">{{ p.date.toDate() | date: 'mediumDate' }}</td>\r
                    <td class="px-3 py-2 font-medium text-slate-900">\u20B9{{ p.amount | number: '1.0-0' }}</td>\r
                    <td class="px-3 py-2 uppercase text-slate-600">{{ p.method }}</td>\r
                  </tr>\r
                }\r
              </tbody>\r
            </table>\r
          </div>\r
        }\r
      </div>\r
\r
      <p class="text-center text-xs text-slate-400">ID: {{ m.memberId }}</p>\r
\r
      <a\r
        routerLink="/members"\r
        class="saas-btn-primary block w-full py-3 text-center text-sm no-underline"\r
        (click)="closeMemberDetail()"\r
      >\r
        Open in Members\r
      </a>\r
    </div>\r
  }\r
</app-modal>\r
\r
<app-modal [open]="setupModalOpen()" title="Setup Bed Availability" (closed)="closeSetupModal()">\r
  <form [formGroup]="setupForm" class="space-y-4">\r
    @if (validationError()) {\r
      <div class="rounded-lg border border-red-200 bg-red-50 px-3 py-2">\r
        <p class="text-sm font-medium text-red-800">{{ validationError() }}</p>\r
      </div>\r
    }\r
    <div>\r
      <label class="mb-1 block text-sm font-medium text-slate-700">Number of floors</label>\r
      <div class="flex items-center gap-2">\r
        <button\r
          type="button"\r
          class="rounded-lg border border-slate-200 px-3 py-2 text-lg font-semibold leading-none"\r
          (click)="decrementFloorCount()"\r
        >\r
          -\r
        </button>\r
        <input\r
          type="number"\r
          min="1"\r
          formControlName="floorCount"\r
          class="w-28 rounded-xl border border-slate-200 px-4 py-2 text-center text-base"\r
          (input)="onFloorCountChange($any($event.target).value)"\r
        />\r
        <button\r
          type="button"\r
          class="rounded-lg border border-slate-200 px-3 py-2 text-lg font-semibold leading-none"\r
          (click)="incrementFloorCount()"\r
        >\r
          +\r
        </button>\r
      </div>\r
    </div>\r
\r
    <div class="max-h-[45vh] space-y-3 overflow-y-auto pr-1">\r
      @for (floor of floorGroups.controls; track $index; let floorIdx = $index) {\r
        <div class="rounded-xl border border-slate-200 p-3">\r
          <div class="mb-2 flex items-center justify-between">\r
            <p class="text-sm font-semibold text-slate-900">\r
              @if (+$any(floor.get('floorNumber')?.value) === 0) {\r
                {{ 'rooms.groundFloor' | t }}\r
              } @else {\r
                {{ 'rooms.floor' | t }} {{ floor.get('floorNumber')?.value }}\r
              }\r
            </p>\r
            <div class="flex items-center gap-2">\r
              <label class="text-xs text-slate-600">Rooms</label>\r
              <button\r
                type="button"\r
                class="rounded border border-slate-200 px-2 py-0.5 text-base font-semibold leading-none"\r
                (click)="decrementRoomCount(floorIdx)"\r
              >\r
                -\r
              </button>\r
              <input\r
                type="number"\r
                min="0"\r
                class="w-16 rounded-lg border border-slate-200 px-2 py-1 text-center text-sm"\r
                [value]="floor.get('roomCount')?.value"\r
                (input)="onRoomCountChange(floorIdx, $any($event.target).value)"\r
              />\r
              <button\r
                type="button"\r
                class="rounded border border-slate-200 px-2 py-0.5 text-base font-semibold leading-none"\r
                (click)="incrementRoomCount(floorIdx)"\r
              >\r
                +\r
              </button>\r
            </div>\r
          </div>\r
          @if (roomGroupsAt(floorIdx).length === 0) {\r
            <p class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-600">\r
              No rooms are available in this floor.\r
            </p>\r
          } @else {\r
            <div class="grid gap-2 sm:grid-cols-2">\r
              @for (room of roomGroupsAt(floorIdx).controls; track $index; let roomIdx = $index) {\r
                <div class="rounded-lg bg-slate-50 px-3 py-2" [formGroup]="$any(room)">\r
                  <p class="text-xs font-semibold text-slate-700">\r
                    {{ 'rooms.room' | t }} {{ formatRoomNumber(floorNumberAtFormIndex(floorIdx), roomIdx + 1) }}\r
                  </p>\r
                  <p class="mt-0.5 text-xs text-slate-500">{{ sharingLabel(room.get('beds')?.value) }}</p>\r
                  <label class="mt-1 block text-xs text-slate-500">Beds</label>\r
                  <div class="mt-1 flex items-center gap-2">\r
                    <button\r
                      type="button"\r
                      class="rounded border border-slate-200 px-2 py-0.5 text-base font-semibold leading-none"\r
                      (click)="decrementBedsCount(floorIdx, roomIdx)"\r
                    >\r
                      -\r
                    </button>\r
                    <input\r
                      type="number"\r
                      min="1"\r
                      class="w-16 rounded-lg border border-slate-200 px-2 py-1.5 text-center text-sm"\r
                      formControlName="beds"\r
                      (input)="onBedsCountChange(floorIdx, roomIdx, $any($event.target).value)"\r
                    />\r
                    <button\r
                      type="button"\r
                      class="rounded border border-slate-200 px-2 py-0.5 text-base font-semibold leading-none"\r
                      (click)="incrementBedsCount(floorIdx, roomIdx)"\r
                    >\r
                      +\r
                    </button>\r
                  </div>\r
                  <label class="mt-2 block text-xs text-slate-500">Rent (optional)</label>\r
                  <input\r
                    type="number"\r
                    min="1"\r
                    class="mt-1 w-full rounded-lg border border-slate-200 px-2 py-1.5 text-sm"\r
                    formControlName="rent"\r
                    placeholder="Price not mentioned"\r
                  />\r
                </div>\r
              }\r
            </div>\r
          }\r
        </div>\r
      }\r
    </div>\r
\r
    <div class="flex flex-col-reverse gap-2 pt-2 sm:flex-row sm:justify-end">\r
      <button type="button" class="rounded-xl border border-slate-200 px-5 py-3 font-semibold" (click)="closeSetupModal()">\r
        Continue Later\r
      </button>\r
      <button type="button" class="rounded-xl border border-emerald-300 px-5 py-3 font-semibold text-emerald-700" (click)="saveDraft(true)">\r
        Save Draft\r
      </button>\r
      <button type="button" class="saas-btn-primary px-6 py-3" (click)="saveDraft(false)">\r
        Save & Close\r
      </button>\r
    </div>\r
  </form>\r
</app-modal>\r
\r
<app-modal\r
  [open]="importModalOpen()"\r
  title="Import Members (CSV)"\r
  [closable]="!importBusy()"\r
  (closed)="closeImportModal()"\r
>\r
  <div class="relative space-y-4">\r
    @if (importBusy()) {\r
      <div\r
        class="absolute inset-0 z-20 flex flex-col items-center justify-center gap-5 rounded-xl bg-white/92 px-6 py-10 text-center shadow-inner backdrop-blur-sm dark:bg-slate-900/92"\r
        aria-live="polite"\r
        aria-busy="true"\r
      >\r
        <div class="max-w-md space-y-2">\r
          <p class="text-base font-semibold text-slate-900 dark:text-slate-100">Importing members</p>\r
          <p class="min-h-[3rem] text-sm leading-relaxed text-slate-600 dark:text-slate-300">\r
            {{ importProgressMessage() }}\r
          </p>\r
        </div>\r
        <div class="w-full max-w-md">\r
          <div\r
            class="relative h-14 w-full overflow-hidden rounded-full border-2 border-indigo-200/80 bg-slate-100 shadow-inner dark:border-indigo-500/40 dark:bg-slate-800"\r
          >\r
            <div\r
              class="absolute inset-y-0 left-0 rounded-full bg-gradient-to-r from-indigo-500 via-violet-500 to-indigo-600 transition-[width] duration-500 ease-out dark:from-indigo-400 dark:via-violet-500 dark:to-indigo-500"\r
              [style.width.%]="importProgressPercent()"\r
            ></div>\r
            <div class="pointer-events-none absolute inset-0 flex items-center justify-center">\r
              <span\r
                class="text-base font-extrabold tabular-nums tracking-tight text-slate-900 drop-shadow-[0_1px_0_rgba(255,255,255,0.85)] dark:text-white dark:drop-shadow-[0_1px_2px_rgba(0,0,0,0.6)]"\r
              >\r
                {{ importProgressPercent() }}%\r
              </span>\r
            </div>\r
          </div>\r
          <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">Please wait while we manage your data.</p>\r
        </div>\r
      </div>\r
    }\r
    <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">\r
      <p class="text-sm font-semibold text-slate-800">Sample Excel columns</p>\r
      @if (isPg()) {\r
        <p class="mt-1 text-xs text-slate-600">\r
          <strong>Required:</strong> name, mobile, plan, dueDate, subscriptionType, floor, room, bed\r
        </p>\r
        <p class="mt-1 text-xs text-slate-500">\r
          For PG: <strong>subscriptionType</strong> must be <code class="rounded bg-slate-200 px-1">monthly</code> only. Use full room numbers (101, 204) or floor + room index (floor 2 + room 4 \u2192 204). Floor must match the room number. Valid rows will extend the room map automatically before members are saved.\r
        </p>\r
      } @else {\r
        <p class="mt-1 text-xs text-slate-600">\r
          <strong>Required:</strong> name, mobile, plan, dueDate, subscriptionType\r
        </p>\r
        <p class="mt-1 text-xs text-slate-500">\r
          For Gym: Leave floor, room, bed empty. Mobile is optional.\r
        </p>\r
      }\r
      <div class="mt-2 flex flex-wrap items-center gap-2">\r
        <button\r
          type="button"\r
          class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 disabled:opacity-50"\r
          [disabled]="importBusy()"\r
          (click)="viewSampleExcel()"\r
        >\r
          View sample\r
        </button>\r
        <button\r
          type="button"\r
          class="rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-xs font-semibold text-indigo-800 hover:bg-indigo-100 disabled:opacity-50 dark:border-indigo-800 dark:bg-indigo-950/60 dark:text-indigo-100 dark:hover:bg-indigo-900/80"\r
          [disabled]="importBusy()"\r
          (click)="downloadSampleExcel()"\r
        >\r
          Download sample Excel\r
        </button>\r
      </div>\r
      <p class="mt-1.5 text-xs text-slate-500">View loads the template into the table below so you can check columns and validation before downloading or uploading your own file.</p>\r
    </div>\r
\r
    <div>\r
      <label class="mb-1 block text-sm font-medium text-slate-700">Upload CSV/Excel file</label>\r
      <input\r
        type="file"\r
        accept=".csv,text/csv,.xlsx,.xls,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel"\r
        class="w-full rounded-xl border border-slate-200 px-3 py-2"\r
        (change)="onImportFileSelected($event)"\r
      />\r
      @if (importFileName()) {\r
        <p class="mt-1 text-xs text-slate-500">Selected: {{ importFileName() }}</p>\r
      }\r
    </div>\r
\r
    <div class="rounded-xl border border-slate-200 bg-white p-3">\r
      <label class="flex items-center gap-2 text-sm font-medium text-slate-800">\r
        <input type="checkbox" [formControl]="importDueDateForAll" />\r
        Use same due date for all valid rows\r
      </label>\r
      @if (importDueDateForAll.value) {\r
        <div class="mt-2">\r
          <input type="date" [formControl]="importDueDate" class="rounded-lg border border-slate-200 px-3 py-2 text-sm" />\r
        </div>\r
      }\r
    </div>\r
\r
    @if (importRows().length > 0) {\r
      <div class="flex items-center gap-4 text-xs">\r
        <span class="rounded-full bg-emerald-100 px-2 py-1 font-semibold text-emerald-800">Valid: {{ importValidCount() }}</span>\r
        <span class="rounded-full bg-red-100 px-2 py-1 font-semibold text-red-800">Invalid: {{ importInvalidCount() }}</span>\r
      </div>\r
\r
      <div class="max-h-72 overflow-auto rounded-xl border border-slate-200">\r
        <table class="saas-table min-w-full text-left text-xs">\r
          <thead class="sticky top-0 bg-slate-50 text-slate-600">\r
            <tr>\r
              <th class="px-2 py-2">Sheet row</th>\r
              <th class="px-2 py-2">Name</th>\r
              <th class="px-2 py-2">Mobile</th>\r
              <th class="px-2 py-2">Plan</th>\r
              <th class="px-2 py-2">Due date</th>\r
              <th class="px-2 py-2">Sub</th>\r
              @if (isPg()) {\r
                <th class="px-2 py-2">Assigned seat</th>\r
              }\r
              <th class="min-w-[10rem] px-2 py-2">Status / issues</th>\r
            </tr>\r
          </thead>\r
          <tbody>\r
            @for (row of importRows(); track row.rowNo) {\r
              <tr [class.bg-emerald-50]="row.valid" [class.bg-red-50]="!row.valid" class="border-t border-slate-100">\r
                <td class="px-2 py-2">{{ row.rowNo }}</td>\r
                <td class="px-2 py-2">{{ row.firstName }} {{ row.lastName }}</td>\r
                <td class="px-2 py-2">{{ row.mobile || '\u2014' }}</td>\r
                <td class="px-2 py-2">\u20B9{{ row.amount | number: '1.0-0' }}</td>\r
                <td class="px-2 py-2">{{ row.dueDate }}</td>\r
                <td class="px-2 py-2">{{ row.subscriptionType }}</td>\r
                @if (isPg()) {\r
                  <td class="px-2 py-2 font-medium text-slate-800">{{ importSeatSummary(row) }}</td>\r
                }\r
                <td class="max-w-xs px-2 py-2 align-top">\r
                  @if (row.valid) {\r
                    <span class="font-semibold text-emerald-800">Valid</span>\r
                  } @else {\r
                    <ul class="list-disc pl-4 text-left text-xs font-medium text-red-900">\r
                      @for (err of row.errors; track err) {\r
                        <li>{{ err }}</li>\r
                      }\r
                    </ul>\r
                  }\r
                </td>\r
              </tr>\r
            }\r
          </tbody>\r
        </table>\r
      </div>\r
    }\r
\r
    <div class="flex flex-col-reverse gap-2 pt-2 sm:flex-row sm:justify-end">\r
      <button\r
        type="button"\r
        class="rounded-xl border border-slate-200 px-5 py-2.5 font-semibold disabled:cursor-not-allowed disabled:opacity-50"\r
        [disabled]="importBusy()"\r
        (click)="closeImportModal()"\r
      >\r
        Cancel\r
      </button>\r
      <button\r
        type="button"\r
        class="saas-btn-primary px-5 py-2.5 disabled:cursor-not-allowed disabled:opacity-50"\r
        [disabled]="importBusy() || importValidCount() === 0"\r
        (click)="importValidMembers()"\r
      >\r
        {{ importBusy() ? 'Importing...' : 'Import Valid Members' }}\r
      </button>\r
    </div>\r
  </div>\r
</app-modal>\r
\r
<app-modal [open]="bedMapModalOpen()" title="Bed Map" [extraWide]="true" (closed)="closeBedMap()">\r
  @if (!hasPgLayout()) {\r
    <p class="text-sm text-slate-600">Setup required</p>\r
  } @else {\r
    <app-bed-map-seat-grid [layout]="pgLayout()" [members]="members()" [showOccupantActions]="true" />\r
  }\r
</app-modal>\r
\r
<!-- Monthly Earnings Sidebar (Deprecated - use main section component instead) -->\r
\r
