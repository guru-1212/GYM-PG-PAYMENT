    (() => {
      (typeof ngDevMode === "undefined" || ngDevMode) && i035.\u0275setClassMetadata(ComplaintsPageComponent, [{
        type: Component26,
        args: [{ selector: "app-complaints-page", standalone: true, imports: [DatePipe17, FormsModule3], template: `<div class="mx-auto max-w-7xl space-y-5">\r
  <!-- \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 Header card \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\r
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900">\r
    <div class="flex flex-wrap items-start justify-between gap-3">\r
      <div class="min-w-0">\r
        <h1 class="flex items-center gap-2 text-xl font-bold text-slate-900 dark:text-slate-100">\r
          <span class="material-icons-outlined text-amber-600 dark:text-amber-400">support_agent</span>\r
          Complaint Box\r
        </h1>\r
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">\r
          Tenants raise complaints from inside the member app (or the public complaint link when enabled).\r
        </p>\r
      </div>\r
      <div class="flex flex-wrap items-center gap-2">\r
        <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-900 dark:bg-amber-900/40 dark:text-amber-200">\r
          <span class="material-icons-outlined text-[14px]">priority_high</span>\r
          Open: {{ openCount() }}\r
        </span>\r
        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-900 dark:bg-emerald-900/40 dark:text-emerald-200">\r
          <span class="material-icons-outlined text-[14px]">check_circle</span>\r
          Resolved: {{ resolvedCount() }}\r
        </span>\r
        <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">\r
          Total: {{ totalCount() }}\r
        </span>\r
      </div>\r
    </div>\r
  </div>\r
\r
  <!-- \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 Tenant online complaints toggle \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\r
  <div\r
    class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-teal-200/80 bg-teal-50/50 p-4 shadow-sm dark:border-teal-900/40 dark:bg-teal-950/25"\r
  >\r
    <div class="min-w-0 max-w-2xl">\r
      <h2 class="text-sm font-bold text-teal-900 dark:text-teal-100">Online complaints (tenant app)</h2>\r
      <p class="mt-1 text-xs leading-relaxed text-teal-900/80 dark:text-teal-200/85">\r
        When on, tenants get the <strong>Complaint</strong> tab in the member app. When off, they only see a short notice\r
        there; existing rows below stay for your records.\r
      </p>\r
    </div>\r
    <label\r
      class="flex shrink-0 cursor-pointer items-center gap-2 rounded-xl border border-teal-300/70 bg-white px-3 py-2 shadow-sm dark:border-teal-800 dark:bg-slate-900"\r
    >\r
      <span class="text-xs font-semibold text-slate-700 dark:text-slate-200">{{\r
        tenantComplaintsOnline() ? 'On' : 'Off'\r
      }}</span>\r
      <input\r
        type="checkbox"\r
        class="h-4 w-4 accent-teal-600"\r
        [checked]="tenantComplaintsOnline()"\r
        [disabled]="complaintSettingsBusy()"\r
        (change)="setTenantComplaintsOnline($any($event.target).checked)"\r
        [attr.aria-label]="tenantComplaintsOnline() ? 'Turn off online complaints' : 'Turn on online complaints'"\r
      />\r
    </label>\r
  </div>\r
\r
  <!-- \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 Filters \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\r
  <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">\r
    <div class="flex flex-wrap items-center gap-3">\r
      <div class="flex shrink-0 rounded-xl bg-slate-100 p-1 dark:bg-slate-800">\r
        <button\r
          type="button"\r
          class="rounded-lg px-3 py-1.5 text-xs font-semibold transition"\r
          [class.bg-white]="statusFilter() === 'all'"\r
          [class.text-slate-900]="statusFilter() === 'all'"\r
          [class.shadow-sm]="statusFilter() === 'all'"\r
          [class.text-slate-500]="statusFilter() !== 'all'"\r
          (click)="setStatusFilter('all')"\r
        >All</button>\r
        <button\r
          type="button"\r
          class="rounded-lg px-3 py-1.5 text-xs font-semibold transition"\r
          [class.bg-white]="statusFilter() === 'open'"\r
          [class.text-amber-700]="statusFilter() === 'open'"\r
          [class.shadow-sm]="statusFilter() === 'open'"\r
          [class.text-slate-500]="statusFilter() !== 'open'"\r
          (click)="setStatusFilter('open')"\r
        >Open</button>\r
        <button\r
          type="button"\r
          class="rounded-lg px-3 py-1.5 text-xs font-semibold transition"\r
          [class.bg-white]="statusFilter() === 'resolved'"\r
          [class.text-emerald-700]="statusFilter() === 'resolved'"\r
          [class.shadow-sm]="statusFilter() === 'resolved'"\r
          [class.text-slate-500]="statusFilter() !== 'resolved'"\r
          (click)="setStatusFilter('resolved')"\r
        >Resolved</button>\r
      </div>\r
\r
      @if (categories().length > 0) {\r
        <select\r
          class="saas-input shrink-0"\r
          [value]="categoryFilter()"\r
          (change)="setCategoryFilter($any($event.target).value)"\r
        >\r
          <option value="">All categories</option>\r
          @for (c of categories(); track c) {\r
            <option [value]="c">{{ c }}</option>\r
          }\r
        </select>\r
      }\r
\r
      <input\r
        type="search"\r
        class="saas-input min-w-[14rem] flex-1"\r
        placeholder="Search by name, room, mobile or text\u2026"\r
        [value]="searchQuery()"\r
        (input)="setSearch($any($event.target).value)"\r
      />\r
    </div>\r
  </div>\r
\r
  <!-- \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 Complaint cards \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\r
  @if (loading()) {\r
    <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">\r
      Loading complaints\u2026\r
    </div>\r
  } @else if (filtered().length === 0) {\r
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center dark:border-slate-700 dark:bg-slate-900">\r
      <span class="material-icons-outlined text-4xl text-slate-300 dark:text-slate-600">inbox</span>\r
      <p class="mt-2 text-base font-semibold text-slate-700 dark:text-slate-200">No complaints to show</p>\r
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">\r
        @if (complaints().length === 0) {\r
          When members raise a complaint from the tenant app, it will appear here.\r
        } @else {\r
          Adjust the filters above to see more.\r
        }\r
      </p>\r
    </div>\r
  } @else {\r
    <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">\r
      @for (c of filtered(); track c.complaintId) {\r
        <article\r
          class="flex flex-col rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md dark:border-slate-700 dark:bg-slate-900"\r
          [class.opacity-80]="c.status === 'resolved'"\r
        >\r
          <!-- Header row: avatar + name + status pill -->\r
          <div class="flex items-start justify-between gap-3">\r
            <div class="flex min-w-0 items-center gap-3">\r
              <span\r
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl text-sm font-bold text-white"\r
                [class.bg-gradient-to-br]="true"\r
                [class.from-teal-500]="c.status === 'open'"\r
                [class.to-indigo-600]="c.status === 'open'"\r
                [class.from-emerald-500]="c.status === 'resolved'"\r
                [class.to-emerald-700]="c.status === 'resolved'"\r
                aria-hidden="true"\r
              >\r
                {{ (c.memberName || '?').charAt(0).toUpperCase() }}\r
              </span>\r
              <div class="min-w-0">\r
                <p class="truncate text-sm font-bold text-slate-900 dark:text-slate-100">\r
                  {{ c.memberName || 'Unknown member' }}\r
                </p>\r
                <p class="truncate text-xs text-slate-500 dark:text-slate-400">\r
                  {{ c.memberMobile }}\r
                </p>\r
              </div>\r
            </div>\r
            @if (c.status === 'open') {\r
              <span class="shrink-0 rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-amber-900 dark:bg-amber-900/40 dark:text-amber-200">Open</span>\r
            } @else {\r
              <span class="shrink-0 rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-emerald-900 dark:bg-emerald-900/40 dark:text-emerald-200">Resolved</span>\r
            }\r
          </div>\r
\r
          <!-- Room + category meta -->\r
          <div class="mt-3 flex flex-wrap items-center gap-1.5 text-xs">\r
            @if (c.roomNumber) {\r
              <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">\r
                <span class="material-icons-outlined text-[14px]">meeting_room</span>\r
                Room {{ c.roomNumber }}\r
              </span>\r
            }\r
            @if (c.floorNumber) {\r
              <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">\r
                <span class="material-icons-outlined text-[14px]">stairs</span>\r
                Floor {{ c.floorNumber }}\r
              </span>\r
            }\r
            @if (c.bedNumber) {\r
              <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">\r
                <span class="material-icons-outlined text-[14px]">bed</span>\r
                Bed {{ c.bedNumber }}\r
              </span>\r
            }\r
            @if (c.category) {\r
              <span class="inline-flex items-center gap-1 rounded-full bg-teal-50 px-2 py-0.5 font-bold text-teal-800 dark:bg-teal-900/40 dark:text-teal-200">\r
                {{ c.category }}\r
              </span>\r
            }\r
          </div>\r
\r
          <!-- Message body -->\r
          <p class="mt-3 whitespace-pre-wrap break-words text-sm leading-relaxed text-slate-700 dark:text-slate-200">\r
            {{ c.message }}\r
          </p>\r
\r
          <!-- Resolution note -->\r
          @if (c.status === 'resolved' && c.resolutionNote) {\r
            <div class="mt-3 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs text-emerald-800 dark:border-emerald-900/50 dark:bg-emerald-900/30 dark:text-emerald-200">\r
              <p class="font-bold">Resolution note</p>\r
              <p class="mt-0.5 whitespace-pre-wrap">{{ c.resolutionNote }}</p>\r
            </div>\r
          }\r
\r
          <!-- Footer -->\r
          <div class="mt-auto flex flex-wrap items-center justify-between gap-2 pt-3">\r
            <p class="text-[11px] text-slate-500 dark:text-slate-400">\r
              @if (c.createdAt; as ca) {\r
                Raised {{ ca.toDate() | date: 'd MMM y, h:mm a' }}\r
              }\r
            </p>\r
            <div class="flex items-center gap-1">\r
              <button\r
                type="button"\r
                class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"\r
                (click)="callMember(c.memberMobile)"\r
                aria-label="Call member"\r
                title="Call"\r
              >\r
                <span class="material-icons-outlined text-[18px]">call</span>\r
              </button>\r
              <button\r
                type="button"\r
                class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-emerald-200 bg-emerald-50 text-emerald-700 transition hover:bg-emerald-100 dark:border-emerald-900/50 dark:bg-emerald-900/30 dark:text-emerald-200"\r
                (click)="whatsappMember(c)"\r
                aria-label="WhatsApp member"\r
                title="WhatsApp"\r
              >\r
                <span class="material-icons-outlined text-[18px]">chat</span>\r
              </button>\r
              @if (c.status === 'open') {\r
                <button\r
                  type="button"\r
                  class="inline-flex items-center gap-1 rounded-lg border border-indigo-300 bg-indigo-600 px-3 py-1.5 text-xs font-bold text-white transition hover:bg-indigo-700 disabled:opacity-50"\r
                  [disabled]="resolvingId() === c.complaintId"\r
                  (click)="openResolve(c.complaintId)"\r
                >\r
                  <span class="material-icons-outlined text-[14px]">done_all</span>\r
                  Mark resolved\r
                </button>\r
              }\r
            </div>\r
          </div>\r
\r
          <!-- Inline resolve panel -->\r
          @if (resolveTargetId() === c.complaintId) {\r
            <div class="mt-3 rounded-xl border border-indigo-200 bg-indigo-50 p-3 dark:border-indigo-800 dark:bg-indigo-950/50">\r
              <p class="text-xs font-bold text-indigo-900 dark:text-indigo-200">\r
                Add a short resolution note (optional)\r
              </p>\r
              <textarea\r
                rows="2"\r
                maxlength="500"\r
                class="saas-input mt-2 w-full text-sm"\r
                placeholder="e.g. Plumber fixed the leak on 30 Apr 2026"\r
                [value]="resolutionNote()"\r
                (input)="resolutionNote.set($any($event.target).value)"\r
              ></textarea>\r
              <div class="mt-2 flex items-center justify-end gap-2">\r
                <button\r
                  type="button"\r
                  class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200"\r
                  (click)="cancelResolve()"\r
                >\r
                  Cancel\r
                </button>\r
                <button\r
                  type="button"\r
                  class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-bold text-white shadow-sm transition hover:bg-emerald-700 disabled:opacity-50"\r
                  [disabled]="resolvingId() === c.complaintId"\r
                  (click)="confirmResolve()"\r
                >\r
                  {{ resolvingId() === c.complaintId ? 'Saving\u2026' : 'Confirm resolve' }}\r
                </button>\r
              </div>\r
            </div>\r
          }\r
        </article>\r
      }\r
    </div>\r
  }\r
</div>\r
` }]
      }], null, null);
    })();
