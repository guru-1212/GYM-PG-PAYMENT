\r
    <main class="min-w-0 flex-1 p-4 pb-28 md:p-6 md:pb-8 lg:p-8 dark:bg-slate-950/50">\r
      <router-outlet />\r
    </main>\r
\r
    <!-- \u2500\u2500 Mobile bottom navigation (visible only on mobile, < md) \u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\r
    <!-- Sits above content with a floating, elevated center "Add Member" FAB. -->\r
    <nav\r
      class="fixed inset-x-0 bottom-0 z-30 md:hidden"\r
      [attr.aria-label]="'a11y.bottomNav' | t"\r
      style="padding-bottom: env(safe-area-inset-bottom)"\r
    >\r
      <div\r
        class="relative flex h-16 items-stretch border-t border-slate-200/80 bg-white/95 px-1 backdrop-blur-xl shadow-[0_-6px_24px_rgba(15,23,42,0.08)] dark:border-slate-700/70 dark:bg-slate-950/95 dark:shadow-[0_-6px_24px_rgba(0,0,0,0.5)]"\r
      >\r
        <!-- 1. Home -->\r
        <a\r
          routerLink="/dashboard"\r
          [routerLinkActiveOptions]="{ exact: true }"\r
          routerLinkActive="!text-indigo-700 dark:!text-indigo-300"\r
          #homeRLA="routerLinkActive"\r
          class="relative flex min-w-0 flex-1 flex-col items-center justify-center gap-0.5 text-slate-500 transition active:scale-[0.96] dark:text-slate-400"\r
        >\r
          @if (homeRLA.isActive) {\r
            <span\r
              class="pointer-events-none absolute top-0 h-1 w-7 -translate-y-px rounded-b-full bg-gradient-to-r from-indigo-500 to-blue-600"\r
              aria-hidden="true"\r
            ></span>\r
          }\r
          <span class="material-icons-outlined text-[22px] leading-none">home</span>\r
          <span class="text-[10px] font-semibold leading-tight">{{ 'nav.home' | t }}</span>\r
        </a>\r
\r
        <!-- 2. Members -->\r
        @if (canViewMembers()) {\r
          <a\r
            routerLink="/members"\r
            routerLinkActive="!text-indigo-700 dark:!text-indigo-300"\r
            [routerLinkActiveOptions]="{ exact: true }"\r
            #memRLA="routerLinkActive"\r
            class="relative flex min-w-0 flex-1 flex-col items-center justify-center gap-0.5 text-slate-500 transition active:scale-[0.96] dark:text-slate-400"\r
          >\r
            @if (memRLA.isActive) {\r
              <span\r
                class="pointer-events-none absolute top-0 h-1 w-7 -translate-y-px rounded-b-full bg-gradient-to-r from-indigo-500 to-blue-600"\r
                aria-hidden="true"\r
              ></span>\r
            }\r
            <span class="material-icons-outlined text-[22px] leading-none">groups</span>\r
            <span class="text-[10px] font-semibold leading-tight">{{ 'nav.members' | t }}</span>\r
          </a>\r
        } @else {\r
          <div class="flex min-w-0 flex-1"></div>\r
        }\r
\r
        <!-- 3. Center FAB: Add Member (elevated, brand gradient) -->\r
        <div class="relative flex w-16 shrink-0 items-end justify-center">\r
          <a\r
            routerLink="/members"\r
            [queryParams]="{ action: 'add' }"\r
            class="group -mt-7 flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br from-indigo-600 via-indigo-600 to-blue-600 text-white shadow-lg shadow-indigo-600/40 ring-[3px] ring-white transition active:scale-95 dark:ring-slate-950"\r
            aria-label="Add member"\r
            title="Add member"\r
          >\r
            <!-- Soft glow ring (purely decorative) -->\r
            <span\r
              class="pointer-events-none absolute inset-0 rounded-full bg-indigo-500/40 blur-md transition group-hover:bg-indigo-500/55"\r
              aria-hidden="true"\r
            ></span>\r
            <span class="material-icons-outlined relative text-[28px] leading-none">person_add</span>\r
          </a>\r
        </div>\r
\r
        <!-- 4. Rooms (PG) \u2014 falls back to Payments (Gym) \u2014 falls back to spacer -->\r
        @if (isPgOwner() && canViewRooms()) {\r
          <a\r
            routerLink="/rooms"\r
            routerLinkActive="!text-indigo-700 dark:!text-indigo-300"\r
            #roomRLA="routerLinkActive"\r
            class="relative flex min-w-0 flex-1 flex-col items-center justify-center gap-0.5 text-slate-500 transition active:scale-[0.96] dark:text-slate-400"\r
          >\r
            @if (roomRLA.isActive) {\r
              <span\r
                class="pointer-events-none absolute top-0 h-1 w-7 -translate-y-px rounded-b-full bg-gradient-to-r from-indigo-500 to-blue-600"\r
                aria-hidden="true"\r
              ></span>\r
            }\r
            <span class="material-icons-outlined text-[22px] leading-none">hotel</span>\r
            <span class="text-[10px] font-semibold leading-tight">{{ 'nav.rooms' | t }}</span>\r
          </a>\r
        } @else if (canViewPayments()) {\r
          <a\r
            routerLink="/payments"\r
            routerLinkActive="!text-indigo-700 dark:!text-indigo-300"\r
            #payRLA="routerLinkActive"\r
            class="relative flex min-w-0 flex-1 flex-col items-center justify-center gap-0.5 text-slate-500 transition active:scale-[0.96] dark:text-slate-400"\r
          >\r
            @if (payRLA.isActive) {\r
              <span\r
                class="pointer-events-none absolute top-0 h-1 w-7 -translate-y-px rounded-b-full bg-gradient-to-r from-indigo-500 to-blue-600"\r
                aria-hidden="true"\r
              ></span>\r
            }\r
            <span class="material-icons-outlined text-[22px] leading-none">payments</span>\r
            <span class="text-[10px] font-semibold leading-tight">{{ 'nav.payments' | t }}</span>\r
          </a>\r
        } @else {\r
          <div class="flex min-w-0 flex-1"></div>\r
        }\r
\r
        <!-- 5. Analytics \u2014 falls back to "More" (opens hamburger drawer) -->\r
        @if (canViewAnalytics()) {\r
          <a\r
            routerLink="/analytics"\r
            routerLinkActive="!text-indigo-700 dark:!text-indigo-300"\r
            #anaRLA="routerLinkActive"\r
            class="relative flex min-w-0 flex-1 flex-col items-center justify-center gap-0.5 text-slate-500 transition active:scale-[0.96] dark:text-slate-400"\r
