    (() => {
      (typeof ngDevMode === "undefined" || ngDevMode) && i019.\u0275setClassMetadata(BedMapSeatGridComponent, [{
        type: Component11,
        args: [{ selector: "app-bed-map-seat-grid", standalone: true, imports: [ModalComponent, TranslatePipe], template: `@if (layout(); as pg) {\r
  <div class="space-y-5">\r
    <div\r
      class="rounded-2xl border border-slate-200/90 bg-gradient-to-b from-white via-white to-slate-50/90 p-1.5 shadow-md shadow-slate-200/40 ring-1 ring-slate-200/60 dark:border-slate-600/80 dark:from-slate-900 dark:via-slate-900 dark:to-slate-900/95 dark:shadow-none dark:ring-slate-700/50 sm:p-2"\r
    >\r
      <div class="flex flex-col gap-2.5 sm:flex-row sm:items-stretch">\r
        <label class="sr-only" for="bedmap-search-input">{{ 'members.bedMapSearchAria' | t }}</label>\r
        <input\r
          id="bedmap-search-input"\r
          type="search"\r
          autocomplete="off"\r
          class="min-w-0 flex-1 rounded-xl border border-slate-200/90 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-inner shadow-slate-900/5 placeholder:text-slate-400 transition focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/25 dark:border-slate-600 dark:bg-slate-950 dark:text-slate-100 dark:shadow-inner dark:placeholder:text-slate-500"\r
          [placeholder]="'members.bedMapSearchPlaceholder' | t"\r
          [value]="searchDraft()"\r
          (input)="onSearchInput($event)"\r
          (keydown.enter)="runBedMapSearch()"\r
        />\r
        <button\r
          type="button"\r
          class="shrink-0 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-indigo-900/15 transition hover:bg-indigo-700 hover:shadow-lg active:scale-[0.99] dark:bg-indigo-500 dark:hover:bg-indigo-400"\r
          (click)="runBedMapSearch()"\r
        >\r
          {{ 'members.bedMapSearchGo' | t }}\r
        </button>\r
      </div>\r
    </div>\r
    @for (floor of pg.floors || []; track floor.floorNumber) {\r
      <section\r
        class="rounded-2xl border border-slate-200/85 bg-white/80 p-4 shadow-sm shadow-slate-200/50 backdrop-blur-sm dark:border-slate-700/80 dark:bg-slate-900/55 dark:shadow-none"\r
        [id]="bedmapFloorDomId(floor.floorNumber)"\r
        [class.bedmap-search-flash]="isSearchFlashing(bedmapFloorDomId(floor.floorNumber))"\r
      >\r
        <div class="flex items-center gap-2 border-b border-slate-200/80 pb-3 dark:border-slate-700/80">\r
          <span\r
            class="inline-block h-6 w-1 rounded-full bg-gradient-to-b from-indigo-500 to-violet-500 dark:from-indigo-400 dark:to-violet-400"\r
            aria-hidden="true"\r
          ></span>\r
          <p class="text-base font-bold tracking-tight text-slate-900 dark:text-slate-50">\r
            @if (+floor.floorNumber === 0) {\r
              {{ 'rooms.groundFloor' | t }}\r
            } @else {\r
              {{ 'rooms.floor' | t }} {{ floor.floorNumber }}\r
            }\r
          </p>\r
        </div>\r
        @if (floor.rooms.length === 0) {\r
          <p\r
            class="mt-4 rounded-xl border border-dashed border-slate-300/90 bg-slate-50/80 px-4 py-3 text-center text-sm text-slate-600 dark:border-slate-600 dark:bg-slate-800/40 dark:text-slate-400"\r
          >\r
            No rooms are available in this floor.\r
          </p>\r
        } @else {\r
          <div class="mt-4 grid gap-4 overflow-visible sm:grid-cols-2 xl:grid-cols-3">\r
            @for (room of floor.rooms; track room.roomNumber) {\r
              <div\r
                class="group/room overflow-visible rounded-2xl border border-slate-200/90 bg-gradient-to-b from-white to-slate-50/90 p-4 shadow-md shadow-slate-200/35 ring-1 ring-slate-200/50 transition hover:shadow-lg hover:ring-slate-300/60 dark:border-slate-600/85 dark:from-slate-900/90 dark:to-slate-950/80 dark:shadow-none dark:ring-slate-700/40 dark:hover:ring-slate-600/60"\r
                [id]="bedmapRoomDomId(floor.floorNumber, room.roomNumber)"\r
                [class.bedmap-search-flash]="isSearchFlashing(bedmapRoomDomId(floor.floorNumber, room.roomNumber))"\r
              >\r
                <div class="flex flex-wrap items-start justify-between gap-2">\r
                  <p class="text-sm font-bold text-slate-900 dark:text-slate-50">\r
                    {{ 'rooms.room' | t }} {{ formatRoomNumber(+floor.floorNumber, +room.roomNumber) }}\r
                  </p>\r
                  @if (roomHasValidRent(room.rent)) {\r
                    <span\r
                      class="inline-flex shrink-0 items-center rounded-full bg-indigo-600/10 px-2.5 py-0.5 text-xs font-semibold tabular-nums text-indigo-800 dark:bg-indigo-400/15 dark:text-indigo-200"\r
                    >\r
                      {{ roomRentText(room.rent) }}\r
                    </span>\r
                  } @else {\r
                    <span\r
                      class="inline-flex shrink-0 items-center rounded-full border border-dashed border-slate-300/90 px-2 py-0.5 text-[11px] font-medium text-slate-500 dark:border-slate-600 dark:text-slate-400"\r
                      [attr.title]="'members.bedMapRentUnset' | t"\r
                    >\r
                      {{ 'members.bedMapRentUnset' | t }}\r
                    </span>\r
                  }\r
                </div>\r
                <p class="mt-1 text-xs font-medium text-slate-600 dark:text-slate-400">{{ sharingLabel(room.beds) }}</p>\r
                <div class="mt-3 grid grid-cols-2 gap-2.5 overflow-visible sm:grid-cols-3">\r
                  @for (_ of [].constructor(room.beds); track $index; let bedIdx = $index) {\r
                    @let seatBedNo = bedIdx + 1;\r
                    @let tooltipAboveBed = tooltipPlacementAboveBed(floor.floorNumber, room.roomNumber, seatBedNo);\r
                    <div\r
                      class="group/seat relative z-0 overflow-visible hover:z-20"\r
                      [id]="bedmapSeatDomId(floor.floorNumber, room.roomNumber, seatBedNo)"\r
                      [class.bedmap-search-flash]="isSearchFlashing(bedmapSeatDomId(floor.floorNumber, room.roomNumber, seatBedNo))"\r
                      (pointerenter)="onSeatPointerEnter($event, floor.floorNumber, room.roomNumber, seatBedNo)"\r
                      (click)="onSeatPointerEnter($event, floor.floorNumber, room.roomNumber, seatBedNo)"\r
                      (pointerleave)="onSeatPointerLeave(floor.floorNumber, room.roomNumber, seatBedNo)"\r
                    >\r
                      <div\r
                        class="seat-block flex h-11 min-h-[2.75rem] items-center justify-center rounded-xl border text-xs font-semibold transition-all duration-200"\r
                        [class.border-red-300]="isBedOccupied(floor.floorNumber, room.roomNumber, seatBedNo)"\r
                        [class.bg-red-100]="isBedOccupied(floor.floorNumber, room.roomNumber, seatBedNo)"\r
                        [class.text-red-800]="isBedOccupied(floor.floorNumber, room.roomNumber, seatBedNo)"\r
                        [class.cursor-not-allowed]="isBedOccupied(floor.floorNumber, room.roomNumber, seatBedNo)"\r
                        [class.border-emerald-200]="!isBedOccupied(floor.floorNumber, room.roomNumber, seatBedNo)"\r
                        [class.bg-emerald-50]="!isBedOccupied(floor.floorNumber, room.roomNumber, seatBedNo)"\r
                        [class.text-emerald-800]="!isBedOccupied(floor.floorNumber, room.roomNumber, seatBedNo)"\r
                        [attr.aria-label]="\r
                          isBedOccupied(floor.floorNumber, room.roomNumber, seatBedNo)\r
                            ? 'Bed ' + seatBedNo + ' - Occupied'\r
                            : 'Bed ' + seatBedNo\r
                        "\r
                      >\r
                        <span class="flex items-center gap-1.5">\r
                          <span\r
                            class="material-icons-outlined text-base leading-none drop-shadow-sm"\r
                            [class.text-red-700]="isBedOccupied(floor.floorNumber, room.roomNumber, seatBedNo)"\r
                            [class.text-emerald-600]="!isBedOccupied(floor.floorNumber, room.roomNumber, seatBedNo)"\r
                          >\r
                            single_bed\r
                          </span>\r
                          <span class="text-[11px] font-bold tabular-nums">{{ seatBedNo }}</span>\r
                        </span>\r
                      </div>\r
\r
                      @if (isBedOccupied(floor.floorNumber, room.roomNumber, seatBedNo)) {\r
                        \r
                        <div\r
                          class="seat-tooltip-panel pointer-events-none invisible absolute z-50 rounded-xl border border-slate-200 bg-white p-3 text-left opacity-0 shadow-xl ring-1 ring-slate-100 transition-opacity duration-150 group-hover/seat:visible group-hover/seat:pointer-events-auto group-hover/seat:opacity-100 dark:border-slate-600 dark:bg-slate-900 dark:ring-slate-700"\r
                          [class.bottom-full]="tooltipAboveBed"\r
                          [class.mb-2]="tooltipAboveBed"\r
                          [class.top-full]="!tooltipAboveBed"\r
                          [class.mt-2]="!tooltipAboveBed"\r
                          [class.seat-tooltip-pos-left]="bedIdx % 3 === 0"\r
                          [class.seat-tooltip-pos-center]="bedIdx % 3 === 1"\r
                          [class.seat-tooltip-pos-right]="bedIdx % 3 === 2"\r
                        >\r
                          <p class="mb-2 text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">\r
                            {{ 'members.bedMapAssignedSeat' | t }}\r
                          </p>\r
                          <div class="space-y-1.5">\r
                            <div class="flex items-start justify-between gap-2">\r
                              <span class="shrink-0 text-xs text-slate-500 dark:text-slate-400">Name</span>\r
                              <span class="min-w-0 break-words text-right text-xs font-semibold text-slate-900 dark:text-slate-100">{{\r
                                memberDisplayName(getOccupiedMember(floor.floorNumber, room.roomNumber, seatBedNo))\r
                              }}</span>\r
                            </div>\r
                            <div class="flex items-start justify-between gap-2">\r
                              <span class="shrink-0 text-xs text-slate-500 dark:text-slate-400">Mobile</span>\r
                              <div class="flex min-w-0 max-w-[78%] flex-nowrap items-center justify-end gap-2 text-right">\r
                                @if (getOccupiedMember(floor.floorNumber, room.roomNumber, seatBedNo); as smTel) {\r
                                  @if (smTel.mobile; as mobText) {\r
                                    @let waPop = whatsappHrefMobile(mobText);\r
                                    <span class="inline-flex max-w-full min-w-0 items-center gap-1">\r
                                      @if (telHref(mobText); as tel) {\r
                                        <a\r
                                          [href]="tel"\r
                                          (click)="$event.stopPropagation()"\r
                                          class="min-w-0 truncate text-xs font-medium text-sky-700 underline underline-offset-2 hover:text-sky-900 dark:text-sky-300 dark:hover:text-sky-100"\r
                                          >{{ mobText }}</a\r
                                        >\r
                                      } @else {\r
                                        <span class="min-w-0 truncate text-xs font-medium text-slate-800 dark:text-slate-200">{{ mobText }}</span>\r
                                      }\r
                                      @if (waPop) {\r
                                        <a\r
                                          [href]="waPop"\r
                                          target="_blank"\r
                                          rel="noopener noreferrer"\r
                                          class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#25D366] text-white shadow-sm hover:bg-[#20bd5a]"\r
                                          title="WhatsApp"\r
                                          aria-label="Open WhatsApp chat"\r
                                          (click)="$event.stopPropagation()"\r
                                        >\r
