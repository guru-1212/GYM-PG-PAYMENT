        type: Component16,
        args: [{ selector: "app-member-receipt", standalone: true, imports: [DatePipe8], template: `<div class="receipt-container">\r
  <div class="receipt-card">\r
    <!-- Loading State -->\r
    @if (loading) {\r
      <div>\r
        <div class="icon-success">\r
          <div class="loading-spinner"></div>\r
        </div>\r
        <h2 style="color: #1e293b; margin: 0 0 16px 0; font-size: 24px; font-weight: 700;">Loading Receipt...</h2>\r
        <p style="color: #64748b; margin: 0;">Please wait while we prepare your receipt</p>\r
      </div>\r
    }\r
\r
    <!-- Error State -->\r
    @if (error) {\r
      <div>\r
        <div class="icon-success" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);">\r
          <span class="material-icons-outlined text-white text-3xl">error</span>\r
        </div>\r
        <h2 style="color: #1e293b; margin: 0 0 16px 0; font-size: 24px; font-weight: 700;">Unable to Load Receipt</h2>\r
        <p style="color: #64748b; margin: 0 0 24px 0;">{{ error }}</p>\r
        <button \r
          (click)="loadReceiptData()" \r
          style="background: linear-gradient(135deg, #64748b 0%, #475569 100%); color: white; border: none; padding: 12px 24px; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer;"\r
        >\r
          Try Again\r
        </button>\r
      </div>\r
    }\r
\r
    <!-- Success State -->\r
    @if (receiptData && !loading && !error) {\r
      <div>\r
        <div class="icon-success">\r
          <span class="material-icons-outlined text-white text-3xl">receipt</span>\r
        </div>\r
        \r
        <h2 style="color: #1e293b; margin: 0 0 8px 0; font-size: 28px; font-weight: 700;">Payment Receipt</h2>\r
        <p style="color: #64748b; margin: 0 0 24px 0;">Your receipt is ready for download</p>\r
\r
        <div class="receipt-info">\r
          <h3>Receipt Details</h3>\r
          <p><strong>Receipt Number:</strong> {{ receiptData.receiptNumber }}</p>\r
          <p><strong>Member:</strong> {{ receiptData.receiptData.memberName }}</p>\r
          <p><strong>Amount:</strong> \u20B9{{ receiptData.receiptData.amount.toLocaleString('en-IN') }}</p>\r
          <p><strong>Pending Amount:</strong> \u20B9{{ (receiptData.receiptData.pendingAmount || 0).toLocaleString('en-IN') }}</p>\r
          @if ((receiptData.receiptData.pendingAmount || 0) > 0) {\r
            <p style="margin-top: 8px; color: #9a3412; font-weight: 600;">\r
              Pending amount \u20B9{{ (receiptData.receiptData.pendingAmount || 0).toLocaleString('en-IN') }} will be charged in next cycle.\r
            </p>\r
          }\r
          <p><strong>Month:</strong> {{ receiptData.receiptData.monthText }}</p>\r
          <p><strong>Payment Date:</strong> {{ paymentDate | date: 'mediumDate' }}</p>\r
          <p><strong>Payment Method:</strong> {{ receiptData.receiptData.paymentMethod.charAt(0).toUpperCase() + receiptData.receiptData.paymentMethod.slice(1) }}</p>\r
          @if ((receiptData.receiptData.pendingPaidAmount || 0) > 0) {\r
            <div style="margin-top: 12px; border-radius: 10px; border: 1px solid #facc15; background: #fef9c3; padding: 10px 12px;">\r
              <p style="margin: 0; color: #713f12; font-size: 13px; font-weight: 700;">\r
                Old pending paid ({{ receiptData.receiptData.pendingMonthText || receiptData.receiptData.monthText }})\r
              </p>\r
              <p style="margin: 4px 0 0 0; color: #854d0e; font-size: 16px; font-weight: 800;">\r
                \u20B9{{ (receiptData.receiptData.pendingPaidAmount || 0).toLocaleString('en-IN') }}\r
              </p>\r
            </div>\r
          }\r
        </div>\r
\r
        <button \r
          class="download-btn" \r
          (click)="downloadReceipt()" \r
          [disabled]="downloading"\r
        >\r
          @if (downloading) {\r
            <div class="loading-spinner"></div>\r
            <span>Downloading...</span>\r
          } @else {\r
            <span class="material-icons-outlined">download</span>\r
            <span>Download Receipt</span>\r
          }\r
        </button>\r
\r
        <p style="color: #94a3b8; margin: 24px 0 0 0; font-size: 12px;">\r
          This receipt link will expire on {{ receiptData.expiresAt.toDate() | date: 'mediumDate' }}\r
        </p>\r
      </div>\r
    }\r
  </div>\r
</div>\r
