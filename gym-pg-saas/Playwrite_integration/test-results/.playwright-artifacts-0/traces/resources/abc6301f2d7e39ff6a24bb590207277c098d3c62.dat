function ptOnCircle(cx, cy, r, deg) {
  const rad = (deg - 90) * Math.PI / 180;
  return { x: cx + r * Math.cos(rad), y: cy + r * Math.sin(rad) };
}
function donutArcPath(cx, cy, outerR, innerR, startDeg, endDeg) {
  const gap = 1.6;
  const s = startDeg + gap, e = endDeg - gap;
  if (e - s <= 0)
    return "";
  const large = e - s > 180 ? 1 : 0;
  const o1 = ptOnCircle(cx, cy, outerR, s), o2 = ptOnCircle(cx, cy, outerR, e);
  const i117 = ptOnCircle(cx, cy, innerR, e), i23 = ptOnCircle(cx, cy, innerR, s);
  return `M${o1.x} ${o1.y} A${outerR} ${outerR} 0 ${large} 1 ${o2.x} ${o2.y} L${i117.x} ${i117.y} A${innerR} ${innerR} 0 ${large} 0 ${i23.x} ${i23.y}Z`;
}
function isSameDay(a, b) {
  return a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();
}
function advanceAttributionDate(m) {
  const a = m.advanceCollectedAt;
  if (a && typeof a.toDate === "function") {
    const d = a.toDate();
    if (d && !Number.isNaN(d.getTime()))
