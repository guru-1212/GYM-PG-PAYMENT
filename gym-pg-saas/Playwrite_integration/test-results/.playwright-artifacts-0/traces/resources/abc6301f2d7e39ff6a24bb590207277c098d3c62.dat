        -->\r
        <div\r
          class="mb-4 flex flex-col gap-2 rounded-2xl border px-4 py-3 shadow-sm sm:flex-row sm:items-center sm:gap-3"\r
          [class.border-amber-300]="banner.tone === 'warn'"\r
          [class.bg-amber-50]="banner.tone === 'warn'"\r
          [class.text-amber-900]="banner.tone === 'warn'"\r
          [class.dark:border-amber-800]="banner.tone === 'warn'"\r
          [class.dark:bg-amber-950]="banner.tone === 'warn'"\r
          [class.dark:text-amber-200]="banner.tone === 'warn'"\r
          [class.border-red-300]="banner.tone === 'danger'"\r
          [class.bg-red-50]="banner.tone === 'danger'"\r
          [class.text-red-900]="banner.tone === 'danger'"\r
          [class.dark:border-red-800]="banner.tone === 'danger'"\r
          [class.dark:bg-red-950]="banner.tone === 'danger'"\r
