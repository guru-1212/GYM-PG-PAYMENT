      <div class="rounded-xl bg-gradient-to-br from-slate-50 to-slate-100 p-6">\r
        <h3 class="mb-4 text-sm font-bold uppercase tracking-wide text-slate-900">Select Month</h3>\r
        <div class="grid grid-cols-3 gap-2">\r
          @for (month of months; track month) {\r
            <button\r
