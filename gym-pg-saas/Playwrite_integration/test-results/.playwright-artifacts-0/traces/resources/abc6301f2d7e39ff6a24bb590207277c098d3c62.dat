        type: Component20,
        args: [{ selector: "app-payments-page", standalone: true, imports: [DatePipe12, DecimalPipe11, NgClass7, PayMemberModalComponent, EditPaymentModalComponent, TranslatePipe], template: `<div class="saas-page mx-auto max-w-6xl space-y-6 px-3 sm:px-4 md:space-y-8">\r
  <header class="space-y-1">\r
    <h1 class="text-xl font-bold text-slate-900 sm:text-2xl">{{ 'payments.title' | t }}</h1>\r
    <p class="text-sm text-slate-600 sm:text-base">{{ 'payments.subtitle' | t }}</p>\r
  </header>\r
\r
  <!-- ========================  COLLECT PAYMENT  ========================\r
       Disabled per client request \u2014 the same Mark-Paid action is now exposed\r
       directly inside the summary cards (Due Today / Overdue / Paid ahead)\r
       below via the green tick-circle icon next to each member.\r
       Re-enable by changing the outer \`@if (false)\` back to \`@if (true)\`.\r
  -->\r
  @if (false) {\r
  @if (canRecordPaymentsAction()) {\r
    <section class="saas-card overflow-hidden">\r
      <!-- Header bar -->\r
      <div class="flex flex-col gap-3 border-b border-slate-100 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4 dark:border-slate-700/70">\r
        <div>\r
          <h2 class="text-base font-semibold text-slate-900 sm:text-lg">Collect payment</h2>\r
          <p class="text-xs text-slate-500 sm:text-sm">\r
            Record a payment for any active member without leaving this page.\r
          </p>\r
        </div>\r
        <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-800 dark:bg-emerald-950/70 dark:text-emerald-200">\r
          <span class="material-icons-outlined text-base">groups</span>\r
          {{ collectCounts().all }} active\r
        </span>\r
      </div>\r
\r
      <!-- Toolbar: search + status pills + page size -->\r
      <div class="space-y-3 border-b border-slate-100 px-4 py-4 dark:border-slate-700/70">\r
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">\r
          <div class="space-y-1 lg:col-span-2">\r
            <label for="collectSearch" class="block text-xs font-semibold uppercase tracking-wide text-slate-500">\r
              Search member\r
            </label>\r
            <div class="relative">\r
              <span class="material-icons-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-base text-slate-400">search</span>\r
              <input\r
                id="collectSearch"\r
                type="text"\r
                placeholder="Name or mobile\u2026"\r
                [value]="collectSearch()"\r
                (input)="onCollectSearchChange($event)"\r
                class="saas-input w-full pl-9 pr-3 py-2 text-sm"\r
              />\r
            </div>\r
          </div>\r
          <div class="space-y-1">\r
            <label for="collectPageSize" class="block text-xs font-semibold uppercase tracking-wide text-slate-500">\r
              Rows per page\r
            </label>\r
            <select\r
              id="collectPageSize"\r
              class="saas-input w-full px-3 py-2 text-sm"\r
              [value]="collectPageSize()"\r
              (change)="onCollectPageSizeChange($event)"\r
            >\r
              <option [value]="10">10</option>\r
              <option [value]="25">25</option>\r
              <option [value]="50">50</option>\r
            </select>\r
          </div>\r
        </div>\r
\r
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">\r
          <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">Status</span>\r
          <div class="flex flex-wrap gap-1.5 rounded-xl bg-slate-100 p-1 dark:bg-slate-800/80">\r
            <button\r
              type="button"\r
              class="rounded-lg px-3 py-1.5 text-xs font-semibold transition-all"\r
              [ngClass]="collectFilter() === 'all'\r
                ? 'bg-white text-indigo-700 shadow-sm dark:bg-slate-900 dark:text-indigo-300'\r
                : 'text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100'"\r
              (click)="setCollectFilter('all')"\r
            >\r
              All\r
              <span class="ml-1 text-slate-400 dark:text-slate-500">\xB7 {{ collectCounts().all }}</span>\r
            </button>\r
            <button\r
              type="button"\r
              class="rounded-lg px-3 py-1.5 text-xs font-semibold transition-all"\r
              [ngClass]="collectFilter() === 'pending'\r
                ? 'bg-white text-amber-700 shadow-sm dark:bg-slate-900 dark:text-amber-300'\r
                : 'text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100'"\r
              (click)="setCollectFilter('pending')"\r
            >\r
              Partial pending\r
              <span class="ml-1 text-slate-400 dark:text-slate-500">\xB7 {{ collectCounts().pending }}</span>\r
            </button>\r
            <button\r
              type="button"\r
              class="rounded-lg px-3 py-1.5 text-xs font-semibold transition-all"\r
              [ngClass]="collectFilter() === 'overdue'\r
                ? 'bg-white text-red-700 shadow-sm dark:bg-slate-900 dark:text-red-300'\r
                : 'text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100'"\r
              (click)="setCollectFilter('overdue')"\r
            >\r
              Overdue\r
              <span class="ml-1 text-slate-400 dark:text-slate-500">\xB7 {{ collectCounts().overdue }}</span>\r
            </button>\r
            <button\r
              type="button"\r
              class="rounded-lg px-3 py-1.5 text-xs font-semibold transition-all"\r
              [ngClass]="collectFilter() === 'dueSoon'\r
                ? 'bg-white text-amber-700 shadow-sm dark:bg-slate-900 dark:text-amber-300'\r
                : 'text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100'"\r
              (click)="setCollectFilter('dueSoon')"\r
            >\r
              Due soon\r
              <span class="ml-1 text-slate-400 dark:text-slate-500">\xB7 {{ collectCounts().dueSoon }}</span>\r
            </button>\r
            <button\r
              type="button"\r
              class="rounded-lg px-3 py-1.5 text-xs font-semibold transition-all"\r
              [ngClass]="collectFilter() === 'paid'\r
                ? 'bg-white text-emerald-700 shadow-sm dark:bg-slate-900 dark:text-emerald-300'\r
                : 'text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100'"\r
              (click)="setCollectFilter('paid')"\r
            >\r
              Paid ahead\r
              <span class="ml-1 text-slate-400 dark:text-slate-500">\xB7 {{ collectCounts().paid }}</span>\r
            </button>\r
          </div>\r
        </div>\r
      </div>\r
\r
      <!-- Desktop / tablet table (>= md) -->\r
      <div class="hidden md:block">\r
        <div class="overflow-x-auto">\r
          <table class="saas-table min-w-full text-left text-sm">\r
            <thead>\r
              <tr>\r
                <th class="px-4 py-3 font-semibold">Member</th>\r
                <th class="px-4 py-3 font-semibold">Mobile</th>\r
                <th class="px-4 py-3 font-semibold">Plan</th>\r
                @if (isPg()) {\r
                  <th class="px-4 py-3 font-semibold">Room</th>\r
                }\r
                <th class="px-4 py-3 font-semibold">{{ dueLabel() }}</th>\r
                <th class="px-4 py-3 font-semibold">Status</th>\r
                <th class="px-4 py-3 text-right font-semibold">Action</th>\r
              </tr>\r
            </thead>\r
            <tbody class="divide-y divide-slate-100 dark:divide-slate-700/60">\r
              @for (m of paginatedCollectMembers(); track m.memberId) {\r
                <tr>\r
                  <td class="px-4 py-3.5">\r
                    <div class="flex items-center gap-3">\r
                      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-semibold uppercase text-indigo-700 dark:bg-indigo-950/70 dark:text-indigo-300">\r
                        {{ (m.firstName || 'M').charAt(0) }}\r
                      </span>\r
                      <div class="min-w-0">\r
                        <p class="truncate font-medium text-slate-900 dark:text-slate-100">\r
                          {{ m.firstName }} {{ m.lastName }}\r
                        </p>\r
                        @if ((m.pendingAmount || 0) > 0) {\r
                          <span class="mt-0.5 inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-900">\r
                            Pending payment\r
                          </span>\r
                        }\r
                      </div>\r
                    </div>\r
                  </td>\r
                  <td class="whitespace-nowrap px-4 py-3.5 text-slate-600">{{ m.mobile || '\u2014' }}</td>\r
                  <td class="whitespace-nowrap px-4 py-3.5 capitalize text-slate-600">\r
                    {{ m.subscriptionType || 'monthly' }}\r
                  </td>\r
                  @if (isPg()) {\r
                    <td class="px-4 py-3.5">\r
                      @if (memberPgRoomLabel(m); as label) {\r
                        @if (label) {\r
                          <span class="rounded bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-700">\r
                            {{ label }}\r
                          </span>\r
                        } @else {\r
                          <span class="text-slate-400">\u2014</span>\r
                        }\r
                      } @else {\r
                        <span class="text-slate-400">\u2014</span>\r
                      }\r
                    </td>\r
                  }\r
                  <td class="whitespace-nowrap px-4 py-3.5 text-slate-800">\r
                    <div class="font-medium">{{ m.dueDate.toDate() | date: 'mediumDate' }}</div>\r
                    <div class="text-xs text-slate-500">{{ dueStatusLabel(m) }}</div>\r
                  </td>\r
                  <td class="whitespace-nowrap px-4 py-3.5">\r
                    @if ((m.pendingAmount || 0) > 0) {\r
                      <span class="text-xs font-semibold text-red-600">\r
                        \u20B9{{ m.pendingAmount | number: '1.0-0' }} pending\r
                      </span>\r
                    } @else if (rowTone(m) === 'red') {\r
                      <span class="status-pill-overdue">OVD</span>\r
                    } @else if (isDueSoon(m)) {\r
                      <span class="status-pill-due-soon whitespace-nowrap">{{ dueStatusLabel(m) }}</span>\r
                    } @else if (rowTone(m) === 'green') {\r
                      <span class="status-pill-paid">PAID</span>\r
                    } @else {\r
                      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">\u2014</span>\r
                    }\r
                  </td>\r
                  <td class="px-4 py-3.5">\r
                    <div class="flex items-center justify-end gap-2">\r
                      @if (rowTone(m) !== 'green' || (m.pendingAmount || 0) > 0) {\r
                        <button\r
                          type="button"\r
                          title="Mark Paid"\r
                          class="inline-flex items-center gap-1.5 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-800 transition-all hover:-translate-y-0.5 hover:shadow-md"\r
                          (click)="openPay(m)"\r
                        >\r
                          <span class="material-icons-outlined text-base">check_circle</span>\r
                          Mark paid\r
                        </button>\r
                      } @else {\r
                        <span class="text-xs text-slate-400">No action</span>\r
                      }\r
                    </div>\r
                  </td>\r
                </tr>\r
              } @empty {\r
                <tr>\r
                  <td [attr.colspan]="isPg() ? 7 : 6" class="px-4 py-12 text-center">\r
                    <span class="material-icons-outlined mx-auto block text-5xl text-slate-300 dark:text-slate-600">groups</span>\r
                    <p class="mt-2 text-sm text-slate-500">No matching members.</p>\r
                  </td>\r
                </tr>\r
              }\r
            </tbody>\r
          </table>\r
        </div>\r
      </div>\r
\r
      <!-- Mobile cards (< md) -->\r
      <ul class="divide-y divide-slate-100 md:hidden dark:divide-slate-700/60">\r
        @for (m of paginatedCollectMembers(); track m.memberId) {\r
          <li class="flex items-start gap-3 px-4 py-3">\r
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-semibold uppercase text-indigo-700 dark:bg-indigo-950/70 dark:text-indigo-300">\r
              {{ (m.firstName || 'M').charAt(0) }}\r
            </span>\r
            <div class="min-w-0 flex-1">\r
              <div class="flex items-start justify-between gap-2">\r
                <div class="min-w-0">\r
                  <p class="truncate font-semibold text-slate-900 dark:text-slate-100">\r
                    {{ m.firstName }} {{ m.lastName }}\r
                  </p>\r
                  <p class="text-xs text-slate-500">\u{1F4DE} {{ m.mobile || '\u2014' }}</p>\r
                  <p class="mt-0.5 text-xs capitalize text-slate-500">\r
                    {{ m.subscriptionType || 'monthly' }}\r
                    @if (isPg() && memberPgRoomLabel(m); as label) {\r
                      @if (label) {\r
                        <span class="ml-1 rounded bg-indigo-50 px-1.5 py-0.5 text-[10px] font-medium text-indigo-700">{{ label }}</span>\r
                      }\r
                    }\r
                  </p>\r
                </div>\r
                <div class="text-right">\r
                  @if ((m.pendingAmount || 0) > 0) {\r
                    <span class="whitespace-nowrap text-xs font-semibold text-red-600">\r
                      \u20B9{{ m.pendingAmount | number: '1.0-0' }}\r
                    </span>\r
                  } @else if (rowTone(m) === 'red') {\r
                    <span class="status-pill-overdue">OVD</span>\r
                  } @else if (isDueSoon(m)) {\r
                    <span class="status-pill-due-soon whitespace-nowrap">{{ dueStatusLabel(m) }}</span>\r
                  } @else if (rowTone(m) === 'green') {\r
                    <span class="status-pill-paid">PAID</span>\r
                  }\r
                </div>\r
              </div>\r
              <div class="mt-1 text-xs text-slate-600">\r
                {{ dueLabel() }}: {{ m.dueDate.toDate() | date: 'mediumDate' }}\r
                <span class="text-slate-400">\xB7</span>\r
                {{ dueStatusLabel(m) }}\r
              </div>\r
              @if (rowTone(m) !== 'green' || (m.pendingAmount || 0) > 0) {\r
                <button\r
                  type="button"\r
                  class="mt-2 inline-flex items-center gap-1.5 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-800 transition-all hover:-translate-y-0.5 hover:shadow-md"\r
                  (click)="openPay(m)"\r
                >\r
                  <span class="material-icons-outlined text-base">check_circle</span>\r
                  Mark paid\r
                </button>\r
              }\r
            </div>\r
          </li>\r
        } @empty {\r
          <li class="px-4 py-12 text-center">\r
            <span class="material-icons-outlined mx-auto block text-5xl text-slate-300 dark:text-slate-600">groups</span>\r
            <p class="mt-2 text-sm text-slate-500">No matching members.</p>\r
          </li>\r
        }\r
      </ul>\r
\r
      <!-- Pagination -->\r
      @if (collectRange(); as range) {\r
        @if (range.total > 0) {\r
          <div class="flex flex-col gap-3 border-t border-slate-100 px-4 py-4 sm:flex-row sm:items-center sm:justify-between dark:border-slate-700/70">\r
            <p class="text-xs text-slate-600 sm:text-sm">\r
              Showing {{ range.from }}\u2013{{ range.to }} of {{ range.total }}\r
            </p>\r
            @if (collectTotalPages() > 1) {\r
              <div class="flex flex-wrap items-center justify-center gap-1 sm:justify-end">\r
                <button\r
                  type="button"\r
                  class="rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 transition-all hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"\r
                  [disabled]="collectPage() === 1"\r
                  (click)="goToCollectPage(collectPage() - 1)"\r
                >\r
                  \u2190 Prev\r
                </button>\r
                <span class="px-3 text-xs font-semibold text-slate-700">\r
                  {{ collectPage() }} / {{ collectTotalPages() }}\r
                </span>\r
                <button\r
                  type="button"\r
                  class="rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 transition-all hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"\r
                  [disabled]="collectPage() === collectTotalPages()"\r
                  (click)="goToCollectPage(collectPage() + 1)"\r
                >\r
                  Next \u2192\r
                </button>\r
              </div>\r
            }\r
          </div>\r
        }\r
      }\r
    </section>\r
  }\r
  }\r
  <!-- ====================  END COLLECT PAYMENT (disabled)  ==================== -->\r
\r
  <!-- ========================  SUMMARY CARDS  ======================== -->\r
  <div class="grid gap-3 sm:gap-4 md:grid-cols-3">\r
    <!-- Due today -->\r
    <section class="saas-card border-amber-200 bg-amber-50/80 p-4">\r
      <div class="flex items-center justify-between gap-3">\r
        <div class="flex items-center gap-2">\r
          <span\r
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-amber-700"\r
          >\r
            <span class="material-icons-outlined text-lg">today</span>\r
          </span>\r
          <h2\r
            class="text-xs font-semibold uppercase tracking-wide text-amber-900 sm:text-sm"\r
          >\r
            {{ 'payments.dueToday' | t }}\r
          </h2>\r
        </div>\r
        <span\r
          class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-bold text-amber-900"\r
        >\r
          {{ dueToday().length }}\r
        </span>\r
      </div>\r
      <ul class="mt-3 space-y-2 text-sm">\r
        @for (m of paginatedDueToday(); track m.memberId) {\r
          <li\r
            class="flex items-center justify-between gap-2 rounded-lg bg-white/70 px-3 py-2 shadow-sm"\r
          >\r
            <span class="truncate font-medium text-slate-900">\r
              {{ m.firstName }} {{ m.lastName }}\r
            </span>\r
            <div class="flex shrink-0 items-center gap-2">\r
              <span class="font-semibold text-amber-800">\r
                \u20B9{{ m.amount | number: '1.0-0' }}\r
              </span>\r
              @if (canRecordPaymentsAction()) {\r
                <button\r
                  type="button"\r
                  title="Mark as paid"\r
                  aria-label="Mark as paid"\r
                  class="flex h-7 w-7 items-center justify-center rounded-full text-emerald-600 transition-colors hover:bg-emerald-100 hover:text-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"\r
                  (click)="openPay(m)"\r
                >\r
                  <span class="material-icons-outlined text-[20px] leading-none">check_circle</span>\r
                </button>\r
              }\r
            </div>\r
          </li>\r
        } @empty {\r
          <li class="rounded-lg bg-white/40 px-3 py-2 text-amber-900/80">\r
            {{ 'payments.none' | t }}\r
          </li>\r
        }\r
      </ul>\r
      @if (dueTodayPages() > 1) {\r
        <div\r
          class="mt-3 flex items-center justify-between border-t border-amber-200 pt-2.5"\r
        >\r
          <button\r
            type="button"\r
            [disabled]="dueTodayPage() === 1"\r
            (click)="setDueTodayPage(dueTodayPage() - 1)"\r
            class="rounded px-2 py-1 text-xs font-medium hover:bg-amber-200 disabled:cursor-not-allowed disabled:opacity-50"\r
          >\r
            \u2190 Prev\r
          </button>\r
          <span class="text-xs font-medium text-amber-900">\r
            {{ dueTodayPage() }} / {{ dueTodayPages() }}\r
          </span>\r
          <button\r
            type="button"\r
            [disabled]="dueTodayPage() === dueTodayPages()"\r
            (click)="setDueTodayPage(dueTodayPage() + 1)"\r
            class="rounded px-2 py-1 text-xs font-medium hover:bg-amber-200 disabled:cursor-not-allowed disabled:opacity-50"\r
          >\r
            Next \u2192\r
          </button>\r
        </div>\r
      }\r
    </section>\r
\r
    <!-- Overdue -->\r
    <section class="saas-card border-red-200 bg-red-50/80 p-4">\r
      <div class="flex items-center justify-between gap-3">\r
        <div class="flex items-center gap-2">\r
          <span\r
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-red-100 text-red-700"\r
          >\r
            <span class="material-icons-outlined text-lg">priority_high</span>\r
          </span>\r
          <h2\r
            class="text-xs font-semibold uppercase tracking-wide text-red-900 sm:text-sm"\r
          >\r
            {{ 'payments.overdue' | t }}\r
          </h2>\r
        </div>\r
        <span\r
          class="rounded-full bg-red-100 px-2.5 py-1 text-xs font-bold text-red-900"\r
        >\r
          {{ overdue().length }}\r
        </span>\r
      </div>\r
      <ul class="mt-3 space-y-2 text-sm">\r
        @for (m of paginatedOverdue(); track m.memberId) {\r
          <li\r
            class="flex items-center justify-between gap-2 rounded-lg bg-white/70 px-3 py-2 shadow-sm"\r
          >\r
            <span class="truncate font-medium text-slate-900">\r
              {{ m.firstName }} {{ m.lastName }}\r
            </span>\r
            <div class="flex shrink-0 items-center gap-2">\r
              <span class="text-xs text-red-800">\r
                {{ m.dueDate.toDate() | date: 'mediumDate' }}\r
              </span>\r
              @if (canRecordPaymentsAction()) {\r
                <button\r
                  type="button"\r
                  title="Mark as paid"\r
                  aria-label="Mark as paid"\r
                  class="flex h-7 w-7 items-center justify-center rounded-full text-emerald-600 transition-colors hover:bg-emerald-100 hover:text-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"\r
                  (click)="openPay(m)"\r
                >\r
                  <span class="material-icons-outlined text-[20px] leading-none">check_circle</span>\r
                </button>\r
              }\r
            </div>\r
          </li>\r
        } @empty {\r
          <li class="rounded-lg bg-white/40 px-3 py-2 text-red-900/80">\r
            {{ 'payments.none' | t }}\r
          </li>\r
        }\r
      </ul>\r
      @if (overduePages() > 1) {\r
        <div\r
          class="mt-3 flex items-center justify-between border-t border-red-200 pt-2.5"\r
        >\r
          <button\r
            type="button"\r
            [disabled]="overduePage() === 1"\r
            (click)="setOverduePage(overduePage() - 1)"\r
            class="rounded px-2 py-1 text-xs font-medium hover:bg-red-200 disabled:cursor-not-allowed disabled:opacity-50"\r
          >\r
            \u2190 Prev\r
          </button>\r
          <span class="text-xs font-medium text-red-900">\r
            {{ overduePage() }} / {{ overduePages() }}\r
          </span>\r
          <button\r
            type="button"\r
            [disabled]="overduePage() === overduePages()"\r
            (click)="setOverduePage(overduePage() + 1)"\r
            class="rounded px-2 py-1 text-xs font-medium hover:bg-red-200 disabled:cursor-not-allowed disabled:opacity-50"\r
          >\r
            Next \u2192\r
          </button>\r
        </div>\r
      }\r
    </section>\r
\r
    <!-- Paid ahead -->\r
    <section class="saas-card border-emerald-200 bg-emerald-50/80 p-4">\r
      <div class="flex items-center justify-between gap-3">\r
        <div class="flex items-center gap-2">\r
          <span\r
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700"\r
          >\r
            <span class="material-icons-outlined text-lg">check_circle</span>\r
          </span>\r
          <h2\r
            class="text-xs font-semibold uppercase tracking-wide text-emerald-900 sm:text-sm"\r
          >\r
            {{ 'payments.paidAhead' | t }}\r
          </h2>\r
        </div>\r
        <span\r
          class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-bold text-emerald-900"\r
        >\r
          {{ paidUp().length }}\r
        </span>\r
      </div>\r
      <p class="mt-1 text-xs text-emerald-800">\r
        {{ 'payments.paidAheadHint' | t: { label: dueLabel() } }}\r
      </p>\r
      <ul class="mt-3 space-y-2 text-sm">\r
        @for (m of paginatedPaidUp(); track m.memberId) {\r
          <li\r
            class="flex items-center justify-between gap-2 rounded-lg bg-white/70 px-3 py-2 shadow-sm"\r
          >\r
            <span class="truncate font-medium text-slate-900">\r
              {{ m.firstName }} {{ m.lastName }}\r
            </span>\r
            <div class="flex shrink-0 items-center gap-2">\r
              <span class="text-xs text-emerald-800">\r
                {{ m.dueDate.toDate() | date: 'mediumDate' }}\r
              </span>\r
              @if (canRecordPaymentsAction()) {\r
                <button\r
                  type="button"\r
                  title="Mark as paid"\r
                  aria-label="Mark as paid"\r
                  class="flex h-7 w-7 items-center justify-center rounded-full text-emerald-700 transition-colors hover:bg-emerald-100 hover:text-emerald-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"\r
                  (click)="openPay(m)"\r
                >\r
                  <span class="material-icons-outlined text-[20px] leading-none">check_circle</span>\r
                </button>\r
              }\r
            </div>\r
          </li>\r
        } @empty {\r
          <li class="rounded-lg bg-white/40 px-3 py-2 text-emerald-900/80">\r
            {{ 'payments.none' | t }}\r
          </li>\r
        }\r
      </ul>\r
      @if (paidUpPages() > 1) {\r
        <div\r
          class="mt-3 flex items-center justify-between border-t border-emerald-200 pt-2.5"\r
        >\r
          <button\r
            type="button"\r
            [disabled]="paidUpPage() === 1"\r
            (click)="setPaidUpPage(paidUpPage() - 1)"\r
            class="rounded px-2 py-1 text-xs font-medium hover:bg-emerald-200 disabled:cursor-not-allowed disabled:opacity-50"\r
          >\r
            \u2190 Prev\r
          </button>\r
          <span class="text-xs font-medium text-emerald-900">\r
            {{ paidUpPage() }} / {{ paidUpPages() }}\r
          </span>\r
          <button\r
            type="button"\r
            [disabled]="paidUpPage() === paidUpPages()"\r
            (click)="setPaidUpPage(paidUpPage() + 1)"\r
            class="rounded px-2 py-1 text-xs font-medium hover:bg-emerald-200 disabled:cursor-not-allowed disabled:opacity-50"\r
          >\r
            Next \u2192\r
          </button>\r
        </div>\r
      }\r
    </section>\r
  </div>\r
\r
  <!-- ========================  ALL PAYMENTS  ======================== -->\r
  <section class="saas-card overflow-hidden">\r
    <!-- Header bar -->\r
    <div\r
      class="flex flex-col gap-3 border-b border-slate-100 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4 dark:border-slate-700/70"\r
    >\r
      <div>\r
        <h2 class="text-base font-semibold text-slate-900 sm:text-lg">\r
          {{ 'payments.allPayments' | t }}\r
        </h2>\r
        <p class="text-xs text-slate-500 sm:text-sm">\r
          {{ 'payments.newestFirst' | t }}\r
        </p>\r
      </div>\r
      <button\r
        type="button"\r
        class="saas-btn-secondary inline-flex w-full items-center justify-center gap-2 px-4 py-2 text-sm sm:w-auto"\r
        (click)="downloadPaymentsPdf()"\r
      >\r
        <span class="material-icons-outlined text-base">download</span>\r
        {{ 'payments.downloadPdf' | t }}\r
      </button>\r
    </div>\r
\r
    <!-- Toolbar: filters -->\r
    <div\r
      class="space-y-3 border-b border-slate-100 px-4 py-4 dark:border-slate-700/70"\r
    >\r
      <!-- Method filter as pills -->\r
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">\r
        <span\r
          class="text-xs font-semibold uppercase tracking-wide text-slate-500"\r
        >\r
          {{ 'payments.filterByMethod' | t }}\r
        </span>\r
        <div\r
          class="flex flex-wrap gap-1.5 rounded-xl bg-slate-100 p-1 dark:bg-slate-800/80"\r
        >\r
          <button\r
            type="button"\r
            class="rounded-lg px-3 py-1.5 text-xs font-semibold transition-all"\r
            [ngClass]="\r
              methodFilter() === ''\r
                ? 'bg-white text-indigo-700 shadow-sm dark:bg-slate-900 dark:text-indigo-300'\r
                : 'text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100'\r
            "\r
            (click)="setMethodFilter('')"\r
          >\r
            {{ 'payments.all' | t }}\r
            <span class="ml-1 text-slate-400 dark:text-slate-500">\r
              \xB7 {{ payments().length }}\r
            </span>\r
          </button>\r
          <button\r
            type="button"\r
            class="rounded-lg px-3 py-1.5 text-xs font-semibold transition-all"\r
            [ngClass]="\r
              methodFilter() === 'cash'\r
                ? 'bg-white text-emerald-700 shadow-sm dark:bg-slate-900 dark:text-emerald-300'\r
                : 'text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100'\r
            "\r
            (click)="setMethodFilter('cash')"\r
          >\r
            {{ 'payments.cash' | t }}\r
            <span class="ml-1 text-slate-400 dark:text-slate-500">\r
              \xB7 {{ paymentMethodCounts().cash }}\r
            </span>\r
          </button>\r
          <button\r
            type="button"\r
            class="rounded-lg px-3 py-1.5 text-xs font-semibold transition-all"\r
            [ngClass]="\r
              methodFilter() === 'upi'\r
                ? 'bg-white text-sky-700 shadow-sm dark:bg-slate-900 dark:text-sky-300'\r
                : 'text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100'\r
            "\r
            (click)="setMethodFilter('upi')"\r
          >\r
            {{ 'payments.upi' | t }}\r
            <span class="ml-1 text-slate-400 dark:text-slate-500">\r
              \xB7 {{ paymentMethodCounts().upi }}\r
            </span>\r
          </button>\r
          <button\r
            type="button"\r
            class="rounded-lg px-3 py-1.5 text-xs font-semibold transition-all"\r
            [ngClass]="\r
              methodFilter() === 'card'\r
                ? 'bg-white text-violet-700 shadow-sm dark:bg-slate-900 dark:text-violet-300'\r
                : 'text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100'\r
            "\r
            (click)="setMethodFilter('card')"\r
          >\r
            {{ 'payments.card' | t }}\r
            <span class="ml-1 text-slate-400 dark:text-slate-500">\r
              \xB7 {{ paymentMethodCounts().card }}\r
            </span>\r
          </button>\r
        </div>\r
      </div>\r
\r
      <!-- Date range + page size -->\r
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">\r
        <div class="space-y-1">\r
          <label\r
            for="fromDate"\r
            class="block text-xs font-semibold uppercase tracking-wide text-slate-500"\r
          >\r
            {{ 'payments.fromDate' | t }}\r
          </label>\r
          <input\r
            id="fromDate"\r
            type="date"\r
            [value]="fromDate()"\r
            (change)="onFromDateChange($event)"\r
            class="saas-input w-full px-3 py-2 text-sm"\r
          />\r
        </div>\r
        <div class="space-y-1">\r
          <label\r
            for="toDate"\r
            class="block text-xs font-semibold uppercase tracking-wide text-slate-500"\r
          >\r
            {{ 'payments.toDate' | t }}\r
          </label>\r
          <input\r
            id="toDate"\r
            type="date"\r
            [value]="toDate()"\r
            (change)="onToDateChange($event)"\r
            class="saas-input w-full px-3 py-2 text-sm"\r
          />\r
        </div>\r
        <div class="space-y-1">\r
          <label\r
            for="paymentsPageSize"\r
            class="block text-xs font-semibold uppercase tracking-wide text-slate-500"\r
          >\r
            {{ 'payments.rowsPerPage' | t }}\r
          </label>\r
          <select\r
            id="paymentsPageSize"\r
            class="saas-input w-full px-3 py-2 text-sm"\r
            [value]="paymentsPageSize()"\r
            (change)="onPaymentsPageSizeChange($event)"\r
          >\r
            <option [value]="10">10</option>\r
            <option [value]="25">25</option>\r
            <option [value]="50">50</option>\r
          </select>\r
        </div>\r
      </div>\r
    </div>\r
\r
    <!-- KPI strip: collected by method -->\r
    <div\r
      class="grid gap-2 border-b border-slate-100 bg-slate-50/60 px-4 py-3 sm:grid-cols-3 dark:border-slate-700/70 dark:bg-slate-800/40"\r
    >\r
      <div\r
        class="flex items-center gap-3 rounded-xl bg-white px-3 py-2.5 shadow-sm dark:bg-slate-900/70"\r
      >\r
        <span\r
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700 dark:bg-emerald-950/70 dark:text-emerald-300"\r
        >\r
          <span class="material-icons-outlined text-lg">payments</span>\r
        </span>\r
        <div class="min-w-0">\r
          <p\r
            class="text-[11px] font-semibold uppercase tracking-wide text-slate-500"\r
          >\r
            {{ 'payments.cashSummary' | t }}\r
          </p>\r
          <p\r
            class="truncate text-base font-bold text-slate-900 dark:text-slate-100"\r
          >\r
            \u20B9{{ paymentMethodSums().cash | number: '1.0-0' }}\r
          </p>\r
        </div>\r
      </div>\r
      <div\r
        class="flex items-center gap-3 rounded-xl bg-white px-3 py-2.5 shadow-sm dark:bg-slate-900/70"\r
      >\r
        <span\r
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-sky-100 text-sky-700 dark:bg-sky-950/70 dark:text-sky-300"\r
        >\r
          <span class="material-icons-outlined text-lg">qr_code_2</span>\r
        </span>\r
        <div class="min-w-0">\r
          <p\r
            class="text-[11px] font-semibold uppercase tracking-wide text-slate-500"\r
          >\r
            {{ 'payments.upiSummary' | t }}\r
          </p>\r
          <p\r
            class="truncate text-base font-bold text-slate-900 dark:text-slate-100"\r
          >\r
            \u20B9{{ paymentMethodSums().upi | number: '1.0-0' }}\r
          </p>\r
        </div>\r
      </div>\r
      <div\r
        class="flex items-center gap-3 rounded-xl bg-white px-3 py-2.5 shadow-sm dark:bg-slate-900/70"\r
      >\r
        <span\r
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-violet-100 text-violet-700 dark:bg-violet-950/70 dark:text-violet-300"\r
        >\r
          <span class="material-icons-outlined text-lg">credit_card</span>\r
        </span>\r
        <div class="min-w-0">\r
          <p\r
            class="text-[11px] font-semibold uppercase tracking-wide text-slate-500"\r
          >\r
            {{ 'payments.cardSummary' | t }}\r
          </p>\r
          <p\r
            class="truncate text-base font-bold text-slate-900 dark:text-slate-100"\r
          >\r
            \u20B9{{ paymentMethodSums().card | number: '1.0-0' }}\r
          </p>\r
        </div>\r
      </div>\r
    </div>\r
\r
    <!-- Desktop / tablet table (>= md) -->\r
    <div class="hidden md:block">\r
      <div class="overflow-x-auto">\r
        <table class="saas-table min-w-full text-left text-sm">\r
          <thead>\r
            <tr>\r
              <th class="px-4 py-3 font-semibold">\r
                {{ 'payments.date' | t }}\r
              </th>\r
              <th class="px-4 py-3 font-semibold">\r
                {{ 'payments.member' | t }}\r
              </th>\r
              <th class="px-4 py-3 text-right font-semibold">\r
                {{ 'payments.amount' | t }}\r
              </th>\r
              <th class="px-4 py-3 font-semibold">\r
                {{ 'payments.method' | t }}\r
              </th>\r
              <th class="hidden px-4 py-3 text-right font-semibold lg:table-cell">\r
                {{ 'payments.pendingAmount' | t }}\r
              </th>\r
              @if (canRecordPaymentsAction()) {\r
                <th class="w-14 px-2 py-3 text-center font-semibold">\r
                  <span class="sr-only">{{ 'common.actions' | t }}</span>\r
                </th>\r
              }\r
            </tr>\r
          </thead>\r
          <tbody class="divide-y divide-slate-100 dark:divide-slate-700/60">\r
            @for (p of paginatedPayments(); track p.paymentId) {\r
              <tr>\r
                <td class="whitespace-nowrap px-4 py-3 text-slate-700 dark:text-slate-200">\r
                  <div class="font-medium">\r
                    {{ p.date.toDate() | date: 'dd MMM yy' }}\r
                  </div>\r
                  <div class="text-xs text-slate-500">\r
                    {{ p.date.toDate() | date: 'EEE' }}\r
                  </div>\r
                </td>\r
                <td class="px-4 py-3">\r
                  <div class="flex items-center gap-3">\r
                    <span\r
                      class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-semibold uppercase text-indigo-700 dark:bg-indigo-950/70 dark:text-indigo-300"\r
                    >\r
                      {{ (nameForPayment(p) || 'M').charAt(0) }}\r
                    </span>\r
                    <span\r
                      class="truncate font-medium text-slate-900 dark:text-slate-100"\r
                    >\r
                      {{ nameForPayment(p) }}\r
                    </span>\r
                  </div>\r
                </td>\r
                <td\r
                  class="whitespace-nowrap px-4 py-3 text-right font-semibold text-slate-900 dark:text-slate-100"\r
                >\r
                  \u20B9{{ p.amount | number: '1.0-0' }}\r
                </td>\r
                <td class="whitespace-nowrap px-4 py-3">\r
                  <span\r
                    class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold"\r
                    [ngClass]="{\r
                      'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:text-emerald-200':\r
                        (p.method || '').toLowerCase() === 'cash',\r
                      'bg-sky-100 text-sky-800 dark:bg-sky-950/70 dark:text-sky-200':\r
                        (p.method || '').toLowerCase() === 'upi',\r
                      'bg-violet-100 text-violet-800 dark:bg-violet-950/70 dark:text-violet-200':\r
                        (p.method || '').toLowerCase() === 'card',\r
                      'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-200':\r
                        (p.method || '').toLowerCase() !== 'cash' &&\r
                        (p.method || '').toLowerCase() !== 'upi' &&\r
                        (p.method || '').toLowerCase() !== 'card',\r
                    }"\r
                  >\r
                    <span class="material-icons-outlined text-[14px]">\r
                      {{\r
                        (p.method || '').toLowerCase() === 'cash'\r
                          ? 'payments'\r
                          : (p.method || '').toLowerCase() === 'upi'\r
                            ? 'qr_code_2'\r
                            : (p.method || '').toLowerCase() === 'card'\r
                              ? 'credit_card'\r
                              : 'circle'\r
                      }}\r
                    </span>\r
                    {{ (p.method || '').toUpperCase() }}\r
                  </span>\r
                </td>\r
                <td\r
                  class="hidden whitespace-nowrap px-4 py-3 text-right lg:table-cell"\r
                >\r
                  @if (p.pendingAmount && p.pendingAmount > 0) {\r
                    <span\r
                      class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-800 dark:bg-amber-950/70 dark:text-amber-200"\r
                    >\r
                      \u20B9{{ p.pendingAmount | number: '1.0-0' }}\r
                    </span>\r
                  } @else {\r
                    <span class="text-slate-400">\u2014</span>\r
                  }\r
                </td>\r
                @if (canRecordPaymentsAction()) {\r
                  <td class="whitespace-nowrap px-2 py-3 text-center">\r
                    <div class="inline-flex items-center justify-center gap-0.5">\r
                      <button\r
                        type="button"\r
                        class="inline-flex rounded-lg p-2 text-slate-500 transition hover:bg-slate-100 hover:text-indigo-600 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-indigo-400"\r
                        [attr.aria-label]="'payments.editRentPayment' | t"\r
                        [attr.title]="'payments.editRentPayment' | t"\r
                        (click)="openEditPaymentRent(p)"\r
                      >\r
                        <span class="material-icons-outlined text-xl">payments</span>\r
                      </button>\r
                      @if (canEditPendingOnPayment(p)) {\r
                        <button\r
                          type="button"\r
                          class="inline-flex rounded-lg p-2 text-amber-700/90 transition hover:bg-amber-50 hover:text-amber-900 dark:text-amber-300 dark:hover:bg-amber-950/50 dark:hover:text-amber-200"\r
                          [attr.aria-label]="'payments.editPendingPayment' | t"\r
                          [attr.title]="'payments.editPendingPayment' | t"\r
                          (click)="openEditPaymentPending(p)"\r
                        >\r
                          <span class="material-icons-outlined text-xl">schedule</span>\r
                        </button>\r
                      }\r
                    </div>\r
                  </td>\r
                }\r
              </tr>\r
            }\r
          </tbody>\r
        </table>\r
      </div>\r
    </div>\r
\r
    <!-- Mobile card list (< md) -->\r
    <ul class="divide-y divide-slate-100 md:hidden dark:divide-slate-700/60">\r
      @for (p of paginatedPayments(); track p.paymentId) {\r
        <li class="flex items-start gap-3 px-4 py-3">\r
          <span\r
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-semibold uppercase text-indigo-700 dark:bg-indigo-950/70 dark:text-indigo-300"\r
          >\r
            {{ (nameForPayment(p) || 'M').charAt(0) }}\r
          </span>\r
          <div class="min-w-0 flex-1">\r
            <div class="flex items-start justify-between gap-2">\r
              <div class="min-w-0">\r
                <p class="truncate font-semibold text-slate-900 dark:text-slate-100">\r
                  {{ nameForPayment(p) }}\r
                </p>\r
                <p class="text-xs text-slate-500">\r
                  {{ p.date.toDate() | date: 'dd MMM yyyy' }}\r
                  \xB7 {{ p.date.toDate() | date: 'EEE' }}\r
                </p>\r
              </div>\r
              <div class="text-right">\r
                <p\r
                  class="whitespace-nowrap text-base font-bold text-slate-900 dark:text-slate-100"\r
                >\r
                  \u20B9{{ p.amount | number: '1.0-0' }}\r
                </p>\r
                @if (p.pendingAmount && p.pendingAmount > 0) {\r
                  <p\r
                    class="mt-0.5 inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold text-amber-800"\r
                  >\r
                    {{ 'payments.pendingAmount' | t }}: \u20B9{{\r
                      p.pendingAmount | number: '1.0-0'\r
                    }}\r
                  </p>\r
                }\r
              </div>\r
            </div>\r
            <div class="mt-1.5 flex flex-wrap items-center justify-between gap-2">\r
              @if (canRecordPaymentsAction()) {\r
                <div class="flex items-center gap-0.5">\r
                  <button\r
                    type="button"\r
                    class="inline-flex rounded-lg p-1.5 text-slate-500 hover:bg-indigo-50 hover:text-indigo-700 dark:text-slate-400 dark:hover:bg-indigo-950/50 dark:hover:text-indigo-300"\r
                    [attr.aria-label]="'payments.editRentPayment' | t"\r
                    [attr.title]="'payments.editRentPayment' | t"\r
                    (click)="openEditPaymentRent(p)"\r
                  >\r
                    <span class="material-icons-outlined text-lg">payments</span>\r
                  </button>\r
                  @if (canEditPendingOnPayment(p)) {\r
                    <button\r
                      type="button"\r
                      class="inline-flex rounded-lg p-1.5 text-amber-800 hover:bg-amber-50 dark:text-amber-300 dark:hover:bg-amber-950/40"\r
                      [attr.aria-label]="'payments.editPendingPayment' | t"\r
                      [attr.title]="'payments.editPendingPayment' | t"\r
                      (click)="openEditPaymentPending(p)"\r
                    >\r
                      <span class="material-icons-outlined text-lg">schedule</span>\r
                    </button>\r
                  }\r
                </div>\r
              } @else {\r
                <span></span>\r
              }\r
              <span\r
                class="inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-[11px] font-semibold"\r
                [ngClass]="{\r
                  'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:text-emerald-200':\r
                    (p.method || '').toLowerCase() === 'cash',\r
                  'bg-sky-100 text-sky-800 dark:bg-sky-950/70 dark:text-sky-200':\r
                    (p.method || '').toLowerCase() === 'upi',\r
                  'bg-violet-100 text-violet-800 dark:bg-violet-950/70 dark:text-violet-200':\r
                    (p.method || '').toLowerCase() === 'card',\r
                  'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-200':\r
                    (p.method || '').toLowerCase() !== 'cash' &&\r
                    (p.method || '').toLowerCase() !== 'upi' &&\r
                    (p.method || '').toLowerCase() !== 'card',\r
                }"\r
              >\r
                <span class="material-icons-outlined text-[12px]">\r
                  {{\r
                    (p.method || '').toLowerCase() === 'cash'\r
                      ? 'payments'\r
                      : (p.method || '').toLowerCase() === 'upi'\r
                        ? 'qr_code_2'\r
                        : (p.method || '').toLowerCase() === 'card'\r
                          ? 'credit_card'\r
                          : 'circle'\r
                  }}\r
                </span>\r
                {{ (p.method || '').toUpperCase() }}\r
              </span>\r
            </div>\r
          </div>\r
        </li>\r
      }\r
    </ul>\r
\r
    @if (filteredPayments().length === 0) {\r
      <div class="px-4 py-12 text-center">\r
        <span\r
          class="material-icons-outlined mx-auto block text-5xl text-slate-300 dark:text-slate-600"\r
        >\r
          receipt_long\r
        </span>\r
        <p class="mt-2 text-sm text-slate-500">\r
          {{ 'payments.noPaymentsYet' | t }}\r
        </p>\r
      </div>\r
    }\r
\r
    <!-- Pagination -->\r
    @if (paymentsTableRange(); as range) {\r
      @if (range.total > 0) {\r
        <div\r
          class="flex flex-col gap-3 border-t border-slate-100 px-4 py-4 sm:flex-row sm:items-center sm:justify-between dark:border-slate-700/70"\r
        >\r
          <p class="text-xs text-slate-600 sm:text-sm">\r
            {{\r
              'payments.showingRange'\r
                | t: { from: range.from, to: range.to, total: range.total }\r
            }}\r
          </p>\r
          @if (paymentsTablePages() > 1) {\r
            <div\r
              class="flex flex-wrap items-center justify-center gap-1 sm:justify-end"\r
            >\r
              <button\r
                type="button"\r
                class="rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 transition-all hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"\r
                [disabled]="paymentsTablePage() === 1"\r
                (click)="goToPaymentsTablePage(1)"\r
              >\r
                {{ 'payments.firstPage' | t }}\r
              </button>\r
              <button\r
                type="button"\r
                class="rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-slate-600 transition-all hover:enabled:border-indigo-200 hover:enabled:bg-indigo-50 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:enabled:border-indigo-700 dark:hover:enabled:bg-indigo-950/50"\r
                [disabled]="!canPrevPaymentsPageGroup()"\r
                (click)="prevPaymentsPageGroup()"\r
                [attr.aria-label]="'payments.prevPages' | t"\r
              >\r
                <span class="material-icons-outlined text-base">chevron_left</span>\r
              </button>\r
              @for (num of visiblePaymentsPageNumbers(); track num) {\r
                <button\r
                  type="button"\r
                  class="min-w-[2.25rem] rounded-md px-3 py-1.5 text-sm font-medium transition-colors"\r
                  [class.bg-indigo-600]="paymentsTablePage() === num"\r
                  [class.text-white]="paymentsTablePage() === num"\r
                  [class.shadow-sm]="paymentsTablePage() === num"\r
                  [class.bg-slate-100]="paymentsTablePage() !== num"\r
                  [class.text-slate-600]="paymentsTablePage() !== num"\r
                  [class.dark:bg-slate-800]="paymentsTablePage() !== num"\r
                  [class.dark:text-slate-200]="paymentsTablePage() !== num"\r
                  (click)="goToPaymentsTablePage(num)"\r
                >\r
                  {{ num }}\r
                </button>\r
              }\r
              <button\r
                type="button"\r
                class="rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-slate-600 transition-all hover:enabled:border-indigo-200 hover:enabled:bg-indigo-50 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:enabled:border-indigo-700 dark:hover:enabled:bg-indigo-950/50"\r
                [disabled]="!canNextPaymentsPageGroup()"\r
                (click)="nextPaymentsPageGroup()"\r
                [attr.aria-label]="'payments.nextPages' | t"\r
              >\r
                <span class="material-icons-outlined text-base">chevron_right</span>\r
              </button>\r
              <button\r
                type="button"\r
                class="rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 transition-all hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"\r
                [disabled]="paymentsTablePage() === paymentsTablePages()"\r
                (click)="goToPaymentsTablePage(paymentsTablePages())"\r
              >\r
                {{ 'payments.lastPage' | t }}\r
              </button>\r
            </div>\r
          }\r
        </div>\r
      }\r
    }\r
  </section>\r
</div>\r
\r
<!-- Shared "Mark as paid" modal \u2014 same UX as the Members table. -->\r
<app-pay-member-modal\r
  [open]="payModalOpen()"\r
  [member]="payTarget()"\r
  [isGym]="isGym()"\r
  [dueLabel]="dueLabel()"\r
  (closed)="closePay()"\r
/>\r
\r
<app-edit-payment-modal\r
  [open]="editPaymentModalOpen()"\r
  [payment]="editPaymentTarget()"\r
  [memberName]="editPaymentTarget() ? nameForPayment(editPaymentTarget()!) : ''"\r
  [editKind]="editPaymentKind()"\r
  (closed)="closeEditPaymentModal()"\r
/>\r
` }]
