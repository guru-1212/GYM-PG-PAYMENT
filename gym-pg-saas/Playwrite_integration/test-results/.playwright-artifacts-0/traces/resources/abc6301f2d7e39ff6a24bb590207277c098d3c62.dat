  <div class="mb-6 flex items-center justify-between border-b border-slate-200 pb-4">\r
    <h2 class="text-xl font-bold text-slate-900">Monthly Earnings Details</h2>\r
    <button\r
      type="button"\r
      (click)="onClose()"\r
      class="rounded-lg p-2 text-slate-500 transition-all duration-200 hover:bg-slate-100 hover:text-slate-700"\r
