  <span class="material-icons-outlined">smart_toy</span>\r
  <span class="launcher-text">Ask to Guru</span>\r
</button>\r
\r
@if (panelOpen()) {\r
  <div class="ask-guru-backdrop" (click)="closeAssistant()">\r
    <section class="ask-guru-shell" (click)="$event.stopPropagation()">\r
      <header class="ask-guru-header">\r
        <div>\r
          <p class="ask-guru-title">Ask to Guru</p>\r
          <p class="ask-guru-subtitle">You are on {{ currentPageTitle() }}. Your smart assistant to guide you.</p>\r
        </div>\r
        <button type="button" class="ask-guru-close" (click)="closeAssistant()" aria-label="Close Ask to Guru">\r
          <span class="material-icons-outlined">close</span>\r
        </button>\r
      </header>\r
\r
      <div #chatViewport class="ask-guru-messages">\r
        @for (msg of messages(); track msg.id) {\r
          <article class="message-row" [class.message-row-user]="msg.sender === 'user'">\r
            <div class="message-bubble" [class.message-bubble-user]="msg.sender === 'user'" [class.message-bubble-highlight]="msg.highlight">\r
              @if (msg.sender === 'assistant' && msg.text.includes('background: white; border: 1px solid #e5e7eb')) {\r
                <div [innerHTML]="msg.text" style="max-width: 100%; overflow-x: auto;"></div>\r
              } @else if (msg.sender === 'assistant' && msg.text.includes('**')) {\r
                <p [innerHTML]="formatOverdueMessage(msg.text)"></p>\r
              } @else {\r
                @for (line of msg.text.split('\\n'); track $index) {\r
                  <p>{{ line }}</p>\r
                }\r
              }\r
            </div>\r
\r
            @if (msg.sender === 'assistant' && msg.suggestions?.length) {\r
              <div class="message-suggestions">\r
                @for (option of msg.suggestions!; track option.id) {\r
                  <button type="button" class="suggestion-chip" (click)="askSuggestion(option)">\r
                    <span>{{ option.label }}</span>\r
                    <span class="material-icons-outlined">arrow_forward</span>\r
                  </button>\r
                }\r
              </div>\r
            }\r
\r
            @if (msg.showStillHelpButton) {\r
              <div class="message-actions">\r
                <button type="button" class="still-help-btn" (click)="showContactOption(msg.id)">Still need help?</button>\r
              </div>\r
            }\r
\r
            @if (msg.showContactAdmin) {\r
              <div class="message-actions">\r
                <button type="button" class="contact-admin-btn" (click)="contactAdminOnWhatsapp()">\r
                  <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>\r
                  Contact Admin via WhatsApp\r
                </button>\r
              </div>\r
            }\r
          </article>\r
        }\r
\r
        @if (isTyping()) {\r
          <article class="message-row">\r
            <div class="message-bubble typing-bubble">\r
              <span></span><span></span><span></span>\r
            </div>\r
          </article>\r
        }\r
      </div>\r
\r
      <footer class="ask-guru-input-wrap">\r
        <div class="ask-guru-input">\r
          <input\r
            type="text"\r
            placeholder="Ask anything..."\r
            [value]="inputText()"\r
            (input)="inputText.set($any($event.target).value)"\r
            (keydown.enter)="sendCurrentQuestion()"\r
          />\r
          <button type="button" (click)="sendCurrentQuestion()" [disabled]="!inputText().trim() || isTyping()">\r
            <span>Send</span>\r
            <span class="material-icons-outlined">arrow_upward</span>\r
          </button>\r
        </div>\r
      </footer>\r
    </section>\r
  </div>\r
}\r
