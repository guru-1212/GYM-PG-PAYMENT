function dayGreetingSegment(now) {
  const h = now.getHours();
  if (h >= 5 && h < 12)
    return "morning";
  if (h >= 12 && h < 17)
    return "afternoon";
  if (h >= 17 && h < 21)
    return "evening";
  return "night";
}
function dayGreetingIcon(segment) {
  switch (segment) {
    case "morning":
      return "wb_sunny";
    case "afternoon":
      return "wb_twilight";
    case "evening":
      return "nights_stay";
    case "night":
      return "bedtime";
    default:
      return "waving_hand";
  }
}
