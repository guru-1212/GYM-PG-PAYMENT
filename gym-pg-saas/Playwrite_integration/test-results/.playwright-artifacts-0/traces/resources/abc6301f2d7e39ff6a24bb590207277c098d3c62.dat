    (() => {
      (typeof ngDevMode === "undefined" || ngDevMode) && i027.\u0275setClassMetadata(MembersComponent, [{
        type: Component18,
        args: [{ selector: "app-members", standalone: true, imports: [
          ReactiveFormsModule5,
          DatePipe10,
          DecimalPipe9,
          ModalComponent,
          EditPaymentModalComponent,
          TranslatePipe
        ], template: `<div class="saas-page mx-auto w-full min-w-0 max-w-6xl">\r
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">\r
    <div>\r
      <h1 class="text-2xl font-bold text-slate-900">{{ pageTitle() }}</h1>\r
      <p class="text-slate-600">{{ pageSubtitle() }}</p>\r
    </div>\r
    @if (listMode() === 'active') {\r
      <div class="flex flex-col gap-2 sm:flex-row">\r
        <button type="button"  class="saas-btn-primary px-4 py-2 text-sm" (click)="openImportModal()">\r
          {{ 'dashboard.importMembers' | t }}\r
        </button>\r
        <!-- <button type="button" class="saas-btn-secondary px-4 py-2 text-sm" (click)="exportToCSV()">\r
          \u{1F4E5} Export CSV\r
        </button> -->\r
        @if (canAddMembersAction()) {\r
          <button type="button" class="saas-btn-primary px-6 py-3 text-base" (click)="openAdd()">\r
            + {{ 'members.addMember' | t }}\r
          </button>\r
        }\r
      </div>\r
    } @else {\r
      <div class="flex flex-col gap-2 sm:flex-row">\r
        <!-- <button type="button" class="saas-btn-secondary px-4 py-2 text-sm" (click)="exportToCSV()">\r
          \u{1F4E5} Export CSV\r
        </button> -->\r
      </div>\r
    }\r
  </div>\r
\r
  @if (onboardingReviewFilter() === 'review') {\r
    <div\r
      class="flex flex-col gap-2 rounded-xl border border-indigo-200 bg-indigo-50/90 px-4 py-3 sm:flex-row sm:items-center sm:justify-between"\r
      role="status"\r
    >\r
      <p class="text-sm text-indigo-900">{{ 'members.onboardingReviewHint' | t }}</p>\r
      <button type="button" class="saas-btn-secondary shrink-0 px-4 py-2 text-sm" (click)="clearOnboardingReviewDeepLink()">\r
        {{ 'members.onboardingReviewShowAll' | t }}\r
      </button>\r
    </div>\r
  }\r
\r
  @if (listMode() === 'active' && pendingJoinIntakes().length > 0) {\r
    <section\r
      class="rounded-2xl border border-emerald-200/90 bg-gradient-to-br from-emerald-50/95 via-white to-teal-50/40 px-4 py-4 shadow-sm dark:border-emerald-900/40 dark:from-emerald-950/30 dark:via-slate-900/80 dark:to-teal-950/20"\r
      aria-label="Pending join requests"\r
    >\r
      <div class="mb-3 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">\r
        <div>\r
          <h2 class="text-sm font-bold uppercase tracking-wide text-emerald-900 dark:text-emerald-200">\r
            {{ 'members.joinIntakeBannerTitle' | t }}\r
          </h2>\r
          <p class="text-xs text-emerald-800/90 dark:text-emerald-300/90">{{ 'members.joinIntakeBannerSubtitle' | t }}</p>\r
        </div>\r
      </div>\r
      <ul class="flex flex-col gap-2">\r
        @for (row of pendingJoinIntakes(); track row.token) {\r
          <li\r
            class="flex flex-col gap-3 rounded-xl border border-emerald-100/90 bg-white/90 px-3 py-3 sm:flex-row sm:items-center sm:justify-between dark:border-emerald-900/50 dark:bg-slate-900/60"\r
          >\r
            <div class="min-w-0">\r
              <p class="truncate text-sm font-semibold text-slate-900 dark:text-slate-50">\r
                {{ row.submissionFirstName }} {{ row.submissionLastName }}\r
              </p>\r
              <p class="text-xs text-slate-600 dark:text-slate-400">{{ row.submissionMobile }}</p>\r
            </div>\r
            <div class="flex shrink-0 flex-wrap gap-2">\r
              <button type="button" class="saas-btn-primary px-3 py-2 text-xs" (click)="openAddFromPendingJoinIntake(row)">\r
                {{ 'members.joinIntakeContinueSetup' | t }}\r
              </button>\r
              <button type="button" class="saas-btn-secondary px-3 py-2 text-xs" (click)="dismissPendingJoinIntake(row)">\r
                {{ 'members.joinIntakeDismiss' | t }}\r
              </button>\r
            </div>\r
          </li>\r
        }\r
      </ul>\r
    </section>\r
  }\r
\r
  <div class="saas-card grid min-w-0 gap-3 p-4 md:grid-cols-2 xl:grid-cols-5 [&>*]:min-w-0">\r
    <div class="min-w-0 md:col-span-2 xl:col-span-2">\r
      <label class="mb-1 block text-xs font-semibold uppercase text-slate-500">{{ 'members.search' | t }}</label>\r
      <input\r
        type="search"\r
        class="saas-input w-full min-w-0 max-w-full"\r
        [placeholder]="'members.searchPlaceholder' | t"\r
        [value]="search()"\r
        (input)="search.set($any($event.target).value)"\r
      />\r
    </div>\r
    <div class="min-w-0">\r
      <label class="mb-1 block text-xs font-semibold uppercase text-slate-500">{{ 'members.memberStatus' | t }}</label>\r
      <select\r
        class="saas-input w-full min-w-0 max-w-full"\r
        [value]="statusFilter()"\r
        (change)="statusFilter.set($any($event.target).value)"\r
      >\r
        <option value="all">{{ 'members.all' | t }}</option>\r
        <option value="active">{{ 'members.active' | t }}</option>\r
        <option value="inactive">{{ 'members.inactive' | t }}</option>\r
      </select>\r
    </div>\r
    <div class="min-w-0">\r
      <label class="mb-1 block text-xs font-semibold uppercase text-slate-500">{{ 'members.payment' | t }}</label>\r
      <select class="saas-input w-full min-w-0 max-w-full" [value]="payFilter()" (change)="onPayFilterChange($any($event.target).value)">\r
        <option value="all">{{ 'members.all' | t }}</option>\r
        <option value="partial">Partial Payment</option>\r
        <option value="overdue">Overdue</option>\r
        <option value="dueSoon">Due Soon</option>\r
        <option value="paid">{{ 'members.paid' | t }}</option>\r
      </select>\r
    </div>\r
    <div class="min-w-0 md:col-span-2 xl:col-span-1 xl:max-w-none">\r
      <label class="mb-1 block text-xs font-semibold uppercase text-slate-500">{{ 'members.sort' | t }}</label>\r
      <div class="flex min-w-0 flex-col gap-2 min-[440px]:flex-row min-[440px]:items-stretch">\r
        <select\r
          class="saas-input min-w-0 w-full max-w-full flex-1"\r
          [value]="sortKey()"\r
          (change)="sortKey.set($any($event.target).value)"\r
        >\r
          <option value="due">{{ 'members.dueUrgent' | t: { label: dueLabel() } }}</option>\r
          <option value="name">{{ 'members.nameSort' | t }}</option>\r
        </select>\r
        <select\r
          class="saas-input min-w-0 w-full max-w-full flex-1 min-[440px]:w-36 min-[440px]:max-w-none min-[440px]:shrink-0 min-[440px]:flex-none"\r
          [value]="sortDir()"\r
          (change)="sortDir.set($any($event.target).value)"\r
        >\r
          <option value="asc">{{ sortKey() === 'due' ? ('members.soonestFirst' | t) : ('members.az' | t) }}</option>\r
          <option value="desc">{{ sortKey() === 'due' ? ('members.latestFirst' | t) : ('members.za' | t) }}</option>\r
        </select>\r
      </div>\r
    </div>\r
  </div>\r
\r
  <div\r
    class="flex flex-col gap-2 rounded-2xl border border-slate-200/90 bg-gradient-to-br from-slate-50/90 via-white to-indigo-50/30 px-4 py-3 shadow-sm dark:border-slate-600/80 dark:from-slate-900/80 dark:via-slate-900/60 dark:to-indigo-950/20 sm:flex-row sm:items-center sm:justify-between"\r
    role="status"\r
    aria-live="polite"\r
  >\r
    <div class="flex min-w-0 items-center gap-3">\r
      <div\r
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-indigo-600 text-lg font-bold tabular-nums text-white shadow-md shadow-indigo-900/25 dark:bg-indigo-500"\r
        aria-hidden="true"\r
      >\r
        {{ displayMembers().length }}\r
      </div>\r
      <div class="min-w-0">\r
        @if (membersFiltersNarrowing()) {\r
          <p class="text-sm font-semibold text-slate-900 dark:text-slate-50">\r
            {{ 'members.listMatchFiltered' | t: { filtered: displayMembers().length, total: membersListBaselineCount() } }}\r
          </p>\r
          <p class="mt-0.5 text-xs text-slate-600 dark:text-slate-400">{{ 'members.listMatchFiltersOn' | t }}</p>\r
        } @else {\r
          <p class="text-sm font-semibold text-slate-900 dark:text-slate-50">\r
            {{ 'members.listMatchCount' | t: { count: displayMembers().length } }}\r
          </p>\r
        }\r
      </div>\r
    </div>\r
    @if (totalPages() > 1) {\r
      <div\r
        class="inline-flex items-center gap-1.5 self-start rounded-full border border-slate-200/90 bg-white/80 px-3 py-1 text-[11px] font-medium text-slate-600 dark:border-slate-600 dark:bg-slate-800/80 dark:text-slate-300 sm:self-auto"\r
      >\r
        <span class="material-icons-outlined text-[14px] text-indigo-600 dark:text-indigo-400">layers</span>\r
        <span class="tabular-nums">{{ currentPage() }} / {{ totalPages() }}</span>\r
        <span class="hidden sm:inline">{{ 'members.pagesShort' | t }}</span>\r
      </div>\r
    }\r
  </div>\r
\r
  @if (displayMembers().length === 0) {\r
    <div class="saas-card p-10 text-center">\r
      <p class="text-slate-600">{{ 'members.noneFound' | t }}</p>\r
      @if (listMode() === 'active') {\r
        @if (canAddMembersAction()) {\r
          <button type="button" class="saas-btn-primary mt-4 px-5 py-2.5 text-sm" (click)="openAdd()">{{ 'members.addMember' | t }}</button>\r
        }\r
      }\r
    </div>\r
  } @else {\r
    <div class="mb-3 hidden items-center justify-end md:flex">\r
      <div class="inline-flex items-center gap-1 rounded-xl border border-slate-200 bg-white p-1 shadow-sm">\r
        <button\r
          type="button"\r
          class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-semibold transition"\r
          [class.bg-indigo-50]="desktopMemberView() === 'card'"\r
          [class.text-indigo-700]="desktopMemberView() === 'card'"\r
          [class.text-slate-600]="desktopMemberView() !== 'card'"\r
          (click)="desktopMemberView.set('card')"\r
        >\r
          <span class="material-icons-outlined text-base">view_agenda</span>\r
          Card View\r
        </button>\r
        <button\r
          type="button"\r
          class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-semibold transition"\r
          [class.bg-indigo-50]="desktopMemberView() === 'table'"\r
          [class.text-indigo-700]="desktopMemberView() === 'table'"\r
          [class.text-slate-600]="desktopMemberView() !== 'table'"\r
          (click)="desktopMemberView.set('table')"\r
        >\r
          <span class="material-icons-outlined text-base">table_rows</span>\r
          Table View\r
        </button>\r
      </div>\r
    </div>\r
\r
    @if (desktopMemberView() === 'table') {\r
      <section class="saas-card hidden overflow-hidden md:block">\r
        <div class="overflow-x-auto">\r
          <table class="saas-table min-w-full text-left text-sm">\r
            <thead>\r
              <tr>\r
                <th class="px-4 py-3">Name</th>\r
                <th class="px-4 py-3">Mobile</th>\r
                <th class="px-4 py-3">Plan</th>\r
                @if (isPg()) {\r
                  <th class="px-4 py-3">Room</th>\r
                }\r
                <th class="px-4 py-3">{{ dueLabel() }}</th>\r
                <th class="px-4 py-3">Time left</th>\r
                <th class="px-4 py-3">Status</th>\r
                <th class="px-4 py-3 text-center">Active</th>\r
                <th class="px-4 py-3 text-right">Actions</th>\r
              </tr>\r
            </thead>\r
            <tbody class="divide-y divide-slate-100">\r
              @for (m of membersPagedList(); track m.memberId; let odd = $odd) {\r
                <tr\r
                  id="member-table-{{ m.memberId }}"\r
                  class="cursor-pointer transition-colors duration-200 hover:bg-indigo-50/70"\r
                  [class.bg-slate-50]="odd"\r
                  (click)="openDetails(m)"\r
                >\r
                  <td class="px-4 py-3.5">\r
                    <div class="flex items-center gap-2">\r
                      @if (m.profilePhotoUrl) {\r
                        <img\r
                          [src]="m.profilePhotoUrl"\r
                          alt="Profile"\r
                          class="h-8 w-8 flex-shrink-0 rounded-full border border-slate-200 object-cover"\r
                        />\r
                      }\r
                      <div>\r
                        <div class="font-medium text-slate-900">{{ m.firstName }} {{ m.lastName }}</div>\r
                        @if (hasPendingSelfOnboardingReview(m)) {\r
                          <div class="mt-0.5">\r
                            <span class="inline-flex items-center rounded-full bg-indigo-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-indigo-800">\r
                              Awaiting your review\r
                            </span>\r
                          </div>\r
                        } @else if (needsSelfOnboarding(m)) {\r
                          <div class="mt-0.5">\r
                            <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-800">\r
                              Profile incomplete\r
                            </span>\r
                          </div>\r
                        }\r
                      </div>\r
                    </div>\r
                    @if (isPartialPaymentPending(m)) {\r
                      <div class="mt-1.5 flex flex-wrap items-center gap-2">\r
                        <span\r
                          class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-amber-900"\r
                          >Pending payment</span\r
                        >\r
                        @if (canRecordPaymentsAction()) {\r
                          <button\r
                            type="button"\r
                            class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-[11px] font-semibold text-amber-800 transition hover:border-amber-300 hover:bg-amber-100"\r
                            (click)="openPayPendingOnly(m); $event.stopPropagation()"\r
                          >\r
                            Collect Due\r
                          </button>\r
                        }\r
                      </div>\r
                    }\r
                  </td>\r
                  <td class="px-4 py-3.5 text-slate-600">{{ m.mobile || '\u2014' }}</td>\r
                  <td class="px-4 py-3.5 capitalize text-slate-600">{{ m.subscriptionType || 'monthly' }}</td>\r
                  @if (isPg()) {\r
                    <td class="px-4 py-3.5 text-slate-600">\r
                      @if (m.roomNumber) {\r
                        <span class="font-medium text-indigo-700 bg-indigo-50 px-2.5 py-1 rounded text-xs">\r
                          {{ memberPgRoomLabel(m) }}\r
                        </span>\r
                      } @else {\r
                        <span class="text-slate-400">\u2014</span>\r
                      }\r
                    </td>\r
                  }\r
                  <td class="px-4 py-3.5 text-slate-800">\r
                    <div class="font-medium">{{ m.dueDate.toDate() | date: 'mediumDate' }}</div>\r
                  </td>\r
                  <td class="max-w-[200px] px-4 py-3.5 text-xs text-slate-700 sm:text-sm">\r
                    {{ dueStatusLabel(m) }}\r
                  </td>\r
                  <td class="px-4 py-3.5">\r
                    @if (isPartialPaymentPending(m) && isDueSoonWithinFiveDays(m)) {\r
                      <div class="flex flex-wrap items-center gap-1.5">\r
                        <span class="status-pill-due-soon whitespace-nowrap">{{ dueSoonWithinFiveDaysPillLabel(m) }}</span>\r
                        <span class="text-xs font-semibold text-red-600">\u20B9{{ (m.pendingAmount || 0) | number: '1.0-0' }} pending</span>\r
                      </div>\r
                    } @else if (isPartialPaymentPending(m)) {\r
                      <span class="text-xs font-semibold text-red-600">\u20B9{{ (m.pendingAmount || 0) | number: '1.0-0' }} pending</span>\r
                    } @else if (rowTone(m) === 'red') {\r
                      <span class="status-pill-overdue">OVD</span>\r
                    } @else if (isDueSoonWithinFiveDays(m)) {\r
                      <span class="status-pill-due-soon whitespace-nowrap">{{ dueSoonWithinFiveDaysPillLabel(m) }}</span>\r
                    } @else if (rowTone(m) === 'green') {\r
                      <span class="status-pill-paid">PAID</span>\r
                    } @else {\r
                      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">\u2014</span>\r
                    }\r
                    @if (isPartialPaymentPending(m)) {\r
                      <div class="mt-1.5 text-[11px] font-medium text-slate-600">\r
                        {{ partialPlanTowardLabel(m) }}\r
                      </div>\r
                    }\r
                  </td>\r
                  <td class="px-4 py-3.5 text-center" (click)="$event.stopPropagation()">\r
                    <label class="inline-flex cursor-pointer items-center">\r
                      <input\r
                        type="checkbox"\r
                        class="h-4 w-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 disabled:cursor-not-allowed disabled:opacity-50"\r
                        [checked]="m.status === 'active'"\r
                        [disabled]="!canEditMembersAction()"\r
                        (change)="onMemberActiveCheckboxChange(m, $event)"\r
                      />\r
                    </label>\r
                  </td>\r
                  <td class="px-4 py-3.5" (click)="$event.stopPropagation()">\r
                    <div class="flex items-center justify-end gap-2">\r
                      @if (m.status === 'active' && rowTone(m) !== 'green' && canRecordPaymentsAction()) {\r
                        <button\r
                          type="button"\r
                          title="Collect Rent"\r
                          class="inline-flex h-9 items-center gap-1.5 rounded-lg border border-emerald-200 bg-emerald-50 px-3 text-xs font-semibold text-emerald-700 transition-all hover:-translate-y-0.5 hover:border-emerald-300 hover:bg-emerald-100 hover:shadow-md"\r
                          (click)="openPay(m)"\r
                        >\r
                          <span class="material-icons-outlined text-base">check_circle</span>\r
                          <span>Collect Rent</span>\r
                        </button>\r
                      }\r
                      @if (rowTone(m) === 'green') {\r
                        <button\r
                          type="button"\r
                          title="Send Receipt"\r
                          class="flex h-9 w-9 items-center justify-center rounded-lg border border-blue-200 bg-blue-50 text-blue-700 transition-all hover:-translate-y-0.5 hover:shadow-md"\r
                          (click)="sendReceipt(m)"\r
                        >\r
                          <span class="material-icons-outlined text-base">receipt</span>\r
                        </button>\r
                      }\r
                      @if (whatsappLink(m); as wa) {\r
                        <a\r
                          [href]="wa"\r
                          target="_blank"\r
                          rel="noopener noreferrer"\r
                          title="Send Reminder"\r
                          class="flex h-9 w-9 items-center justify-center rounded-lg border border-amber-200 bg-amber-50 text-amber-700 transition-all hover:-translate-y-0.5 hover:shadow-md"\r
                        >\r
                          <span class="material-icons-outlined text-base">campaign</span>\r
                        </a>\r
                      }\r
                      @if (needsSelfOnboarding(m) && canShareOnboardingLinkAction()) {\r
                        <div class="flex flex-col items-center gap-0.5">\r
                          <button\r
                            type="button"\r
                            [disabled]="!canShareOnboardingLink(m)"\r
                            [title]="canShareOnboardingLink(m) ? 'Share onboarding link' : 'Add a 10-digit mobile number to share'"\r
                            class="flex h-9 w-9 items-center justify-center rounded-lg border border-purple-200 bg-purple-50 text-purple-700 transition-all hover:-translate-y-0.5 hover:shadow-md disabled:cursor-not-allowed disabled:opacity-40"\r
                            (click)="openShareLink(m)"\r
                          >\r
                            <span class="material-icons-outlined text-base">share</span>\r
                          </button>\r
                          @if ((m.onboardingLinkShareCount || 0) > 0) {\r
                            <span class="absolute -top-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-purple-600 text-[9px] font-semibold text-white">{{ m.onboardingLinkShareCount }}</span>\r
                          }\r
                        </div>\r
                      }\r
                      @if (canEditMembersAction()) {\r
                        <button\r
                          type="button"\r
                          title="Edit Member"\r
                          class="flex h-9 w-9 items-center justify-center rounded-lg border border-indigo-200 bg-indigo-50 text-indigo-700 transition-all hover:-translate-y-0.5 hover:shadow-md"\r
                          (click)="openEdit(m)"\r
                        >\r
                          <span class="material-icons-outlined text-base">edit</span>\r
                        </button>\r
                      }\r
                    </div>\r
                  </td>\r
                </tr>\r
              }\r
            </tbody>\r
          </table>\r
        </div>\r
      </section>\r
    } @else {\r
      <section class="hidden md:block">\r
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 xl:grid-cols-3">\r
          @for (m of membersPagedList(); track m.memberId) {\r
            <article id="member-card-{{ m.memberId }}" class="saas-card cursor-pointer space-y-3 p-4 transition hover:-translate-y-0.5 hover:shadow-md" (click)="openDetails(m)">\r
              <div class="flex items-start justify-between gap-2">\r
                <div class="min-w-0">\r
                  <p class="truncate text-base font-semibold text-slate-900">{{ m.firstName }} {{ m.lastName }}</p>\r
                  @if (isPartialPaymentPending(m)) {\r
                    <div class="mt-1.5 flex flex-wrap items-center gap-2">\r
                      <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-amber-900">\r
                        Pending payment\r
                      </span>\r
                      @if (canRecordPaymentsAction()) {\r
                        <button\r
                          type="button"\r
                          class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-[11px] font-semibold text-amber-800 transition hover:border-amber-300 hover:bg-amber-100"\r
                          (click)="openPayPendingOnly(m); $event.stopPropagation()"\r
                        >\r
                          Collect Due\r
                        </button>\r
                      }\r
                    </div>\r
                  }\r
                </div>\r
                @if (isPartialPaymentPending(m)) {\r
                  <span class="text-xs font-semibold text-red-600">\u20B9{{ (m.pendingAmount || 0) | number: '1.0-0' }} pending</span>\r
                } @else if (rowTone(m) === 'red') {\r
                  <span class="status-pill-overdue">OVD</span>\r
                } @else if (isDueSoonWithinFiveDays(m)) {\r
                  <span class="status-pill-due-soon whitespace-nowrap">{{ dueSoonWithinFiveDaysPillLabel(m) }}</span>\r
                } @else if (rowTone(m) === 'green') {\r
                  <span class="status-pill-paid">PAID</span>\r
                } @else {\r
                  <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">\u2014</span>\r
                }\r
              </div>\r
\r
              <div class="grid grid-cols-2 gap-y-1.5 text-sm">\r
                <p class="text-slate-500">Mobile</p>\r
                <p class="justify-self-end text-slate-700">{{ m.mobile || '\u2014' }}</p>\r
                <p class="text-slate-500">Plan</p>\r
                <p class="justify-self-end capitalize text-slate-700">{{ m.subscriptionType || 'monthly' }}</p>\r
                @if (isPg()) {\r
                  <p class="text-slate-500">Room</p>\r
                  <p class="justify-self-end text-slate-700">{{ memberPgRoomLabel(m) }}</p>\r
                }\r
                <p class="text-slate-500">{{ dueLabel() }}</p>\r
                <p class="justify-self-end text-slate-700">{{ m.dueDate.toDate() | date: 'mediumDate' }}</p>\r
                <p class="text-slate-500">Time left</p>\r
                <p class="justify-self-end text-slate-700">{{ dueStatusLabel(m) }}</p>\r
              </div>\r
\r
              @if (isPartialPaymentPending(m)) {\r
                <p class="text-xs font-medium text-slate-600">{{ partialPlanTowardLabel(m) }}</p>\r
              }\r
\r
              <div class="flex items-center justify-between border-t border-slate-100 pt-2.5" (click)="$event.stopPropagation()">\r
                <label class="inline-flex items-center gap-2 text-xs font-semibold text-slate-600">\r
                  <input\r
                    type="checkbox"\r
                    class="h-4 w-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 disabled:cursor-not-allowed disabled:opacity-50"\r
                    [checked]="m.status === 'active'"\r
                    [disabled]="!canEditMembersAction()"\r
                    (change)="onMemberActiveCheckboxChange(m, $event)"\r
                  />\r
                  Active\r
                </label>\r
                <div class="flex flex-wrap items-center justify-end gap-1.5">\r
                  @if (m.status === 'active' && rowTone(m) !== 'green' && canRecordPaymentsAction()) {\r
                    <button\r
                      type="button"\r
                      class="inline-flex items-center gap-1 rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-1.5 text-[11px] font-semibold text-emerald-700 transition hover:border-emerald-300 hover:bg-emerald-100"\r
                      (click)="openPay(m)"\r
                    >\r
                      <span class="material-icons-outlined text-sm">check_circle</span>\r
                      Collect Rent\r
                    </button>\r
                  }\r
                  @if (rowTone(m) === 'green') {\r
                    <button type="button" class="saas-btn-secondary px-2.5 py-1.5 text-[11px]" (click)="sendReceipt(m)">Receipt</button>\r
                  }\r
                  @if (whatsappLink(m); as wa) {\r
                    <a [href]="wa" target="_blank" rel="noopener noreferrer" class="saas-btn-secondary px-2.5 py-1.5 text-[11px]">Reminder</a>\r
                  }\r
                  @if (needsSelfOnboarding(m) && canShareOnboardingLinkAction()) {\r
                    <button\r
                      type="button"\r
                      class="saas-btn-secondary px-2.5 py-1.5 text-[11px] disabled:cursor-not-allowed disabled:opacity-40"\r
                      [disabled]="!canShareOnboardingLink(m)"\r
                      (click)="openShareLink(m)"\r
                    >\r
                      Share\r
                    </button>\r
                  }\r
                  @if (canEditMembersAction()) {\r
                    <button type="button" class="saas-btn-secondary px-2.5 py-1.5 text-[11px]" (click)="openEdit(m)">Edit</button>\r
                  }\r
                </div>\r
              </div>\r
            </article>\r
          }\r
        </div>\r
      </section>\r
    }\r
\r
    <div class="space-y-3 md:hidden" (click)="closeMobileMenu()">\r
      @for (m of membersPagedList(); track m.memberId) {\r
        <article id="member-mobile-{{ m.memberId }}" class="saas-card animate-[fadeIn_0.35s_ease] cursor-pointer space-y-3 p-4" (click)="openDetails(m)">\r
          <div class="flex items-start justify-between gap-3">\r
            <div class="min-w-0 flex-1">\r
              <p class="text-base font-semibold text-slate-900">{{ m.firstName }} {{ m.lastName }}</p>\r
              @if (isPartialPaymentPending(m)) {\r
                <div class="mt-1.5 flex flex-wrap items-center gap-2">\r
                  <span\r
                    class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-amber-900"\r
                    >Pending payment</span\r
                  >\r
                </div>\r
              }\r
              <p class="mt-1 text-sm text-slate-600">\u{1F4DE} {{ m.mobile || 'Not available' }}</p>\r
            </div>\r
            <div class="flex items-center gap-2">\r
              @if (isPartialPaymentPending(m) && isDueSoonWithinFiveDays(m)) {\r
                <div class="flex flex-shrink-0 flex-wrap items-center justify-end gap-1.5">\r
                  <span class="status-pill-due-soon whitespace-nowrap">{{ dueSoonWithinFiveDaysPillLabel(m) }}</span>\r
                  <span class="text-xs font-semibold text-red-600">\u20B9{{ (m.pendingAmount || 0) | number: '1.0-0' }}</span>\r
                </div>\r
              } @else if (isPartialPaymentPending(m)) {\r
                <span class="flex-shrink-0 text-xs font-semibold text-red-600">\u20B9{{ (m.pendingAmount || 0) | number: '1.0-0' }} pending</span>\r
              } @else if (rowTone(m) === 'red') {\r
                <span class="status-pill-overdue">OVD</span>\r
              } @else if (isDueSoonWithinFiveDays(m)) {\r
                <span class="status-pill-due-soon whitespace-nowrap">{{ dueSoonWithinFiveDaysPillLabel(m) }}</span>\r
              } @else if (rowTone(m) === 'green') {\r
                <span class="status-pill-paid">PAID</span>\r
              } @else {\r
                <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">\u2014</span>\r
              }\r
              <!-- 3-dot menu button -->\r
              <div class="relative">\r
                <button\r
                  type="button"\r
                  class="flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-600 transition hover:bg-slate-100"\r
                  (click)="toggleMobileMenu(m.memberId, $event); $event.stopPropagation()"\r
                  [attr.aria-expanded]="mobileMenuOpen() === m.memberId"\r
                  aria-label="More options"\r
                >\r
                  <span class="material-icons-outlined text-sm">more_vert</span>\r
                </button>\r
                \r
                <!-- Dropdown menu -->\r
                @if (mobileMenuOpen() === m.memberId) {\r
                  <div class="absolute right-0 top-full z-50 mt-1 w-48 rounded-xl border border-slate-200 bg-white py-1 shadow-lg dark:border-slate-700 dark:bg-slate-800">\r
                    @if (isPartialPaymentPending(m)) {\r
                      @if (canRecordPaymentsAction()) {\r
                        <button\r
                          type="button"\r
                          class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-slate-700 transition hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-700"\r
                          (click)="openPayPendingOnly(m); closeMobileMenu(); $event.stopPropagation()"\r
                        >\r
                          <span class="material-icons-outlined text-base text-amber-600">payments</span>\r
                          Collect Due Amount\r
                        </button>\r
                      }\r
                    }                                                                                 \r
                    @if (m.status === 'active' && rowTone(m) !== 'green') {\r
                      @if (canRecordPaymentsAction()) {\r
                        <button\r
                          type="button"\r
                          class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-slate-700 transition hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-700"\r
                          (click)="openPay(m); closeMobileMenu(); $event.stopPropagation()"\r
                        >\r
                          <span class="material-icons-outlined text-base text-emerald-600">check_circle</span>\r
                          Collect Rent\r
                        </button>\r
                      }\r
                    }\r
                    @if (rowTone(m) === 'green') {\r
                      <button\r
                        type="button"\r
                        class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-slate-700 transition hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-700"\r
                        (click)="sendReceipt(m); closeMobileMenu(); $event.stopPropagation()"\r
                      >\r
                        <span class="material-icons-outlined text-base text-blue-600">receipt</span>\r
                        Send Receipt\r
                      </button>\r
                    }\r
                    @if (whatsappLink(m); as wa) {\r
                      <a\r
                        [href]="wa"\r
                        target="_blank"\r
                        rel="noopener noreferrer"\r
                        class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-slate-700 transition hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-700"\r
                        (click)="closeMobileMenu(); $event.stopPropagation()"\r
                      >\r
                        <span class="material-icons-outlined text-base text-amber-600">campaign</span>\r
                        Send Reminder\r
                      </a>\r
                    }\r
                    @if (needsSelfOnboarding(m) && canShareOnboardingLinkAction()) {\r
                      <button\r
                        type="button"\r
                        class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-slate-700 transition hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-700 disabled:cursor-not-allowed disabled:opacity-40"\r
                        [disabled]="!canShareOnboardingLink(m)"\r
                        (click)="openShareLink(m); closeMobileMenu(); $event.stopPropagation()"\r
                      >\r
                        <span class="material-icons-outlined text-base text-purple-600">share</span>\r
                        Profile Update Link\r
                      </button>\r
                    }\r
                    @if (canEditMembersAction()) {\r
                      @if (m.status === 'active') {\r
                        <button\r
                          type="button"\r
                          class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-slate-700 transition hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-700"\r
                          (click)="requestDeactivateMember(m); closeMobileMenu(); $event.stopPropagation()"\r
                        >\r
                          <span class="material-icons-outlined text-base text-rose-600">person_off</span>\r
                          {{ 'members.makeInactive' | t }}\r
                        </button>\r
                      } @else if (m.status === 'inactive') {\r
                        <button\r
                          type="button"\r
                          class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-slate-700 transition hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-700"\r
                          (click)="toggleMemberStatus(m, true); closeMobileMenu(); $event.stopPropagation()"\r
                        >\r
                          <span class="material-icons-outlined text-base text-emerald-600">person</span>\r
                          Make Active\r
                        </button>\r
                      }\r
                      <button\r
                        type="button"\r
                        class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-slate-700 transition hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-700"\r
                        (click)="openEdit(m); closeMobileMenu(); $event.stopPropagation()"\r
                      >\r
                        <span class="material-icons-outlined text-base text-indigo-600">edit</span>\r
                        Edit Member\r
                      </button>\r
                    }\r
                  </div>\r
                }\r
              </div>\r
            </div>\r
          </div>\r
          @if (isPartialPaymentPending(m)) {\r
            <p class="text-xs text-slate-600">{{ partialPlanTowardLabel(m) }}</p>\r
          }\r
          <div class="grid grid-cols-2 gap-2 text-sm">\r
            <p class="text-slate-500">Plan</p>\r
            <p class="justify-self-end capitalize text-slate-700">{{ m.subscriptionType || 'monthly' }}</p>\r
            @if (isPg() && m.roomNumber) {\r
              <p class="text-slate-500">Room</p>\r
              <p class="justify-self-end text-slate-700">{{ memberPgRoomLabel(m) }}</p>\r
            }\r
            <p class="text-slate-500">{{ dueLabel() }}</p>\r
            <p class="justify-self-end text-slate-700">{{ m.dueDate.toDate() | date: 'mediumDate' }}</p>\r
            <p class="text-slate-500">Time left</p>\r
            <p class="justify-self-end text-right text-slate-700">{{ dueStatusLabel(m) }}</p>\r
          </div>\r
        </article>\r
      }\r
    </div>\r
\r
    @if (totalPages() > 1) {\r
      <div class="saas-card mt-6 flex items-center justify-center gap-2 p-4">\r
        <!-- Left Arrow / Prev Group -->\r
        <button\r
          type="button"\r
          (click)="prevPageGroup()"\r
          [disabled]="!canPrevPageGroup()"\r
          class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-slate-600 transition-all disabled:cursor-not-allowed disabled:opacity-50 hover:enabled:border-indigo-200 hover:enabled:bg-indigo-50"\r
        >\r
          <span class="material-icons-outlined text-base">chevron_left</span>\r
        </button>\r
\r
        <!-- Page Numbers -->\r
        <div class="flex flex-wrap gap-1">\r
          @for (pageNum of visiblePageNumbers(); track pageNum) {\r
            <button\r
              type="button"\r
              (click)="goToPage(pageNum)"\r
              [class.bg-indigo-100]="currentPage() === pageNum"\r
              [class.text-indigo-900]="currentPage() === pageNum"\r
              [class.bg-slate-100]="currentPage() !== pageNum"\r
              [class.text-slate-600]="currentPage() !== pageNum"\r
              class="rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-indigo-50"\r
            >\r
              {{ pageNum }}\r
            </button>\r
          }\r
        </div>\r
\r
        <!-- Right Arrow / Next Group -->\r
        <button\r
          type="button"\r
          (click)="nextPageGroup()"\r
          [disabled]="!canNextPageGroup()"\r
          class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-slate-600 transition-all disabled:cursor-not-allowed disabled:opacity-50 hover:enabled:border-indigo-200 hover:enabled:bg-indigo-50"\r
        >\r
          <span class="material-icons-outlined text-base">chevron_right</span>\r
        </button>\r
      </div>\r
    }\r
  }\r
</div>\r
\r
<app-modal [open]="modalOpen()" [wide]="true" [title]="editingId() ? 'Edit member' : 'Add member'" (closed)="closeModal()">\r
  @if (!editingId()) {\r
    @if (joinIntakeFromReview()) {\r
      <div\r
        class="mb-4 rounded-xl border border-indigo-200 bg-indigo-50/80 px-4 py-3 text-sm text-indigo-950 dark:border-indigo-800 dark:bg-indigo-950/40 dark:text-indigo-100"\r
      >\r
        <span class="material-icons-outlined mr-1 align-middle text-base text-indigo-600 dark:text-indigo-300">info</span>\r
        {{ 'members.joinIntakeModalSectionHint' | t }}\r
      </div>\r
    } @else {\r
      <div\r
        class="mb-4 rounded-2xl border border-slate-200/80 bg-gradient-to-br from-slate-50 to-indigo-50/60 p-4 dark:border-slate-600 dark:from-slate-900 dark:to-indigo-950/30"\r
      >\r
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">\r
          <div>\r
            <h3 class="text-sm font-bold text-slate-900 dark:text-slate-50">{{ 'members.joinIntakeModalSectionTitle' | t }}</h3>\r
            <p class="mt-1 max-w-xl text-xs leading-relaxed text-slate-600 dark:text-slate-400">\r
              {{ 'members.joinIntakeModalSectionHint' | t }}\r
            </p>\r
            @if (joinIntakeShareUrl() && joinIntakeCountdownLabel()) {\r
              <p class="mt-2 text-xs font-medium text-indigo-700 dark:text-indigo-300">\r
                {{ 'members.joinIntakeExpiresIn' | t: { time: joinIntakeCountdownLabel() } }}\r
              </p>\r
            }\r
          </div>\r
          @if (joinIntakeBusy()) {\r
            <div class="flex flex-col items-center justify-center gap-2 self-center py-4 sm:px-6">\r
              <div class="h-10 w-10 animate-spin rounded-full border-2 border-indigo-200 border-t-indigo-600"></div>\r
              <span class="text-xs text-slate-600">{{ 'members.joinIntakeQrBusy' | t }}</span>\r
            </div>\r
          } @else if (joinIntakeError()) {\r
            <div class="flex flex-col items-center gap-2 self-center py-2 text-center sm:px-4">\r
              <p class="text-xs text-red-600">{{ 'members.joinIntakeQrError' | t }}</p>\r
              <button type="button" class="saas-btn-secondary px-3 py-1.5 text-xs" (click)="retryBootstrapJoinIntake()">\r
                {{ 'members.joinIntakeRetry' | t }}\r
              </button>\r
            </div>\r
          } @else if (joinIntakeQrDataUrl() && joinIntakeShareUrl()) {\r
            <div class="flex flex-col items-center gap-3 sm:items-end">\r
              <div\r
                class="relative rounded-xl border border-white bg-white p-2 shadow-md dark:border-slate-600 dark:bg-slate-800"\r
                [class.opacity-40]="joinIntakeQrConsumed()"\r
              >\r
                <img [src]="joinIntakeQrDataUrl()" alt="QR code for join link" class="h-44 w-44 object-contain" width="176" height="176" />\r
                @if (joinIntakeQrConsumed()) {\r
                  <div\r
                    class="absolute inset-0 m-2 flex flex-col items-center justify-center gap-2 rounded-lg bg-emerald-950/90 px-3 py-4 text-center text-white shadow-inner"\r
                    role="status"\r
                  >\r
                    <span class="material-icons-outlined text-3xl text-emerald-300">verified</span>\r
                    <p class="text-xs font-semibold leading-snug">{{ 'members.joinIntakeQrUsedOverlayTitle' | t }}</p>\r
                    <p class="text-[11px] leading-snug text-emerald-100/95">{{ 'members.joinIntakeQrUsedOverlayHint' | t }}</p>\r
                  </div>\r
                }\r
              </div>\r
              <div class="flex w-full max-w-xs flex-col gap-2 sm:items-end">\r
                @if (!joinIntakeQrConsumed()) {\r
                  <button type="button" class="saas-btn-secondary w-full px-3 py-2 text-xs sm:w-auto" (click)="copyJoinIntakeLink()">\r
                    @if (joinIntakeCopied()) {\r
                      {{ 'members.joinIntakeCopied' | t }}\r
                    } @else {\r
                      {{ 'members.joinIntakeCopyLink' | t }}\r
                    }\r
                  </button>\r
                  @if (joinIntakeWhatsAppHref()) {\r
                    <a\r
                      class="saas-btn-primary inline-flex w-full items-center justify-center gap-2 px-3 py-2 text-center text-xs sm:w-auto"\r
                      [href]="joinIntakeWhatsAppHref()!"\r
                      target="_blank"\r
                      rel="noopener noreferrer"\r
                    >\r
                      <span class="material-icons-outlined text-base">chat</span>\r
                      {{ 'members.joinIntakeWhatsApp' | t }}\r
                    </a>\r
                  }\r
                }\r
              </div>\r
            </div>\r
          }\r
        </div>\r
        @if (joinIntakeShareUrl() && joinIntakeCountdownLabel() === '0:00' && !joinIntakeBusy() && !joinIntakeError()) {\r
          <p class="mt-3 text-xs font-medium text-amber-800 dark:text-amber-200">{{ 'members.joinIntakeExpired' | t }}</p>\r
        }\r
      </div>\r
    }\r
  }\r
  <form [formGroup]="memberForm" (ngSubmit)="saveMember()" class="space-y-4">\r
    <div>\r
      <label class="mb-1 block text-sm font-medium text-slate-700">First name</label>\r
      <input\r
        formControlName="firstName"\r
        (input)="onNameInput('firstName', $event)"\r
        class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base"\r
      />\r
      @if (memberForm.controls.firstName.touched && memberForm.controls.firstName.invalid) {\r
        @if (memberForm.controls.firstName.errors?.['required']) {\r
          <p class="mt-1 text-sm text-red-600">First name is required</p>\r
        }\r
        @if (memberForm.controls.firstName.errors?.['pattern']) {\r
          <p class="mt-1 text-sm text-red-600">First name cannot contain numbers</p>\r
        }\r
      }\r
    </div>\r
    <div>\r
      <label class="mb-1 block text-sm font-medium text-slate-700">Last name</label>\r
      <input\r
        formControlName="lastName"\r
        (input)="onNameInput('lastName', $event)"\r
        class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base"\r
      />\r
      @if (memberForm.controls.lastName.touched && memberForm.controls.lastName.errors?.['pattern']) {\r
        <p class="mt-1 text-sm text-red-600">Last name cannot contain numbers</p>\r
      }\r
    </div>\r
    <div>\r
      <label class="mb-1 block text-sm font-medium text-slate-700">\r
        Mobile <span class="text-red-500">*</span>\r
      </label>\r
      <input\r
        #memberMobile\r
        type="tel"\r
        formControlName="mobile"\r
        class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base"\r
        inputmode="tel"\r
        autocomplete="tel"\r
        placeholder="98765 43210"\r
        (focus)="onMemberMobileFocus($event)"\r
        (input)="onMemberMobileInput($event)"\r
      />\r
      @if (\r
        memberForm.controls.mobile.touched &&\r
          memberForm.controls.mobile.invalid &&\r
          !memberForm.controls.mobile.hasError('incomplete')\r
      ) {\r
        @if (memberForm.controls.mobile.hasError('required')) {\r
          <p class="mt-1 text-sm text-red-600">Mobile number is required</p>\r
        } @else if (memberForm.controls.mobile.hasError('indianMobileInvalid')) {\r
          <p class="mt-1 text-sm text-red-600">Enter a valid 10-digit Indian mobile number</p>\r
        }\r
      }\r
      <p class="mt-1 text-xs text-slate-500">\r
        Used to verify the member when they open their profile-completion link.\r
      </p>\r
    </div>\r
    <div>\r
      <label class="mb-1 block text-sm font-medium text-slate-700">Email</label>\r
      <input\r
        type="email"\r
        formControlName="email"\r
        class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base"\r
      />\r
    </div>\r
    <div>\r
      <label class="mb-1 block text-sm font-medium text-slate-700">Member Permanent Address</label>\r
      <textarea\r
        formControlName="address"\r
        rows="2"\r
        class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base"\r
      ></textarea>\r
    </div>\r
    <div>\r
      <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2">\r
        <input type="checkbox" formControlName="status" [checked]="memberForm.controls.status.value === 'active'" (change)="memberForm.controls.status.setValue($any($event.target).checked ? 'active' : 'inactive')" class="h-4 w-4" />\r
        <span class="text-sm font-medium text-slate-700">Active member</span>\r
      </label>\r
    </div>\r
      @if (isPg()) {\r
      @if (hasSeatLayout()) {\r
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">\r
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">\r
            <p class="text-sm text-slate-700">Choose bed from your actual seat map.</p>\r
            <button\r
              type="button"\r
              class="rounded-lg border-2 border-emerald-600 bg-emerald-600 px-3 py-2 text-xs font-semibold text-white hover:bg-emerald-700"\r
              [class.seat-assign-highlight]="manualSeatEntryTriggered()"\r
              (click)="openBedPicker()"\r
            >\r
              You can assign bed from here as well\r
            </button>\r
          </div>\r
        </div>\r
      } @else {\r
        <p class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800">\r
          Seat map not setup yet. You can enter floor/room/bed manually.\r
        </p>\r
      }\r
    }\r
    @if (isPg() && hasSeatLayout()) {\r
      <div class="grid gap-4 sm:grid-cols-3">\r
        <div>\r
          <label class="mb-1 block text-sm font-medium text-slate-700">Floor</label>\r
          <select\r
            formControlName="floorNumber"\r
            class="pg-seat-select w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-base"\r
            (change)="onSeatFloorSelectChange()"\r
          >\r
            <option value="">Select floor\u2026</option>\r
            @for (floor of pgFloorsOrdered(); track floor.floorNumber) {\r
              <option\r
                [value]="floor.floorNumber"\r
                [disabled]="isFloorFullyOccupied(floor)"\r
              >\r
                @if (+floor.floorNumber === 0) {\r
                  {{ 'rooms.groundFloor' | t }}\r
                } @else {\r
                  {{ 'rooms.floor' | t }} {{ floor.floorNumber }}\r
                }\r
                @if (isFloorFullyOccupied(floor)) {\r
                  \u2014 full\r
                }\r
              </option>\r
            }\r
          </select>\r
          @if (memberForm.controls.floorNumber.touched && memberForm.controls.floorNumber.invalid) {\r
            @if (memberForm.controls.floorNumber.hasError('required')) {\r
              <p class="mt-1 text-sm text-red-600">Floor is required</p>\r
            } @else if (memberForm.controls.floorNumber.hasError('pattern')) {\r
              <p class="mt-1 text-sm text-red-600">Choose a valid floor</p>\r
            }\r
          }\r
        </div>\r
        <div>\r
          <label class="mb-1 block text-sm font-medium text-slate-700">Room</label>\r
          <select\r
            formControlName="roomNumber"\r
            class="pg-seat-select w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-base"\r
            [disabled]="!memberForm.controls.floorNumber.value"\r
            (change)="onSeatRoomSelectChange()"\r
          >\r
            <option value="">Select room\u2026</option>\r
            @for (room of roomsForSelectedFloor(); track room.roomNumber) {\r
              <option\r
                [value]="room.roomNumber"\r
                [disabled]="isRoomFullyOccupied(seatFloorFormNum()!, room.roomNumber)"\r
              >\r
                Room {{ formatRoomNumber(seatFloorFormNum()!, room.roomNumber) }}\r
                @if (isRoomFullyOccupied(seatFloorFormNum()!, room.roomNumber)) {\r
                  \u2014 full\r
                }\r
              </option>\r
            }\r
          </select>\r
          @if (memberForm.controls.roomNumber.touched && memberForm.controls.roomNumber.invalid) {\r
            @if (memberForm.controls.roomNumber.hasError('required')) {\r
              <p class="mt-1 text-sm text-red-600">Room is required</p>\r
            } @else if (memberForm.controls.roomNumber.hasError('pattern')) {\r
              <p class="mt-1 text-sm text-red-600">Choose a valid room</p>\r
            }\r
          }\r
        </div>\r
        <div>\r
          <label class="mb-1 block text-sm font-medium text-slate-700">Bed</label>\r
          <select\r
            formControlName="bedNumber"\r
            class="pg-seat-select w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-base"\r
            [disabled]="!memberForm.controls.roomNumber.value"\r
            (change)="onSeatBedSelectChange()"\r
          >\r
            <option value="">Select bed\u2026</option>\r
            @for (bedIdx of bedIndicesForSelectedRoom(); track bedIdx) {\r
              <option\r
                [value]="bedIdx"\r
                [disabled]="isBedOccupied(seatFloorFormNum(), seatRoomFormNum(), bedIdx)"\r
              >\r
                Bed {{ bedIdx }}\r
                @if (isBedOccupied(seatFloorFormNum(), seatRoomFormNum(), bedIdx)) {\r
                  \u2014 occupied\r
                }\r
              </option>\r
            }\r
          </select>\r
          @if (memberForm.controls.bedNumber.touched && memberForm.controls.bedNumber.invalid) {\r
            @if (memberForm.controls.bedNumber.hasError('required')) {\r
              <p class="mt-1 text-sm text-red-600">Bed is required</p>\r
            } @else if (memberForm.controls.bedNumber.hasError('pattern')) {\r
              <p class="mt-1 text-sm text-red-600">Choose a valid bed</p>\r
            }\r
          }\r
        </div>\r
      </div>\r
      <p class="text-xs text-slate-500">\r
        Full floors/rooms and occupied beds are listed but cannot be selected (shown in red in the list where supported).\r
      </p>\r
    } @else {\r
      <div class="grid gap-4 sm:grid-cols-3">\r
        <div>\r
          <label class="mb-1 block text-sm font-medium text-slate-700">Floor number</label>\r
          <input\r
            type="text"\r
            inputmode="numeric"\r
            autocomplete="off"\r
            formControlName="floorNumber"\r
            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base"\r
            (input)="onNumericSeatField('floorNumber', $event)"\r
          />\r
          @if (memberForm.controls.floorNumber.touched && memberForm.controls.floorNumber.invalid) {\r
            @if (memberForm.controls.floorNumber.hasError('required')) {\r
              <p class="mt-1 text-sm text-red-600">Floor number is required</p>\r
            } @else if (memberForm.controls.floorNumber.hasError('pattern')) {\r
              <p class="mt-1 text-sm text-red-600">Floor number must contain only digits (0\u20139)</p>\r
            }\r
          }\r
        </div>\r
        <div>\r
          <label class="mb-1 block text-sm font-medium text-slate-700">Room number</label>\r
          <input\r
            type="text"\r
            inputmode="numeric"\r
            autocomplete="off"\r
            formControlName="roomNumber"\r
            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base"\r
            (input)="onNumericSeatField('roomNumber', $event)"\r
          />\r
          @if (memberForm.controls.roomNumber.touched && memberForm.controls.roomNumber.invalid) {\r
            @if (memberForm.controls.roomNumber.hasError('required')) {\r
              <p class="mt-1 text-sm text-red-600">Room number is required</p>\r
            } @else if (memberForm.controls.roomNumber.hasError('pattern')) {\r
              <p class="mt-1 text-sm text-red-600">Room number must contain only digits (0\u20139)</p>\r
            }\r
          }\r
        </div>\r
        <div>\r
          <label class="mb-1 block text-sm font-medium text-slate-700">Bed number</label>\r
          <input\r
            type="text"\r
            inputmode="numeric"\r
            autocomplete="off"\r
            formControlName="bedNumber"\r
            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base"\r
            (input)="onNumericSeatField('bedNumber', $event)"\r
          />\r
          @if (memberForm.controls.bedNumber.touched && memberForm.controls.bedNumber.invalid) {\r
            @if (memberForm.controls.bedNumber.hasError('required')) {\r
              <p class="mt-1 text-sm text-red-600">Bed number is required</p>\r
            } @else if (memberForm.controls.bedNumber.hasError('pattern')) {\r
              <p class="mt-1 text-sm text-red-600">Bed number must contain only digits (0\u20139)</p>\r
            }\r
          }\r
        </div>\r
      </div>\r
    }\r
    @if (manualSeatError()) {\r
      <p class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm font-medium text-red-700">\r
        {{ manualSeatError() }}\r
      </p>\r
    }\r
  \r
    @if (isGym()) {\r
      <div>\r
        <label class="mb-1 block text-sm font-medium text-slate-700">Subscription</label>\r
        <select\r
          formControlName="subscriptionType"\r
          class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base capitalize"\r
        >\r
          <option value="monthly">Monthly</option>\r
          <option value="quarterly">Quarterly (3 months)</option>\r
          <option value="yearly">Yearly (12 months)</option>\r
        </select>\r
        <p class="mt-1 text-xs text-slate-500">Next due after payment moves by this period from the current due date.</p>\r
      </div>\r
    }\r
    @if (!editingId()) {\r
      <div class="grid gap-4 sm:grid-cols-3">\r
        <div>\r
          <label class="mb-1 block text-sm font-medium text-slate-700">Total amount (\u20B9)</label>\r
          <input\r
            type="number"\r
            formControlName="amount"\r
            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base"\r
            min="1"\r
            step="1"\r
          />\r
          @if (memberForm.controls.amount.touched && memberForm.controls.amount.invalid) {\r
            <p class="mt-1 text-sm text-red-600">Enter a positive amount</p>\r
          }\r
        </div>\r
        <div>\r
          <label class="mb-1 block text-sm font-medium text-slate-700">Advance Paid (\u20B9)</label>\r
          <input\r
            type="number"\r
            formControlName="advancePaid"\r
            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base"\r
            min="0"\r
            step="1"\r
          />\r
        </div>\r
        <div>\r
          <label class="mb-1 block text-sm font-medium text-slate-700">Payment Method</label>\r
          <select formControlName="paymentMethod" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base">\r
            <option value="cash">Cash</option>\r
            <option value="upi">UPI</option>\r
            <option value="card">Card</option>\r
          </select>\r
          @if (memberForm.controls.paymentMethod.touched && memberForm.controls.paymentMethod.invalid) {\r
            <p class="mt-1 text-sm text-red-600">Payment method is required</p>\r
          }\r
        </div>\r
      </div>\r
      <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">\r
        <label\r
          class="flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 cursor-pointer"\r
        >\r
          <input type="checkbox" formControlName="isPartialPayment" class="h-4 w-4" />\r
          <span class="text-sm font-medium text-slate-700">Split payment (partial payment done)</span>\r
        </label>\r
\r
        @if (memberForm.controls.isPartialPayment.value) {\r
          <div class="mt-3 grid gap-3 sm:grid-cols-2">\r
            <div>\r
              <label class="mb-1 block text-sm font-medium text-slate-700">Current paying amount (\u20B9)</label>\r
              <input\r
                type="number"\r
                formControlName="paidAmount"\r
                min="1"\r
                class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base"\r
              />\r
              @if (memberForm.controls.paidAmount.touched && memberForm.controls.paidAmount.invalid) {\r
                <p class="mt-1 text-sm text-red-600">Enter a valid current paying amount</p>\r
              }\r
            </div>\r
            <div>\r
              <label class="mb-1 block text-sm font-medium text-slate-700">Pending amount (\u20B9)</label>\r
              <input\r
                type="number"\r
                [value]="memberModalPendingAmountDisplay()"\r
                readonly\r
                class="w-full rounded-xl border border-slate-200 bg-slate-100 px-4 py-3 text-base text-slate-700"\r
              />\r
              <p class="mt-1 text-xs text-slate-500">Pending is auto calculated from total minus current paying.</p>\r
            </div>\r
          </div>\r
        }\r
      </div>\r
    } @else {\r
      <div\r
        class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-sm ring-1 ring-slate-100/80 dark:border-slate-600 dark:bg-slate-900/85 dark:ring-slate-700/60"\r
      >\r
        <div class="flex flex-wrap items-start justify-between gap-3 border-b border-slate-100 pb-4 dark:border-slate-700/80">\r
          <div class="min-w-0">\r
            <div class="flex flex-wrap items-center gap-2">\r
              <h3 class="text-base font-semibold tracking-tight text-slate-900 dark:text-slate-100">Rent & balance</h3>\r
              <span\r
                class="inline-flex shrink-0 items-center rounded-full bg-indigo-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-indigo-800 dark:bg-indigo-900/70 dark:text-indigo-200"\r
                >Profile only</span>\r
            </div>\r
            <p class="mt-1 max-w-prose text-xs leading-relaxed text-slate-500 dark:text-slate-400">\r
              These numbers control what the <strong class="font-medium text-slate-700 dark:text-slate-300">member list</strong> and\r
              <strong class="font-medium text-slate-700 dark:text-slate-300">reminders</strong> show. They are not bank or receipt entries.\r
            </p>\r
          </div>\r
        </div>\r
\r
        <div\r
          class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 rounded-xl border border-slate-200/90 bg-slate-50/95 px-4 py-3.5 dark:border-slate-600 dark:bg-slate-800/55"\r
          role="status"\r
          aria-live="polite"\r
        >\r
          <div class="flex flex-col items-center gap-0.5 sm:items-start">\r
            <span class="text-[10px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Plan</span>\r
            <span class="tabular-nums text-base font-semibold text-slate-900 dark:text-slate-50">\u20B9{{ memberEditBillingSummary().plan | number: '1.0-0' }}</span>\r
          </div>\r
          <span class="text-base font-light text-slate-400 dark:text-slate-500" aria-hidden="true">\u2212</span>\r
          <div class="flex flex-col items-center gap-0.5 sm:items-start">\r
            <span class="text-[10px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Paid rent</span>\r
            <span class="tabular-nums text-base font-semibold text-slate-900 dark:text-slate-50">\u20B9{{ memberEditBillingSummary().paid | number: '1.0-0' }}</span>\r
          </div>\r
          <span class="text-base font-light text-slate-400 dark:text-slate-500" aria-hidden="true">=</span>\r
          <div\r
            class="flex flex-col items-center gap-0.5 rounded-lg bg-amber-50 px-3 py-1.5 sm:items-start dark:bg-amber-950/45 dark:ring-1 dark:ring-amber-900/30"\r
          >\r
            <span class="text-[10px] font-semibold uppercase tracking-wide text-amber-800 dark:text-amber-200/90">Still due</span>\r
            <span class="tabular-nums text-base font-bold text-amber-950 dark:text-amber-100">\u20B9{{ memberEditBillingSummary().pending | number: '1.0-0' }}</span>\r
          </div>\r
        </div>\r
\r
        <ul class="mt-3 space-y-2 text-xs leading-snug text-slate-600 dark:text-slate-400">\r
          <li class="flex gap-2.5">\r
            <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-indigo-400" aria-hidden="true"></span>\r
            <span>\r
              <strong class="font-medium text-slate-800 dark:text-slate-200">Plan / total rent</strong> \u2014 fee for this billing cycle on the\r
              profile.\r
            </span>\r
          </li>\r
          <li class="flex gap-2.5">\r
            <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-indigo-400" aria-hidden="true"></span>\r
            <span>\r
              <strong class="font-medium text-slate-800 dark:text-slate-200">Paid rent</strong> \u2014 amount treated as already settled toward\r
              that plan (cannot exceed plan).\r
            </span>\r
          </li>\r
          <li class="flex gap-2.5">\r
            <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-indigo-400" aria-hidden="true"></span>\r
            <span>\r
              <strong class="font-medium text-slate-800 dark:text-slate-200">Advance held</strong> \u2014 security deposit; separate from rent due\r
              above.\r
            </span>\r
          </li>\r
        </ul>\r
\r
        <div\r
          class="mt-4 flex gap-3 rounded-xl border border-amber-200/90 bg-amber-50/90 px-3.5 py-3 dark:border-amber-900/40 dark:bg-amber-950/35"\r
        >\r
          <span class="material-icons-outlined shrink-0 text-lg leading-none text-amber-700 dark:text-amber-400/90">receipt_long</span>\r
          <p class="text-xs leading-relaxed text-amber-950/95 dark:text-amber-100/85">\r
            To correct <strong class="font-semibold">actual payment history</strong>, open the\r
            <strong class="font-semibold">Payments</strong> page. This section does not add or change receipt rows.\r
          </p>\r
        </div>\r
\r
        <div class="mt-5 grid grid-cols-2 gap-x-3 gap-y-4 sm:gap-x-4 sm:gap-y-5">\r
          <div>\r
            <label class="mb-1.5 block text-sm font-medium text-slate-800 dark:text-slate-200">Plan / total rent (\u20B9)</label>\r
            <input\r
              type="number"\r
              formControlName="amount"\r
              class="saas-input w-full dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-indigo-500 dark:focus:ring-indigo-950/50"\r
              min="1"\r
              step="1"\r
            />\r
            @if (memberForm.controls.amount.touched && memberForm.controls.amount.invalid) {\r
              <p class="mt-1 text-sm text-red-600">Enter a positive amount</p>\r
            }\r
          </div>\r
          <div>\r
            <label class="mb-1.5 block text-sm font-medium text-slate-800 dark:text-slate-200">Paid rent (\u20B9)</label>\r
            <input\r
              type="number"\r
              formControlName="paidRent"\r
              class="saas-input w-full dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-indigo-500 dark:focus:ring-indigo-950/50"\r
              min="0"\r
              step="1"\r
            />\r
            @if (memberForm.controls.paidRent.touched && memberForm.controls.paidRent.invalid) {\r
              <p class="mt-1 text-sm text-red-600">Cannot be negative</p>\r
            }\r
            <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">Counted toward the plan total</p>\r
          </div>\r
          <div>\r
            <label class="mb-1.5 block text-sm font-medium text-slate-800 dark:text-slate-200">Advance held (\u20B9)</label>\r
            <input\r
              type="number"\r
              formControlName="advancePaid"\r
              class="saas-input w-full dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100 dark:focus:border-indigo-500 dark:focus:ring-indigo-950/50"\r
              min="0"\r
              step="1"\r
            />\r
            <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">Deposit \u2014 not part of \u201Cstill due\u201D</p>\r
          </div>\r
          <div>\r
            <div class="mb-1.5 flex flex-wrap items-center gap-2">\r
              <label class="block text-sm font-medium text-slate-800 dark:text-slate-200">Still due (\u20B9)</label>\r
              <span\r
                class="inline-flex items-center rounded-md bg-slate-200/90 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-slate-600 dark:bg-slate-700 dark:text-slate-300"\r
                >Auto</span>\r
            </div>\r
            <input\r
              type="number"\r
              formControlName="pendingAmount"\r
              readonly\r
              class="w-full cursor-not-allowed rounded-xl border border-slate-200 bg-slate-100/95 px-4 py-3 text-base tabular-nums text-slate-800 ring-0 dark:border-slate-600 dark:bg-slate-800/90 dark:text-slate-100"\r
              tabindex="-1"\r
              aria-readonly="true"\r
            />\r
            <p class="mt-1 text-[11px] font-medium text-slate-600 dark:text-slate-400">Plan minus paid rent</p>\r
          </div>\r
        </div>\r
      </div>\r
    }\r
    <div class="grid gap-4 sm:grid-cols-2">\r
      <div>\r
        <label class="mb-1 block text-sm font-medium text-slate-700">Join date</label>\r
        <input\r
          type="date"\r
          formControlName="joinDate"\r
          autocomplete="off"\r
          class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-base"\r
          (change)="onMemberJoinDatePickerChange()"\r
        />\r
        @if (memberJoinDateDdMmHint()) {\r
          <p class="mt-1 text-xs text-slate-500">DD/MM/YYYY: {{ memberJoinDateDdMmHint() }}</p>\r
        }\r
        @if (daysFromJoinDateDisplay() !== null) {\r
          <p class="mt-1 text-xs font-medium text-slate-600">Date adjustment: {{ daysFromJoinDateDisplay() }} days</p>\r
        }\r
        @if (memberForm.controls.joinDate.touched && memberForm.controls.joinDate.invalid) {\r
          @if (memberForm.controls.joinDate.hasError('required')) {\r
            <p class="mt-1 text-sm text-red-600">Join date is required</p>\r
          }\r
          @if (memberForm.controls.joinDate.hasError('pattern') || memberForm.controls.joinDate.hasError('joinDateInvalid')) {\r
            <p class="mt-1 text-sm text-red-600">Choose a valid join date</p>\r
          }\r
          @if (memberForm.controls.joinDate.hasError('joinDateInPast')) {\r
            <p class="mt-1 text-sm text-red-600">Join date cannot be before today</p>\r
          }\r
        }\r
      </div>\r
      <div>\r
        <label class="mb-1 block text-sm font-medium text-slate-700">End date</label>\r
        <input\r
          type="date"\r
          formControlName="dueDate"\r
          autocomplete="off"\r
          class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-base"\r
          [attr.min]="memberDueDateInputMinIso()"\r
          (change)="onMemberDueDatePickerChange()"\r
        />\r
        @if (memberDueDateDdMmHint()) {\r
          <p class="mt-1 text-xs text-slate-500">DD/MM/YYYY: {{ memberDueDateDdMmHint() }}</p>\r
        }\r
        @if (daysUntilDueDateDisplay() !== null) {\r
          <p class="mt-1 text-xs font-medium {{ daysUntilDueDateDisplay()! < 0 ? 'text-red-600' : 'text-slate-600' }}">Date adjustment:{{ daysUntilDueDateDisplay()! < 0 ? '-' : '' }}{{ daysUntilDueDateDisplay()! < 0 ? -daysUntilDueDateDisplay()! : daysUntilDueDateDisplay()! }} days</p>\r
        }\r
        @if (memberForm.controls.dueDate.touched && memberForm.controls.dueDate.invalid) {\r
          @if (memberForm.controls.dueDate.errors?.['required']) {\r
            <p class="mt-1 text-sm text-red-600">End date is required</p>\r
          }\r
          @if (memberForm.controls.dueDate.errors?.['pattern']) {\r
            <p class="mt-1 text-sm text-red-600">Choose a valid end date</p>\r
          }\r
          @if (memberForm.controls.dueDate.errors?.['dueDateBeforeJoinDate']) {\r
            <p class="mt-1 text-sm text-red-600">End date cannot be before join date</p>\r
          }\r
        }\r
      </div>\r
    </div>\r
    <details class="rounded-xl border border-slate-200 bg-slate-50" [open]="moreOpen()" (toggle)="moreOpen.set($any($event.target).open)">\r
      <summary class="cursor-pointer px-4 py-3 text-sm font-semibold text-slate-800">More details (optional)</summary>\r
      <div class="space-y-4 border-t border-slate-200 bg-white px-4 py-4">\r
        <p class="rounded-lg border border-indigo-100 bg-indigo-50 px-3 py-2 text-xs text-indigo-800">\r
          These fields are optional. Skip any of them and the member can fill them in\r
          themselves later via a share link from the members list.\r
        </p>\r
        <div>\r
          <label class="mb-1 block text-sm font-medium text-slate-700">Gender</label>\r
          <select formControlName="gender" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base">\r
            <option value="">\u2014</option>\r
            <option value="male">Male</option>\r
            <option value="female">Female</option>\r
            <option value="other">Other</option>\r
          </select>\r
        </div>\r
        <div>\r
          <label class="mb-1 block text-sm font-medium text-slate-700">Aadhaar number</label>\r
          <input\r
            formControlName="aadhaarLast4"\r
            maxlength="12"\r
            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base"\r
            inputmode="numeric"\r
            (input)="onAadhaarDigitsInput($event)"\r
          />\r
          @if (memberForm.controls.aadhaarLast4.touched && memberForm.controls.aadhaarLast4.invalid) {\r
            @if (memberForm.controls.aadhaarLast4.hasError('digitsOnly')) {\r
              <p class="mt-1 text-sm text-red-600">Aadhaar must be numbers only (no spaces or symbols)</p>\r
            } @else if (memberForm.controls.aadhaarLast4.hasError('digitsLen')) {\r
              <p class="mt-1 text-sm text-red-600">Enter the full 12-digit Aadhaar or leave blank</p>\r
            }\r
          }\r
        </div>\r
\r
        @if (!editingId()) {\r
          <div class="grid gap-3 sm:grid-cols-3">\r
            <div>\r
              <label class="mb-1 block text-sm font-medium text-slate-700">Profile photo</label>\r
              @if (profilePhotoPreview()) {\r
                <div class="relative mb-2 h-28 w-28 overflow-hidden rounded-xl border border-slate-200 bg-slate-100">\r
                  <img [src]="profilePhotoPreview()" alt="Profile preview" class="h-full w-full object-cover" />\r
                  <button\r
                    type="button"\r
                    class="absolute right-1 top-1 rounded-full bg-white/90 p-1 text-red-600 shadow"\r
                    (click)="removeMemberPhoto('profile')"\r
                    aria-label="Remove profile photo"\r
                  >\r
                    <span class="material-icons-outlined text-base">delete</span>\r
                  </button>\r
                </div>\r
              }\r
              <input\r
                type="file"\r
                accept="image/jpeg,image/png,image/webp"\r
                class="block w-full text-xs text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-indigo-700 hover:file:bg-indigo-100"\r
                (change)="onMemberPhotoSelected('profile', $event)"\r
              />\r
            </div>\r
            <div>\r
              <label class="mb-1 block text-sm font-medium text-slate-700">Aadhaar \u2013 Front</label>\r
              @if (aadhaarFrontPreview()) {\r
                <div class="relative mb-2 h-28 w-full overflow-hidden rounded-xl border border-slate-200 bg-slate-100">\r
                  <img [src]="aadhaarFrontPreview()" alt="Aadhaar front preview" class="h-full w-full object-cover" />\r
                  <button\r
                    type="button"\r
                    class="absolute right-1 top-1 rounded-full bg-white/90 p-1 text-red-600 shadow"\r
                    (click)="removeMemberPhoto('aadhaarFront')"\r
                    aria-label="Remove Aadhaar front"\r
                  >\r
                    <span class="material-icons-outlined text-base">delete</span>\r
                  </button>\r
                </div>\r
              }\r
              <input\r
                type="file"\r
                accept="image/jpeg,image/png,image/webp"\r
                class="block w-full text-xs text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-indigo-700 hover:file:bg-indigo-100"\r
                (change)="onMemberPhotoSelected('aadhaarFront', $event)"\r
              />\r
            </div>\r
            <div>\r
              <label class="mb-1 block text-sm font-medium text-slate-700">Aadhaar \u2013 Back</label>\r
              @if (aadhaarBackPreview()) {\r
                <div class="relative mb-2 h-28 w-full overflow-hidden rounded-xl border border-slate-200 bg-slate-100">\r
                  <img [src]="aadhaarBackPreview()" alt="Aadhaar back preview" class="h-full w-full object-cover" />\r
                  <button\r
                    type="button"\r
                    class="absolute right-1 top-1 rounded-full bg-white/90 p-1 text-red-600 shadow"\r
                    (click)="removeMemberPhoto('aadhaarBack')"\r
                    aria-label="Remove Aadhaar back"\r
                  >\r
                    <span class="material-icons-outlined text-base">delete</span>\r
                  </button>\r
                </div>\r
              }\r
              <input\r
                type="file"\r
                accept="image/jpeg,image/png,image/webp"\r
                class="block w-full text-xs text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-indigo-700 hover:file:bg-indigo-100"\r
                (change)="onMemberPhotoSelected('aadhaarBack', $event)"\r
              />\r
            </div>\r
          </div>\r
        }\r
\r
        <div>\r
          <label class="mb-1 block text-sm font-medium text-slate-700">Notes</label>\r
          <textarea\r
            formControlName="notes"\r
            rows="2"\r
            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base"\r
          ></textarea>\r
        </div>\r
      </div>\r
    </details>\r
\r
    <div class="flex flex-col-reverse gap-2 pt-2 sm:flex-row sm:justify-end">\r
      <button\r
        type="button"\r
        class="rounded-xl border border-slate-200 px-5 py-3 font-semibold disabled:cursor-not-allowed disabled:opacity-50"\r
        [disabled]="memberSavingBusy()"\r
        (click)="closeModal()"\r
      >\r
        Cancel\r
      </button>\r
      <button\r
        type="submit"\r
        [disabled]="memberSavingBusy()"\r
        [class.opacity-50]="memberSavingBusy()"\r
        [class.cursor-not-allowed]="memberSavingBusy()"\r
        class="rounded-xl bg-emerald-600 px-6 py-3 font-semibold text-white hover:bg-emerald-700 disabled:bg-slate-400"\r
      >\r
        @if (memberSavingBusy()) {\r
          Saving\u2026\r
        } @else {\r
          Save\r
        }\r
      </button>\r
    </div>\r
  </form>\r
</app-modal>\r
\r
<app-modal [open]="detailsModalOpen()" title="Member Details" (closed)="closeDetails()">\r
  @if (detailsMember(); as m) {\r
    <div class="space-y-4">\r
      <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-slate-50 p-3">\r
        @if (m.profilePhotoUrl) {\r
          <img\r
            [src]="m.profilePhotoUrl"\r
            alt="Profile photo"\r
            class="h-16 w-16 flex-shrink-0 rounded-full border border-slate-200 object-cover"\r
          />\r
        }\r
        <div class="min-w-0 flex-1">\r
          <p class="text-base font-semibold text-slate-900">{{ m.firstName }} {{ m.lastName }}</p>\r
          <p class="mt-1 text-xs text-slate-500">ID: {{ m.memberId }}</p>\r
          @if (hasPendingSelfOnboardingReview(m)) {\r
            <span class="mt-2 inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-indigo-900">\r
              Awaiting your review\r
            </span>\r
          } @else if (needsSelfOnboarding(m)) {\r
            <span class="mt-2 inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-amber-900">\r
              Profile incomplete\r
            </span>\r
          } @else if (m.selfOnboardingStatus === 'completed') {\r
            <span class="mt-2 inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-emerald-900">\r
              Profile complete\r
            </span>\r
          }\r
        </div>\r
      </div>\r
\r
      @if (m.pendingSelfOnboarding; as pend) {\r
        <div class="rounded-xl border border-indigo-200 bg-indigo-50/80 p-4 space-y-3">\r
          <div class="flex flex-wrap items-center justify-between gap-2">\r
            <p class="text-sm font-semibold text-indigo-950">Review submitted profile</p>\r
            @if (pend.submittedAt; as st) {\r
              <p class="text-xs text-indigo-800">Submitted {{ st.toDate() | date: 'medium' }}</p>\r
            }\r
          </div>\r
          <p class="text-xs text-indigo-900">\r
            These details and photos are not saved to the member profile until you approve them.\r
          </p>\r
          <div class="grid gap-3 sm:grid-cols-3">\r
            <div>\r
              <p class="mb-1 text-[11px] font-semibold uppercase tracking-wide text-slate-600">Profile</p>\r
              <a [href]="pend.profilePhotoUrl" target="_blank" rel="noopener noreferrer" class="block">\r
                <img [src]="pend.profilePhotoUrl" alt="Submitted profile" class="h-28 w-full rounded-lg border border-slate-200 object-cover" />\r
              </a>\r
            </div>\r
            <div>\r
              <p class="mb-1 text-[11px] font-semibold uppercase tracking-wide text-slate-600">Aadhaar front</p>\r
              <a [href]="pend.aadhaarFrontUrl" target="_blank" rel="noopener noreferrer" class="block">\r
                <img [src]="pend.aadhaarFrontUrl" alt="Aadhaar front" class="h-28 w-full rounded-lg border border-slate-200 object-cover" />\r
              </a>\r
            </div>\r
            <div>\r
              <p class="mb-1 text-[11px] font-semibold uppercase tracking-wide text-slate-600">Aadhaar back</p>\r
              <a [href]="pend.aadhaarBackUrl" target="_blank" rel="noopener noreferrer" class="block">\r
                <img [src]="pend.aadhaarBackUrl" alt="Aadhaar back" class="h-28 w-full rounded-lg border border-slate-200 object-cover" />\r
              </a>\r
            </div>\r
          </div>\r
          <div class="grid gap-2 text-sm sm:grid-cols-2">\r
            <p><span class="text-slate-500">Email:</span> <span class="font-medium text-slate-900">{{ pend.email || '\u2014' }}</span></p>\r
            <p><span class="text-slate-500">Last name:</span> <span class="font-medium text-slate-900">{{ pend.lastName || '\u2014' }}</span></p>\r
            <p><span class="text-slate-500">Gender:</span> <span class="font-medium capitalize text-slate-900">{{ pend.gender || '\u2014' }}</span></p>\r
            <p><span class="text-slate-500">Aadhaar:</span> <span class="font-medium text-slate-900">{{ pend.aadhaarNumber || '\u2014' }}</span></p>\r
            <p class="sm:col-span-2"><span class="text-slate-500">Address:</span> <span class="font-medium text-slate-900">{{ pend.address || '\u2014' }}</span></p>\r
          </div>\r
          @if (canEditMembersAction()) {\r
            <div class="flex flex-wrap gap-2 pt-1">\r
              <button\r
                type="button"\r
                class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700 disabled:opacity-50"\r
                [disabled]="onboardingReviewBusyId() === m.memberId"\r
                (click)="approvePendingOnboarding(m)"\r
              >\r
                Approve & save to profile\r
              </button>\r
              <button\r
                type="button"\r
                class="rounded-lg border border-red-200 bg-white px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50 disabled:opacity-50"\r
                [disabled]="onboardingReviewBusyId() === m.memberId"\r
                (click)="rejectPendingOnboarding(m)"\r
              >\r
                Reject submission\r
              </button>\r
            </div>\r
          }\r
        </div>\r
      }\r
\r
      <div class="grid gap-2 sm:grid-cols-2">\r
        <div class="rounded-lg border border-slate-200 p-3">\r
          <p class="text-xs text-slate-500">Mobile</p>\r
          @if (dialLink(m); as dial) {\r
            <a [href]="dial" class="text-sm font-semibold text-indigo-700 underline">{{ m.mobile || 'N/A' }}</a>\r
          } @else {\r
            <p class="text-sm font-semibold text-slate-800">{{ m.mobile || 'N/A' }}</p>\r
          }\r
        </div>\r
        <div class="rounded-lg border border-slate-200 p-3">\r
          <p class="text-xs text-slate-500">Email</p>\r
          <p class="text-sm font-semibold text-slate-800 break-all">{{ m.email || 'N/A' }}</p>\r
        </div>\r
        <div class="rounded-lg border border-slate-200 p-3">\r
          <p class="text-xs text-slate-500">Status</p>\r
          <p class="text-sm font-semibold capitalize text-slate-800">{{ m.status }}</p>\r
        </div>\r
        <div class="rounded-lg border border-slate-200 p-3">\r
          <p class="text-xs text-slate-500">Plan</p>\r
          <p class="text-sm font-semibold capitalize text-slate-800">{{ m.subscriptionType || 'monthly' }}</p>\r
        </div>\r
        <div class="rounded-lg border border-slate-200 p-3">\r
          <p class="text-xs text-slate-500">Total Amount</p>\r
          <p class="text-sm font-semibold text-slate-800">\u20B9{{ m.amount | number: '1.0-0' }}</p>\r
        </div>\r
        <div class="rounded-lg border border-slate-200 p-3">\r
          <p class="text-xs text-slate-500">Pending Amount</p>\r
          <p class="text-sm font-semibold text-amber-700">\u20B9{{ (m.pendingAmount || 0) | number: '1.0-0' }}</p>\r
        </div>\r
        <div class="rounded-lg border border-slate-200 p-3">\r
          <p class="text-xs text-slate-500">Advance Paid</p>\r
          <p class="text-sm font-semibold text-slate-800">\u20B9{{ (m.advancePaid || 0) | number: '1.0-0' }}</p>\r
          <p class="mt-1 text-[11px] font-medium capitalize text-slate-500">Status: {{ m.advanceStatus || 'held' }}</p>\r
        </div>\r
        <div class="rounded-lg border border-slate-200 p-3">\r
          <p class="text-xs text-slate-500">Join Date</p>\r
          <p class="text-sm font-semibold text-slate-800">{{ m.joinDate.toDate() | date: 'mediumDate' }}</p>\r
        </div>\r
        <div class="rounded-lg border border-slate-200 p-3">\r
          <p class="text-xs text-slate-500">End Date</p>\r
          <p class="text-sm font-semibold text-slate-800">{{ m.dueDate.toDate() | date: 'mediumDate' }}</p>\r
        </div>\r
        <div class="rounded-lg border border-slate-200 p-3">\r
          <p class="text-xs text-slate-500">Room \xB7 Bed</p>\r
          <p class="text-sm font-semibold text-slate-800">\r
            {{ memberPgRoomLabel(m) }} \xB7 {{ m.bedNumber || '\u2014' }}\r
          </p>\r
        </div>\r
        <div class="rounded-lg border border-slate-200 p-3 sm:col-span-2">\r
          <p class="text-xs text-slate-500">Address</p>\r
          <p class="text-sm font-semibold text-slate-800">{{ m.address || 'N/A' }}</p>\r
        </div>\r
        <div class="rounded-lg border border-slate-200 p-3">\r
          <p class="text-xs text-slate-500">Gender</p>\r
          <p class="text-sm font-semibold capitalize text-slate-800">{{ m.gender || 'N/A' }}</p>\r
        </div>\r
        <div class="rounded-lg border border-slate-200 p-3">\r
          <p class="text-xs text-slate-500">Aadhaar</p>\r
          <p class="text-sm font-semibold text-slate-800">{{ m.aadhaarNumber || m.aadhaarLast4 || 'N/A' }}</p>\r
        </div>\r
        <div class="rounded-lg border border-slate-200 p-3 sm:col-span-2">\r
          <p class="text-xs text-slate-500">Notes</p>\r
          <p class="text-sm font-semibold text-slate-800">{{ m.notes || 'N/A' }}</p>\r
        </div>\r
      </div>\r
\r
      @if (m.aadhaarFrontUrl || m.aadhaarBackUrl) {\r
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">\r
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">\r
            Aadhaar card images\r
          </p>\r
          <div class="grid gap-2 sm:grid-cols-2">\r
            @if (m.aadhaarFrontUrl) {\r
              <a [href]="m.aadhaarFrontUrl" target="_blank" rel="noopener noreferrer" class="block">\r
                <img\r
                  [src]="m.aadhaarFrontUrl"\r
                  alt="Aadhaar front"\r
                  class="h-40 w-full rounded-lg border border-slate-200 bg-white object-cover hover:opacity-90"\r
                />\r
                <p class="mt-1 text-[11px] text-slate-500">Front</p>\r
              </a>\r
            }\r
            @if (m.aadhaarBackUrl) {\r
              <a [href]="m.aadhaarBackUrl" target="_blank" rel="noopener noreferrer" class="block">\r
                <img\r
                  [src]="m.aadhaarBackUrl"\r
                  alt="Aadhaar back"\r
                  class="h-40 w-full rounded-lg border border-slate-200 bg-white object-cover hover:opacity-90"\r
                />\r
                <p class="mt-1 text-[11px] text-slate-500">Back</p>\r
              </a>\r
            }\r
          </div>\r
        </div>\r
      }\r
\r
      @if (canSendWhatsAppReminder(m)) {\r
        <div class="rounded-xl border border-emerald-200 bg-emerald-50/60 p-3">\r
          <p class="mb-2 text-sm font-semibold text-emerald-800">WhatsApp Reminder</p>\r
          <textarea\r
            rows="3"\r
            class="w-full rounded-lg border border-emerald-200 bg-white px-3 py-2 text-sm"\r
            [value]="detailsMessageDraft()"\r
            (input)="detailsMessageDraft.set($any($event.target).value)"\r
          ></textarea>\r
          <div class="mt-2 flex justify-end">\r
            <button\r
              type="button"\r
              class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700"\r
              (click)="sendWhatsAppFromDetails(m)"\r
            >\r
              Send WhatsApp\r
            </button>\r
          </div>\r
        </div>\r
      }\r
    </div>\r
  }\r
</app-modal>\r
\r
<app-modal [open]="bedPickerOpen()" title="Assign Bed" (closed)="closeBedPicker()">\r
  @if (!hasSeatLayout()) {\r
    <p class="text-sm text-slate-600">Setup required</p>\r
  } @else {\r
    <div class="space-y-3">\r
      @for (floor of (pgLayout()?.floors || []); track floor.floorNumber) {\r
        <section\r
          class="rounded-xl border p-3"\r
          [class.border-slate-200]="!isFloorFullyOccupied(floor)"\r
          [class.border-red-300]="isFloorFullyOccupied(floor)"\r
          [class.bg-rose-50]="isFloorFullyOccupied(floor)"\r
        >\r
          <p\r
            class="text-sm font-semibold"\r
            [class.text-slate-900]="!isFloorFullyOccupied(floor)"\r
            [class.text-red-800]="isFloorFullyOccupied(floor)"\r
          >\r
            @if (+floor.floorNumber === 0) {\r
              {{ 'rooms.groundFloor' | t }}\r
            } @else {\r
              {{ 'rooms.floor' | t }} {{ floor.floorNumber }}\r
            }\r
            @if (isFloorFullyOccupied(floor)) {\r
              <span class="ml-1 text-xs font-normal text-red-700">(full)</span>\r
            }\r
          </p>\r
          @if (floor.rooms.length === 0) {\r
            <p class="mt-3 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-600">\r
              No rooms are available in this floor.\r
            </p>\r
          } @else {\r
            <div class="mt-3 grid gap-3 sm:grid-cols-2">\r
              @for (room of floor.rooms; track room.roomNumber) {\r
                <div\r
                  class="rounded-lg border p-3"\r
                  [class.border-slate-200]="!isRoomFullyOccupied(floor.floorNumber, room.roomNumber)"\r
                  [class.bg-slate-50]="!isRoomFullyOccupied(floor.floorNumber, room.roomNumber)"\r
                  [class.border-red-300]="isRoomFullyOccupied(floor.floorNumber, room.roomNumber)"\r
                  [class.bg-red-50]="isRoomFullyOccupied(floor.floorNumber, room.roomNumber)"\r
                >\r
                  <p\r
                    class="text-xs font-semibold uppercase tracking-wide"\r
                    [class.text-slate-600]="!isRoomFullyOccupied(floor.floorNumber, room.roomNumber)"\r
                    [class.text-red-800]="isRoomFullyOccupied(floor.floorNumber, room.roomNumber)"\r
                  >\r
                    Room {{ formatRoomNumber(floor.floorNumber, room.roomNumber) }}\r
                    @if (isRoomFullyOccupied(floor.floorNumber, room.roomNumber)) {\r
                      <span class="ml-1 font-normal normal-case text-red-700">(full)</span>\r
                    }\r
                  </p>\r
                  <p class="mt-1 text-xs text-slate-600">{{ sharingLabel(room.beds) }} \xB7 {{ roomRentText(room.rent) }}</p>\r
                  <div class="mt-2 grid grid-cols-3 gap-2">\r
                    @for (_ of [].constructor(room.beds); track $index; let bedIdx = $index) {\r
                      <button\r
                        type="button"\r
                        class="seat-block flex h-9 items-center justify-center rounded-md border text-xs font-semibold"\r
                        [disabled]="isBedOccupied(floor.floorNumber, room.roomNumber, bedIdx + 1)"\r
                        [class.border-red-200]="isBedOccupied(floor.floorNumber, room.roomNumber, bedIdx + 1)"\r
                        [class.bg-red-100]="isBedOccupied(floor.floorNumber, room.roomNumber, bedIdx + 1)"\r
                        [class.text-red-800]="isBedOccupied(floor.floorNumber, room.roomNumber, bedIdx + 1)"\r
                        [class.cursor-not-allowed]="isBedOccupied(floor.floorNumber, room.roomNumber, bedIdx + 1)"\r
                        [class.border-emerald-200]="!isBedOccupied(floor.floorNumber, room.roomNumber, bedIdx + 1)"\r
                        [class.bg-emerald-50]="!isBedOccupied(floor.floorNumber, room.roomNumber, bedIdx + 1)"\r
                        [class.text-emerald-800]="!isBedOccupied(floor.floorNumber, room.roomNumber, bedIdx + 1)"\r
                        (click)="selectBed(floor.floorNumber, room.roomNumber, bedIdx + 1)"\r
                      >\r
                        <span class="flex items-center gap-1.5">\r
                          <span\r
                            class="material-icons-outlined text-base leading-none drop-shadow-sm"\r
                            [class.text-red-700]="isBedOccupied(floor.floorNumber, room.roomNumber, bedIdx + 1)"\r
                            [class.text-emerald-600]="!isBedOccupied(floor.floorNumber, room.roomNumber, bedIdx + 1)"\r
                          >\r
                            single_bed\r
                          </span>\r
                          <span class="text-[11px] font-bold tabular-nums">{{ bedIdx + 1 }}</span>\r
                        </span>\r
                      </button>\r
                    }\r
                  </div>\r
                </div>\r
              }\r
            </div>\r
          }\r
        </section>\r
      }\r
    </div>\r
  }\r
</app-modal>\r
\r
<app-modal [open]="payModalOpen()" [closable]="!paymentSubmitting()" [title]="payEntryMode() === 'pendingOnly' ? 'Collect Due' : 'Collect Rent'" (closed)="closePay()">\r
  @if (payTarget(); as m) {\r
    <form [formGroup]="payForm" (ngSubmit)="submitPay()" class="space-y-4">\r
      <p class="text-sm text-slate-600">\r
        Recording payment for <span class="font-semibold text-slate-900">{{ m.firstName }} {{ m.lastName }}</span>\r
      </p>\r
      <p class="rounded-xl bg-slate-50 px-3 py-2 text-xs text-slate-600">\r
        @if (getPayTargetDueDate(); as dueDate) {\r
          @if ((m.pendingAmount || 0) > 0 && !payForm.controls.isPartialPayment.value) {\r
            @if (payEntryMode() === 'pendingOnly') {\r
              Pending-only mode: this action records only the current outstanding balance\r
              <span class="font-semibold text-slate-900">\u20B9{{ payTargetPendingAmount() | number: '1.0-0' }}</span>.\r
            } @else {\r
              This action collects <span class="font-semibold">rent amount + pending balance</span> together.\r
              Adjust rent amount if needed.\r
            }\r
          } @else if (payForm.controls.isPartialPayment.value) {\r
            You are recording a split payment. Enter how much will remain owed after this payment.\r
          } @else {\r
            Next {{ dueLabel() }} will be one billing period after the current due date ({{\r
              dueDate | date: 'mediumDate'\r
            }}), not from today.\r
          }\r
        } @else {\r
          <span class="text-red-600">Error: Invalid due date. Please refresh and try again.</span>\r
        }\r
      </p>\r
      <div>\r
        <label class="mb-1 block text-sm font-medium text-slate-700">\r
          {{ payEntryMode() === 'pendingOnly' ? 'Pending amount to collect (\u20B9)' : 'Rent amount (\u20B9)' }}\r
        </label>\r
        <input\r
          type="number"\r
          formControlName="amount"\r
          class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base"\r
          [class.bg-slate-100]="payEntryMode() === 'pendingOnly'"\r
          [class.text-slate-700]="payEntryMode() === 'pendingOnly'"\r
          [readonly]="payEntryMode() === 'pendingOnly'"\r
          min="1"\r
        />\r
        @if (payEntryMode() !== 'pendingOnly') {\r
          <p class="mt-1 text-xs text-slate-500">Prefilled from member rent. You can edit manually before confirming.</p>\r
        }\r
      </div>\r
      @if (!payForm.controls.isPartialPayment.value && payEntryMode() !== 'pendingOnly' && payTargetPendingAmount() > 0) {\r
        <div>\r
          <label class="mb-1 block text-sm font-medium text-slate-700">Pending amount (\u20B9)</label>\r
          <input\r
            type="number"\r
            [value]="payTargetPendingAmount()"\r
            class="w-full rounded-xl border border-slate-200 bg-slate-100 px-4 py-3 text-base text-slate-700"\r
            readonly\r
          />\r
        </div>\r
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-900">\r
          Total amount to collect now:\r
          <span class="font-semibold">\u20B9{{ payModeTotalAmount() | number: '1.0-0' }}</span>\r
        </div>\r
      }\r
      <div>\r
        <label class="mb-1 block text-sm font-medium text-slate-700">Method</label>\r
        <select formControlName="method" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base">\r
          <option value="cash">Cash</option>\r
          <option value="upi">UPI</option>\r
          <option value="card">Card</option>\r
        </select>\r
        @if (payForm.controls.method.touched && payForm.controls.method.invalid) {\r
          <p class="mt-1 text-sm text-red-600">Payment method is required</p>\r
        }\r
      </div>\r
      @if (isGym()) {\r
        <div>\r
          <label class="mb-1 block text-sm font-medium text-slate-700">Plan for this payment</label>\r
          <select formControlName="subscriptionType" class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base capitalize">\r
            <option value="monthly">Monthly</option>\r
            <option value="quarterly">Quarterly (3 months)</option>\r
            <option value="yearly">Yearly (12 months)</option>\r
          </select>\r
          @if (payForm.controls.subscriptionType.touched && payForm.controls.subscriptionType.invalid) {\r
            <p class="mt-1 text-sm text-red-600">Subscription type is required</p>\r
          }\r
        </div>\r
      }\r
      <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 px-3 py-2">\r
        <input type="checkbox" formControlName="isPartialPayment" class="h-4 w-4" />\r
        <span class="text-sm font-medium text-slate-700">Partial payment done</span>\r
      </label>\r
      @if (payForm.controls.isPartialPayment.value) {\r
        <div>\r
          <label class="mb-1 block text-sm font-medium text-slate-700">Current paying amount (\u20B9)</label>\r
          <input\r
            type="number"\r
            formControlName="currentPayingAmount"\r
            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-base"\r
            min="1"\r
            [max]="payCurrentAllowedMax()"\r
          />\r
          @if (payForm.controls.currentPayingAmount.touched && payForm.controls.currentPayingAmount.invalid) {\r
            <p class="mt-1 text-sm text-red-600">Enter a valid current paying amount</p>\r
          }\r
        </div>\r
        <div>\r
          <label class="mb-1 block text-sm font-medium text-slate-700">Pending amount (\u20B9)</label>\r
          <input\r
            type="number"\r
            [value]="pendingFromPayForm()"\r
            readonly\r
            class="w-full rounded-xl border border-slate-200 bg-slate-100 px-4 py-3 text-base text-slate-700"\r
          />\r
          <p class="mt-1 text-xs text-slate-500">Pending is auto calculated from total rent - current paying.</p>\r
        </div>\r
        @if (showMoveDueOnPartialOption()) {\r
          <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-indigo-200 bg-indigo-50 px-3 py-2">\r
            <input type="checkbox" formControlName="moveDueToNextCycle" class="h-4 w-4" />\r
            <span class="text-sm font-medium text-indigo-800">Move due date to next cycle even with pending</span>\r
          </label>\r
        }\r
      }\r
      <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">\r
        <button\r
          type="button"\r
          [disabled]="paymentSubmitting()"\r
          class="rounded-xl border border-slate-200 px-5 py-3 font-semibold disabled:cursor-not-allowed disabled:opacity-50"\r
          (click)="closePay()"\r
        >\r
          Cancel\r
        </button>\r
        <button\r
          type="submit"\r
          [disabled]="payForm.invalid || paymentSubmitting()"\r
          [class.opacity-50]="payForm.invalid && !paymentSubmitting()"\r
          [class.cursor-not-allowed]="payForm.invalid || paymentSubmitting()"\r
          class="inline-flex min-w-[10rem] items-center justify-center gap-2 rounded-xl bg-emerald-600 px-6 py-3 font-semibold text-white transition hover:bg-emerald-700 disabled:bg-emerald-600/80"\r
        >\r
          @if (paymentSubmitting()) {\r
            <svg\r
              class="h-4 w-4 animate-spin text-white"\r
              xmlns="http://www.w3.org/2000/svg"\r
              fill="none"\r
              viewBox="0 0 24 24"\r
              aria-hidden="true"\r
            >\r
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>\r
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>\r
            </svg>\r
            <span>Recording\u2026</span>\r
          } @else {\r
            {{\r
              payForm.controls.isPartialPayment.value\r
                ? 'Save Partial Payment'\r
                : (payEntryMode() === 'pendingOnly' ? 'Collect Due' : 'Collect Rent')\r
            }}\r
          }\r
        </button>\r
      </div>\r
    </form>\r
  }\r
</app-modal>\r
\r
<app-modal [open]="historyModalOpen()" title="Payment history" (closed)="closeHistory()">\r
  @if (historyMember(); as hm) {\r
    <p class="mb-3 text-sm text-slate-600">{{ hm.firstName }} {{ hm.lastName }}</p>\r
    @if (historyPayments().length === 0) {\r
      <p class="text-sm text-slate-500">No payments yet.</p>\r
    } @else {\r
      <ul class="max-h-72 space-y-2 overflow-y-auto">\r
        @for (p of historyPayments(); track p.paymentId) {\r
          <li\r
            class="flex items-center justify-between gap-2 rounded-xl border border-slate-100 bg-slate-50 px-3 py-2 text-sm"\r
          >\r
            <div class="min-w-0 flex-1">\r
              <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">\r
                <span>{{ p.date.toDate() | date: 'mediumDate' }}</span>\r
                <span class="font-semibold tabular-nums">\u20B9{{ p.amount | number: '1.0-0' }}</span>\r
                <span class="uppercase text-slate-500">{{ p.method }}</span>\r
              </div>\r
            </div>\r
            @if (canRecordPaymentsAction()) {\r
              <div class="flex shrink-0 items-center gap-0.5">\r
                <button\r
                  type="button"\r
                  class="rounded-lg p-1.5 text-slate-500 hover:bg-white hover:text-indigo-600 dark:hover:bg-slate-800 dark:hover:text-indigo-400"\r
                  [attr.aria-label]="'payments.editRentPayment' | t"\r
                  [attr.title]="'payments.editRentPayment' | t"\r
                  (click)="openHistoryEditPaymentRent(p)"\r
                >\r
                  <span class="material-icons-outlined text-lg">payments</span>\r
                </button>\r
                @if (canEditPendingOnPayment(p)) {\r
                  <button\r
                    type="button"\r
                    class="rounded-lg p-1.5 text-amber-800 hover:bg-white hover:text-amber-900 dark:text-amber-300 dark:hover:bg-slate-800 dark:hover:text-amber-200"\r
                    [attr.aria-label]="'payments.editPendingPayment' | t"\r
                    [attr.title]="'payments.editPendingPayment' | t"\r
                    (click)="openHistoryEditPaymentPending(p)"\r
                  >\r
                    <span class="material-icons-outlined text-lg">schedule</span>\r
                  </button>\r
                }\r
              </div>\r
            }\r
          </li>\r
        }\r
      </ul>\r
    }\r
  }\r
</app-modal>\r
\r
<app-edit-payment-modal\r
  [open]="historyEditPaymentOpen()"\r
  [payment]="historyEditPayment()"\r
  [memberName]="historyEditMemberLabel()"\r
  [editKind]="historyEditPaymentKind()"\r
  [elevated]="true"\r
  (closed)="closeHistoryEditPayment()"\r
/>\r
\r
<app-modal\r
  [open]="importModalOpen()"\r
  title="Import Members (CSV)"\r
  [closable]="!importBusy()"\r
  (closed)="closeImportModal()"\r
>\r
  <div class="relative space-y-4">\r
    @if (importBusy()) {\r
      <div\r
        class="absolute inset-0 z-20 flex flex-col items-center justify-center gap-5 rounded-xl bg-white/92 px-6 py-10 text-center shadow-inner backdrop-blur-sm dark:bg-slate-900/92"\r
        aria-live="polite"\r
        aria-busy="true"\r
      >\r
        <div class="max-w-md space-y-2">\r
          <p class="text-base font-semibold text-slate-900 dark:text-slate-100">Importing members</p>\r
          <p class="min-h-[3rem] text-sm leading-relaxed text-slate-600 dark:text-slate-300">\r
            {{ importProgressMessage() }}\r
          </p>\r
        </div>\r
        <div class="w-full max-w-md">\r
          <div\r
            class="relative h-14 w-full overflow-hidden rounded-full border-2 border-indigo-200/80 bg-slate-100 shadow-inner dark:border-indigo-500/40 dark:bg-slate-800"\r
          >\r
            <div\r
              class="absolute inset-y-0 left-0 rounded-full bg-gradient-to-r from-indigo-500 via-violet-500 to-indigo-600 transition-[width] duration-500 ease-out dark:from-indigo-400 dark:via-violet-500 dark:to-indigo-500"\r
              [style.width.%]="importProgressPercent()"\r
            ></div>\r
            <div class="pointer-events-none absolute inset-0 flex items-center justify-center">\r
              <span\r
                class="text-base font-extrabold tabular-nums tracking-tight text-slate-900 drop-shadow-[0_1px_0_rgba(255,255,255,0.85)] dark:text-white dark:drop-shadow-[0_1px_2px_rgba(0,0,0,0.6)]"\r
              >\r
                {{ importProgressPercent() }}%\r
              </span>\r
            </div>\r
          </div>\r
          <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">Please wait while we manage your data.</p>\r
        </div>\r
      </div>\r
    }\r
    <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">\r
      <p class="text-sm font-semibold text-slate-800">Sample Excel columns</p>\r
      @if (isPg()) {\r
        <p class="mt-1 text-xs text-slate-600">\r
          <strong>Required:</strong> name, mobile, plan, dueDate, subscriptionType, floor, room, bed\r
        </p>\r
        <p class="mt-1 text-xs text-slate-500">\r
          For PG: <strong>subscriptionType</strong> must be <code class="rounded bg-slate-200 px-1">monthly</code> only. Use full room numbers (101, 204, 407) or floor + room index (e.g. floor 2 + room 4 \u2192 204). The floor column must match the room (e.g. room 284 belongs to floor 2, not floor 1). Preview lists every problem per row.\r
        </p>\r
      } @else {\r
        <p class="mt-1 text-xs text-slate-600">\r
          <strong>Required:</strong> name, mobile, plan, dueDate, subscriptionType\r
        </p>\r
        <p class="mt-1 text-xs text-slate-500">\r
          For Gym: Leave floor, room, bed empty. Mobile is optional.\r
        </p>\r
      }\r
      <div class="mt-2 flex flex-wrap items-center gap-2">\r
        <button\r
          type="button"\r
          class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 disabled:opacity-50"\r
          [disabled]="importBusy()"\r
          (click)="viewSampleExcel()"\r
        >\r
          View sample\r
        </button>\r
        <button\r
          type="button"\r
          class="rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-xs font-semibold text-indigo-800 hover:bg-indigo-100 disabled:opacity-50 dark:border-indigo-800 dark:bg-indigo-950/60 dark:text-indigo-100 dark:hover:bg-indigo-900/80"\r
          [disabled]="importBusy()"\r
          (click)="downloadSampleExcel()"\r
        >\r
          Download sample Excel\r
        </button>\r
      </div>\r
      <p class="mt-1.5 text-xs text-slate-500">View loads the template into the table below so you can check columns and validation before downloading or uploading your own file.</p>\r
    </div>\r
\r
    <div>\r
      <label class="mb-1 block text-sm font-medium text-slate-700">Upload CSV/Excel file</label>\r
      <input\r
        type="file"\r
        accept=".csv,text/csv,.xlsx,.xls,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel"\r
        class="w-full rounded-xl border border-slate-200 px-3 py-2"\r
        (change)="onImportFileSelected($event)"\r
      />\r
      @if (importFileName()) {\r
        <p class="mt-1 text-xs text-slate-500">Selected: {{ importFileName() }}</p>\r
      }\r
    </div>\r
\r
    <div class="rounded-xl border border-slate-200 bg-white p-3">\r
      <label class="flex items-center gap-2 text-sm font-medium text-slate-800">\r
        <input type="checkbox" [formControl]="importDueDateForAll" />\r
        Use same due date for all valid rows\r
      </label>\r
      @if (importDueDateForAll.value) {\r
        <div class="mt-2">\r
          <input type="date" [formControl]="importDueDate" class="rounded-lg border border-slate-200 px-3 py-2 text-sm" />\r
        </div>\r
      }\r
    </div>\r
\r
    @if (importRows().length > 0) {\r
      <div class="flex items-center gap-4 text-xs">\r
        <span class="rounded-full bg-emerald-100 px-2 py-1 font-semibold text-emerald-800">Valid: {{ importValidCount() }}</span>\r
        <span class="rounded-full bg-red-100 px-2 py-1 font-semibold text-red-800">Invalid: {{ importInvalidCount() }}</span>\r
      </div>\r
\r
      <div class="max-h-72 overflow-auto rounded-xl border border-slate-200">\r
        <table class="saas-table min-w-full text-left text-xs">\r
          <thead class="sticky top-0 bg-slate-50 text-slate-600">\r
            <tr>\r
              <th class="px-2 py-2">Sheet row</th>\r
              <th class="px-2 py-2">Name</th>\r
              <th class="px-2 py-2">Mobile</th>\r
              <th class="px-2 py-2">Plan</th>\r
              <th class="px-2 py-2">Due date</th>\r
              <th class="px-2 py-2">Sub</th>\r
              @if (isPg()) {\r
                <th class="px-2 py-2">Assigned seat</th>\r
              }\r
              <th class="min-w-[10rem] px-2 py-2">Status / issues</th>\r
            </tr>\r
          </thead>\r
          <tbody>\r
            @for (row of importRows(); track row.rowNo) {\r
              <tr [class.bg-emerald-50]="row.valid" [class.bg-red-50]="!row.valid" class="border-t border-slate-100">\r
                <td class="px-2 py-2">{{ row.rowNo }}</td>\r
                <td class="px-2 py-2">{{ row.firstName }} {{ row.lastName }}</td>\r
                <td class="px-2 py-2">{{ row.mobile || '\u2014' }}</td>\r
                <td class="px-2 py-2">\u20B9{{ row.amount | number: '1.0-0' }}</td>\r
                <td class="px-2 py-2">{{ row.dueDate }}</td>\r
                <td class="px-2 py-2">{{ row.subscriptionType }}</td>\r
                @if (isPg()) {\r
                  <td class="px-2 py-2 font-medium text-slate-800">{{ importSeatSummary(row) }}</td>\r
                }\r
                <td class="max-w-xs px-2 py-2 align-top">\r
                  @if (row.valid) {\r
                    <span class="font-semibold text-emerald-800">Valid</span>\r
                  } @else {\r
                    <ul class="list-disc pl-4 text-left text-xs font-medium text-red-900">\r
                      @for (err of row.errors; track err) {\r
                        <li>{{ err }}</li>\r
                      }\r
                    </ul>\r
                  }\r
                </td>\r
              </tr>\r
            }\r
          </tbody>\r
        </table>\r
      </div>\r
    }\r
\r
    <div class="flex flex-col-reverse gap-2 pt-2 sm:flex-row sm:justify-end">\r
      <button\r
        type="button"\r
        class="rounded-xl border border-slate-200 px-5 py-2.5 font-semibold disabled:cursor-not-allowed disabled:opacity-50"\r
        [disabled]="importBusy()"\r
        (click)="closeImportModal()"\r
      >\r
        Cancel\r
      </button>\r
      <button\r
        type="button"\r
        class="saas-btn-primary px-5 py-2.5 disabled:cursor-not-allowed disabled:opacity-50"\r
        [disabled]="importBusy() || importValidCount() === 0"\r
        (click)="importValidMembers()"\r
      >\r
        {{ importBusy() ? 'Importing...' : 'Import Valid Members' }}\r
      </button>\r
    </div>\r
  </div>\r
</app-modal>\r
\r
<app-modal [open]="shareLinkOpen()" title="Share onboarding link" (closed)="closeShareLink()">\r
  @if (shareLinkMember(); as m) {\r
    <div class="space-y-4">\r
      <div class="rounded-xl border border-indigo-100 bg-indigo-50/60 p-3">\r
        <p class="text-sm text-slate-700">\r
          Send this link to <span class="font-semibold">{{ m.firstName }} {{ m.lastName }}</span>\r
          so they can upload their photo and Aadhaar themselves. You approve their submission before it appears on their profile. The link is valid for\r
          <span class="font-semibold">24 hours</span>.\r
        </p>\r
        <p class="mt-1 text-xs text-slate-600">\r
          When they open the link they will be asked to enter their mobile number\r
          (<span class="font-semibold">{{ m.mobile }}</span>) to verify their identity.\r
        </p>\r
      </div>\r
\r
      @if (shareLinkBusy()) {\r
        <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4">\r
          <span class="material-icons-outlined animate-spin text-slate-500">progress_activity</span>\r
          <p class="text-sm text-slate-600">Generating link...</p>\r
        </div>\r
      } @else if (shareLinkUrl()) {\r
        <div>\r
          <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-600">\r
            Share link\r
          </label>\r
          <div class="flex gap-2">\r
            <input\r
              type="text"\r
              readonly\r
              [value]="shareLinkUrl()"\r
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-700"\r
            />\r
            <button\r
              type="button"\r
              class="flex items-center gap-1 rounded-xl border border-indigo-200 bg-indigo-50 px-3 py-2 text-xs font-semibold text-indigo-700 hover:bg-indigo-100"\r
              (click)="copyShareLink()"\r
            >\r
              <span class="material-icons-outlined text-base">\r
                {{ shareLinkCopied() ? 'check' : 'content_copy' }}\r
              </span>\r
              {{ shareLinkCopied() ? 'Copied' : 'Copy' }}\r
            </button>\r
          </div>\r
          @if (shareLinkExpiresAt(); as exp) {\r
            <p class="mt-2 text-xs text-slate-500">\r
              Expires: <span class="font-semibold text-slate-700">{{ exp | date: 'medium' }}</span>\r
            </p>\r
          }\r
        </div>\r
\r
        @if (whatsappShareLink(); as wa) {\r
          <a\r
            [href]="wa"\r
            target="_blank"\r
            rel="noopener noreferrer"\r
            class="flex items-center justify-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800 hover:bg-emerald-100"\r
          >\r
            <span class="material-icons-outlined text-base">campaign</span>\r
            Send via WhatsApp\r
          </a>\r
        }\r
      }\r
\r
      <div class="flex justify-end pt-2">\r
        <button\r
          type="button"\r
          class="rounded-xl border border-slate-200 px-5 py-2 text-sm font-semibold"\r
          (click)="closeShareLink()"\r
        >\r
          Done\r
        </button>\r
      </div>\r
    </div>\r
  }\r
</app-modal>\r
\r
<app-modal [open]="receiptConfirmOpen()" title="Send receipt now?" (closed)="onReceiptConfirmClosed()">\r
  @if (receiptConfirmTarget(); as target) {\r
    <div class="space-y-4">\r
      <div class="rounded-xl border border-indigo-100 bg-indigo-50/70 p-3">\r
        <p class="text-sm text-slate-700">\r
          Payment is saved for\r
          <span class="font-semibold text-slate-900">{{ target.firstName }} {{ target.lastName }}</span>.\r
        </p>\r
        <p class="mt-1 text-xs text-slate-600">\r
          Do you want to open WhatsApp and send the receipt link now?\r
        </p>\r
      </div>\r
      @if (receiptConfirmAmount() > 0) {\r
        <div class="rounded-xl border border-slate-200 bg-white p-3 text-sm text-slate-700">\r
          Receipt amount:\r
          <span class="font-semibold text-slate-900">\u20B9{{ receiptConfirmAmount() | number: '1.0-0' }}</span>\r
        </div>\r
      }\r
      <div class="flex flex-col-reverse gap-2 pt-1 sm:flex-row sm:justify-end">\r
        <button\r
          type="button"\r
          class="rounded-xl border border-slate-200 px-5 py-2.5 font-semibold"\r
          (click)="onReceiptConfirmSkip()"\r
          [disabled]="receiptConfirmSending()"\r
        >\r
          Not now\r
        </button>\r
        <button\r
          type="button"\r
          class="rounded-xl bg-emerald-600 px-6 py-2.5 font-semibold text-white hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-60"\r
          (click)="onReceiptConfirmSend()"\r
          [disabled]="receiptConfirmSending()"\r
        >\r
          @if (receiptConfirmSending()) {\r
            Sending...\r
          } @else {\r
            Send on WhatsApp\r
          }\r
        </button>\r
      </div>\r
    </div>\r
  }\r
</app-modal>\r
\r
<app-modal\r
  [open]="billingProfileReminderOpen()"\r
  title="Profile amounts updated"\r
  (closed)="closeBillingProfileReminder()"\r
>\r
  <div class="space-y-4">\r
    <div class="rounded-xl border border-amber-200/90 bg-amber-50/90 px-4 py-3 dark:border-amber-900/45 dark:bg-amber-950/40">\r
      <p class="text-sm leading-relaxed text-amber-950 dark:text-amber-50/95">\r
        You edited <strong class="font-semibold">payment-related amounts</strong> on this member (plan rent, paid rent, or\r
        advance). Those values apply to the <strong class="font-semibold">member list and reminders only</strong> \u2014 they do\r
        <strong class="font-semibold">not</strong> change existing payment rows or your collection history.\r
      </p>\r
      <p class="mt-3 text-sm leading-relaxed text-amber-950/90 dark:text-amber-100/85">\r
        To keep <strong class="font-semibold">receipts and totals</strong> accurate, update entries on the\r
        <strong class="font-semibold">Payments</strong> page when needed.\r
      </p>\r
    </div>\r
    @if (!canViewPaymentsAction()) {\r
      <p class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-600 dark:border-slate-600 dark:bg-slate-800/80 dark:text-slate-300">\r
        You don\u2019t have access to Payments. Ask an owner to adjust receipts and the payments table if required.\r
      </p>\r
    }\r
    <div class="flex flex-col-reverse gap-2 pt-1 sm:flex-row sm:justify-end">\r
      <button\r
        type="button"\r
        class="rounded-xl border border-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"\r
        (click)="closeBillingProfileReminder()"\r
      >\r
        {{ canViewPaymentsAction() ? 'Not now' : 'Got it' }}\r
      </button>\r
      @if (canViewPaymentsAction()) {\r
        <button\r
          type="button"\r
          class="rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-400"\r
          (click)="goToPaymentsFromBillingReminder()"\r
        >\r
          Open Payments\r
        </button>\r
      }\r
    </div>\r
  </div>\r
</app-modal>\r
\r
<app-modal\r
  [open]="deactivateConfirmOpen()"\r
  [title]="'members.makeInactive' | t"\r
  [closable]="!deactivateConfirmBusy()"\r
  [backdropClose]="!deactivateConfirmBusy()"\r
  (closed)="onDeactivateModalDismiss()"\r
>\r
  @if (deactivateConfirmMember(); as dm) {\r
    <div class="space-y-4">\r
      <div\r
        class="rounded-xl border border-amber-200/80 bg-gradient-to-br from-amber-50 to-orange-50/80 p-4 shadow-inner dark:border-amber-800/45 dark:from-amber-950/50 dark:to-orange-950/30"\r
      >\r
        <p class="text-sm leading-relaxed text-slate-800 dark:text-slate-100">\r
          {{ 'members.confirmMakeInactive' | t: { name: memberConfirmDisplayName(dm) } }}\r
        </p>\r
      </div>\r
      <div class="flex flex-col-reverse gap-2 pt-1 sm:flex-row sm:justify-end">\r
        <button\r
          type="button"\r
          class="rounded-xl border border-slate-200 bg-white px-5 py-2.5 font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"\r
          (click)="cancelDeactivateMember()"\r
          [disabled]="deactivateConfirmBusy()"\r
        >\r
          {{ 'common.cancel' | t }}\r
        </button>\r
        <button\r
          type="button"\r
          class="rounded-xl bg-rose-600 px-6 py-2.5 font-semibold text-white shadow-md transition hover:bg-rose-700 disabled:cursor-not-allowed disabled:opacity-60"\r
          (click)="confirmDeactivateMember()"\r
          [disabled]="deactivateConfirmBusy()"\r
        >\r
          @if (deactivateConfirmBusy()) {\r
            {{ 'common.loading' | t }}\r
          } @else {\r
            {{ 'members.deactivateConfirmYes' | t }}\r
          }\r
        </button>\r
      </div>\r
    </div>\r
  }\r
</app-modal>\r
