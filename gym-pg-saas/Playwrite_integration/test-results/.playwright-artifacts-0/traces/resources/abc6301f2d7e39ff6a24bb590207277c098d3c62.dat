function ownerDayGreetingSegment(now) {
  const h = now.getHours();
  if (h >= 5 && h < 12)
    return "morning";
  if (h >= 12 && h < 17)
    return "afternoon";
  if (h >= 17 && h < 21)
    return "evening";
  return "night";
}
