    (() => {
      (typeof ngDevMode === "undefined" || ngDevMode) && i09.\u0275setClassMetadata(SupervisorShellComponent, [{
        type: Component5,
        args: [{ selector: "app-supervisor-shell", standalone: true, imports: [
