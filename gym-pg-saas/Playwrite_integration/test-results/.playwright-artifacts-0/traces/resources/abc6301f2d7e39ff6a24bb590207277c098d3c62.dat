            </p>\r
          </div>\r
          <button\r
            type="button"\r
            class="absolute right-3 top-3 inline-flex h-7 w-7 items-center justify-center rounded-full bg-white/15 text-white/90 transition hover:bg-white/25"\r
            (click)="closeInstallPopup()"\r
            aria-label="Close"\r
          >\r
            <i class="fa-solid fa-xmark text-sm"></i>\r
          </button>\r
        </div>\r
