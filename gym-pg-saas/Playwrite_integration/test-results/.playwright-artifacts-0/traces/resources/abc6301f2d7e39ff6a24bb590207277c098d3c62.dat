    (() => {
      (typeof ngDevMode === "undefined" || ngDevMode) && i032.\u0275setClassMetadata(MonthlyEarningsPageComponent, [{
        type: Component23,
        args: [{ selector: "app-monthly-earnings-page", standalone: true, imports: [CommonModule6, DatePipe13], template: `<div class="saas-page mx-auto max-w-7xl">\r
  <!-- Header -->\r
  <div class="mb-8">\r
    <h1 class="text-4xl font-bold text-slate-900">Monthly Earnings</h1>\r
    <p class="mt-2 text-lg text-slate-600">Track and manage your income by month</p>\r
  </div>\r
\r
  <div class="grid gap-6 lg:grid-cols-4">\r
    <!-- Sidebar - Month & Year Selection -->\r
    <div class="space-y-6 lg:col-span-1">\r
      <!-- Month Selection -->\r
      <div class="saas-card space-y-4 p-6">\r
        <h3 class="text-sm font-bold uppercase tracking-wide text-slate-900">Select Month</h3>\r
        <div class="grid grid-cols-3 gap-2">\r
          @for (month of months; track month; let i = $index) {\r
            <button\r
              type="button"\r
              (click)="selectMonth(i)"\r
              [class.bg-gradient-to-r]="selectedMonth() === i"\r
              [class.from-blue-600]="selectedMonth() === i"\r
              [class.to-blue-800]="selectedMonth() === i"\r
              [class.text-white]="selectedMonth() === i"\r
              [class.shadow-lg]="selectedMonth() === i"\r
              [class.font-bold]="selectedMonth() === i"\r
              [class.bg-white]="selectedMonth() !== i"\r
              [class.text-slate-700]="selectedMonth() !== i"\r
              [class.border]="selectedMonth() !== i"\r
              [class.border-slate-300]="selectedMonth() !== i"\r
              [class.hover:bg-slate-50]="selectedMonth() !== i"\r
              class="rounded-lg px-3 py-2 text-xs transition-all duration-200"\r
            >\r
              {{ month }}\r
            </button>\r
          }\r
        </div>\r
      </div>\r
\r
      <!-- Year Selection -->\r
      <div class="saas-card space-y-4 p-6">\r
        <div class="flex items-center justify-between">\r
          <h3 class="text-sm font-bold uppercase tracking-wide text-slate-900">Year</h3>\r
          <div class="flex gap-1">\r
            <button\r
              type="button"\r
              (click)="previousYear()"\r
              class="rounded-lg p-1 text-slate-600 transition hover:bg-slate-100"\r
              title="Previous year"\r
            >\r
              <span class="material-icons-outlined text-xl">navigate_before</span>\r
            </button>\r
            <button\r
              type="button"\r
              (click)="nextYear()"\r
              class="rounded-lg p-1 text-slate-600 transition hover:bg-slate-100"\r
              title="Next year"\r
            >\r
              <span class="material-icons-outlined text-xl">navigate_after</span>\r
            </button>\r
          </div>\r
        </div>\r
        <div class="grid grid-cols-2 gap-2">\r
          @for (year of years; track year) {\r
            <button\r
              type="button"\r
              (click)="selectYear(year)"\r
              [class.bg-gradient-to-r]="selectedYear() === year"\r
              [class.from-blue-600]="selectedYear() === year"\r
              [class.to-blue-800]="selectedYear() === year"\r
              [class.text-white]="selectedYear() === year"\r
              [class.shadow-lg]="selectedYear() === year"\r
              [class.font-bold]="selectedYear() === year"\r
              [class.bg-white]="selectedYear() !== year"\r
              [class.text-slate-700]="selectedYear() !== year"\r
              [class.border]="selectedYear() !== year"\r
              [class.border-slate-300]="selectedYear() !== year"\r
              [class.hover:bg-slate-50]="selectedYear() !== year"\r
              class="rounded-lg px-3 py-2 text-sm transition-all duration-200"\r
            >\r
              {{ year }}\r
            </button>\r
          }\r
        </div>\r
      </div>\r
\r
      <!-- Summary Cards -->\r
      <div class="saas-card space-y-3 p-6">\r
        <div class="text-center">\r
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Monthly Total</p>\r
          <p class="mt-2 text-3xl font-bold text-slate-900">{{ formatCurrency(monthlyEarnings()) }}</p>\r
        </div>\r
      </div>\r
\r
      <!-- Year Summary -->\r
      <div class="saas-card space-y-4 p-6">\r
        <h3 class="text-sm font-bold uppercase tracking-wide text-slate-900">{{ selectedYear() }} Summary</h3>\r
        <div class="space-y-2">\r
          @for (month of months; track month; let i = $index) {\r
            <div class="flex items-center justify-between rounded-lg bg-slate-50 px-3 py-2">\r
              <span class="text-xs font-medium text-slate-600">{{ month }}</span>\r
              <span class="text-sm font-bold text-slate-900">{{ formatCurrency(yearlyEarnings()[i]) }}</span>\r
            </div>\r
          }\r
        </div>\r
      </div>\r
    </div>\r
\r
    <!-- Main Content -->\r
    <div class="space-y-6 lg:col-span-3">\r
      <!-- Monthly Stats -->\r
      <div class="grid gap-4 md:grid-cols-3">\r
        <div class="saas-card space-y-2 p-6">\r
          <p class="text-sm font-medium uppercase tracking-wide text-slate-500">Total Earnings</p>\r
          <p class="text-3xl font-bold text-slate-900">{{ formatCurrency(monthlyEarnings()) }}</p>\r
          <div class="mt-2 flex items-center gap-1 text-xs text-slate-600">\r
            <span class="material-icons-outlined text-sm">data_usage</span>\r
            {{ paymentsByDay().length }} payments this month\r
          </div>\r
        </div>\r
\r
        <div class="saas-card space-y-2 p-6">\r
          <p class="text-sm font-medium uppercase tracking-wide text-slate-500">Average Payment</p>\r
          <p class="text-3xl font-bold text-slate-900">\r
            {{ formatCurrency(paymentsByDay().length > 0 ? monthlyEarnings() / paymentsByDay().length : 0) }}\r
          </p>\r
          <div class="mt-2 flex items-center gap-1 text-xs text-slate-600">\r
            <span class="material-icons-outlined text-sm">trending_up</span>\r
            Per transaction\r
          </div>\r
        </div>\r
\r
        <div class="saas-card space-y-2 p-6">\r
          <p class="text-sm font-medium uppercase tracking-wide text-slate-500">Max Payment</p>\r
          <p class="text-3xl font-bold text-slate-900">\r
            {{ formatCurrency(maxPayment()) }}\r
          </p>\r
          <div class="mt-2 flex items-center gap-1 text-xs text-slate-600">\r
            <span class="material-icons-outlined text-sm">arrow_upward</span>\r
            Highest payment\r
          </div>\r
        </div>\r
      </div>\r
\r
      <!-- Payments by Day -->\r
      <div class="saas-card space-y-6 p-6">\r
        <div>\r
          <h2 class="text-2xl font-bold text-slate-900">\r
            {{ months[selectedMonth()] }} {{ selectedYear() }} Payments\r
          </h2>\r
          <p class="mt-1 text-sm text-slate-600">Daily breakdown of all payments</p>\r
        </div>\r
\r
        @if (paymentsByDay().length === 0) {\r
          <div class="rounded-lg bg-slate-50 py-12 text-center">\r
            <span class="material-icons-outlined mb-2 text-4xl text-slate-400">receipt</span>\r
            <p class="text-sm text-slate-600">No payments recorded in {{ months[selectedMonth()] }} {{ selectedYear() }}</p>\r
          </div>\r
        } @else {\r
          <div class="space-y-3">\r
            @for (dayData of paymentsByDay(); track dayData.day) {\r
              <div class="rounded-xl border border-slate-200 p-4 transition hover:border-slate-300 hover:shadow-sm">\r
                <div class="flex items-center justify-between">\r
                  <div>\r
                    <p class="text-sm font-semibold text-slate-900">\r
                      {{ months[selectedMonth()] }} {{ dayData.day }}, {{ selectedYear() }}\r
                    </p>\r
                    <p class="mt-1 text-xs text-slate-500">{{ dayData.count }} payment(s)</p>\r
                  </div>\r
                  <div class="text-right">\r
                    <p class="text-2xl font-bold text-slate-900">{{ formatCurrency(dayData.amount) }}</p>\r
                  </div>\r
                </div>\r
\r
                <!-- Payment details for this day -->\r
                <div class="mt-4 space-y-2 border-t border-slate-100 pt-4">\r
                  @for (payment of dayData.payments; track payment.paymentId) {\r
                    <div class="flex items-center justify-between">\r
                      <div class="flex items-center gap-2">\r
                        <span class="material-icons-outlined text-sm text-slate-400">attach_money</span>\r
                        <span class="text-xs text-slate-600">{{ payment.method || 'Cash' }}</span>\r
                      </div>\r
                      <span class="font-semibold text-slate-900">{{ formatCurrency(payment.amount) }}</span>\r
                    </div>\r
                  }\r
                </div>\r
              </div>\r
            }\r
          </div>\r
        }\r
      </div>\r
\r
      <!-- Who Paid Table Section -->\r
      <div class="saas-card space-y-6 p-6">\r
        <div class="flex items-center justify-between">\r
          <div>\r
            <h2 class="text-2xl font-bold text-slate-900">Who Paid</h2>\r
            <p class="mt-1 text-sm text-slate-600">Complete list of members who made payments</p>\r
          </div>\r
          <button\r
            type="button"\r
            (click)="generatePDF()"\r
            class="flex items-center gap-2 rounded-lg bg-gradient-to-r from-blue-600 to-blue-800 px-4 py-2.5 text-sm font-semibold text-white shadow-lg transition hover:shadow-xl"\r
            title="Generate PDF report"\r
          >\r
            <span class="material-icons-outlined text-base">picture_as_pdf</span>\r
            Download PDF\r
          </button>\r
        </div>\r
\r
        @if (monthlyPaymentsWithMembers().length === 0) {\r
          <div class="rounded-lg bg-slate-50 py-12 text-center">\r
            <span class="material-icons-outlined mb-2 text-4xl text-slate-400">person_off</span>\r
            <p class="text-sm text-slate-600">No payments recorded in {{ months[selectedMonth()] }} {{ selectedYear() }}</p>\r
          </div>\r
        } @else {\r
          <!-- Desktop Table -->\r
          <div class="hidden overflow-x-auto md:block">\r
            <table class="w-full text-sm">\r
              <thead class="border-b border-slate-200 bg-slate-50">\r
                <tr>\r
                  <th class="px-4 py-3 text-left font-semibold text-slate-900">Date</th>\r
                  <th class="px-4 py-3 text-left font-semibold text-slate-900">Member Name</th>\r
                  <th class="px-4 py-3 text-left font-semibold text-slate-900">Mobile</th>\r
                  <th class="px-4 py-3 text-left font-semibold text-slate-900">Amount</th>\r
                  <th class="px-4 py-3 text-left font-semibold text-slate-900">Method</th>\r
                </tr>\r
              </thead>\r
              <tbody class="divide-y divide-slate-100">\r
                @for (payment of monthlyPaymentsWithMembers(); track payment.paymentId; let odd = $odd) {\r
                  <tr [class.bg-slate-50]="odd" class="transition hover:bg-slate-100">\r
                    <td class="px-4 py-3 text-slate-600">\r
                      {{ getPaymentDate(payment) | date : 'dd MMM yyyy' }}\r
                    </td>\r
                    <td class="px-4 py-3 font-medium text-slate-900">{{ payment.memberName }}</td>\r
                    <td class="px-4 py-3 text-slate-600">{{ payment.memberMobile }}</td>\r
                    <td class="px-4 py-3 font-semibold text-slate-900">{{ formatCurrency(payment.amount) }}</td>\r
                    <td class="px-4 py-3 text-slate-600">\r
                      <span class="rounded-full bg-slate-200 px-2.5 py-1 text-xs font-medium text-slate-700">\r
                        {{ payment.method || 'Cash' }}\r
                      </span>\r
                    </td>\r
                  </tr>\r
                }\r
              </tbody>\r
            </table>\r
          </div>\r
\r
          <!-- Mobile Cards -->\r
          <div class="space-y-3 md:hidden">\r
            @for (payment of monthlyPaymentsWithMembers(); track payment.paymentId) {\r
              <div class="rounded-lg border border-slate-200 p-4">\r
                <div class="flex items-start justify-between gap-3">\r
                  <div class="flex-1">\r
                    <p class="font-semibold text-slate-900">{{ payment.memberName }}</p>\r
                    <p class="mt-1 text-sm text-slate-600">\u{1F4DE} {{ payment.memberMobile }}</p>\r
                  </div>\r
                  <span class="text-right">\r
                    <p class="text-lg font-bold text-slate-900">{{ formatCurrency(payment.amount) }}</p>\r
                  </span>\r
                </div>\r
                <div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-3">\r
                  <span class="text-xs text-slate-600">\r
                    {{ getPaymentDate(payment) | date : 'dd MMM yyyy' }}\r
                  </span>\r
                  <span class="rounded-full bg-slate-200 px-2.5 py-1 text-xs font-medium text-slate-700">\r
                    {{ payment.method || 'Cash' }}\r
                  </span>\r
                </div>\r
              </div>\r
            }\r
          </div>\r
        }\r
      </div>\r
    </div>\r
  </div>\r
</div>\r
