                                    </span>\r
                                  } @else {\r
                                    <span class="text-xs font-medium text-slate-500 dark:text-slate-400">N/A</span>\r
                                  }\r
                                } @else {\r
                                  <span class="text-xs font-medium text-slate-500 dark:text-slate-400">N/A</span>\r
                                }\r
                              </div>\r
                            </div>\r
                            <div class="flex items-start justify-between gap-2">\r
                              <span class="shrink-0 text-xs text-slate-500 dark:text-slate-400">Paid</span>\r
                              <span class="min-w-0 text-right text-xs font-semibold text-emerald-700 dark:text-emerald-400">\r
                                {{ formatCurrency(getOccupiedMember(floor.floorNumber, room.roomNumber, seatBedNo)?.amount) }}\r
                              </span>\r
                            </div>\r
                            <div class="flex items-start justify-between gap-2">\r
                              <span class="shrink-0 text-xs text-slate-500 dark:text-slate-400">Assigned Date</span>\r
                              <span class="min-w-0 text-right text-xs font-medium text-slate-800 dark:text-slate-200">\r
                                {{ formatDateTime(getOccupiedMember(floor.floorNumber, room.roomNumber, seatBedNo)?.joinDate) }}\r
                              </span>\r
                            </div>\r
                            <div class="flex items-start justify-between gap-2">\r
                              <span class="shrink-0 text-xs text-slate-500 dark:text-slate-400">End Time</span>\r
                              <span class="min-w-0 text-right text-xs font-medium text-slate-800 dark:text-slate-200">\r
                                {{ formatDateTime(getOccupiedMember(floor.floorNumber, room.roomNumber, seatBedNo)?.dueDate) }}\r
                              </span>\r
                            </div>\r
                            @if (getOccupiedMember(floor.floorNumber, room.roomNumber, seatBedNo)?.scheduledVacateYyyyMmDd; as vac) {\r
                              <div class="flex items-start justify-between gap-2 rounded-lg border border-amber-200/80 bg-amber-50/90 px-2 py-1.5 dark:border-amber-800/50 dark:bg-amber-950/40">\r
                                <span class="shrink-0 text-xs font-medium text-amber-900 dark:text-amber-100">{{ 'members.bedVacateOn' | t }}</span>\r
                                <span class="text-right text-xs font-bold text-amber-950 dark:text-amber-50">{{\r
                                  formatScheduledVacateDisplay(vac)\r
                                }}</span>\r
                              </div>\r
                            }\r
                          </div>\r
                          @if (showActionsStrip()) {\r
                            @if (getOccupiedMember(floor.floorNumber, room.roomNumber, seatBedNo); as occ) {\r
                              <div class="pointer-events-auto mt-3 flex flex-col gap-2 border-t border-slate-100 pt-3 dark:border-slate-700" (click)="$event.stopPropagation()">\r
                                <button\r
                                  type="button"\r
                                  class="w-full rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-2 text-center text-xs font-semibold text-indigo-800 transition hover:bg-indigo-100 dark:border-indigo-900/60 dark:bg-indigo-950/50 dark:text-indigo-100 dark:hover:bg-indigo-950/80"\r
                                  (click)="viewMemberDetails(occ)"\r
                                >\r
                                  {{ 'common.seeMore' | t }}\r
                                </button>\r
                                <button\r
                                  type="button"\r
                                  class="w-full rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-center text-xs font-semibold text-rose-800 transition hover:bg-rose-100 dark:border-rose-900/60 dark:bg-rose-950/50 dark:text-rose-100 dark:hover:bg-rose-950/80"\r
                                  (click)="openDeactivateConfirm(occ)"\r
                                >\r
                                  {{ 'members.makeInactive' | t }}\r
                                </button>\r
                                <button\r
                                  type="button"\r
                                  class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-center text-xs font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700"\r
                                  (click)="openScheduleModal(occ)"\r
                                >\r
                                  {{ 'members.bedFutureInactive' | t }}\r
                                </button>\r
                              </div>\r
                            }\r
                          }\r
                          <div\r
                            class="absolute h-3 w-3 border-slate-200 bg-white dark:border-slate-600 dark:bg-slate-900"\r
                            [class.border-b]="tooltipAboveBed"\r
                            [class.border-r]="tooltipAboveBed"\r
                            [class.border-t]="!tooltipAboveBed"\r
                            [class.border-l]="!tooltipAboveBed"\r
                            [class.seat-tooltip-arrow-left]="bedIdx % 3 === 0"\r
                            [class.seat-tooltip-arrow-center]="bedIdx % 3 === 1"\r
                            [class.seat-tooltip-arrow-right]="bedIdx % 3 === 2"\r
                            [class.seat-tooltip-arrow-dir-down]="tooltipAboveBed"\r
                            [class.seat-tooltip-arrow-dir-up]="!tooltipAboveBed"\r
                          ></div>\r
                        </div>\r
                      }\r
                    </div>\r
                  }\r
                </div>\r
              </div>\r
            }\r
          </div>\r
        }\r
      </section>\r
    }\r
  </div>\r
}\r
\r
<app-modal\r
  [open]="deactivateOpen()"\r
  [elevated]="true"\r
  [title]="'members.makeInactive' | t"\r
  [closable]="!deactivateBusy()"\r
  [backdropClose]="!deactivateBusy()"\r
  (closed)="onDeactivateModalDismiss()"\r
>\r
  @if (deactivateMember(); as dm) {\r
    <div class="space-y-4">\r
      <div\r
        class="rounded-xl border border-amber-200/80 bg-gradient-to-br from-amber-50 to-orange-50/80 p-4 shadow-inner dark:border-amber-800/45 dark:from-amber-950/50 dark:to-orange-950/30"\r
      >\r
        <p class="text-sm leading-relaxed text-slate-800 dark:text-slate-100">\r
          {{ 'members.confirmMakeInactive' | t: { name: memberConfirmDisplayName(dm) } }}\r
        </p>\r
      </div>\r
      <div class="flex flex-col-reverse gap-2 pt-1 sm:flex-row sm:justify-end">\r
        <button\r
          type="button"\r
          class="rounded-xl border border-slate-200 bg-white px-5 py-2.5 font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"\r
          (click)="cancelDeactivate()"\r
          [disabled]="deactivateBusy()"\r
        >\r
          {{ 'common.cancel' | t }}\r
        </button>\r
        <button\r
          type="button"\r
          class="rounded-xl bg-rose-600 px-6 py-2.5 font-semibold text-white shadow-md transition hover:bg-rose-700 disabled:cursor-not-allowed disabled:opacity-60"\r
          (click)="confirmDeactivate()"\r
          [disabled]="deactivateBusy()"\r
        >\r
          @if (deactivateBusy()) {\r
            {{ 'common.loading' | t }}\r
          } @else {\r
            {{ 'members.deactivateConfirmYes' | t }}\r
          }\r
        </button>\r
      </div>\r
    </div>\r
  }\r
</app-modal>\r
\r
<app-modal\r
  [open]="scheduleOpen()"\r
  [elevated]="true"\r
  [title]="'members.bedFutureInactiveTitle' | t"\r
  [closable]="!scheduleBusy()"\r
  [backdropClose]="!scheduleBusy()"\r
  (closed)="onScheduleModalDismiss()"\r
>\r
  @if (scheduleMember(); as sm) {\r
    <div class="space-y-4">\r
      <p class="text-sm text-slate-600 dark:text-slate-300">\r
        {{ 'members.bedFutureInactiveHint' | t }}\r
      </p>\r
      <p class="text-xs font-semibold text-slate-800 dark:text-slate-100">\r
        {{ memberDisplayName(sm) }}\r
        @if (sm.mobile) {\r
          <span class="font-normal text-slate-500 dark:text-slate-400"> - {{ sm.mobile }}</span>\r
        }\r
      </p>\r
      <div>\r
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{{\r
          'members.bedSelectVacateDate' | t\r
        }}</label>\r
        <input\r
          type="date"\r
          class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"\r
          [min]="todayYyyyMmDd()"\r
          [value]="scheduleDateRaw()"\r
          (change)="scheduleDateRaw.set($any($event.target).value)"\r
        />\r
      </div>\r
      <div class="flex flex-col-reverse gap-2 pt-1 sm:flex-row sm:justify-between">\r
        @if (sm.scheduledVacateYyyyMmDd) {\r
          <button\r
            type="button"\r
            class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 disabled:opacity-50 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800"\r
            [disabled]="scheduleBusy()"\r
            (click)="clearSchedule()"\r
          >\r
            {{ 'members.bedClearSchedule' | t }}\r
          </button>\r
        }\r
        <div class="flex flex-1 flex-col-reverse gap-2 sm:flex-row sm:justify-end">\r
          <button\r
            type="button"\r
            class="rounded-xl border border-slate-200 bg-white px-5 py-2.5 font-semibold text-slate-700 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200"\r
            [disabled]="scheduleBusy()"\r
            (click)="cancelSchedule()"\r
          >\r
            {{ 'common.cancel' | t }}\r
          </button>\r
          <button\r
            type="button"\r
            class="rounded-xl bg-indigo-600 px-6 py-2.5 font-semibold text-white shadow-sm hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-60"\r
            [disabled]="scheduleBusy()"\r
            (click)="saveSchedule()"\r
          >\r
            @if (scheduleBusy()) {\r
              {{ 'common.loading' | t }}\r
            } @else {\r
              {{ 'members.bedSaveSchedule' | t }}\r
            }\r
          </button>\r
        </div>\r
      </div>\r
    </div>\r
  }\r
</app-modal>\r
