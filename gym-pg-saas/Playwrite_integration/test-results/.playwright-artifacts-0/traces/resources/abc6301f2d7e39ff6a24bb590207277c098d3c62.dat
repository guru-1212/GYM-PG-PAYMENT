function compactRupee(v) {
  if (v >= 1e7)
    return "\u20B9" + (v / 1e7).toFixed(1).replace(/\.0$/, "") + "Cr";
  if (v >= 1e5)
    return "\u20B9" + (v / 1e5).toFixed(1).replace(/\.0$/, "") + "L";
  if (v >= 1e3)
    return "\u20B9" + (v / 1e3).toFixed(1).replace(/\.0$/, "") + "K";
  return "\u20B9" + Math.round(v);
}
function dashboardDayGreetingSegment(now) {
  const h = now.getHours();
  if (h >= 5 && h < 12)
    return "morning";
  if (h >= 12 && h < 17)
    return "afternoon";
  if (h >= 17 && h < 21)
    return "evening";
  return "night";
}
function dashboardDayGreetingIcon(segment) {
  switch (segment) {
    case "morning":
      return "waving_hand";
    case "afternoon":
      return "wb_twilight";
    case "evening":
      return "nights_stay";
    case "night":
      return "bedtime";
    default:
      return "waving_hand";
  }
}
