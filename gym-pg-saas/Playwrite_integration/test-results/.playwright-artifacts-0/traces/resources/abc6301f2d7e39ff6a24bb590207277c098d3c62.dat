      </button>\r
    </div>\r
  </aside>\r
\r
  <div class="flex min-w-0 flex-1 flex-col">\r
    <header\r
      class="sticky top-0 z-20 flex w-full items-center border-b border-slate-200/90 bg-white px-3 py-2.5 md:hidden dark:border-slate-700 dark:bg-slate-950"\r
    >\r
      <div class="flex w-full min-w-0 items-center justify-between gap-3">\r
        <button\r
