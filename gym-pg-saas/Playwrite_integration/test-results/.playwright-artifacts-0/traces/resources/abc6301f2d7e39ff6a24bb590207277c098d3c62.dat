\n.message-row {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 0.5rem;\n}\n.message-row-user {\n  align-items: flex-end;\n}\n.message-bubble {\n  max-width: min(80%, 34rem);\n  border-radius: 1rem;\n  padding: 0.72rem 0.85rem;\n  background: #ffffff;\n  color: #0f172a;\n  font-size: 0.9rem;\n  line-height: 1.45;\n  border: 1px solid rgba(148, 163, 184, 0.3);\n}\n.message-bubble p {\n  margin: 0;\n}\n.message-bubble p + p {\n  margin-top: 0.28rem;\n}\n.message-bubble-user {\n  background:\n    linear-gradient(\n      135deg,\n      #4338ca,\n      #2563eb);\n  color: #ffffff;\n  border-color: transparent;\n}\n.message-bubble-highlight {\n  animation: guru-glow 1.4s ease;\n  border-color: rgba(79, 70, 229, 0.6);\n  box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.16);\n}\n.typing-bubble {\n  width: 3.2rem;\n  display: flex;\n  justify-content: center;\n  gap: 0.26rem;\n}\n.typing-bubble span {\n  width: 0.42rem;\n  height: 0.42rem;\n  border-radius: 999px;\n  background: #64748b;\n  animation: typing-bounce 1s infinite ease-in-out;\n}\n.typing-bubble span:nth-child(2) {\n  animation-delay: 0.12s;\n}\n.typing-bubble span:nth-child(3) {\n  animation-delay: 0.24s;\n}\n.message-suggestions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.45rem;\n}\n.suggestion-chip {\n  border: 1px solid rgba(99, 102, 241, 0.35);\n  background: #eef2ff;\n  color: #3730a3;\n  border-radius: 999px;\n  padding: 0.3rem 0.68rem;\n  font-size: 0.78rem;\n  font-weight: 600;\n  display: inline-flex;\n  align-items: center;\n  gap: 0.22rem;\n}\n.suggestion-chip .material-icons-outlined {\n  font-size: 14px;\n}\n.message-actions {\n  display: flex;\n  gap: 0.5rem;\n}\n.still-help-btn,\n.contact-admin-btn {\n  border-radius: 0.75rem;\n  border: 1px solid rgba(148, 163, 184, 0.45);\n  background: #ffffff;\n  color: #0f172a;\n  font-size: 0.8rem;\n  font-weight: 600;\n  padding: 0.45rem 0.72rem;\n}\n.contact-admin-btn {\n  border-color: rgba(16, 185, 129, 0.45);\n  color: #047857;\n  display: inline-flex;\n  align-items: center;\n  gap: 0.35rem;\n}\n.ask-guru-input-wrap {\n  padding: 0.85rem 1rem 1rem;\n  border-top: 1px solid rgba(148, 163, 184, 0.34);\n  background: rgba(255, 255, 255, 0.8);\n}\n.ask-guru-input {\n  display: flex;\n  align-items: center;\n  gap: 0.45rem;\n  border: 1px solid rgba(148, 163, 184, 0.44);\n  border-radius: 1rem;\n  padding: 0.4rem;\n  background: white;\n}\n.ask-guru-input input {\n  flex: 1;\n  border: none;\n  outline: none;\n  font-size: 0.9rem;\n  color: #0f172a;\n  padding: 0.32rem 0.46rem;\n}\n.ask-guru-input button {\n  border: none;\n  border-radius: 0.8rem;\n  background:\n    linear-gradient(\n      135deg,\n      #4f46e5,\n      #2563eb);\n  color: white;\n  font-weight: 600;\n  font-size: 0.82rem;\n  display: inline-flex;\n  align-items: center;\n  gap: 0.24rem;\n  padding: 0.44rem 0.72rem;\n}\n.ask-guru-input button:disabled {\n  opacity: 0.55;\n  cursor: not-allowed;\n}\n.ask-guru-input .material-icons-outlined {\n  font-size: 16px;\n}\n@keyframes typing-bounce {\n  0%, 80%, 100% {\n    transform: translateY(0);\n    opacity: 0.55;\n  }\n  40% {\n    transform: translateY(-4px);\n    opacity: 1;\n  }\n}\n@keyframes guru-glow {\n  0% {\n    box-shadow: 0 0 0 0 rgba(99, 102, 241, 0);\n  }\n  45% {\n    box-shadow: 0 0 0 6px rgba(99, 102, 241, 0.22);\n  }\n  100% {\n    box-shadow: 0 0 0 0 rgba(99, 102, 241, 0);\n  }\n}\n@media (max-width: 640px) {\n  .ask-guru-launcher {\n    bottom: calc(4.8rem + env(safe-area-inset-bottom));\n    right: 0.75rem;\n    padding: 0.62rem;\n    border-radius: 0.95rem;\n  }\n  .launcher-text {\n    display: none;\n  }\n  .ask-guru-backdrop {\n    padding: 0;\n  }\n  .ask-guru-shell {\n    width: 100%;\n    height: 100vh;\n    border-radius: 0;\n  }\n  .message-bubble {\n    max-width: 88%;\n  }\n}\n/*# sourceMappingURL=ask-to-guru-assistant.component.css.map */\n"] }]
