        type: Component25,
        args: [{ selector: "app-supervisor-dashboard", standalone: true, imports: [CommonModule8, DecimalPipe14, RouterLink7], template: `<!-- =========================================================== -->\r
<!-- Supervisor dashboard                                          -->\r
<!-- =========================================================== -->\r
<section class="mx-auto w-full max-w-6xl space-y-5 md:space-y-6">\r
\r
  <!-- Welcome / context card --------------------------------------- -->\r
  <div\r
    class="overflow-hidden rounded-2xl border border-indigo-100 bg-gradient-to-br from-indigo-600 via-indigo-600 to-blue-700 p-5 text-white shadow-lg shadow-indigo-900/10 md:p-6 dark:border-indigo-900/60"\r
  >\r
    <div class="flex items-start justify-between gap-3">\r
      <div class="min-w-0">\r
        <p class="text-xs font-semibold uppercase tracking-wider text-indigo-100">\r
          Hello, {{ profile()?.name || 'Supervisor' }}\r
        </p>\r
        <h1 class="mt-1 truncate text-xl font-bold leading-tight md:text-2xl">\r
          {{ profile()?.businessName || 'Your assigned business' }}\r
        </h1>\r
        <p class="mt-1 text-sm text-indigo-100/90">\r
          Here's what needs your attention today.\r
        </p>\r
      </div>\r
      <span\r
        class="hidden h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/15 ring-1 ring-white/30 backdrop-blur-sm md:inline-flex"\r
        aria-hidden="true"\r
      >\r
        <span class="material-icons-outlined text-2xl">badge</span>\r
      </span>\r
    </div>\r
  </div>\r
\r
  <!-- Stat cards --------------------------------------------------- -->\r
  <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">\r
\r
    <!-- Overdue -->\r
    <a\r
      *ngIf="canViewMembers(); else overdueDisabled"\r
      routerLink="/supervisor/members"\r
      [queryParams]="{ due: 'overdue' }"\r
      class="group flex flex-col rounded-2xl border border-rose-100 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-rose-200 hover:shadow-md dark:border-rose-900/40 dark:bg-slate-900 dark:hover:border-rose-700"\r
    >\r
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-rose-50 text-rose-600 dark:bg-rose-950/50 dark:text-rose-300">\r
        <span class="material-icons-outlined">schedule</span>\r
      </span>\r
      <p class="mt-3 text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">\r
        Overdue\r
      </p>\r
      <p class="mt-1 text-2xl font-bold text-rose-600 tabular-nums dark:text-rose-300">\r
        {{ overdueMembers().length }}\r
      </p>\r
      <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">\r
        Members past due date\r
      </p>\r
    </a>\r
    <ng-template #overdueDisabled>\r
      <div class="flex flex-col rounded-2xl border border-slate-100 bg-white p-4 shadow-sm opacity-60 dark:border-slate-800 dark:bg-slate-900">\r
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-rose-50 text-rose-600 dark:bg-rose-950/50 dark:text-rose-300">\r
          <span class="material-icons-outlined">schedule</span>\r
        </span>\r
        <p class="mt-3 text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Overdue</p>\r
        <p class="mt-1 text-2xl font-bold text-slate-400 tabular-nums">\u2014</p>\r
        <p class="mt-0.5 text-[11px] text-slate-400">Permission required</p>\r
      </div>\r
    </ng-template>\r
\r
    <!-- Due today -->\r
    <a\r
      *ngIf="canViewMembers(); else dueTodayDisabled"\r
      routerLink="/supervisor/members"\r
      [queryParams]="{ due: 'dueToday' }"\r
      class="group flex flex-col rounded-2xl border border-amber-100 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-amber-200 hover:shadow-md dark:border-amber-900/40 dark:bg-slate-900 dark:hover:border-amber-700"\r
    >\r
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-950/50 dark:text-amber-300">\r
        <span class="material-icons-outlined">today</span>\r
      </span>\r
      <p class="mt-3 text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">\r
        Due today\r
      </p>\r
      <p class="mt-1 text-2xl font-bold text-amber-600 tabular-nums dark:text-amber-300">\r
        {{ dueTodayMembers().length }}\r
      </p>\r
      <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">\r
        Renewals due today\r
      </p>\r
    </a>\r
    <ng-template #dueTodayDisabled>\r
      <div class="flex flex-col rounded-2xl border border-slate-100 bg-white p-4 shadow-sm opacity-60 dark:border-slate-800 dark:bg-slate-900">\r
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-950/50 dark:text-amber-300">\r
          <span class="material-icons-outlined">today</span>\r
        </span>\r
        <p class="mt-3 text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Due today</p>\r
        <p class="mt-1 text-2xl font-bold text-slate-400 tabular-nums">\u2014</p>\r
        <p class="mt-0.5 text-[11px] text-slate-400">Permission required</p>\r
      </div>\r
    </ng-template>\r
\r
    <!-- Active members -->\r
    <div class="flex flex-col rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700/70 dark:bg-slate-900">\r
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 dark:bg-indigo-950/50 dark:text-indigo-300">\r
        <span class="material-icons-outlined">groups</span>\r
      </span>\r
      <p class="mt-3 text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">\r
        Active members\r
      </p>\r
      <p class="mt-1 text-2xl font-bold text-slate-800 tabular-nums dark:text-slate-100">\r
        {{ activeMembers().length }}\r
      </p>\r
      <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">\r
        Currently on the roster\r
      </p>\r
    </div>\r
\r
    <!-- Today's collections -->\r
    <div\r
      *ngIf="canViewPayments(); else collectionsHidden"\r
      class="flex flex-col rounded-2xl border border-emerald-100 bg-white p-4 shadow-sm dark:border-emerald-900/40 dark:bg-slate-900"\r
    >\r
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-300">\r
        <span class="material-icons-outlined">payments</span>\r
      </span>\r
      <p class="mt-3 text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">\r
        Today's collections\r
      </p>\r
      <p class="mt-1 text-2xl font-bold text-emerald-700 tabular-nums dark:text-emerald-300">\r
        \u20B9{{ todayCollectionsTotal() | number:'1.0-0' }}\r
      </p>\r
      <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">\r
        {{ todayPayments().length }}\r
        {{ todayPayments().length === 1 ? 'payment' : 'payments' }} recorded\r
      </p>\r
    </div>\r
    <ng-template #collectionsHidden>\r
      <div class="flex flex-col rounded-2xl border border-slate-100 bg-white p-4 shadow-sm opacity-60 dark:border-slate-800 dark:bg-slate-900">\r
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-300">\r
          <span class="material-icons-outlined">payments</span>\r
        </span>\r
        <p class="mt-3 text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Today's collections</p>\r
        <p class="mt-1 text-2xl font-bold text-slate-400 tabular-nums">\u2014</p>\r
        <p class="mt-0.5 text-[11px] text-slate-400">Permission required</p>\r
      </div>\r
    </ng-template>\r
  </div>\r
\r
  <!-- Quick actions ------------------------------------------------ -->\r
  @if (quickActions().length > 0) {\r
    <div>\r
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">\r
        Quick actions\r
      </h2>\r
      <div class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4 lg:grid-cols-4">\r
        @for (action of quickActions(); track action.label) {\r
          <a\r
            [routerLink]="action.route"\r
            [queryParams]="action.queryParams || {}"\r
            class="group relative flex items-start gap-3 overflow-hidden rounded-2xl border border-slate-200 bg-white p-4 text-left shadow-sm ring-1 transition hover:-translate-y-0.5 hover:shadow-md dark:border-slate-700/70 dark:bg-slate-900"\r
            [class]="toneClasses(action.tone).ring"\r
          >\r
            <span\r
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br text-white shadow-md transition group-hover:scale-105"\r
              [class]="toneClasses(action.tone).bg"\r
              aria-hidden="true"\r
            >\r
              <span class="material-icons-outlined text-[22px] leading-none">{{ action.icon }}</span>\r
            </span>\r
            <span class="min-w-0">\r
              <span class="block truncate text-sm font-semibold text-slate-900 dark:text-slate-100">\r
                {{ action.label }}\r
              </span>\r
              <span class="mt-0.5 block truncate text-[11px] text-slate-500 dark:text-slate-400">\r
                {{ action.hint }}\r
              </span>\r
            </span>\r
          </a>\r
        }\r
      </div>\r
    </div>\r
  }\r
\r
  <!-- Recent activity --------------------------------------------- -->\r
  @if (canViewPayments()) {\r
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700/70 dark:bg-slate-900">\r
      <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3 dark:border-slate-800">\r
        <div>\r
          <h2 class="text-sm font-semibold text-slate-800 dark:text-slate-100">\r
            Recent activity\r
          </h2>\r
          <p class="text-[11px] text-slate-500 dark:text-slate-400">\r
            Last few payments recorded\r
          </p>\r
        </div>\r
        @if (canSeeMoreActivity()) {\r
          <a\r
            routerLink="/supervisor/payments"\r
            class="inline-flex items-center gap-1 text-xs font-semibold text-indigo-600 transition hover:text-indigo-800 dark:text-indigo-300 dark:hover:text-indigo-200"\r
          >\r
            View all\r
            <span class="material-icons-outlined text-base">arrow_forward</span>\r
          </a>\r
        }\r
      </div>\r
\r
      @if (loading()) {\r
        <div class="px-4 py-6 text-center text-sm text-slate-500 dark:text-slate-400">\r
          Loading\u2026\r
        </div>\r
      } @else if (recentPayments().length === 0) {\r
        <div class="px-4 py-8 text-center">\r
          <span class="material-icons-outlined text-3xl text-slate-300 dark:text-slate-600">inbox</span>\r
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">\r
            No payments yet.\r
          </p>\r
          @if (canRecordPayments()) {\r
            <a\r
              routerLink="/supervisor/payments"\r
              [queryParams]="{ action: 'collect' }"\r
              class="mt-3 inline-flex items-center gap-1 rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white shadow hover:bg-emerald-700"\r
            >\r
              <span class="material-icons-outlined text-base">attach_money</span>\r
              Collect now\r
            </a>\r
          }\r
        </div>\r
      } @else {\r
        <ul class="divide-y divide-slate-100 dark:divide-slate-800">\r
          @for (p of recentPayments(); track p.paymentId) {\r
            <li class="flex items-center gap-3 px-4 py-3">\r
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300">\r
                <span class="material-icons-outlined text-[20px]">paid</span>\r
              </span>\r
              <div class="min-w-0 flex-1">\r
                <p class="truncate text-sm font-semibold text-slate-800 dark:text-slate-100">\r
                  {{ paymentMemberName(p) }}\r
                </p>\r
                <p class="truncate text-[11px] text-slate-500 dark:text-slate-400">\r
                  {{ p.method | titlecase }} \xB7 {{ paymentTime(p) }}\r
                </p>\r
              </div>\r
              <p class="shrink-0 text-sm font-bold text-emerald-700 tabular-nums dark:text-emerald-300">\r
                \u20B9{{ p.amount | number:'1.0-0' }}\r
              </p>\r
            </li>\r
          }\r
        </ul>\r
      }\r
    </div>\r
  }\r
\r
  <!-- Help / permissions footer ----------------------------------- -->\r
  <p class="text-center text-[11px] text-slate-400 dark:text-slate-500">\r
    Some actions may be hidden based on the permissions your owner has granted.\r
  </p>\r
</section>\r
` }]
