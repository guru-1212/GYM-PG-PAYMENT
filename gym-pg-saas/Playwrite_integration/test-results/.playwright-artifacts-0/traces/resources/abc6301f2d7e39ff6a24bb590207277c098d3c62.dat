                    </label>\r
                    <label class="flex items-center gap-1.5 text-slate-700">\r
                      <input\r
                        type="checkbox"\r
                        class="h-4 w-4 accent-emerald-600"\r
                        [checked]="isWhatsappEnabled(o)"\r
                        [disabled]="busyId() === o.ownerId"\r
                        (change)="toggleWhatsappEnabled(o, $any($event.target).checked)"\r
                      />\r
