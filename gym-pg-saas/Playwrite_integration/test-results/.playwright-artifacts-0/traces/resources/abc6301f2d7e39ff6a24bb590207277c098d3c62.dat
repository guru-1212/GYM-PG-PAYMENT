              role="menu"\r
            >\r
              <p class="border-b border-slate-100 px-3 py-2 text-xs text-slate-500 dark:border-slate-700 dark:text-slate-400">{{ 'auth.email' | t }}</p>\r
              <p class="px-3 pb-2 text-sm font-medium text-slate-900 break-all dark:text-slate-100">{{ profile()?.email }}</p>\r
