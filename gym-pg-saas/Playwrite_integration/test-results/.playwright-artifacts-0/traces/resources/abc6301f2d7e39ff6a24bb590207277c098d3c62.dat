          [class.bg-green-50]="filterMethod() !== 'cash'"\r
          [class.text-green-700]="filterMethod() !== 'cash'"\r
          class="flex w-full items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold transition-all duration-200"\r
        >\r
          <span class="material-icons text-lg"></span>\r
          Cash\r
        </button>\r
        <button\r
          type="button"\r
          (click)="filterByMethod('online'); stopPropagation($event)"\r
          [class.bg-gradient-to-r]="filterMethod() === 'online'"\r
          [class.from-blue-600]="filterMethod() === 'online'"\r
          [class.to-blue-800]="filterMethod() === 'online'"\r
          [class.text-white]="filterMethod() === 'online'"\r
          [class.shadow-lg]="filterMethod() === 'online'"\r
          [class.bg-blue-50]="filterMethod() !== 'online'"\r
          [class.text-blue-700]="filterMethod() !== 'online'"\r
          class="flex w-full items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold transition-all duration-200"\r
        >\r
          <span class="material-icons text-lg">payment</span>\r
          Online\r
        </button>\r
      </div>\r
    </div>\r
\r
    <!-- Main Content - Payments Table -->\r
    <div class="lg:col-span-3">\r
      <!-- Summary Cards -->\r
      <div class="mb-6 grid grid-cols-2 gap-4">\r
        <div class="rounded-xl border-2 border-slate-200 bg-white p-6">\r
          <p class="text-sm font-semibold text-slate-600">Total Earnings</p>\r
          <p class="mt-2 text-3xl font-bold bg-gradient-to-r from-blue-600 to-blue-800 bg-clip-text text-transparent">\r
            \u20B9{{ totalMonthEarnings() | number: '1.0-0' }}\r
          </p>\r
        </div>\r
        <div class="rounded-xl border-2 border-slate-200 bg-white p-6">\r
          <p class="text-sm font-semibold text-slate-600">Transactions</p>\r
          <p class="mt-2 text-3xl font-bold text-slate-900">\r
            {{ filteredPayments().length }}\r
          </p>\r
        </div>\r
      </div>\r
\r
      <!-- Payments Header -->\r
      <div class="mb-4 flex items-center justify-between">\r
        <h3 class="text-xl font-bold text-slate-900">\r
          {{ selectedMonth() }} {{ selectedYear() }} Payments\r
        </h3>\r
      </div>\r
\r
      <!-- Payments Table -->\r
      @if (filteredPayments().length === 0) {\r
        <div class="rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 py-12 text-center">\r
          <span class="material-icons mb-3 inline-block text-5xl text-slate-400">receipt_long</span>\r
          <p class="text-lg font-semibold text-slate-600">No payments found</p>\r
          <p class="mt-1 text-sm text-slate-500">Try selecting a different month or payment method</p>\r
        </div>\r
      } @else {\r
        <div class="overflow-hidden rounded-xl border-2 border-slate-200 shadow-lg">\r
          <div class="overflow-x-auto">\r
            <table class="w-full">\r
              <thead class="bg-gradient-to-r from-blue-50 via-slate-50 to-slate-50">\r
                <tr class="border-b-2 border-slate-200">\r
                  <th class="px-6 py-4 text-left text-sm font-bold text-slate-900">Member Name</th>\r
                  <th class="px-6 py-4 text-left text-sm font-bold text-slate-900">Payment Date</th>\r
                  <th class="px-6 py-4 text-right text-sm font-bold text-slate-900">Amount</th>\r
                  <th class="px-6 py-4 text-center text-sm font-bold text-slate-900">Method</th>\r
                </tr>\r
              </thead>\r
              <tbody class="divide-y divide-slate-100">\r
                @for (item of displayedPayments(); track item.payment.paymentId) {\r
                  <tr class="transition-colors hover:bg-slate-50">\r
                    <td class="px-6 py-4">\r
                      <div class="flex items-center gap-3">\r
                        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-100 text-sm font-bold text-blue-700">\r
                          {{ (item.memberName | slice: 0: 1).toUpperCase() }}\r
                        </div>\r
                        <div>\r
                          <p class="font-semibold text-slate-900">{{ item.memberName }}</p>\r
                        </div>\r
                      </div>\r
                    </td>\r
                    <td class="px-6 py-4">\r
                      <p class="text-slate-600">{{ item.paymentDate | date: 'MMM dd, yyyy' }}</p>\r
                    </td>\r
                    <td class="px-6 py-4 text-right">\r
                      <p class="text-lg font-bold text-slate-900">\u20B9{{ item.payment.amount | number: '1.0-0' }}</p>\r
                    </td>\r
                    <td class="px-6 py-4 text-center">\r
                      <span\r
                        [ngClass]="{\r
                          'bg-green-100 text-green-800': item.payment.method === 'cash',\r
                          'bg-blue-100 text-blue-800': item.payment.method === 'upi' || item.payment.method === 'card',\r
                        }"\r
                        class="inline-flex rounded-full px-3 py-1 text-xs font-bold capitalize"\r
                      >\r
                        {{ item.payment.method }}\r
                      </span>\r
                    </td>\r
                  </tr>\r
                }\r
              </tbody>\r
            </table>\r
          </div>\r
        </div>\r
\r
        <!-- Download Button -->\r
        <div class="mt-6">\r
          <button\r
            type="button"\r
            (click)="downloadPDF(); stopPropagation($event)"\r
            class="flex w-full items-center justify-center gap-2 rounded-lg bg-gradient-to-r from-red-600 to-red-700 px-6 py-3 font-bold text-white transition-all duration-200 hover:shadow-lg"\r
          >\r
            <span class="material-icons">download</span>\r
            Download as CSV\r
          </button>\r
        </div>\r
      }\r
    </div>\r
  </div>\r
</div>\r
