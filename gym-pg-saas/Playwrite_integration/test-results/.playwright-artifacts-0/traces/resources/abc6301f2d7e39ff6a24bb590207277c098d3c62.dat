  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">\r
    <div>\r
      <h1 class="text-2xl font-bold text-slate-900">{{ 'rooms.title' | t }}</h1>\r
      <p class="text-slate-600">{{ 'rooms.subtitle' | t }}</p>\r
    </div>\r
    @if (isPg()) {\r
      <button\r
        type="button"\r
        class="saas-btn-primary px-5 py-3 text-sm"\r
        (click)="openSetup()"\r
      >\r
        {{ 'rooms.setupBed' | t }}\r
      </button>\r
    }\r
  </div>\r
\r
  @if (!isPg()) {\r
    <div class="saas-card p-10 text-center text-slate-500">\r
      {{ 'rooms.pgOnly' | t }}\r
    </div>\r
  } @else if (!hasLayout()) {\r
    <div class="saas-card border-amber-200 bg-amber-50/80 p-8 text-center">\r
      <p class="font-semibold text-amber-900">{{ 'dashboard.setupRequired' | t }}</p>\r
      <p class="mt-1 text-sm text-amber-800">{{ 'rooms.setupPrompt' | t }}</p>\r
    </div>\r
  } @else {\r
    <div class="saas-card p-4">\r
      <p class="text-sm text-slate-600">\r
        {{ (pgLayout()?.floors?.length || 0) }} floors \xB7 {{ totalRooms() }} rooms \xB7 {{ totalBeds() }} beds\r
      </p>\r
    </div>\r
    <app-bed-map-seat-grid [layout]="pgLayout()" [members]="members()" [showOccupantActions]="true" />\r
  }\r
</div>\r
\r
<app-modal [open]="setupModalOpen()" title="Setup Bed Availability" (closed)="closeSetup()">\r
  <form [formGroup]="setupForm" class="space-y-4">\r
    <!-- Bed Status Info -->\r
    @if (occupiedBedCount() > 0) {\r
      <div class="rounded-lg border border-blue-200 bg-blue-50 p-3">\r
        <p class="text-sm text-blue-900">\r
          <strong>Current Status:</strong> {{ occupiedBedCount() }} bed{{ occupiedBedCount() !== 1 ? 's' : '' }} occupied, {{ totalBeds() - occupiedBedCount() }} empty\r
        </p>\r
        <p class="mt-1 text-xs text-blue-800">\r
          Proposed capacity: {{ proposedTotalBeds() }} bed{{ proposedTotalBeds() !== 1 ? 's' : '' }}\r
        </p>\r
      </div>\r
    }\r
\r
    @if (validationError()) {\r
      <div class="rounded-lg border border-red-200 bg-red-50 px-3 py-2">\r
        <p class="text-sm font-medium text-red-800">{{ validationError() }}</p>\r
      </div>\r
    }\r
\r
    <div>\r
      <label class="mb-1 block text-sm font-medium text-slate-700">Number of floors</label>\r
      <div class="flex items-center gap-2">\r
        <button\r
          type="button"\r
          class="rounded-lg border border-slate-200 px-3 py-2 text-lg font-semibold leading-none"\r
          (click)="decrementFloorCount()"\r
        >\r
          -\r
        </button>\r
        <input\r
          type="number"\r
          min="1"\r
          formControlName="floorCount"\r
          class="w-28 rounded-xl border border-slate-200 px-4 py-2 text-center text-base"\r
          (input)="onFloorCountChange($any($event.target).value)"\r
        />\r
        <button\r
          type="button"\r
          class="rounded-lg border border-slate-200 px-3 py-2 text-lg font-semibold leading-none"\r
          (click)="incrementFloorCount()"\r
        >\r
          +\r
        </button>\r
      </div>\r
    </div>\r
    <div class="max-h-[45vh] space-y-3 overflow-y-auto pr-1">\r
      @for (floor of floorGroups.controls; track $index; let floorIdx = $index) {\r
        <div class="rounded-xl border border-slate-200 p-3">\r
          <div class="mb-2 flex items-center justify-between">\r
            <p class="text-sm font-semibold text-slate-900">\r
              @if (+$any(floor.get('floorNumber')?.value) === 0) {\r
                {{ 'rooms.groundFloor' | t }}\r
              } @else {\r
                {{ 'rooms.floor' | t }} {{ floor.get('floorNumber')?.value }}\r
              }\r
            </p>\r
            <div class="flex items-center gap-2">\r
              <label class="text-xs text-slate-600">Rooms</label>\r
              <button\r
                type="button"\r
                class="rounded border border-slate-200 px-2 py-0.5 text-base font-semibold leading-none"\r
                (click)="decrementRoomCount(floorIdx)"\r
              >\r
                -\r
              </button>\r
              <input\r
                type="number"\r
                min="0"\r
                class="w-16 rounded-lg border border-slate-200 px-2 py-1 text-center text-sm"\r
                [value]="floor.get('roomCount')?.value"\r
                (input)="onRoomCountChange(floorIdx, $any($event.target).value)"\r
              />\r
              <button\r
                type="button"\r
                class="rounded border border-slate-200 px-2 py-0.5 text-base font-semibold leading-none"\r
                (click)="incrementRoomCount(floorIdx)"\r
              >\r
                +\r
              </button>\r
            </div>\r
          </div>\r
          @if (roomGroupsAt(floorIdx).length === 0) {\r
            <p class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-600">\r
              No rooms are available in this floor.\r
            </p>\r
          } @else {\r
            <div class="grid gap-2 sm:grid-cols-2">\r
              @for (room of roomGroupsAt(floorIdx).controls; track $index; let roomIdx = $index) {\r
                <div class="rounded-lg bg-slate-50 px-3 py-2" [formGroup]="$any(room)">\r
                  <p class="text-xs font-semibold text-slate-700">\r
                    {{ 'rooms.room' | t }} {{ formatRoomNumber(floorNumberAtFormIndex(floorIdx), roomIdx + 1) }}\r
                  </p>\r
                  <p class="mt-0.5 text-xs text-slate-500">{{ sharingLabel(room.get('beds')?.value) }}</p>\r
                  <label class="mt-1 block text-xs text-slate-500">Beds</label>\r
                  <div class="mt-1 flex items-center gap-2">\r
                    <button\r
                      type="button"\r
                      class="rounded border border-slate-200 px-2 py-0.5 text-base font-semibold leading-none"\r
                      (click)="decrementBedsCount(floorIdx, roomIdx)"\r
                    >\r
                      -\r
                    </button>\r
                    <input\r
                      type="number"\r
                      min="1"\r
                      class="w-16 rounded-lg border border-slate-200 px-2 py-1.5 text-center text-sm"\r
                      formControlName="beds"\r
                      (input)="onBedsCountChange(floorIdx, roomIdx, $any($event.target).value)"\r
                    />\r
                    <button\r
                      type="button"\r
                      class="rounded border border-slate-200 px-2 py-0.5 text-base font-semibold leading-none"\r
                      (click)="incrementBedsCount(floorIdx, roomIdx)"\r
                    >\r
                      +\r
                    </button>\r
                  </div>\r
                  <label class="mt-2 block text-xs text-slate-500">Rent (optional)</label>\r
                  <input\r
                    type="number"\r
                    min="1"\r
                    class="mt-1 w-full rounded-lg border border-slate-200 px-2 py-1.5 text-sm"\r
                    formControlName="rent"\r
                    placeholder="Price not mentioned"\r
                  />\r
                </div>\r
              }\r
            </div>\r
          }\r
        </div>\r
      }\r
    </div>\r
    <div class="flex flex-col-reverse gap-2 pt-2 sm:flex-row sm:justify-end">\r
      <button type="button" class="rounded-xl border border-slate-200 px-5 py-3 font-semibold" (click)="closeSetup()">\r
        Continue Later\r
      </button>\r
      <button\r
        type="button"\r
        class="rounded-xl border border-emerald-300 px-5 py-3 font-semibold text-emerald-700"\r
        (click)="saveDraft(true)"\r
      >\r
        Save Draft\r
      </button>\r
      <button\r
        type="button"\r
        class="rounded-xl bg-emerald-600 px-6 py-3 font-semibold text-white hover:bg-emerald-700"\r
        (click)="saveDraft(false)"\r
      >\r
        Save & Close\r
      </button>\r
    </div>\r
  </form>\r
</app-modal>\r
`, styles: ["/* angular:styles/component:scss;ad43e4fb63c116e24bb2e19604a9172f6ed2635eaf3a05835e302c0861fd7725;C:/Users/gurunath.h/Desktop/New folder/GYM-PG-PAYMENT/gym-pg-saas/src/app/pages/rooms/rooms-page.component.ts */\ninput[type=number]::-webkit-outer-spin-button,\ninput[type=number]::-webkit-inner-spin-button {\n  -webkit-appearance: none;\n  margin: 0;\n}\ninput[type=number] {\n  -moz-appearance: textfield;\n  appearance: textfield;\n}\n/*# sourceMappingURL=rooms-page.component.css.map */\n"] }]
