    (() => {
      (typeof ngDevMode === "undefined" || ngDevMode) && i018.\u0275setClassMetadata(HomeComponent, [{
        type: Component10,
        args: [{ selector: "app-home", standalone: true, imports: [CommonModule4, FormsModule2, RouterModule, BrandLogoComponent, ThemeToggleComponent], template: `<div class="home-bg min-h-screen">\r
  <div class="saas-page mx-auto max-w-6xl space-y-10 px-4 py-5 sm:px-6 lg:px-8">\r
    <nav class="glass-nav sticky top-3 z-50 rounded-2xl border border-white/60 bg-white/85 px-3 py-2.5 shadow-sm backdrop-blur-xl sm:px-4 sm:py-3">\r
      <div\r
        class="flex w-full min-w-0 flex-nowrap items-center justify-between gap-2 sm:gap-3 lg:gap-4"\r
      >\r
        <app-brand-logo class="min-w-0 shrink" [logoSize]="'38px'" [showText]="true" brandName="OurPGTracker"></app-brand-logo>\r
\r
        <!-- Desktop: centre links \u2014 horizontal scroll on very tight widths (never wrap). -->\r
        <div\r
          class="mx-1 hidden min-h-0 min-w-0 flex-1 justify-center overflow-x-auto [-ms-overflow-style:none] [scrollbar-width:none] lg:flex [&::-webkit-scrollbar]:hidden"\r
        >\r
          <div class="inline-flex items-center gap-0.5 whitespace-nowrap px-0.5 py-0.5 sm:gap-1">\r
            <button class="nav-link nav-link--dense" type="button" (click)="scrollTo('about')">About</button>\r
            <button class="nav-link nav-link--dense" type="button" (click)="scrollTo('benefits')">Benefits</button>\r
            <button class="nav-link nav-link--dense" type="button" (click)="scrollTo('features')">Features</button>\r
            <button class="nav-link nav-link--dense" type="button" (click)="scrollTo('how-it-works')">How It Works</button>\r
            <button class="nav-link nav-link--dense" type="button" (click)="scrollTo('contact')">Contact Us</button>\r
          </div>\r
        </div>\r
\r
        <!-- Desktop: theme + Sign in menu + Start Free (single row). -->\r
        <div class="hidden shrink-0 items-center gap-2 lg:flex">\r
          <app-theme-toggle />\r
          <div class="relative" data-home-signin-menu>\r
            <button\r
              type="button"\r
              class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white/80 px-3 py-2 text-sm font-semibold text-slate-800 shadow-sm transition hover:bg-white dark:border-slate-600 dark:bg-slate-900/70 dark:text-slate-100 dark:hover:bg-slate-800"\r
              (click)="onDesktopSignInToggle($event)"\r
              [attr.aria-expanded]="desktopSignInOpen()"\r
              [attr.aria-haspopup]="true"\r
            >\r
              Sign in\r
              <i\r
                class="fa-solid fa-chevron-down text-[0.6rem] opacity-70 transition-transform duration-200"\r
                [class.rotate-180]="desktopSignInOpen()"\r
                aria-hidden="true"\r
              ></i>\r
            </button>\r
            @if (desktopSignInOpen()) {\r
              <div\r
                class="absolute right-0 top-[calc(100%+0.35rem)] z-[70] min-w-[14rem] overflow-hidden rounded-xl border border-slate-200/90 bg-white py-1 shadow-xl dark:border-slate-600 dark:bg-slate-900"\r
                role="menu"\r
                (click)="$event.stopPropagation()"\r
              >\r
                <p class="border-b border-slate-100 px-3 py-2 text-[10px] font-bold uppercase tracking-wide text-slate-400 dark:border-slate-700 dark:text-slate-500">\r
                  Choose account\r
                </p>\r
                <a\r
                  routerLink="/login"\r
                  [queryParams]="{ mode: 'signin' }"\r
                  class="flex items-center gap-2 px-3 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800/80"\r
                  role="menuitem"\r
                  (click)="closeDesktopSignInMenu()"\r
                >\r
                  <i class="fa-solid fa-building-user w-4 text-center text-slate-500" aria-hidden="true"></i>\r
                  Owner / supervisor\r
                </a>\r
                <a\r
                  routerLink="/login"\r
                  [queryParams]="{ mode: 'signin' }"\r
                  class="flex items-center gap-2 px-3 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800/80"\r
                  role="menuitem"\r
                  (click)="closeDesktopSignInMenu()"\r
                >\r
                  <i class="fa-solid fa-shield-halved w-4 text-center text-slate-500" aria-hidden="true"></i>\r
                  Admin\r
                </a>\r
                <a\r
                  routerLink="/member-app/login"\r
                  class="flex items-center gap-2 px-3 py-2.5 text-sm font-semibold text-teal-800 transition hover:bg-teal-50 dark:text-teal-200 dark:hover:bg-teal-950/50"\r
                  role="menuitem"\r
                  (click)="closeDesktopSignInMenu()"\r
                >\r
                  <i class="fa-solid fa-house-user w-4 text-center text-teal-600 dark:text-teal-400" aria-hidden="true"></i>\r
                  Tenant\r
                </a>\r
                @if (showInstallCta()) {\r
                  <div class="my-1 border-t border-slate-100 dark:border-slate-700"></div>\r
                  <button\r
                    type="button"\r
                    class="flex w-full items-center gap-2 px-3 py-2.5 text-left text-sm font-semibold text-emerald-800 transition hover:bg-emerald-50 dark:text-emerald-200 dark:hover:bg-emerald-950/40"\r
                    role="menuitem"\r
                    (click)="installApp()"\r
                    [attr.title]="isIosSafari() ? 'See how to add to your iPhone home screen' : 'Install the app on this device'"\r
                  >\r
                    <i class="fa-solid fa-download w-4 text-center text-emerald-600 dark:text-emerald-400" aria-hidden="true"></i>\r
                    Install app\r
                  </button>\r
                }\r
              </div>\r
            }\r
          </div>\r
          <a\r
            routerLink="/login"\r
            [queryParams]="{ mode: 'signup' }"\r
            class="btn-gradient btn-border-anim shrink-0 rounded-xl px-3 py-2 text-sm font-semibold text-white shadow-md transition hover:opacity-95 sm:px-4"\r
          >\r
            Start Free\r
          </a>\r
        </div>\r
\r
        <button class="menu-btn shrink-0 lg:hidden" type="button" (click)="mobileMenuOpen = !mobileMenuOpen" aria-label="Toggle menu">\r
          <i class="fa-solid" [class.fa-bars]="!mobileMenuOpen" [class.fa-xmark]="mobileMenuOpen"></i>\r
        </button>\r
      </div>\r
\r
      <div *ngIf="mobileMenuOpen" class="mt-3 space-y-2 rounded-xl border border-slate-200 bg-white/90 p-3 lg:hidden">\r
        <app-theme-toggle />\r
        <a\r
          routerLink="/member-app/login"\r
          (click)="mobileMenuOpen = false"\r
          class="mobile-link block w-full rounded-lg border border-teal-200 bg-teal-50 py-2 text-center font-semibold text-teal-800"\r
        >\r
          Tenant login\r
        </a>\r
        <button class="mobile-link" type="button" (click)="scrollTo('about')">About</button>\r
        <button class="mobile-link" type="button" (click)="scrollTo('benefits')">Benefits</button>\r
        <button class="mobile-link" type="button" (click)="scrollTo('features')">Features</button>\r
        <button class="mobile-link" type="button" (click)="scrollTo('how-it-works')">How It Works</button>\r
        <button class="mobile-link" type="button" (click)="scrollTo('contact')">Contact Us</button>\r
        @if (showInstallCta()) {\r
          <button\r
            type="button"\r
            (click)="installApp()"\r
            class="flex w-full items-center justify-center gap-1.5 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-700"\r
          >\r
            <i class="fa-solid fa-download"></i>\r
            Install App\r
          </button>\r
        }\r
        <div class="flex gap-2 pt-1">\r
          <a routerLink="/login" [queryParams]="{ mode: 'signin' }" class="flex-1 rounded-lg border border-slate-200 bg-white px-3 py-2 text-center text-sm font-semibold text-slate-700">\r
            Sign In\r
          </a>\r
          <a routerLink="/login" [queryParams]="{ mode: 'signup' }" class="btn-gradient btn-border-anim flex-1 rounded-lg px-3 py-2 text-center text-sm font-semibold text-white">\r
            Start Free\r
          </a>\r
        </div>\r
      </div>\r
    </nav>\r
\r
    <section class="saas-card relative overflow-hidden p-6 sm:p-8" id="top">\r
      <div class="hero-glow"></div>\r
      <div class="relative z-10 grid gap-8 lg:grid-cols-[1.3fr_1fr] lg:items-center">\r
        <div>\r
          <p\r
            class="mb-3 inline-flex rounded-full border border-indigo-200/80 bg-indigo-50/70 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-indigo-700 dark:border-indigo-500/35 dark:bg-indigo-950/70 dark:text-indigo-200"\r
          >\r
            Built for PG & Hostel Owners\r
          </p>\r
          <h1 class="text-3xl font-bold leading-tight text-slate-900 sm:text-4xl">\r
            <span class="bg-gradient-to-r from-indigo-600 to-blue-600 bg-clip-text text-transparent">Our PG Tracker</span>\r
            \u2013 Manage PG Rooms, Rent &amp; Tenants Easily\r
          </h1>\r
          <p class="mt-4 max-w-2xl text-sm text-slate-600 sm:text-base">\r
            Our PG Tracker is a simple PG management software that helps owners track rent, manage tenants,\r
            assign rooms and beds, and monitor monthly earnings \u2014 all in one clear dashboard.\r
          </p>\r
          <div class="mt-6 flex flex-wrap gap-3">\r
            <a routerLink="/login" [queryParams]="{ mode: 'signup' }" class="btn-gradient btn-border-anim rounded-xl px-5 py-2.5 text-sm font-semibold text-white shadow-md transition hover:opacity-95">\r
              Start Free\r
            </a>\r
            <button type="button" class="rounded-xl border border-slate-200 bg-white/70 px-5 py-2.5 text-sm font-semibold text-slate-700 backdrop-blur hover:bg-white" (click)="scrollTo('contact')">\r
              Request Demo\r
            </button>\r
          </div>\r
        </div>\r
\r
        <div\r
          class="glass-panel rounded-2xl border border-white/70 bg-white/55 p-4 shadow-xl backdrop-blur-xl dark:border-slate-600/70 dark:bg-slate-900/65 dark:shadow-black/30"\r
        >\r
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Live Snapshot</p>\r
          <div class="mt-3 grid gap-3 sm:grid-cols-2">\r
            <div class="rounded-xl border border-white/70 bg-white/70 p-3">\r
              <p class="text-xs text-slate-500">Total Members</p>\r
              <p class="mt-1 text-xl font-bold text-slate-900">1,280</p>\r
            </div>\r
            <div class="rounded-xl border border-white/70 bg-white/70 p-3">\r
              <p class="text-xs text-slate-500">Monthly Earnings</p>\r
              <p class="mt-1 text-xl font-bold text-emerald-700">\u20B94.2L</p>\r
            </div>\r
            <div class="rounded-xl border border-white/70 bg-white/70 p-3">\r
              <p class="text-xs text-slate-500">Occupied Beds</p>\r
              <p class="mt-1 text-xl font-bold text-slate-900">96</p>\r
            </div>\r
            <div class="rounded-xl border border-white/70 bg-white/70 p-3">\r
              <p class="text-xs text-slate-500">Pending Dues</p>\r
              <p class="mt-1 text-xl font-bold text-amber-700">34</p>\r
            </div>\r
          </div>\r
        </div>\r
      </div>\r
    </section>\r
\r
    <section class="saas-card border-white/70 bg-white/65 p-6 backdrop-blur-xl sm:p-8" id="about" aria-labelledby="about-title">\r
      <div class="grid gap-6 lg:grid-cols-[1fr_1.1fr] lg:items-start">\r
        <div>\r
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-indigo-700">About</p>\r
          <h2 id="about-title" class="text-2xl font-bold text-slate-900">About Our PG Tracker</h2>\r
          <p class="mt-3 text-sm text-slate-600 sm:text-base">\r
            <strong>Our PG Tracker</strong> is an easy-to-use PG management software built for owners of paying-guest accommodations,\r
            hostels, and co-living properties. It brings rent tracking, tenant management, and room &amp; bed allotment\r
            into a single, clean dashboard so you can run daily operations without spreadsheets or paperwork.\r
          </p>\r
        </div>\r
        <div class="grid gap-3 sm:grid-cols-2">\r
          <div class="rounded-xl border border-white/70 bg-white/70 p-4">\r
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Who it's for</p>\r
            <p class="mt-1 text-sm text-slate-700">\r
              PG owners, hostel managers, and co-living operators who want a simple way to track rent and tenants.\r
            </p>\r
          </div>\r
          <div class="rounded-xl border border-white/70 bg-white/70 p-4">\r
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Key benefits</p>\r
            <ul class="mt-1 list-disc space-y-1 pl-5 text-sm text-slate-700">\r
              <li>Rent tracking with pending &amp; overdue alerts</li>\r
              <li>Tenant management with full payment history</li>\r
              <li>Live room &amp; bed occupancy view</li>\r
              <li>Monthly earnings &amp; growth insights</li>\r
            </ul>\r
          </div>\r
        </div>\r
      </div>\r
    </section>\r
\r
    <section class="space-y-4" id="benefits">\r
      <div class="text-center">\r
        <h2 class="text-2xl font-bold text-slate-900">Why owners choose Our PG Tracker</h2>\r
        <p class="mt-1 text-sm text-slate-600">Quickly understand what you get as a PG or hostel owner.</p>\r
      </div>\r
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">\r
        <article *ngFor="let benefit of quickBenefits" class="saas-card border-white/70 bg-white/60 p-5 backdrop-blur-xl transition hover:-translate-y-0.5">\r
          <div class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-indigo-700 shadow-sm">\r
            <i class="fa-solid {{ benefit.icon }}" aria-hidden="true"></i>\r
          </div>\r
          <h3 class="text-base font-semibold text-slate-900">{{ benefit.title }}</h3>\r
        </article>\r
      </div>\r
    </section>\r
\r
    <section class="space-y-4" id="features">\r
      <div class="text-center">\r
        <h2 class="text-2xl font-bold text-slate-900">Everything Our PG Tracker offers</h2>\r
        <p class="mt-1 text-sm text-slate-600">Rent, tenants, rooms and reports \u2014 grouped for easy day-to-day PG operations.</p>\r
      </div>\r
      <div class="grid gap-4 md:grid-cols-2">\r
        <article *ngFor="let section of groupedFeatures" class="saas-card border-white/70 bg-white/60 p-5 backdrop-blur-xl">\r
          <div class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-700 shadow-sm">\r
            <i class="fa-solid {{ section.icon }}" aria-hidden="true"></i>\r
          </div>\r
          <h3 class="text-lg font-semibold text-slate-900">{{ section.title }}</h3>\r
          <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-slate-600">\r
            <li *ngFor="let point of section.points">{{ point }}</li>\r
          </ul>\r
          <p class="mt-3 text-sm font-semibold text-indigo-700">{{ section.summary }}</p>\r
        </article>\r
      </div>\r
    </section>\r
\r
    <section class="saas-card border-white/70 bg-white/65 p-6 backdrop-blur-xl sm:p-8" id="how-it-works">\r
      <h2 class="text-center text-2xl font-bold text-slate-900">How Our PG Tracker works</h2>\r
      <p class="mx-auto mt-2 max-w-2xl text-center text-sm text-slate-600">\r
        Get started in three simple steps and start managing your PG, tenants and rent from day one.\r
      </p>\r
      <div class="mt-6 grid gap-4 md:grid-cols-3">\r
        <article class="step-card">\r
          <p class="step-tag">Step 1</p>\r
          <h3>Set up your PG</h3>\r
          <p>Configure floors, rooms, and beds as per your property setup.</p>\r
        </article>\r
        <article class="step-card">\r
          <p class="step-tag">Step 2</p>\r
          <h3>Add tenants</h3>\r
          <p>Add tenant details and assign beds in just a few clicks.</p>\r
        </article>\r
        <article class="step-card">\r
          <p class="step-tag">Step 3</p>\r
          <h3>Track rent &amp; earnings</h3>\r
          <p>Monitor rent payments, pending dues, and monthly growth from your dashboard.</p>\r
        </article>\r
      </div>\r
    </section>\r
\r
    <section class="saas-card border-white/70 bg-gradient-to-br from-indigo-600/90 to-blue-700/90 p-6 text-center text-white backdrop-blur-xl sm:p-8">\r
      <h2 class="text-2xl font-bold">Start managing your PG digitally with Our PG Tracker.</h2>\r
      <p class="mt-2 text-sm text-indigo-100">Faster rent collection, clearer tenant records, and one dashboard for every room.</p>\r
      <div class="mt-5 flex flex-wrap items-center justify-center gap-3">\r
        <a routerLink="/login" [queryParams]="{ mode: 'signup' }" class="btn-light btn-border-anim inline-flex rounded-xl px-5 py-2.5 text-sm font-semibold text-indigo-700 shadow-md transition hover:bg-indigo-50">\r
          Start Free\r
        </a>\r
        <button type="button" class="btn-gradient btn-border-anim inline-flex rounded-xl px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-500/45" (click)="scrollTo('contact')">\r
          Contact / Demo\r
        </button>\r
      </div>\r
    </section>\r
\r
    <section class="saas-card border-white/70 bg-white/70 p-6 backdrop-blur-xl sm:p-8" id="contact">\r
      <div class="mb-5 text-center">\r
        <h2 class="text-2xl font-bold text-slate-900">Request Demo</h2>\r
        <p class="mt-1 text-sm text-slate-600">Fill details and send directly on WhatsApp.</p>\r
      </div>\r
      <form #demoFormRef="ngForm" class="grid gap-4 md:grid-cols-2" (ngSubmit)="sendDemoRequest(demoFormRef)" novalidate>\r
        <label class="field">\r
          <span>Name</span>\r
          <input type="text" [(ngModel)]="demoForm.name" name="name" required minlength="2" maxlength="60" placeholder="Enter your name" #nameModel="ngModel" />\r
          <small class="field-error" *ngIf="nameModel.invalid && (nameModel.dirty || nameModel.touched)">Enter valid name</small>\r
        </label>\r
        <label class="field">\r
          <span>Business Type</span>\r
          <select [(ngModel)]="demoForm.businessType" name="businessType" required>\r
            <option value="pg">PG</option>\r
            <option value="hostel">Hostel</option>\r
            <option value="other">Other</option>\r
          </select>\r
        </label>\r
        <label class="field md:col-span-2">\r
          <span>Address</span>\r
          <textarea rows="3" [(ngModel)]="demoForm.address" name="address" required minlength="5" maxlength="180" placeholder="Enter your address" #addressModel="ngModel"></textarea>\r
          <small class="field-error" *ngIf="addressModel.invalid && (addressModel.dirty || addressModel.touched)">Enter valid address</small>\r
        </label>\r
        <label class="field">\r
          <span>Email</span>\r
          <input type="email" [(ngModel)]="demoForm.email" name="email" required email placeholder="Enter your email" #emailModel="ngModel" />\r
          <small class="field-error" *ngIf="emailModel.invalid && (emailModel.dirty || emailModel.touched)">Enter valid email</small>\r
        </label>\r
        <label class="field">\r
          <span>Mobile</span>\r
          <input type="tel" [(ngModel)]="demoForm.mobile" name="mobile" required pattern="[0-9]{10}" maxlength="10" placeholder="Enter 10-digit mobile number" #mobileModel="ngModel" />\r
          <small class="field-error" *ngIf="mobileModel.invalid && (mobileModel.dirty || mobileModel.touched)">Enter valid 10-digit mobile</small>\r
        </label>\r
\r
        <div class="md:col-span-2 flex flex-wrap justify-end gap-3">\r
          <button type="button" class="rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" (click)="openWhatsAppGeneral()">\r
            General WhatsApp\r
          </button>\r
          <button type="submit" [disabled]="demoFormRef.invalid || !isDemoFormValid()" class="btn-gradient btn-border-anim rounded-xl px-5 py-2.5 text-sm font-semibold text-white shadow-md transition hover:opacity-95 disabled:cursor-not-allowed disabled:opacity-50">\r
            Send Demo Request\r
          </button>\r
        </div>\r
      </form>\r
    </section>\r
\r
    <!-- Hero banner carousel (images in public/banners_carousel_home_page) \u2014 at end of page -->\r
    <section\r
      id="highlights-carousel"\r
      class="home-carousel-section"\r
      aria-roledescription="carousel"\r
      aria-labelledby="highlights-carousel-title"\r
      tabindex="0"\r
      (pointerenter)="onCarouselPointerEnter()"\r
      (pointerleave)="onCarouselPointerLeave()"\r
      (keydown)="onCarouselKeydown($event)"\r
    >\r
      <header class="mb-5 text-center sm:mb-6">\r
        <h2 id="highlights-carousel-title" class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100 sm:text-3xl">\r
          See Our PG Tracker in action\r
        </h2>\r
        <p class="mx-auto mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-400 sm:text-base">\r
          A quick tour of the owner app \u2014 rooms, rent collections, tenants, and insights in one place.\r
        </p>\r
      </header>\r
      <div class="home-carousel-viewport">\r
        <div\r
          class="home-carousel-track"\r
          [ngStyle]="{\r
            width: heroCarouselSlides.length * 100 + '%',\r
            transform: carouselTrackTransform(),\r
          }"\r
        >\r
          @for (slide of heroCarouselSlides; track slide.src; let i = $index) {\r
            <div class="home-carousel-slide" [style.flex]="'0 0 ' + 100 / heroCarouselSlides.length + '%'">\r
              <div class="home-carousel-slide-inner">\r
                <img\r
                  class="home-carousel-img"\r
                  [src]="slide.src"\r
                  [alt]="slide.alt"\r
                  [attr.fetchpriority]="i === 0 ? 'high' : null"\r
                  [attr.loading]="i === 0 ? 'eager' : 'lazy'"\r
                  draggable="false"\r
                />\r
              </div>\r
            </div>\r
          }\r
        </div>\r
\r
        <button\r
          type="button"\r
          class="home-carousel-nav home-carousel-nav--prev"\r
          (click)="prevCarousel()"\r
          aria-label="Previous slide"\r
        >\r
          <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>\r
        </button>\r
        <button\r
          type="button"\r
          class="home-carousel-nav home-carousel-nav--next"\r
          (click)="nextCarousel()"\r
          aria-label="Next slide"\r
        >\r
          <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>\r
        </button>\r
      </div>\r
\r
      <div class="home-carousel-dots" role="tablist" aria-label="Choose slide">\r
        @for (slide of heroCarouselSlides; track slide.src; let i = $index) {\r
          <button\r
            type="button"\r
            role="tab"\r
            [attr.aria-selected]="carouselIndex() === i"\r
            [attr.aria-label]="'Slide ' + (i + 1)"\r
            class="home-carousel-dot"\r
            [class.home-carousel-dot--active]="carouselIndex() === i"\r
            (click)="goCarousel(i)"\r
          ></button>\r
        }\r
      </div>\r
    </section>\r
\r
    <footer class="rounded-2xl border border-white/60 bg-white/60 p-4 text-center text-xs text-slate-500 backdrop-blur-xl">\r
      \xA9 2026 Our PG Tracker \u2014 PG management, rent tracking &amp; tenant management made simple. v-03/04 v1.0.7\r
    </footer>\r
  </div>\r
\r
  <button\r
    class="wa-fab"\r
    type="button"\r
    (click)="openWhatsAppGeneral()"\r
    aria-label="Contact on WhatsApp"\r
    title="Chat on WhatsApp"\r
  >\r
    <i class="fa-brands fa-whatsapp wa-icon" aria-hidden="true"></i>\r
    <span class="wa-text">WhatsApp</span>\r
  </button>\r
</div>\r
`, styles: ['@charset "UTF-8";\n\n/* src/app/pages/home/home.component.scss */\n:host {\n  display: block;\n}\n.home-carousel-section {\n  outline: none;\n}\n.home-carousel-section:focus-visible {\n  outline: 2px solid rgba(99, 102, 241, 0.55);\n  outline-offset: 4px;\n  border-radius: 1.35rem;\n}\n.home-carousel-viewport {\n  position: relative;\n  overflow: hidden;\n  border-radius: 1.25rem;\n  border: 1px solid rgba(255, 255, 255, 0.65);\n  background: rgba(15, 23, 42, 0.06);\n  box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.08), 0 24px 48px -12px rgba(30, 41, 59, 0.22);\n}\n:host-context(html.dark) .home-carousel-viewport {\n  border-color: rgba(51, 65, 85, 0.85);\n  background: rgba(2, 6, 23, 0.5);\n  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.35), 0 24px 48px -12px rgba(0, 0, 0, 0.45);\n}\n.home-carousel-track {\n  display: flex;\n  will-change: transform;\n  transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);\n}\n@media (prefers-reduced-motion: reduce) {\n  .home-carousel-track {\n    transition: none;\n  }\n}\n.home-carousel-slide-inner {\n  position: relative;\n  width: 100%;\n  aspect-ratio: 16/9;\n  min-height: 11.5rem;\n  max-height: min(70vh, 28rem);\n}\n@media (min-width: 640px) {\n  .home-carousel-slide-inner {\n    min-height: 12.5rem;\n    max-height: min(72vh, 30rem);\n  }\n}\n@media (min-width: 1024px) {\n  .home-carousel-slide-inner {\n    min-height: 13rem;\n    max-height: min(75vh, 32rem);\n  }\n}\n.home-carousel-img {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: center;\n  display: block;\n}\n.home-carousel-nav {\n  position: absolute;\n  top: 50%;\n  z-index: 4;\n  transform: translateY(-50%);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 2.25rem;\n  height: 2.25rem;\n  border-radius: 999px;\n  border: 1px solid rgba(255, 255, 255, 0.35);\n  background: rgba(15, 23, 42, 0.45);\n  color: #fff;\n  cursor: pointer;\n  backdrop-filter: blur(8px);\n  transition:\n    background 0.2s ease,\n    transform 0.15s ease,\n    opacity 0.2s ease;\n}\n@media (min-width: 640px) {\n  .home-carousel-nav {\n    width: 2.65rem;\n    height: 2.65rem;\n  }\n}\n.home-carousel-nav:hover {\n  background: rgba(79, 70, 229, 0.65);\n  transform: translateY(-50%) scale(1.04);\n}\n.home-carousel-nav:active {\n  transform: translateY(-50%) scale(0.96);\n}\n.home-carousel-nav--prev {\n  left: 0.45rem;\n}\n.home-carousel-nav--next {\n  right: 0.45rem;\n}\n@media (min-width: 640px) {\n  .home-carousel-nav--prev {\n    left: 0.85rem;\n  }\n  .home-carousel-nav--next {\n    right: 0.85rem;\n  }\n}\n.home-carousel-dots {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 0.4rem;\n  margin-top: 0.85rem;\n  padding: 0 0.25rem;\n}\n.home-carousel-dot {\n  width: 0.45rem;\n  height: 0.45rem;\n  padding: 0;\n  border: 0;\n  border-radius: 999px;\n  background: rgba(100, 116, 139, 0.45);\n  cursor: pointer;\n  transition:\n    width 0.25s ease,\n    background 0.2s ease,\n    opacity 0.2s ease;\n}\n@media (min-width: 640px) {\n  .home-carousel-dot {\n    width: 0.5rem;\n    height: 0.5rem;\n  }\n}\n.home-carousel-dot:hover {\n  background: rgba(71, 85, 105, 0.75);\n}\n.home-carousel-dot--active {\n  width: 1.35rem;\n  background:\n    linear-gradient(\n      90deg,\n      #6366f1,\n      #3b82f6);\n}\n:host-context(html.dark) .home-carousel-dot {\n  background: rgba(148, 163, 184, 0.35);\n}\n:host-context(html.dark) .home-carousel-dot:hover {\n  background: rgba(148, 163, 184, 0.55);\n}\n.home-bg {\n  background:\n    radial-gradient(\n      800px 400px at 0% 0%,\n      rgba(59, 130, 246, 0.14),\n      transparent 60%),\n    radial-gradient(\n      700px 350px at 100% 0%,\n      rgba(14, 165, 233, 0.13),\n      transparent 60%),\n    linear-gradient(\n      180deg,\n      #f8fafc 0%,\n      #eef2ff 45%,\n      #f8fafc 100%);\n}\n:host-context(html.dark) .home-bg {\n  background:\n    radial-gradient(\n      78